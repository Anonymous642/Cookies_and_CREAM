{"manifest_version": 2, "name": "TEA Focus \u2013 Rutina y Web Calm", "version": "1.0.0", "description": "Apoyo visual para alumnado TEA: rutina/agenda, temporizador suave y modo Web Calm para reducir sobrecarga y mejorar la concentraci\u00f3n.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "tea-focus@pp4mnk", "strict_min_version": "102.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "browser_action": {"default_title": "TEA Focus", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["activeTab", "storage"], "commands": {"toggle-calm": {"suggested_key": {"default": "Ctrl+Shift+C"}, "description": "Activar/desactivar Web Calm"}, "toggle-panel": {"suggested_key": {"default": "Ctrl+Shift+R"}, "description": "Mostrar/ocultar Rutina"}, "start-timer": {"suggested_key": {"default": "Ctrl+Shift+T"}, "description": "Iniciar temporizador"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}]}