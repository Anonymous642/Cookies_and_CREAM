{"manifest_version": 3, "name": "Screenshot Crawler", "version": "1.2.8", "description": "Screenshot the visible area, the whole page, or any inner scrolling panel at full length. Captures sidebars, dashboards and scrolling DIVs that ordinary full-page capture misses. Batch-crawl a list of URLs (Pro). Save as PNG or PDF.", "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "app@screenshotcrawler.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["lib/modes.js", "lib/toolbar-action.js", "lib/licence.js", "lib/history.js", "lib/filenames.js", "result/pdf.js", "result/ocr.js", "lib/capture-registry.js", "background.js"]}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/crop-toolbar.svg", "32": "icons/crop-toolbar.svg", "48": "icons/crop-toolbar.svg"}, "default_title": "Screenshot Crawler"}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "menus", "scripting", "tabs", "downloads", "storage", "clipboardWrite", "notifications"], "optional_host_permissions": ["<all_urls>"], "commands": {"capture-visible": {"suggested_key": {"default": "Alt+Shift+V"}, "description": "Capture the visible viewport"}, "capture-fullpage": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Capture the full page via scroll-and-stitch"}, "capture-pick": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Pick a scrollable element and capture it in full"}, "capture-region": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Drag to select a region and capture it"}, "stop-recording": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Stop the screen recording and save it"}, "cancel-recording": {"suggested_key": {"default": "Alt+Shift+X"}, "description": "Cancel the screen recording and discard it"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "homepage_url": "https://www.screenshotcrawler.com", "content_scripts": [{"matches": ["https://screenshotcrawler.com/*", "https://www.screenshotcrawler.com/*"], "js": ["content/activate.js"], "run_at": "document_idle"}]}