{"manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "nuenki_firefox_0_stopbeingduplicate@nuenki.app", "strict_min_version": "110.0"}}, "name": "Nuenki", "description": "Learn languages while you browse the web.", "version": "2.0.0", "permissions": ["storage", "tabs", "alarms"], "action": {"default_popup": "./popup.html", "default_area": "navbar"}, "icons": {"96": "./assets/logo-g-96.png", "256": "./assets/logo-g-256.png", "512": "./assets/logo-g-512.png"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["./root.js"], "all_frames": true}], "background": {"scripts": ["./background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "web_accessible_resources": [{"resources": ["pages/licenses.html", "pages/welcome_msg.gif"], "matches": ["<all_urls>"]}]}