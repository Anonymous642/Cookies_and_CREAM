{"manifest_version": 3, "name": "am Familientisch \u2013 Rezept-Import", "version": "1.1.1", "description": "Liest JSON-LD-Rezeptdaten von der aktuellen Seite aus und sendet sie zur Review an die am-Familientisch-Webapp.", "action": {"default_popup": "popup.html", "default_title": "Rezept-JSON-LD extrahieren", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://firestore.googleapis.com/*", "https://identitytoolkit.googleapis.com/*", "https://securetoken.googleapis.com/*"], "browser_specific_settings": {"gecko": {"id": "rezept-import@am-familientisch.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "authenticationInfo", "personallyIdentifyingInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}