{"manifest_version": 2, "name": "TuCalendi", "version": "1.1.1", "description": "Meetings with a Smile. Planning meetings? Easy! No endless emails, no double bookings. TuCalendi syncs with your calendar and automates your scheduling \u2013 effortlessly.", "homepage_url": "https://www.tucalendi.com", "icons": {"48": "icons/logo_48x48.png", "96": "icons/logo_96x96.png"}, "browser_specific_settings": {"gecko": {"id": "browser-addon@tucalendi.com"}}, "permissions": ["activeTab", "storage", "contextMenus", "clipboardWrite"], "browser_action": {"default_icon": "icons/logo_32x32.png", "default_title": "TuCalendi", "default_popup": "content/index.html"}, "background": {"scripts": ["scripts/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["scripts/content.js"], "all_frames": true}]}