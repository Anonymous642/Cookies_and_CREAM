{"manifest_version": 3, "name": "DocCloud Save", "short_name": "DocCloud", "version": "0.1.4", "description": "Speichere Bilder, PDFs, Links und Screenshots direkt aus dem Browser in DocCloud.", "action": {"default_title": "In DocCloud speichern", "default_popup": "popup.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "contextMenus", "activeTab", "clipboardWrite", "notifications"], "host_permissions": ["https://doccloud.cloud/*", "https://doccloud.me/*"], "icons": {"16": "assets/icon-16.png", "32": "assets/icon-32.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "save@doccloud.me", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}}, "content_scripts": [{"matches": ["https://doccloud.me/*"], "js": ["content-script.js"], "run_at": "document_idle"}]}