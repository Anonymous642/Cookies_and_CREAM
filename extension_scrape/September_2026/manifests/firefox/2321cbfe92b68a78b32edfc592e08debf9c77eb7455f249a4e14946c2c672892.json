{"manifest_version": 3, "name": "Rainbow Bar", "version": "6.5.5", "description": "Privacy-focused bookmarks toolbar with gradient colors and multi-row support", "author": "Rainbow Bar", "permissions": ["bookmarks", "storage"], "action": {"default_popup": "popup.html", "default_title": "Rainbow Bar", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["bookmarks-bar.css"], "run_at": "document_end", "all_frames": false}], "background": {"scripts": ["background.js"]}, "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "browser_specific_settings": {"gecko": {"id": "rainbow-bar@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}