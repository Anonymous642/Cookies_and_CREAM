{"manifest_version": 3, "name": "SheetsGroups", "version": "1.0.6", "description": "Group Google Sheets tabs into hover dropdown menus allowing for quick contextual navigation without sidebars.", "permissions": ["storage"], "host_permissions": ["https://docs.google.com/spreadsheets/*"], "content_scripts": [{"matches": ["https://docs.google.com/spreadsheets/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "SheetsGroups", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "sheetsmenu@sheetsmenu", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}