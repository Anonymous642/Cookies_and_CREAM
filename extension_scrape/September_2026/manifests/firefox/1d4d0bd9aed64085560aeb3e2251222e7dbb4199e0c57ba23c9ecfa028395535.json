{"manifest_version": 3, "name": "YouTube Segment Player", "version": "1.0", "description": "Rewatch only specific segments of YouTube videos", "permissions": ["storage", "scripting", "tabs"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}], "action": {"default_popup": "popup.html", "default_title": "YouTube Segment Player"}, "browser_specific_settings": {"gecko": {"id": "youtube-segment-player@leeevvvv.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}