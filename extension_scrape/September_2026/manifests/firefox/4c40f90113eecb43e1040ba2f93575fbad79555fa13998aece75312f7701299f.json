{"manifest_version": 3, "name": "CineTime Movie Tracker", "description": "Never miss a release with automated schedule alerts and streaming notifications for your favorite films.", "version": "1.0.0", "author": "CineTime Lab", "permissions": ["storage", "notifications", "alarms"], "host_permissions": ["*://*.imdb.com/*", "*://*.themoviedb.org/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "cinetimemovietracker@cinetimelab.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}