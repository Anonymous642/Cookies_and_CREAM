{"manifest_version": 2, "name": "Google Docs History Hider", "version": "6.0", "description": "Adds a button to the Google Docs UI to toggle history visibility.", "permissions": ["storage", "tabs"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://docs.google.com/document/d/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "applications": {"gecko": {"id": "gdocs-history-hider@gmail.com"}}}