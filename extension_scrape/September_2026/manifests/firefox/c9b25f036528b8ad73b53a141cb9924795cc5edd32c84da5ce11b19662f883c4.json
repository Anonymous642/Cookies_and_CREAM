{"manifest_version": 2, "name": "TubeShelf", "version": "1.0.0", "description": "Bookmark YouTube videos to your self-hosted TubeShelf instance", "author": "TubeShelf", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "TubeShelf", "default_popup": "popup/popup.html"}, "commands": {"quick-save": {"suggested_key": {"default": "Alt+S"}, "description": "Quick-save current YouTube video to TubeShelf"}}, "permissions": ["activeTab", "contextMenus", "notifications", "storage", "tabs", "*://www.youtube.com/*", "*://youtu.be/*", "<all_urls>"], "background": {"scripts": ["background/background.js"], "persistent": false}, "options_ui": {"page": "options/options.html", "open_in_tab": false}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content/content.js"], "css": [], "run_at": "document_idle"}], "web_accessible_resources": ["content/dialog.css", "content/dialog.js", "icons/*.png"], "browser_specific_settings": {"gecko": {"id": "tubeshelf-v2@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}