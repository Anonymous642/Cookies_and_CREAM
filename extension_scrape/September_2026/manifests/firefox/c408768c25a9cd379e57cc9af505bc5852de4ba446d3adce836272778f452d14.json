{"manifest_version": 3, "name": "KuaLat Shortener", "version": "1.0", "description": "Shorten URLs with Kua.Lat", "permissions": ["activeTab", "storage", "contextMenus"], "host_permissions": ["https://kua.lat/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "kualat-shortener-firefox@kua.lat", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}}