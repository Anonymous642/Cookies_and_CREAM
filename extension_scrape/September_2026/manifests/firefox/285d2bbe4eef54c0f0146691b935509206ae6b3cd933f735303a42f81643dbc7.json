{"manifest_version": 3, "name": "GPTFlow", "version": "1.0.3", "description": "GPTFlow is a privacy-first browser extension that transforms ChatGPT into a multilingual, organized workspace with numbered tabs and productivity tools. No user data collection.", "permissions": ["storage", "clipboardWrite"], "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "browser_specific_settings": {"gecko": {"id": "workspace@gptflow.local", "strict_min_version": "103.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_title": "Open GPTFlow"}, "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}]}