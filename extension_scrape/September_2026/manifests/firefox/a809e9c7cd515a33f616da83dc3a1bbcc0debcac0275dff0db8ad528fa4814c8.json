{"manifest_version": 3, "name": "Tautora Verify", "version": "1.0.0", "description": "Check authorized contact number availability.", "permissions": ["storage"], "host_permissions": ["https://api.tautora.net/*"], "action": {"default_title": "Tautora Verify", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "tautora-verify@tautora.net", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}