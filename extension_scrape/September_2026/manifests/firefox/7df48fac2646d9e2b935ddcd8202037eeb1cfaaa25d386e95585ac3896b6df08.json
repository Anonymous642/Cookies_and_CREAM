{"manifest_version": 3, "name": "Unspool Me", "version": "2.0.0", "description": "Family-friendly browser extension to block distracting content and protect focus", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_title": "Unspool Me"}, "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.youtube.com/*", "*://*.facebook.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.kwai.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.facebook.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.kwai.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "unspoolme@unspoolme.lovable.app", "strict_min_version": "140.0", "data_collection_permissions": {"urlBarReporting": false, "technicalAndInteraction": false, "required": ["none"]}}}}