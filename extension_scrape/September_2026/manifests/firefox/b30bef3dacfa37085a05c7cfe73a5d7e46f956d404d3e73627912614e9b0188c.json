{"manifest_version": 2, "browser_specific_settings": {"gecko": {"id": "{c8f74737-3e49-4c9c-8ba0-2bb7f8c79935}"}}, "name": "Expandify - Text Expander & Snippet Manager", "version": "1.0", "description": "Smart text expansion tool. Type shortcuts to instantly create emails, code snippets & formatted text. Save time typing!", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["browser-polyfill.bundle.js", "content.js"]}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}