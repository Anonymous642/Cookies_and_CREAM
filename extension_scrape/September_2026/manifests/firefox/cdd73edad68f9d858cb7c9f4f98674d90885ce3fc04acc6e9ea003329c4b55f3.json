{"manifest_version": 3, "name": "VFM Games: Is it worth it?", "version": "1.0.0", "description": "Shows the VFM value score and the cheapest official price across retailers, right on Steam, Epic, Xbox and PlayStation store pages.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "action": {"default_title": "VFM Games: Is it worth it?", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["*://store.steampowered.com/app/*"], "js": ["core.js", "steam.js"], "run_at": "document_idle"}, {"matches": ["*://store.epicgames.com/*/p/*", "*://store.epicgames.com/p/*"], "js": ["core.js", "epic.js"], "run_at": "document_idle"}, {"matches": ["*://www.microsoft.com/*/p/*", "*://apps.microsoft.com/detail/*", "*://www.xbox.com/*/games/store/*"], "js": ["core.js", "ms.js"], "run_at": "document_idle"}, {"matches": ["*://store.playstation.com/*/concept/*"], "js": ["core.js", "psn.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "vfm-games@vfmgames.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["browsingActivity"]}}}}