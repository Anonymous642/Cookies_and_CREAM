{"manifest_version": 3, "name": "SentiPass Extension", "version": "2.2", "description": "Gestionnaire de mots de passe SentiPass avec autofill, g\u00e9n\u00e9rateur et synchronisation.", "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_popup": "popup/popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"]}], "browser_specific_settings": {"gecko": {"id": "sentinet.web@gmail.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent", "personallyIdentifyingInfo"]}}}}