{"manifest_version": 2, "name": "BingFarmer", "version": "3.1", "description": "Human-like Bing search automation. Types letter-by-letter with unique queries and progress saving.", "icons": {"48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "permissions": ["storage", "tabs", "alarms", "https://www.bing.com/*"], "browser_specific_settings": {"gecko": {"id": "bingfarmer@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_popup": "popup.html", "default_title": "BingFarmer", "default_icon": {"48": "icon-48.png", "96": "icon-96.png"}}, "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["https://www.bing.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}