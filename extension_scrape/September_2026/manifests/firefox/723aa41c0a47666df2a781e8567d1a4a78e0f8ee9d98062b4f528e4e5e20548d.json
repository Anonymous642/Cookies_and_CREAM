{"manifest_version": 2, "name": "QuickLyric Hover", "version": "1.0.1", "description": "Show quick lyric snippet in a small hover bubble on pages that are currently playing audio.", "permissions": ["tabs", "activeTab", "storage"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle"}], "browser_action": {"default_title": "QuickLyric Hover", "default_popup": "popup.html"}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "quicklyrichover@local", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "host_permissions": ["<all_urls>"]}