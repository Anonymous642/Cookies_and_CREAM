{"manifest_version": 3, "name": "PageMark \u2013 Webpage Annotator", "version": "1.0.2", "description": "Annotate any webpage with drawings, arrows, shapes and text. Capture annotated screenshots.", "browser_specific_settings": {"gecko": {"id": "pagemark@annotator.ext", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["activeTab", "tabs", "scripting", "downloads"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["src/background.js"]}, "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Toggle PageMark Annotator"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/selector.js", "src/content.js"], "css": ["src/toolbar.css"], "run_at": "document_idle", "all_frames": false}]}