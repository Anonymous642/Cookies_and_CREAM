{"manifest_version": 2, "name": "HomeTab", "version": "1.0", "description": "Smart tab duplication and homepage navigation with keyboard shortcuts and elegant feedback.", "permissions": ["tabs", "activeTab", "scripting"], "background": {"scripts": ["background.js"]}, "commands": {"duplicate-tab": {"suggested_key": {"default": "Ctrl+Shift+K"}, "description": "Duplicate current tab"}, "go-home": {"suggested_key": {"default": "Ctrl+Shift+H"}, "description": "Go to site's homepage"}, "open-home-new-tab": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Open site's homepage in a new tab"}}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": ["Zain-Regular.ttf"], "browser_specific_settings": {"gecko": {"id": "{64bee6e1-1ef4-43b5-9155-bc78e9ea1e7d}"}}}