{"manifest_version": 2, "name": "Ad Tracker Map", "version": "1.3", "description": "Visualizes advertising and tracking requests made by websites in real time.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["webRequest", "webRequestBlocking", "tabs", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_title": "Ad Tracker Map", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "@Ad-Tracker-Map", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}