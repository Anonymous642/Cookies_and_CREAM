{"manifest_version": 3, "name": "Kalydian - XEFI", "description": "Extension Kalydian pour XEFI", "version": "1.9.0", "icons": {"256": "medias/icon_extension_xefi.png"}, "action": {"default_title": "Kalydian pour XEFI", "default_icon": "medias/icon_extension_xefi.png", "default_popup": "popup.html"}, "permissions": ["cookies", "tabs", "storage"], "host_permissions": ["*://localhost/*", "*://*.xefi.fr/*", "*://*.kalydian.com/*"], "web_accessible_resources": [{"resources": ["medias/logo.png", "page-bridge.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "kalydian@kalydian.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteActivity", "websiteContent"], "optional": ["technicalAndInteraction"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "run_at": "document_end", "js": ["content-scripts/content.js"]}]}