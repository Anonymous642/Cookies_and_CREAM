{"manifest_version": 3, "name": "Send Site to Todoist", "version": "0.2.5", "description": "Add opened tab to Todoist from toolbar or context menu. Only for Firefox.", "permissions": ["activeTab", "contextMenus", "notifications", "storage"], "host_permissions": ["https://api.todoist.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["src/background.js"]}, "action": {"default_title": "Send site to Todoist", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "send-site-to-todoist@kobioxide.gmail.com", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}}