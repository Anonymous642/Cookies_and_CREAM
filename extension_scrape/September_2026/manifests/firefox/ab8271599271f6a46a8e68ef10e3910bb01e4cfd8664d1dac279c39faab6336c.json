{"manifest_version": 3, "name": "Markdown Viewer", "description": "Fast, safe markdown rendering for local and remote .md files.", "version": "0.1.0", "permissions": ["storage", "declarativeNetRequest"], "host_permissions": ["*://*/*.md*", "*://*/*.markdown*", "*://*/*.mkd*"], "declarative_net_request": {"rule_resources": [{"id": "strip-csp", "enabled": true, "path": "rules.firefox.json"}]}, "web_accessible_resources": [{"resources": ["assets/*", "chunks/*", "mermaid-runner.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "browser-markdown@sutharjay", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Markdown Viewer Settings", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*/*.markdown*", "*://*/*.md*", "*://*/*.mkd*", "file:///*.markdown*", "file:///*.md*", "file:///*.mkd*"], "exclude_matches": ["*://github.com/*", "*://www.github.com/*"], "run_at": "document_idle", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}