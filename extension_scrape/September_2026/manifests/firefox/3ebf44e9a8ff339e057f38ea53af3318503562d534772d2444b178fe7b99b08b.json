{"manifest_version": 3, "name": "Yoslion Download", "version": "1.1.0", "description": "Hands your Firefox downloads to the Yoslion Download desktop app. Automatic capture is on by default and can be turned off.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Yoslion Download"}, "permissions": ["alarms", "contextMenus", "cookies", "downloads", "nativeMessaging", "notifications", "scripting", "storage", "webRequest", "webRequestBlocking"], "background": {"scripts": ["background_firefox.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "yoslion-download@yoslion.com", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}, "strict_min_version": "140.0"}}, "optional_host_permissions": ["*://*/*"]}