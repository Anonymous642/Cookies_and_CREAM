{"manifest_version": 3, "name": "Colorado Legislature Lobbyist Viewer", "version": "0.1.0", "description": "Shows registered lobbyist positions on Colorado legislature bill pages.", "action": {"default_popup": "popup.html", "default_title": "Colorado Legislature Lobbyist Viewer"}, "browser_specific_settings": {"gecko": {"id": "colobbyistviewer@chasecrom.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["scripting", "activeTab", "storage"], "host_permissions": ["https://leg.colorado.gov/*"], "content_scripts": [{"matches": ["https://leg.colorado.gov/bills/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}