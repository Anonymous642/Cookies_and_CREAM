{"manifest_version": 3, "name": "RTL Fix for AI Assistants", "version": "1.2.0", "description": "Fixes Persian/Arabic RTL text direction in Google NotebookLM and Claude.ai \u2014 handles mixed Farsi+English content automatically.", "permissions": ["storage", "tabs"], "host_permissions": ["https://notebooklm.google.com/*", "https://claude.ai/*"], "content_scripts": [{"matches": ["https://notebooklm.google.com/*", "https://claude.ai/*"], "js": ["browser-polyfill.min.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "RTL Fix for AI Assistants", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["browser-polyfill.min.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "rtl-fix@hamidshahabi.github.io", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}