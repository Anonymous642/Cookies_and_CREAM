{"manifest_version": 2, "name": "ChatGPT Conversation Exporter", "version": "1.0", "description": "One-click export of the current ChatGPT conversation to Markdown.", "browser_specific_settings": {"gecko": {"id": "chatgpt-exporter@andrew.local", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "https://chatgpt.com/*"], "browser_action": {"default_title": "Export this ChatGPT conversation", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}