{"manifest_version": 3, "name": "Twitch Viewer Range Filter", "version": "1.0", "description": "Filters Twitch category pages to show streams within a specific viewer range.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "activeTab"], "content_scripts": [{"matches": ["https://*.twitch.tv/directory/category/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_title": "Twitch Viewer Range Filter"}, "browser_specific_settings": {"gecko": {"id": "facelesslovesyou@localdev.local", "data_collection_permissions": {"required": ["none"], "optional": []}}}}