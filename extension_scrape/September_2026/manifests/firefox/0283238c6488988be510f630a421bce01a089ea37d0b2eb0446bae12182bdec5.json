{"manifest_version": 3, "name": "UnKee", "short_name": "UnKee", "version": "1.5.0", "description": "UnKee Password Manager for KeePass databases", "author": "TechQuests", "homepage_url": "https://techquests.dev/unkee", "permissions": ["activeTab", "nativeMessaging", "storage"], "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "action": {"default_popup": "popup/index.html", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "options_ui": {"page": "options/index.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/index.js"], "run_at": "document_idle"}], "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "browser_specific_settings": {"gecko": {"id": "extension@unkee.app", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}