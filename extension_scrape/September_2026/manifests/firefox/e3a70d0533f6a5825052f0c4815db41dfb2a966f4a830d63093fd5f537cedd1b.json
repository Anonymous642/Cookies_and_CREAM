{"manifest_version": 3, "name": "SecuAudit Link Hunter", "version": "1.0.0", "description": "Extract, filter, copy and export links, emails, JavaScript files and interesting endpoints from any page.", "permissions": ["activeTab", "scripting", "tabs", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_title": "SecuAudit Link Hunter", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "secuaudit-link-hunter@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}