{"manifest_version": 2, "name": "Focus - YouTube Tab Snoozer", "version": "2.0.1", "description": "Automatically closes idle YouTube tabs and stores them for later. Also auto-pauses YouTube on tab switch.", "permissions": ["tabs", "storage", "activeTab"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "exclude_matches": ["*://music.youtube.com/*"], "js": ["content.js"]}], "browser_action": {"default_popup": "popup.html", "default_title": "Focus - Tab Snoozer"}, "icons": {"16": "image/focus-16.png", "48": "image/focus-48.png", "128": "image/focus-128.png"}, "browser_specific_settings": {"gecko": {"id": "{10725dbe-f2c4-44d8-904d-7b0f270ea5be}"}}}