{"manifest_version": 3, "name": "CardGuard for eBay", "version": "1.1.1", "description": "Warnt auf eBay-Angeboten vor selbst definierten Begriffen in Titel und Beschreibung.", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "action": {"default_title": "CardGuard Wortliste", "default_popup": "popup/popup.html", "default_icon": "icons/icon.svg"}, "permissions": ["storage"], "host_permissions": ["*://*.ebay.de/*", "*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.ebay.at/*", "*://*.ebay.ch/*", "*://*.ebay.fr/*", "*://*.ebay.it/*", "*://*.ebay.es/*", "*://*.ebay.nl/*", "*://*.ebay.be/*", "*://*.ebay.ca/*", "*://*.ebay.com.au/*", "*://*.ebay.ie/*", "*://*.ebay.pl/*", "*://*.ebaydesc.com/*"], "content_scripts": [{"matches": ["*://*.ebay.de/*", "*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.ebay.at/*", "*://*.ebay.ch/*", "*://*.ebay.fr/*", "*://*.ebay.it/*", "*://*.ebay.es/*", "*://*.ebay.nl/*", "*://*.ebay.be/*", "*://*.ebay.ca/*", "*://*.ebay.com.au/*", "*://*.ebay.ie/*", "*://*.ebay.pl/*", "*://*.ebaydesc.com/*"], "js": ["content/content.js"], "run_at": "document_idle", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "cardguard-ebay@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}