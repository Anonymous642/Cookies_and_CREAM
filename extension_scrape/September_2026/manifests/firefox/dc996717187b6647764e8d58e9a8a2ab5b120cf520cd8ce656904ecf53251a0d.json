{"manifest_version": 2, "name": "Local Weather Overlay", "version": "1.3", "description": "Record and view local weather notes in a simple browser overlay.", "permissions": ["storage", "activeTab"], "browser_action": {"default_title": "Local Weather Overlay", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Local-Weather-Overlay", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}