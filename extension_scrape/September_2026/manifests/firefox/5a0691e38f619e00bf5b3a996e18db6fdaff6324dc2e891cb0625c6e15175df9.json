{"manifest_version": 3, "name": "Done-O-Hidden", "version": "1.0.1", "icons": {"32": "icon32.png", "64": "icon64.png"}, "developer": {"name": "Rajeesh Punathil", "url": "https://github.com/rajeeshrp/done-or-hidden"}, "description": "Block distracting apps initially, then earn back access as you check off daily goals.", "browser_specific_settings": {"gecko": {"id": "done-o-hidden@aarpee", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}, "permissions": ["declarativeNetRequest", "storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["todo.html"], "matches": ["<all_urls>"]}]}