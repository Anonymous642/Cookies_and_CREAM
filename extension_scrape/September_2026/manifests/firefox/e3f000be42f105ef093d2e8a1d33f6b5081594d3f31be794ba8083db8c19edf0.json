{"manifest_version": 3, "name": "Gradux", "version": "1.0.0", "description": "Capture jobs, company intel and evidence directly to your Gradux pipeline.", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["https://gradux.app/*", "http://localhost:3000/*"], "background": {"scripts": ["sw.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Gradux", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "extension@gradux.app", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "websiteContent"]}}}}