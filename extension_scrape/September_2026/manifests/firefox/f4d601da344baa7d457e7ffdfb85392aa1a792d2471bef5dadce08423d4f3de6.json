{"manifest_version": 3, "name": "Hide AI Overview & AI Mode for Google", "short_name": "Hide AI Overview", "version": "1.0.1", "default_locale": "en", "description": "Hide, disable, remove and block Google AI Overview and AI Mode. Clean, classic search results. Lightweight, private, no setup.", "browser_specific_settings": {"gecko": {"id": "ai-overview-hider@getinfotoyou", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "permissions": ["storage", "declarativeNetRequestWithHostAccess"], "host_permissions": ["*://*.google.com/*", "*://*.google.co.uk/*", "*://*.google.de/*", "*://*.google.ca/*", "*://*.google.com.au/*", "*://*.google.co.in/*", "*://*.google.fr/*", "*://*.google.es/*", "*://*.google.it/*", "*://*.google.com.br/*"], "background": {"scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["*://*.google.com/search*", "*://*.google.co.uk/search*", "*://*.google.de/search*", "*://*.google.ca/search*", "*://*.google.com.au/search*", "*://*.google.co.in/search*", "*://*.google.fr/search*", "*://*.google.es/search*", "*://*.google.it/search*", "*://*.google.com.br/search*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_start", "all_frames": false}], "action": {"default_popup": "src/popup.html", "default_icon": {"16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png"}}, "declarative_net_request": {"rule_resources": [{"id": "force_web", "enabled": false, "path": "rules.json"}]}}