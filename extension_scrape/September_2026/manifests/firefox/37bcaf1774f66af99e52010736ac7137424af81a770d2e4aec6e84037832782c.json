{"manifest_version": 3, "name": "Roblox Covers Unblock", "version": "1.1.0", "description": "Shows geo-blocked Roblox covers, avatars and thumbnails (tr.rbxcdn.com) by reloading broken images through working mirrors.", "minimum_chrome_version": "102", "icons": {"128": "icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "Roblox Covers Unblock", "default_icon": "icon128.png"}, "permissions": ["storage"], "host_permissions": ["*://*.rbxcdn.com/*", "*://wsrv.nl/*", "*://images.weserv.nl/*", "*://external-content.duckduckgo.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.roblox.com/*", "*://roblox.com/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "roblox-covers-unblock@local.addon", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}