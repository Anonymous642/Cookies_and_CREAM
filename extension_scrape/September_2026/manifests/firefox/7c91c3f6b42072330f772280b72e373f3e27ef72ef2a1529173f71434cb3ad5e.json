{"manifest_version": 3, "name": "Dialego Password Manager", "version": "0.1.6", "description": "Zero-Knowledge Passwort-Manager von Dialego.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Dialego Password Manager", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["scripting", "activeTab", "storage", "identity", "nativeMessaging", "tabs", "contextMenus", "alarms", "clipboardRead", "clipboardWrite"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Popup \u00f6ffnen"}, "fill-login": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Besten Login auf der Seite ausf\u00fcllen"}}, "host_permissions": ["https://password.dialego.de/*", "http://*/*", "https://*/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "pwm@dialego.de", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["authenticationInfo", "financialAndPaymentInfo"]}}}}