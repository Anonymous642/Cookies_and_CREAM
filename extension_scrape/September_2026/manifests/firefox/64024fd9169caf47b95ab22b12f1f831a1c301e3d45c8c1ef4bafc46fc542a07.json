{"manifest_version": 2, "name": "eBay Live Remover", "version": "1.0.0", "description": "Hides and removes all 'eBay Live' promos, nav links, banners, and modules from eBay pages.", "icons": {"48": "icon.svg", "96": "icon.svg"}, "permissions": ["*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.ebay.com.au/*", "*://*.ebay.de/*", "*://*.ebay.ca/*", "*://*.ebay.fr/*", "*://*.ebay.it/*", "*://*.ebay.es/*"], "content_scripts": [{"matches": ["*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.ebay.com.au/*", "*://*.ebay.de/*", "*://*.ebay.ca/*", "*://*.ebay.fr/*", "*://*.ebay.it/*", "*://*.ebay.es/*"], "css": ["hide.css"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "ebay-live-remover@local.extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}