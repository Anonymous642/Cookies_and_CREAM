{"manifest_version": 2, "name": "How Did I Login", "version": "1.2.10", "description": "Remembers and marks your last used login method and google account for websites with a 'Last used' marker.", "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "180": "images/icon180.png"}, "permissions": ["storage", "activeTab"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "180": "images/icon180.png"}}, "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"]}, {"matches": ["https://accounts.google.com/o/oauth2*", "https://accounts.google.com/gsi/select*", "https://accounts.google.com/v3/signin/accountchooser*"], "js": ["google.js"]}], "web_accessible_resources": ["images/icon16.png", "images/icon48.png", "images/icon180.png"], "browser_specific_settings": {"gecko": {"id": "{b613de81-e146-4f1a-8eec-4bb54601e2e2}"}}}