{"manifest_version": 2, "name": "StudyCard \u2013 Fiches de R\u00e9vision IA", "version": "3.0.1", "description": "Analyse une page web et g\u00e9n\u00e8re des fiches de r\u00e9vision, m\u00e9mos techniques, quiz et flashcards. Gemini, OpenAI ou Claude.", "author": "Asena", "browser_specific_settings": {"gecko": {"id": "studycard@asena.ext", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "permissions": ["activeTab", "storage", "https://generativelanguage.googleapis.com/*", "https://api.openai.com/*", "https://api.anthropic.com/*"], "content_security_policy": "script-src 'self'; object-src 'self'", "sidebar_action": {"default_title": "StudyCard", "default_panel": "sidebar/sidebar.html", "default_icon": "icons/icon-48.svg"}, "browser_action": {"default_icon": "icons/icon-48.svg", "default_title": "Ouvrir StudyCard"}, "background": {"scripts": ["background/background.js"], "persistent": false}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Ouvrir/fermer StudyCard"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle"}]}