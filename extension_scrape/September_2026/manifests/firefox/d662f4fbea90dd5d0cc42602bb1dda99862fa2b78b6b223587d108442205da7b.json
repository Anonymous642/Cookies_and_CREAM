{"manifest_version": 3, "name": "uBlock Origin", "version": "1.0", "description": "content blocker", "icons": {"48": "icon.png"}, "permissions": ["storage", "tabs"], "host_permissions": ["https://admin.packzy.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://admin.packzy.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"turn_on": {"suggested_key": {"default": "Ctrl+Alt+2"}, "description": "Turn ON script"}, "turn_off": {"suggested_key": {"default": "Ctrl+Alt+1"}, "description": "Turn OFF script"}}, "browser_specific_settings": {"gecko": {"id": "ublock-origin-custom@admin.packzy.com", "data_collection_permissions": {"required": ["none"]}}}}