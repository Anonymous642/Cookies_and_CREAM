{"manifest_version": 2, "name": "BBC iPlayer Skip Interval Modifier", "version": "1.0.1", "description": "Changes the skip interval on BBC iPlayer from 20 seconds to 10 seconds", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "@bbc-iplayer-skip-interval-modifier", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.bbc.co.uk/iplayer/*"], "js": ["content.js"]}], "browser_action": {"default_popup": "popup.html"}}