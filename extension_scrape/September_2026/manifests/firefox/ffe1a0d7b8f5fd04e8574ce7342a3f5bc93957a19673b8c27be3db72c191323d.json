{"manifest_version": 3, "name": "ProAdBlock Shield - Ad & Tracker Blocker", "short_name": "ProAdBlock", "version": "2.1.6", "description": "A privacy-first ad, tracker, popup and annoyance blocker with per-site controls and element blocking.", "permissions": ["activeTab", "storage", "alarms", "declarativeNetRequestWithHostAccess"], "host_permissions": ["*://*/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "ProAdBlock Shield", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["scripts/page-guard.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["http://*/*", "https://*/*"], "css": ["styles/content.css"], "js": ["scripts/content.js"], "run_at": "document_start", "world": "ISOLATED"}], "declarative_net_request": {"rule_resources": [{"id": "ads_core", "enabled": true, "path": "rules/ads.json"}, {"id": "trackers_core", "enabled": true, "path": "rules/trackers.json"}, {"id": "annoyances_core", "enabled": true, "path": "rules/annoyances.json"}, {"id": "strict_core", "enabled": false, "path": "rules/strict.json"}, {"id": "privacy_clean", "enabled": true, "path": "rules/privacy.json"}]}, "browser_specific_settings": {"gecko": {"id": "proadblock-shield@codeintra.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}