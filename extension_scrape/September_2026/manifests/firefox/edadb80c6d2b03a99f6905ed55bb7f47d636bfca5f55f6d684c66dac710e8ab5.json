{"manifest_version": 2, "name": "Thales URL Analyzer (local)", "version": "0.1.2", "description": "Envia a URL + texto da aba atual para um servidor local (WSL) e exibe a an\u00e1lise.", "browser_specific_settings": {"gecko": {"id": "thales-url-analyzer@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteActivity", "websiteContent"]}}}, "permissions": ["activeTab", "tabs", "http://127.0.0.1:8787/*", "http://localhost:8787/*"], "browser_action": {"default_title": "Thales: analisar aba", "default_popup": "popup.html"}}