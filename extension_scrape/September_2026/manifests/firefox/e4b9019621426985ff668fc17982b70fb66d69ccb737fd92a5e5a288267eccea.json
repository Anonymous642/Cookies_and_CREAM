{"manifest_version": 3, "name": "TabManager", "version": "1.0.0", "description": "Tab organizer and session manager. Group, search, and manage browser tabs.", "icons": {"48": "tab-icons/icon-48.png", "96": "tab-icons/icon-96.png", "128": "tab-icons/icon-128.png"}, "action": {"default_icon": {"48": "tab-icons/icon-48.png", "96": "tab-icons/icon-96.png"}, "default_title": "TabManager", "default_popup": "manager-ui/tabs.html"}, "permissions": ["tabs", "storage"], "browser_specific_settings": {"gecko": {"id": "tabmanager@tab.organizer", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}