{"manifest_version": 3, "name": "Roblox Marketplace ID Copier", "version": "1.0.0", "description": "Adds a 'Copy ID' button to every item card on the Roblox marketplace so you can grab bundle/catalog IDs in one click.", "permissions": ["clipboardWrite"], "content_scripts": [{"matches": ["https://www.roblox.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "roblox-id-copier@local.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}