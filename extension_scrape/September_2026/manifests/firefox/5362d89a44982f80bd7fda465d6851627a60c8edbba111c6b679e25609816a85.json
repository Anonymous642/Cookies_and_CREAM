{"manifest_version": 2, "name": "Knowledge Decay Tracker", "version": "1.3", "description": "Tracks estimated knowledge decay and recommends timely review sessions.", "permissions": ["storage", "tabs", "notifications", "activeTab"], "background": {"scripts": ["decayEngine.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"], "run_at": "document_idle"}], "browser_action": {"default_title": "Knowledge Decay Tracker", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Knowledge-Decay-Tracker", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}