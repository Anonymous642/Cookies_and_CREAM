{"manifest_version": 3, "name": "TabWorkset", "version": "1.5.3", "description": "Tab manager that saves, organizes, and restores your browser workspaces instantly.", "permissions": ["tabs", "tabGroups", "storage", "alarms"], "background": {"scripts": ["background.js"]}, "web_accessible_resources": [{"resources": ["page.html"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "tabworkset@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["browsingActivity"], "optional": []}}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}