{"manifest_version": 2, "name": "Dopamine Browser Extension", "version": "0.1.0", "description": "Routes browser tab telemetry to the Dopamine native host.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["tabs", "nativeMessaging"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "dopamine@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}