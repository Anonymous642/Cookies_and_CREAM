{"manifest_version": 2, "name": "Midodi Popup Remover", "version": "1.64", "description": "Remove multiple cookie popups, especially French ones.", "icons": {"32": "icons/popup-remover.svg", "48": "icons/popup-remover.svg", "64": "icons/popup-remover.svg"}, "browser_specific_settings": {"gecko": {"id": "@midodi-popup-remover", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["popup-remover.js"]}]}