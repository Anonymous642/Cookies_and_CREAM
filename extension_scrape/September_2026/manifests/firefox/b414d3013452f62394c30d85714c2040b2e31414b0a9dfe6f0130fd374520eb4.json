{"manifest_version": 3, "name": "Bewertungs-Sortierer f\u00fcr Amazon", "version": "1.3.1", "description": "Sammelt bis zu 400 Amazon-Suchtreffer und sortiert sie nach Sternebewertung, Anzahl der Rezensionen oder einem gewichteten Score.", "author": "Eigenbau", "browser_specific_settings": {"gecko": {"id": "bewertungs-sortierer@lokal.example", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["*://*.amazon.de/*", "*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.nl/*", "*://*.amazon.pl/*", "*://*.amazon.se/*", "*://*.amazon.ca/*", "*://*.amazon.com.au/*", "*://*.amazon.co.jp/*", "*://*.amazon.com.tr/*", "*://*.amazon.com.be/*", "*://*.amazon.ie/*"], "action": {"default_popup": "popup.html", "default_title": "Bewertungs-Sortierer", "default_icon": {"16": "icon-16.png", "32": "icon-32.png"}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "64": "icon-64.png", "96": "icon-96.png", "128": "icon-128.png"}, "content_scripts": [{"matches": ["*://*.amazon.de/s*", "*://*.amazon.com/s*", "*://*.amazon.co.uk/s*", "*://*.amazon.fr/s*", "*://*.amazon.it/s*", "*://*.amazon.es/s*", "*://*.amazon.nl/s*", "*://*.amazon.pl/s*", "*://*.amazon.se/s*", "*://*.amazon.ca/s*", "*://*.amazon.com.au/s*", "*://*.amazon.co.jp/s*", "*://*.amazon.com.tr/s*", "*://*.amazon.com.be/s*", "*://*.amazon.ie/s*"], "js": ["content.js"], "run_at": "document_idle"}]}