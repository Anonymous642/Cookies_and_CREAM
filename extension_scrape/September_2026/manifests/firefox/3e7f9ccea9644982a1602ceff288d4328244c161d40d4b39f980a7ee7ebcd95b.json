{"manifest_version": 3, "name": "Exam Reviewer: Spoiler-Free Review", "version": "1.0.0", "description": "Hide previous selections and correct/incorrect spoilers while reviewing Udemy and Tutorials Dojo exams.", "permissions": ["storage"], "host_permissions": ["*://*.udemy.com/*", "*://*.tutorialsdojo.com/*"], "background": {"scripts": ["src/state.js", "src/background.js"]}, "action": {"default_icon": "assets/ExamReview-Off.svg", "default_title": "Toggle spoiler-free exam review"}, "commands": {"toggle-review-mode": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Toggle spoiler-free exam review"}}, "content_scripts": [{"matches": ["*://*.udemy.com/*", "*://*.tutorialsdojo.com/*"], "css": ["src/review-mode.css"], "js": ["src/review-mode.js", "src/content.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "exam-reviewer@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}