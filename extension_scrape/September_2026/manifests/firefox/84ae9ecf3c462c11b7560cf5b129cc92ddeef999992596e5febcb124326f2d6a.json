{"manifest_version": 3, "name": "Tracklay", "version": "0.3.1", "description": "Overlay the currently playing track on YouTube videos from timestamped comments.", "permissions": ["activeTab", "contextMenus"], "host_permissions": ["*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["src/modules/parser.js", "src/modules/selection.js", "src/modules/commentMenu.js", "src/modules/tracker.js", "src/modules/overlay.js", "src/modules/navigation.js", "src/content.js"], "css": ["src/styles/overlay.css"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "tracklay@tracklay.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}