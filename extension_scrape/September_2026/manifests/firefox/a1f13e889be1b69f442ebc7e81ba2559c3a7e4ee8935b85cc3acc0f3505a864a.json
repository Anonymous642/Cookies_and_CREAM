{"manifest_version": 3, "name": "Voetbalzone Clickbait Exposer", "version": "1.0", "description": "A Chrome extension that shows the actual content of a Voetbalzone clickbait header.", "browser_specific_settings": {"gecko": {"id": "voetbalzone-clickbait-exposer@coachsupreme.com"}}, "permissions": ["activeTab"], "content_scripts": [{"matches": ["https://www.voetbalzone.nl/*"], "js": ["content.js"]}], "action": {"default_popup": "content.html", "default_icon": "icon.png"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}