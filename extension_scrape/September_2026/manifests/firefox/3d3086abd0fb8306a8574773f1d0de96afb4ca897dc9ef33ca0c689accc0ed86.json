{"manifest_version": 3, "name": "No Google AI Overview", "version": "1.2", "description": "Removes Google AI Overviews from search results.", "icons": {"16": "128.png", "48": "128.png", "128": "128.png"}, "action": {"default_popup": "popup.html"}, "permissions": ["storage", "tabs"], "host_permissions": ["https://google.com*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "nogoogleaioverview@yourdomain.local", "data_collection_permissions": {"required": ["none"]}}}}