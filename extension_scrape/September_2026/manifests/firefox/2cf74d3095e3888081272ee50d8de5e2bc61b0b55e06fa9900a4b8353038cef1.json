{"manifest_version": 2, "name": "JS Domain Monitor", "version": "1.0.0", "description": "Monitors for expired or vulnerable domains in JavaScript supply chains.", "author": "JS Domain Monitor Team", "homepage_url": "https://github.com/js-domain-monitor", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage", "tabs", "webRequest", "webRequestBlocking", "<all_urls>"], "background": {"scripts": ["utils/domain-utils.js", "background.js"], "persistent": true}, "browser_action": {"default_title": "JS Domain Monitor", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "js-domain-monitor@extension.firefox", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {}}}