{"manifest_version": 2, "name": "CSSPick \u2014 Inspect & Copy CSS", "short_name": "CSSPick", "version": "1.0.0", "description": "Hover any element, copy its CSS as vanilla CSS, SCSS, Tailwind, or React inline styles. With CSS variable detection and a spacing overlay.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_title": "CSSPick", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["src/background-ff.js"], "persistent": false}, "permissions": ["activeTab", "tabs", "storage", "<all_urls>"], "web_accessible_resources": ["src/tailwind-map.js", "src/content.js", "src/content-ff.js", "src/overlay.css"], "browser_specific_settings": {"gecko": {"id": "csspick@getcsspick.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo"]}}}}