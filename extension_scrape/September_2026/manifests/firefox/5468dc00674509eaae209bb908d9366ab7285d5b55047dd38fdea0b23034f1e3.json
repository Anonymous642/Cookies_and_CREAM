{"manifest_version": 3, "name": "Zenix TempMail", "version": "1.5.0", "description": "Generate temporary email addresses, auto-fill signup forms, and catch verification codes the moment they arrive.", "icons": {"16": "icons/logo.png", "48": "icons/logo.png", "128": "icons/logo.png"}, "action": {"default_title": "Zenix TempMail", "default_icon": {"16": "icons/logo.png", "48": "icons/logo.png", "128": "icons/logo.png"}}, "permissions": ["activeTab", "storage", "scripting", "clipboardWrite", "alarms", "notifications"], "host_permissions": ["https://zenix-tempmail.vercel.app/*", "http://localhost/*", "http://127.0.0.1/*", "http://*/*", "https://*/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "background": {"service_worker": "background/background.js", "scripts": ["background/atoll-bridge.js", "background/telemetry.js", "background/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["popup/*"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "zenix-tempmail@vast.sh", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}}