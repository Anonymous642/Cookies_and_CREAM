{"manifest_version": 3, "name": "LeetGenius", "version": "1.0", "description": "Stuck on a LeetCode problem? LeetGenius provides AI-driven solutions, detailed breakdowns, test cases, complete code examples, and relevant resources to help you level up your coding skills.", "permissions": ["storage", "activeTab", "tabs", "webRequest", "clipboardRead", "clipboardWrite", "scripting"], "browser_specific_settings": {"gecko": {"id": "LeetGenius@LeetGenius"}}, "host_permissions": ["https://leetcode.com/*"], "action": {"default_popup": "index.html", "default_icon": "icons/brain-bulb.svg"}, "sidebar_action": {"default_panel": "sidebar.html", "default_icon": "icons/brain-bulb.svg", "default_title": "LeetGenius", "open_at_install": true}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://leetcode.com/problems/*"], "js": ["content_script.js"]}], "web_accessible_resources": [{"resources": ["dist/index.css", "icons/brain-bulb.svg", "ToggleIconSidebar.html"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/brain-bulb.svg", "48": "icons/brain-bulb.svg", "128": "icons/brain-bulb.svg"}}