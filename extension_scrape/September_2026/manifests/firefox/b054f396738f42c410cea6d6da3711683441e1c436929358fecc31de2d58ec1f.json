{"manifest_version": 3, "name": "Umango Embedded App Manager", "version": "1.0.3", "description": "Manage and deploy Umango embedded applications across your network devices.", "browser_specific_settings": {"gecko": {"id": "deployer@umango.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "tabs"], "host_permissions": ["https://*.umango.com/*"], "optional_host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["background/index.js"], "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/bridge.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}}