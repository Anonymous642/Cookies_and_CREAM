{"manifest_version": 3, "name": "Subreddit Hider", "version": "1.0.0", "author": "RobbiRobb", "description": "Allows you to permanently hide any subreddit on r/popular", "icons": {"48": "icons/subreddit-hider-48.png", "96": "icons/subreddit-hider-96.png"}, "browser_specific_settings": {"gecko": {"id": "{a7f3789f-b64f-44ee-86a9-1db99d324903}", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_area": "navbar", "default_popup": "views/popup.html"}, "web_accessible_resources": [{"resources": ["icons/hide.png"], "matches": ["<all_urls>"]}], "permissions": ["storage"], "content_scripts": [{"matches": ["*://www.reddit.com/r/popular/*", "*://www.reddit.com/"], "js": ["src/subreddit-hider.js"]}]}