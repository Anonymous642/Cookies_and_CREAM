{"manifest_version": 3, "name": "Guswut's Microsoft Clipboard Wrangler", "version": "1.0.0", "description": "Fixes annoying Microsoft Outlook and Calendar bug when trying to paste using Clipboard Fusion via Ctrl + Shift + V.", "browser_specific_settings": {"gecko": {"id": "Guswut_Microsoft_Clipboard_Wrangler@guswut.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}, "action": {"default_icon": "icons/icon-128.png"}, "permissions": ["clipboardRead", "clipboardWrite", "activeTab"], "content_scripts": [{"matches": ["https://outlook.cloud.microsoft/*"], "js": ["content.js"], "run_at": "document_start", "world": "MAIN"}]}