{"manifest_version": 2, "name": "The Researcher", "version": "2.1", "description": "Take research notes on any webpage with sticky notes", "icons": {"48": "assets/icon48.png", "96": "assets/icon96.png", "128": "assets/icon128.png"}, "permissions": ["storage", "activeTab", "contextMenus", "<all_urls>"], "web_accessible_resources": ["src/content/styles.css", "assets/*"], "browser_action": {"default_title": "The Researcher", "default_popup": "src/popup/index.html"}, "background": {"scripts": ["src/background/index.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/utils/storage.js", "src/utils/translator.js", "src/content/index.js"], "css": ["src/content/styles.css"]}], "browser_specific_settings": {"gecko": {"id": "the-researcher@theresearcher-iki.com", "data_collection_permissions": {"required": ["none"]}}}}