{"manifest_version": 3, "name": "steam-sellr", "description": "Bulk-list your own Steam trading cards on the Community Market. Sell only -- no buying, trading, or automated confirmations.", "version": "0.2.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "host_permissions": ["*://steamcommunity.com/*"], "browser_specific_settings": {"gecko": {"id": "@steam-card-bulk-seller", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "steam-sellr", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://steamcommunity.com/id/*/inventory*", "*://steamcommunity.com/market/*", "*://steamcommunity.com/profiles/*/inventory*"], "exclude_matches": ["*://steamcommunity.com/market/listings/*"], "js": ["content-scripts/content.js"]}]}