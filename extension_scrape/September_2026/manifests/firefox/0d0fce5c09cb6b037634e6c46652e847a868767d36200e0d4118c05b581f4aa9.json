{"manifest_version": 3, "name": "Write-For-Facebook", "version": "1.0.0", "description": "Formatez votre texte sur Facebook avec des styles Unicode (gras, italique, etc.) inspir\u00e9s de Yaytext.", "browser_specific_settings": {"gecko": {"id": "writeforfacebook.contact@jakobel.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["*://*.facebook.com/*"], "action": {"default_popup": "popup/popup.html", "default_title": "Formater pour Facebook", "default_icon": {"16": "icons/icon-16.png", "24": "icons/icon-24.png", "32": "icons/icon-32.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://*.facebook.com/*"], "css": ["content/content.css"], "js": ["lib/styles-config.js", "lib/formatter.js", "content/content.js"], "run_at": "document_end"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png", "512": "icons/icon-512.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["*://*.facebook.com/*"]}]}