{"manifest_version": 3, "name": "TikTok Video Downloader & Analytics", "version": "0.1.0", "description": "View TikTok video metrics and save an accessible source from the page you are watching.", "author": "ClipScope / CX Growth Lab", "homepage_url": "https://cxgrowthlab.com/about/", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "clipscope@cxgrowthlab.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["downloads", "scripting", "storage"], "host_permissions": ["https://*.tiktok.com/*", "https://tiktok.com/*"], "background": {"scripts": ["background.js"]}, "web_accessible_resources": [{"resources": ["page-fetcher.js", "assets/wechat-qr.png"], "matches": ["https://*.tiktok.com/*", "https://tiktok.com/*"]}], "action": {"default_title": "Open ClipScope on this TikTok video"}, "content_scripts": [{"matches": ["https://*.tiktok.com/*", "https://tiktok.com/*"], "js": ["tiktok-media-capture.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://*.tiktok.com/*", "https://tiktok.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}