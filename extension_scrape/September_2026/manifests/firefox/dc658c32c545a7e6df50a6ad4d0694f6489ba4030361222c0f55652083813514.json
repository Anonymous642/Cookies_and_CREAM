{"manifest_version": 3, "name": "YouTube to TikTok Uploader", "description": "Send YouTube URLs to a private backend that downloads, saves, formats, and uploads videos to TikTok.", "version": "1.0.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "YouTube to TikTok", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "yt2tt-uploader@yt2tt.work.gd", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "financialAndPaymentInfo", "personalCommunications", "browsingActivity", "websiteContent", "websiteActivity"]}}}, "options_page": "options.html", "permissions": ["activeTab", "downloads", "storage", "tabs"], "host_permissions": ["https://www.youtube.com/*", "https://youtu.be/*", "http://localhost/*", "https://*/*"]}