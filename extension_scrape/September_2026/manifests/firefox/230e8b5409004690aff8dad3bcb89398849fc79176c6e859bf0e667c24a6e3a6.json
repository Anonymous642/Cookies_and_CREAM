{"manifest_version": 3, "name": "Google AI Remover", "version": "1.0", "description": "Blocks Google AI results before they get generated, in any language. Not just hidden! 0% unwanted AI queries and no wasted energy!", "icons": {"48": "icon.png"}, "permissions": ["declarativeNetRequest"], "host_permissions": ["*://*.google.com/*"], "declarative_net_request": {"rule_resources": [{"id": "aio_rules", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["*://www.google.com/search*"], "js": ["content.js"], "css": ["hide-aio.css"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "google-ai-remover@byteglyph", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}