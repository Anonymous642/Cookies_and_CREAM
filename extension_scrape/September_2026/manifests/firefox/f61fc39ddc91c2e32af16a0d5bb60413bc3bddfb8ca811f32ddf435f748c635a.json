{"manifest_version": 3, "name": "Meterous", "short_name": "Meterous", "version": "1.0.5", "description": "A usage meter for Claude subscribers: see how much of your session, Fable, and weekly limits you've used.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Meterous", "default_icon": {"16": "icons/toolbar-16.png", "19": "icons/toolbar-19.png", "32": "icons/toolbar-32.png", "38": "icons/toolbar-38.png"}}, "background": {"scripts": ["lib.js", "icon.js", "background.js", "install.js"]}, "content_scripts": [{"matches": ["https://claude.ai/*"], "js": ["lib.js", "content.js"], "run_at": "document_idle"}], "permissions": ["storage", "alarms"], "host_permissions": ["https://claude.ai/*"], "browser_specific_settings": {"gecko": {"id": "meterous@meterous.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}