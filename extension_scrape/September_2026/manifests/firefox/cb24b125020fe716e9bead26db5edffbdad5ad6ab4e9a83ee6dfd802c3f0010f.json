{"manifest_version": 3, "name": "YT Replay Chat: Youtube Extension", "version": "1.2.1", "description": "Displays timestamped YouTube comments as a live chat replay.", "browser_specific_settings": {"gecko": {"id": "yt-replay-chat@protonmail.com"}}, "permissions": ["tabs", "storage", "webNavigation"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content/utils.js", "content/api.js", "content/ui.js", "content/sync.js", "content/main.js"]}], "web_accessible_resources": [{"resources": ["popup/help.html"], "matches": ["*://www.youtube.com/*"]}], "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "host_permissions": ["https://*.googleapis.com/"]}