{"manifest_version": 3, "name": "Seamprint", "version": "1.0.0", "description": "Seal a page's structural landmarks locally and reveal what was added, removed, rewritten, or moved when you return.", "permissions": ["activeTab", "scripting", "storage"], "action": {"default_title": "Seamprint", "default_popup": "popup.html"}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "browser_specific_settings": {"gecko": {"id": "seamprint@threshold.tools", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"}}