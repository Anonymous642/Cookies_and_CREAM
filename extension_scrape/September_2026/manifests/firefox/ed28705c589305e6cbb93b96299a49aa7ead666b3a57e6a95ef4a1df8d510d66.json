{"manifest_version": 3, "name": "Luminaera ThreadJumper", "version": "0.81", "description": "Jump to inputs and manage notes in Grok or ChatGPT", "browser_specific_settings": {"gecko": {"id": "threadjumper@Luminaera.tech", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"128": "icon_128.png"}, "permissions": ["activeTab", "storage"], "content_scripts": [{"matches": ["https://grok.com/*", "https://chatgpt.com/*"], "js": ["i18n.js", "content.js"]}], "commands": {"jump-to-next-input": {"suggested_key": {"default": "Ctrl+Down", "mac": "MacCtrl+Down"}, "description": "Jump to the next user input"}, "jump-to-prev-input": {"suggested_key": {"default": "Ctrl+Up", "mac": "MacCtrl+Up"}, "description": "Jump to the previous user input"}, "add-note": {"suggested_key": {"default": "Alt+N", "mac": "Alt+N"}, "description": "Add a note to the current user input"}, "show-note-map": {"suggested_key": {"default": "Alt+M", "mac": "Alt+M"}, "description": "Show all notes for the current page"}}, "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "options_page": "options.html"}