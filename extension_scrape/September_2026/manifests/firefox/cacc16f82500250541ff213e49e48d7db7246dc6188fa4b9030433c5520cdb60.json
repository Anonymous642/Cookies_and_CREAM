{"manifest_version": 3, "name": "Disenshittify", "version": "1.0.7", "description": "Strip ads, Shorts, Grok, promoted posts, and algorithmic clutter from YouTube, X/Twitter, and LinkedIn. Every feature a toggle.", "homepage_url": "https://github.com/neverbot/disenshittify", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Disenshittify", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "permissions": ["storage"], "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["platforms/youtube.js"], "run_at": "document_start", "all_frames": false}, {"matches": ["https://twitter.com/*", "https://x.com/*"], "js": ["platforms/twitter.js"], "run_at": "document_start", "all_frames": false}, {"matches": ["https://www.linkedin.com/*"], "js": ["platforms/linkedin.js"], "run_at": "document_start", "all_frames": false}], "browser_specific_settings": {"gecko": {"id": "disenshittify@neverbot.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}