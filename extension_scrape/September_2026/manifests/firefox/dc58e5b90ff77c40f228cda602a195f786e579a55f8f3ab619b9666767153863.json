{"manifest_version": 3, "name": "AiosignalBot - Autotrading", "version": "1.0.1", "description": "AiosignalBot - Help you to autotrading in Binomo & Stockity.", "action": {"default_title": "Aiosignal Binomo", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "aiosignal@web", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "financialAndPaymentInfo"]}}}, "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* http://localhost:8080 http://127.0.0.1:8080 https://api.aiosignal.site https://ws.aiosignal.site https://aiosignal.site;"}, "permissions": ["tabs", "alarms", "storage"], "host_permissions": ["*://*.binomo.com/*", "*://*.binomo5.com/*", "*://binomo-r3.com/*", "*://*.stockity.com/*", "*://*.stockity.id/*", "*://*.market-quotex.pro/*", "http://localhost/*", "http://127.0.0.1/*", "<all_urls>"], "background": {"scripts": ["vendor/socket.io.min.js", "background.js"]}, "content_scripts": [{"matches": ["*://*.binomo.com/*", "*://*.binomo5.com/*", "*://binomo-r3.com/*", "*://*.stockity.com/*", "*://*.stockity.id/*"], "js": ["vendor/socket.io.min.js", "content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}, {"matches": ["*://*.market-quotex.pro/*"], "js": ["vendor/socket.io.min.js", "content.quotex.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["<all_urls>"]}]}