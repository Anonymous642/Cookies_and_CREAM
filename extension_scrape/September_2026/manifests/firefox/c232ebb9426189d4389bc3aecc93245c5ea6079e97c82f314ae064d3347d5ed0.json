{"manifest_version": 3, "name": "Bull Tech", "version": "1.0.1", "description": "All-in-one browser security and performance extension. Process monitoring, recon, cookie audit, security headers, screenshots, and tab suspension.", "author": "Bull Tech", "permissions": ["tabs", "activeTab", "cookies", "storage", "alarms", "declarativeNetRequest", "declarativeNetRequestFeedback", "webRequest", "scripting", "downloads", "browsingData"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Bull Tech"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "declarative_net_request": {"rule_resources": [{"id": "cookie_block_rules", "enabled": false, "path": "rules/cookie_block_rules.json"}]}, "commands": {"suspend-tab": {"suggested_key": {"default": "Alt+S"}, "description": "Suspend the current tab"}, "open-popup": {"suggested_key": {"default": "Alt+M"}, "description": "Open the SecureTab Pro popup"}}, "web_accessible_resources": [{"resources": ["suspended/suspended.html", "suspended/suspended.js"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://dns.google https://api.ipify.org https://api64.ipify.org"}, "browser_specific_settings": {"gecko": {"id": "bulltech@hmz2mtr.dev", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "minimum_chrome_version": "116"}