{"manifest_version": 2, "name": "PlayPatch", "description": "Enhance YouTube: clean the feed, hide Shorts, upgrade the player, and recolor the interface. Everything local.", "version": "1.0.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "*://*.youtube.com/*"], "web_accessible_resources": ["icon/16.png", "icon/32.png", "icon/48.png", "icon/128.png", "yt-player-main.js"], "browser_specific_settings": {"gecko": {"id": "playpatch@local.extension", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "PlayPatch", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "run_at": "document_start", "js": ["content-scripts/youtube.js"]}]}