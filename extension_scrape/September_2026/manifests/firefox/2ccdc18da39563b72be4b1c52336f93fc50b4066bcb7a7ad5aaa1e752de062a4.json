{"manifest_version": 3, "name": "OpenLitBase", "description": "Titel mit einem Klick von Webseiten und Bibliothekskatalogen in deine OpenLitBase-Literaturverwaltung \u00fcbernehmen.", "version": "0.5.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "homepage_url": "https://openlitbase.de", "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "extension@openlitbase.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "OpenLitBase", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}