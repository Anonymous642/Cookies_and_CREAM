{"manifest_version": 2, "name": "BBL Track Subscriber", "version": "1.1.0", "description": "Track Bambu Lab filament stock from bbltracker.com while browsing the Bambu Lab store.", "permissions": ["storage", "alarms", "notifications", "https://bbltracker.com/*"], "background": {"scripts": ["background/index.js"]}, "content_scripts": [{"matches": ["https://*.store.bambulab.com/*/products/*", "https://*.store.bambulab.com/products/*", "https://*.store.bambulab.com/*/cart", "https://*.store.bambulab.com/cart"], "js": ["content/index.js"], "css": ["content/overlay.css"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup/index.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "bbltracksubscriber@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}