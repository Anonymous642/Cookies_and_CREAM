{"manifest_version": 2, "name": "Clean YouTube", "version": "2.0.2", "description": "Hides YouTube Shorts, suggestions, sponsored results, and more. Customize via popup or options.", "browser_specific_settings": {"gecko": {"id": "youtube-simplified-cleanup@example.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "webRequest", "webRequestBlocking", "*://*.youtube.com/*"], "browser_action": {"default_popup": "popup.html", "default_title": "Clean YouTube", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"scripts": ["background.js"], "persistent": true}, "commands": {"toggle-up-next": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Toggle Up next sidebar visibility"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_end"}]}