{"manifest_version": 3, "name": "COMC Shipment Helper", "version": "1.0.2", "description": "Adds all visible COMC inventory cards to the current shipment.", "browser_specific_settings": {"gecko": {"id": "comc-shipment-helper@paulcarlcards.com", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://*.comc.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}