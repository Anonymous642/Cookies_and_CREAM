{"manifest_version": 2, "name": "SnapText \u2013 Text Expander", "version": "1.0.0", "description": "Define shortcuts that auto-expand to formatted text snippets as you type \u2014 on every website.", "author": "SnapText", "browser_specific_settings": {"gecko": {"id": "snaptext@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_title": "SnapText \u2013 Text Expander", "default_icon": {"48": "icon48.svg", "96": "icon96.svg"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"48": "icon48.svg", "96": "icon96.svg"}}