{"manifest_version": 2, "name": "X (Twitter) to Obsidian Downloader", "version": "1.0", "description": "Download X (Twitter) threads and images to Obsidian", "permissions": ["activeTab", "downloads", "storage", "contextMenus", "*://x.com/*", "*://twitter.com/*"], "browser_specific_settings": {"gecko": {"id": "xtoobsidian@julianferrone.com"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://x.com/*/status/*", "*://twitter.com/*/status/*"], "js": ["content.js"]}], "options_ui": {"page": "options.html"}, "commands": {"_execute_download": {"suggested_key": {"default": "Alt+D"}, "description": "Download current tweet thread"}}, "page_action": {"default_icon": "icons/xtoobsidian.svg", "show_matches": ["*://x.com/*/status/*", "*://twitter.com/*/status/*"], "default_title": "Download Tweet to Obsidian"}}