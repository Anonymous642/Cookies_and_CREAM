{"manifest_version": 2, "name": "Keyboard Shortcuts for Bitbucket", "version": "1.0", "description": "Adds custom keyboard shortcuts to Bitbucket.", "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "content_scripts": [{"matches": ["*://*.bitbucket.org/*"], "css": ["styles.css"], "js": ["types.js", "icons.js", "content.js"], "run_at": "document_idle"}], "browser_action": {"default_icon": {"16": "images/icon16.png", "48": "images/icon48.png"}, "default_title": "Bitbucket Shortcuts"}, "browser_specific_settings": {"gecko": {"id": "bitbucket-shortcuts@smiling-friends.com", "strict_min_version": "79.0"}}, "permissions": ["*://*.bitbucket.org/*"]}