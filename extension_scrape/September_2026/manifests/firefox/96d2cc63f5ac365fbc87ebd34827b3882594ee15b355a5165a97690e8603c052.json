{"name": "ActivityWatch Web Watcher", "description": "Log the current tab and your browser activity with ActivityWatch.", "version": "0.5.4", "manifest_version": 2, "icons": {"128": "logo-128.png"}, "browser_action": {"default_icon": "logo-128.png", "default_popup": "src/popup/index.html"}, "background": {"scripts": ["src/background/main.js"], "persistent": true}, "options_ui": {"page": "src/settings/index.html"}, "permissions": ["tabs", "alarms", "notifications", "activeTab", "storage", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "aw-watcher-web-configurable@local", "data_collection_permissions": {"required": ["browsingActivity"]}}}}