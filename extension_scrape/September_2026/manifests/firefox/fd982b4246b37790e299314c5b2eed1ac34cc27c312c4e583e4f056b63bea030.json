{"manifest_version": 2, "name": "eBay Risk Highlighter", "version": "0.1.0", "description": "Highlights and optionally hides potentially risky eBay listings and sellers.", "permissions": ["storage", "*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.ebay.de/*", "*://*.ebay.fr/*", "*://*.ebay.it/*", "*://*.ebay.es/*", "*://*.ebay.ca/*", "*://*.ebay.com.au/*", "*://*.ebay.at/*", "*://*.ebay.ch/*", "*://*.ebay.ie/*", "*://*.ebay.nl/*", "*://*.ebay.be/*", "*://*.ebay.pl/*", "*://*.ebay.com.sg/*", "*://*.ebay.com.hk/*", "*://*.ebay.com.my/*", "*://*.ebay.ph/*"], "background": {"scripts": ["src/background/background.js"]}, "content_scripts": [{"matches": ["*://*.ebay.com/*", "*://*.ebay.co.uk/*", "*://*.ebay.de/*", "*://*.ebay.fr/*", "*://*.ebay.it/*", "*://*.ebay.es/*", "*://*.ebay.ca/*", "*://*.ebay.com.au/*", "*://*.ebay.at/*", "*://*.ebay.ch/*", "*://*.ebay.ie/*", "*://*.ebay.nl/*", "*://*.ebay.be/*", "*://*.ebay.pl/*", "*://*.ebay.com.sg/*", "*://*.ebay.com.hk/*", "*://*.ebay.com.my/*", "*://*.ebay.ph/*"], "js": ["src/lib/constants.js", "src/lib/storage.js", "src/content/dom-selectors.js", "src/content/risk-evaluator.js", "src/content/dom-mutator.js", "src/content/content-observer.js", "src/content/content-main.js"], "css": ["src/styles/highlight.css"], "run_at": "document_idle"}], "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "ebay-risk-highlighter@example.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}