{"manifest_version": 3, "name": "Clockwork CRM Voyager", "version": "1.0.2", "description": "Add LinkedIn people and companies to your Clockwork CRM in a click, and log conversations to their timeline as you browse.", "author": "Mythic Software", "homepage_url": "https://www.clockworkcrm.com", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "alarms", "identity", "cookies"], "host_permissions": ["https://*.linkedin.com/*", "https://*.licdn.com/*", "https://*.clockworkcrm.com/*"], "action": {"default_title": "Clockwork CRM Voyager", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://*.linkedin.com/*"], "js": ["boot.js"], "run_at": "document_start"}, {"matches": ["https://*.linkedin.com/*"], "js": ["interceptor.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true}, {"matches": ["https://www.linkedin.com/*"], "js": ["content.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["fonts/*.woff", "icons/*.svg"], "matches": ["https://*.linkedin.com/*"]}], "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Clockwork CRM Voyager", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "browser_specific_settings": {"gecko_android": {"strict_min_version": "142.0"}, "gecko": {"id": "clockwork-voyager@mythic.software", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "personalCommunications"]}}}}