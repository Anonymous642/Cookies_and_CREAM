{"manifest_version": 3, "name": "SmartMute Auto Control", "description": "Automatically mutes inactive tabs and paused media to ensure a quiet, distraction-free browsing experience.", "version": "1.0.0", "author": "SoundWave Labs", "permissions": ["tabs", "storage", "audio"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "smartmuteautocontrol@soundwavelabs.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}