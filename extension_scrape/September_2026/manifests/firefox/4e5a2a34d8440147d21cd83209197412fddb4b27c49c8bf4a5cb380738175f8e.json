{"manifest_version": 2, "name": "Network Zipper", "version": "0.5.1", "description": "Extension that lets you download the network tab in a zip file.", "homepage_url": "https://github.com/genizy/network-zipper", "background": {"scripts": ["background.js"]}, "content_scripts": [{"js": ["panel.js"], "matches": ["<all_urls>"]}], "devtools_page": "devtools.html", "permissions": ["activeTab", "http://*/*", "https://*/*"], "icons": {"16": "icon/icon.png", "32": "icon/icon.png", "48": "icon/icon.png", "128": "icon/icon.png"}, "browser_specific_settings": {"gecko": {"id": "network-zipper@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}