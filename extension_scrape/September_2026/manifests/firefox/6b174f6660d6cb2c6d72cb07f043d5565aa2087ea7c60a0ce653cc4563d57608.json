{"manifest_version": 3, "name": "X Video Flipper", "description": "Rotate individual videos on X and Twitter by 180 degrees.", "version": "0.1.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "x-video-flipper@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}