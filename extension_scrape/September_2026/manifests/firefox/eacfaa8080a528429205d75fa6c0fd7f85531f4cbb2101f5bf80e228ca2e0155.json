{"author": "Johannes Zellner", "manifest_version": 3, "name": "Meemo", "description": "This extension allows to add the current page with notes into Meemo.", "homepage_url": "https://meemo.minimal-space.de", "icons": {"48": "logo.svg", "96": "logo.svg", "128": "logo.svg", "256": "logo.svg", "512": "logo.svg"}, "version": "1.2.0", "browser_specific_settings": {"gecko": {"id": "guacamoly@nebulon.de"}}, "action": {"default_title": "Meemo", "default_icon": "logo.svg", "default_popup": "popup.html"}, "permissions": ["activeTab", "scripting"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["logo.svg", "dist/*"], "matches": ["<all_urls>"]}]}