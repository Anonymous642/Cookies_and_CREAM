{"manifest_version": 2, "name": "Kuma", "description": "Doublage et traduction instantan\u00e9e de vid\u00e9os web par IA avec synchronisation labiale et vocale.", "version": "0.1.8", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "permissions": ["storage", "cookies", "http://localhost:3001/*", "http://localhost:3002/*", "https://*.kdesire.com/*", "https://*.youtube.com/*", "https://*.youtube-nocookie.com/*", "*://*/*"], "browser_specific_settings": {"gecko": {"id": "extension@kuma.app", "data_collection_permissions": {"required": ["authenticationInfo", "financialAndPaymentInfo"], "optional": ["technicalAndInteraction"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Kuma", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube-nocookie.com/*", "*://*.youtube.com/*", "*://*/*"], "all_frames": true, "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}