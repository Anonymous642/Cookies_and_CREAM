{"manifest_version": 3, "name": "BookStack Clipper", "version": "1.4.0", "description": "Seiten, Artikel und Links per Klick in eine eigene BookStack-Instanz speichern (Read-it-later).", "author": "Booky Stack", "icons": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg", "128": "icons/icon.svg"}, "permissions": ["storage", "contextMenus", "activeTab", "scripting", "notifications"], "optional_host_permissions": ["*://*/*"], "background": {"scripts": ["common/bookstack-api.js", "background.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "BookStack Clipper", "default_icon": {"16": "icons/icon.svg", "32": "icons/icon.svg"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true, "browser_style": false}, "browser_specific_settings": {"gecko": {"id": "bookstack-clipper@booky-stack.local", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}