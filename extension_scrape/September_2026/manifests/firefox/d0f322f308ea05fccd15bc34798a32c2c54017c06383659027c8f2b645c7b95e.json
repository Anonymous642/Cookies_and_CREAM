{"manifest_version": 2, "name": "ChatGPT Business", "version": "1.3.0", "description": "Organize ChatGPT conversations with color-coded threads, templates, and folders", "permissions": ["storage", "https://chat.openai.com/*", "https://chatgpt.com/*"], "content_scripts": [{"matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_title": "ChatGPT Business", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "chatgpt-business@deafconmedia.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}