{"manifest_version": 3, "name": "SimpleUI for Facebook Messenger", "version": "1.5", "description": "Makes facebook.com/messages feel more like messenger.com", "browser_specific_settings": {"gecko": {"id": "simpleui.for.facebook.messenger@simpleui.site", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs", "windows"], "host_permissions": ["https://www.facebook.com/*", "https://web.facebook.com/*", "https://facebook.com/*"], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Options", "default_popup": "options.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "options_page": "options.html", "web_accessible_resources": [{"resources": ["options.html", "options.js", "icons/*", "icons/emoji/*"], "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*", "https://facebook.com/*"]}], "content_scripts": [{"matches": ["https://www.facebook.com/*", "https://web.facebook.com/*", "https://facebook.com/*"], "js": ["localeMeta.js", "content.js"], "run_at": "document_start"}]}