{"manifest_version": 3, "name": "YT Shorts to Videos", "version": "1.0.0", "description": "Automatically redirects YouTube Shorts URLs to regular YouTube video URLs.", "permissions": ["declarativeNetRequest", "webNavigation", "tabs"], "host_permissions": ["https://www.youtube.com/*"], "background": {"scripts": ["src/background.js"]}, "browser_specific_settings": {"gecko": {"id": "yt-shorts-to-vids@rando.tomingas", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "declarative_net_request": {"rule_resources": [{"id": "redirect_rules", "enabled": true, "path": "src/rules.json"}]}, "icons": {"16": "src/icons/icon16.png", "48": "src/icons/icon48.png", "128": "src/icons/icon128.png"}}