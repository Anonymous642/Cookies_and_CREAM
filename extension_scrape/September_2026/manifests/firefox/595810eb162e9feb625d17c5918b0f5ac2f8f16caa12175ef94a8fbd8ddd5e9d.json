{"version": "4.0.2", "manifest_version": 3, "name": "Notion Search", "description": "__MSG_extensionDescription__", "default_locale": "en", "options_page": "pages/options.html", "action": {"default_icon": "images/store-icons/icon38.png", "default_popup": "search.html?mode=popup"}, "background": {"page": "background.html"}, "permissions": ["storage", "unlimitedStorage"], "host_permissions": ["https://www.notion.so/api/v3/*", "https://app.notion.com/*"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "MacCtrl+Shift+P"}, "description": "Open the popup"}, "open-search-page": {"description": "Open the search page in new a tab"}}, "icons": {"16": "images/store-icons/icon16.png", "32": "images/store-icons/icon32.png", "48": "images/store-icons/icon48.png", "128": "images/store-icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "notion-search@cside.github.io"}}}