{"manifest_version": 3, "name": "Microslop Replacer", "version": "1.0", "browser_specific_settings": {"gecko": {"id": "microslop@luckyluk", "data_collection_permissions": {"required": ["none"]}}}, "description": "Replaces 'Microsoft' with 'Microslop' on all websites.", "permissions": ["activeTab", "scripting"], "icons": {"32": "icons/icon32.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}]}