{"manifest_version": 3, "name": "HumanTyper: Realistic Auto Typing", "version": "2.3.0", "description": "Paste text like a human! HumanTyper simulates natural keystrokes with speed control, random delays, and smart typing patterns.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "38": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage", "scripting", "contextMenus", "notifications", "clipboardWrite", "clipboardRead"], "host_permissions": ["https://www.google-analytics.com/*"], "action": {"default_popup": "popup.html", "default_title": "HumanTyper", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "38": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true}], "background": {"scripts": ["ExtPay.js", "analytics.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "humantyper@yourdomain.com", "strict_min_version": "109.0"}}, "web_accessible_resources": [{"resources": ["popup.html", "pricing.html", "feedback.html", "pricing.js", "feedback.js", "ExtPay.js", "license-manager.js", "analytics.js"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "commands": {"start-typing": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Start/stop automatic typing"}}}