{"manifest_version": 3, "name": "Cozey - Focus Control", "version": "0.1.0", "description": "Goal-oriented website access control powered by the Cozey desktop app", "permissions": ["alarms", "storage", "webNavigation"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["background-adapter.js"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Cozey", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "browser_specific_settings": {"gecko": {"id": "extension@cozey.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity", "searchTerms", "websiteActivity"]}}}}