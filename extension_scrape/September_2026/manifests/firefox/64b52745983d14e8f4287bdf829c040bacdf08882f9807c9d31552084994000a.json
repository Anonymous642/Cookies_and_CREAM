{"manifest_version": 3, "name": "Roblox Community Role Viewer", "version": "1.0", "description": "Displays user ranks in the Communities section of your Roblox profile.", "host_permissions": ["https://groups.roblox.com/*"], "content_scripts": [{"matches": ["https://www.roblox.com/users/*/profile*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"128": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "roblox-community-role-viewer@addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "location": {"description": "Not collected", "required": false}, "websiteActivity": {"description": "Not collected", "required": false}, "userIdentifiers": {"description": "Not collected", "required": false}, "health": {"description": "Not collected", "required": false}, "financialAndPaymentInfo": {"description": "Not collected", "required": false}, "authenticationInfo": {"description": "Not collected", "required": false}, "personalCommunications": {"description": "Not collected", "required": false}}}}}