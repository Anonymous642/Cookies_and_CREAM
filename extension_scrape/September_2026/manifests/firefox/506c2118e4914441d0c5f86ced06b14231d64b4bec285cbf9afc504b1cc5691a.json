{"manifest_version": 3, "name": "Shiki Search", "version": "1.0.2", "description": "\u0420\u0430\u0441\u0448\u0438\u0440\u0435\u043d\u0438\u0435 \u0434\u043b\u044f \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043f\u043e\u0438\u0441\u043a\u043e\u0432\u044b\u0445 \u043a\u043d\u043e\u043f\u043e\u043a \u043d\u0430 \u0441\u0430\u0439\u0442\u0435 Shikimori", "action": {"default_icon": "./assets/icon-512.png"}, "sidebar_action": {"default_panel": "dist/sidepanel/index.html", "open_at_install": true}, "background": {"scripts": ["dist/background/index.mjs"], "type": "module"}, "icons": {"16": "./assets/icon-512.png", "48": "./assets/icon-512.png", "128": "./assets/icon-512.png"}, "permissions": ["tabs", "storage", "activeTab", "sidePanel"], "host_permissions": ["*://*/*"], "content_scripts": [{"matches": ["https://*.shikimori.one/*"], "js": ["dist/contentScripts/index.global.js"]}], "web_accessible_resources": [{"resources": ["dist/contentScripts/style.css"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "shikimori-search-extension@example.com"}}}