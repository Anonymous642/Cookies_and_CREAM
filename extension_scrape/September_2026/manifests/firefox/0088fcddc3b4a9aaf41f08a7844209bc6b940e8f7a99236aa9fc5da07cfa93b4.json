{"manifest_version": 3, "name": "YouTube Quick Trim", "version": "1.7.4", "description": "Create, edit and manage YouTube clips on YouTubeTrimmer", "permissions": ["storage", "tabs"], "host_permissions": ["*://www.youtube.com/*"], "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"]}], "action": {"default_popup": "popup.html"}, "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "yt-quick-clip@yourname", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}