{"manifest_version": 2, "name": "Speed Dial & Tools Hub", "version": "1.0.1", "description": "A fast, minimal new tab with speed dial, notepad, calculator, bookmarks, and recent history.", "chrome_url_overrides": {"newtab": "newtab.html"}, "permissions": ["storage", "history", "bookmarks"], "content_security_policy": "script-src 'self'; object-src 'self'; img-src 'self' https://www.google.com data:;", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "speed-dial-hub@paperclip.ing", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteActivity"], "optional": []}}}}