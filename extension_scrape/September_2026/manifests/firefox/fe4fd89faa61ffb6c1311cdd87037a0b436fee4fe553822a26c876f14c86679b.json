{"manifest_version": 2, "name": "ColumnDeck", "version": "1.0.0", "description": "View user-selected web pages side by side in a compact four-column dashboard.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "tabs", "webRequest", "webRequestBlocking", "<all_urls>"], "browser_action": {"default_title": "ColumnDeck", "default_popup": "launcher.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content/x-adapter.js"], "run_at": "document_idle", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "columndeck@example.local", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "115.0"}}}