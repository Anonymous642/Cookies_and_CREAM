{"manifest_version": 3, "name": "AI Block", "version": "1.0.3", "description": "Google AI Overview blocker", "browser_specific_settings": {"gecko": {"id": "ai-block@twonest.com", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "host_permissions": ["*://*.google.com/*", "*://*.google.fr/*"], "content_scripts": [{"matches": ["*://*.google.com/search*", "*://*.google.fr/search*"], "js": ["content.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html"}}