{"manifest_version": 3, "name": "Pawster", "version": "0.3.29", "description": "Headless helper for the Pawster web app. This posts to Patreon and Subscribestar in your logged-in session.", "permissions": [], "browser_specific_settings": {"gecko": {"id": "ziggy@wolfbard.art", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "host_permissions": ["https://*.patreon.com/*", "https://*.patreonusercontent.com/*", "https://*.subscribestar.com/*", "https://*.subscribestar.adult/*", "https://*.amazonaws.com/*", "https://*.googleapis.com/*"], "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "background": {"scripts": ["paw-resolvers.js", "paw-shared.js", "paw-patreon.js", "paw-subscribestar.js", "offscreen.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Pawster helper", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}}, "content_scripts": [{"matches": ["https://*.patreon.com/*", "https://*.subscribestar.com/*", "https://*.subscribestar.adult/*"], "js": ["paw-resolvers.js", "paw-shared.js", "paw-patreon.js", "paw-subscribestar.js", "api.js", "content.js"], "run_at": "document_idle"}, {"matches": ["https://wolfbard.art/*", "https://www.wolfbard.art/*"], "js": ["bridge.js"], "run_at": "document_idle"}]}