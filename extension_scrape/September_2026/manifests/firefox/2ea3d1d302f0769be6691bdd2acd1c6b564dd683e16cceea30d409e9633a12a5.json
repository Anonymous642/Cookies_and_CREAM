{"manifest_version": 3, "name": "Sweet Home", "version": "1.0", "description": "A simple little extension for your browser that allows you to set a custom HTML page as a home page", "permissions": ["storage", "tabs"], "browser_specific_settings": {"gecko": {"id": "SweetHome@ztzzdsy", "data_collection_permissions": {"required": ["none"]}}}, "homepage_url": "https://github.com/ztzzdsy/sweethome", "icons": {"48": "Icons/Icon48.png", "96": "Icons/Icon96.png"}, "chrome_url_overrides": {"newtab": "Pages/HomePage/HomePage.html"}, "background": {"scripts": ["Background.js"], "service_worker": "Background.js"}, "action": {"default_title": "Sweet Home", "default_icon": {"32": "Icons/Icon32.png"}}}