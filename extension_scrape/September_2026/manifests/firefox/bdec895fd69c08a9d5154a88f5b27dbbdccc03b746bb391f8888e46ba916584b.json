{"manifest_version": 3, "name": "YouTube Pause All, Focus Timer & Blocker", "version": "1.2.0", "description": "Pause all YouTube tabs, hide distractions, control speed and sound, and block YouTube during a focus timer with a live countdown.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["alarms", "notifications", "storage", "tabs", "webRequest", "webRequestBlocking"], "host_permissions": ["*://youtube.com/*", "*://*.youtube.com/*", "*://youtube-nocookie.com/*", "*://*.youtube-nocookie.com/*", "*://youtu.be/*", "*://*.youtu.be/*"], "background": {"scripts": ["focus-common.js", "background.js"]}, "action": {"default_title": "Open YouTube pause and focus controls", "default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "content_scripts": [{"matches": ["*://youtube.com/*", "*://*.youtube.com/*", "*://youtube-nocookie.com/*", "*://*.youtube-nocookie.com/*", "*://youtu.be/*", "*://*.youtu.be/*"], "js": ["focus-common.js", "focus-guard.js"], "all_frames": true, "match_about_blank": true, "run_at": "document_start"}, {"matches": ["*://youtube.com/*", "*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"toggle-youtube-playback": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Pause or resume YouTube videos across all tabs"}}, "browser_specific_settings": {"gecko": {"id": "tubetidy@creativeworks.tools", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "web_accessible_resources": [{"resources": ["focus/blocked.html"], "matches": ["<all_urls>"]}]}