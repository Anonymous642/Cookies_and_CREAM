{"manifest_version": 2, "name": "History Heist", "version": "1.0.1", "description": "A memory/adventure game that treats your browsing history as 'stolen items' you must remember and recover.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["history", "storage", "notifications"], "browser_action": {"default_title": "History Heist", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "options_ui": {"page": "popup.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "historyheist@lamthao.dev", "strict_min_version": "100.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo"]}}}}