{"manifest_version": 3, "name": "KeepS - Manage tabs into workspaces", "version": "1.0.0", "version_name": "1.0.0", "description": "Save complete browsing sessions, freeze tabs for later, and restore your workspace whenever you need it.", "browser_specific_settings": {"gecko": {"id": "keeps@sitraka.dev", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage", "alarms"], "background": {"scripts": ["background.js"], "type": "module"}, "sidebar_action": {"default_panel": "index.html", "default_title": "Keeps", "default_icon": {"16": "logo.png", "32": "logo.png", "48": "logo.png", "128": "logo.png"}}, "action": {"default_title": "Keeps", "default_icon": {"16": "logo.png", "32": "logo.png", "48": "logo.png", "128": "logo.png"}}, "icons": {"16": "logo.png", "32": "logo.png", "48": "logo.png", "128": "logo.png"}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Ouvrir la sidebar Keeps"}, "save-to-icebox": {"suggested_key": {"default": "Alt+S", "mac": "Alt+S"}, "description": "Envoyer l'onglet actif dans la Icebox"}}}