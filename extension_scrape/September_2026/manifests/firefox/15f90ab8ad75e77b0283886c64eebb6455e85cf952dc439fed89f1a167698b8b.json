{"manifest_version": 2, "name": "Geld", "description": "Hide test files from GitHub diffs. Review what matters; the tests wait in a tidy section at the bottom.", "version": "0.1.2.355", "short_name": "Geld", "icons": {"16": "icon/16.png", "32": "icon/32.png", "128": "icon/128.png", "256": "icon/256.png", "512": "icon/512.png"}, "homepage_url": "https://github.com/brandonmcconnell/geld", "permissions": ["storage", "alarms", "https://github.com/*", "https://patch-diff.githubusercontent.com/*", "https://api.github.com/*"], "optional_permissions": ["https://*/*"], "commands": {"toggle-hidden": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Show or hide the files Geld hides on the current page"}}, "browser_specific_settings": {"gecko": {"id": "geld@brandonmcconnell.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_icon": {"16": "icon/action/black-16.png", "32": "icon/action/black-32.png", "48": "icon/action/black-48.png"}, "default_title": "Geld", "default_popup": "popup.html", "theme_icons": [{"dark": "icon/action/black-16.png", "light": "icon/action/white-16.png", "size": 16}, {"dark": "icon/action/black-32.png", "light": "icon/action/white-32.png", "size": 32}, {"dark": "icon/action/black-48.png", "light": "icon/action/white-48.png", "size": 48}]}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://github.com/*"], "run_at": "document_start", "css": ["content-scripts/github.css"], "js": ["content-scripts/github.js"]}]}