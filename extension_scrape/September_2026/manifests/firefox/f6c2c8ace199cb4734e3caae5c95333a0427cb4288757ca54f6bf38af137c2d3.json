{"manifest_version": 3, "name": "TicketBot", "version": "1.6.0", "description": "Ticket Bot", "browser_specific_settings": {"gecko": {"id": "ticketbot@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_title": "TicketBot", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["defaults.js", "background.js"]}, "content_scripts": [{"matches": ["https://discord.com/*", "https://ptb.discord.com/*", "https://canary.discord.com/*"], "js": ["defaults.js", "content.js"], "run_at": "document_idle"}], "permissions": ["storage", "tabs", "scripting"], "host_permissions": ["https://discord.com/*", "https://ptb.discord.com/*", "https://canary.discord.com/*"], "web_accessible_resources": [{"resources": ["page-bridge.js"], "matches": ["https://discord.com/*", "https://ptb.discord.com/*", "https://canary.discord.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:"}}