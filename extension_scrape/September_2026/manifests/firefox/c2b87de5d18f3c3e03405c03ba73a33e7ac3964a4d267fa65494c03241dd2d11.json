{"manifest_version": 3, "name": "Gather Meetings (Classic)", "description": "Schedule meetings in Gather directly from Google Calendar.", "homepage_url": "https://gather.town", "author": "Gather", "version": "0.0.98.5", "icons": {"16": "logo/logo-16.png", "48": "logo/logo-48.png", "128": "logo/logo-128.png"}, "action": {"default_title": "Gather Calendar Extension", "default_popup": "popup/popup.html"}, "permissions": ["storage"], "host_permissions": ["https://api.gather.town/*", "https://api.staging.gather.town/*", "https://identitytoolkit.googleapis.com/*", "https://securetoken.googleapis.com/*"], "background": {"scripts": ["background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "content_scripts": [{"matches": ["https://calendar.google.com/calendar/*"], "js": ["content-script.js"], "run_at": "document_end"}, {"matches": ["https://app.gather.town/*"], "js": ["gather-page-relay.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["gather-page-bridge.js"], "matches": ["https://app.gather.town/*"]}, {"resources": ["gather-auth-sync.js"], "matches": ["https://app.gather.town/*"]}, {"resources": ["logo/logo-128.png"], "matches": ["https://calendar.google.com/*"]}], "browser_specific_settings": {"gecko": {"id": "gather-meetings-classic@addons.mozilla.org", "strict_min_version": "154.0", "data_collection_permissions": {"required": ["none"]}}}}