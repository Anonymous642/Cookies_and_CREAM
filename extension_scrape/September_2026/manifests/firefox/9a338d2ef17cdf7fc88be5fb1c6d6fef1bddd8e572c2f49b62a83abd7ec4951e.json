{"manifest_version": 2, "name": "Reverbify - Remix Music on Spotify", "version": "1.1.5", "description": "Easily remix audio live from the Spotify Web App, including effects like speed, pitch, reverb, and much more!", "icons": {"128": "icons/reverbify-128.png"}, "browser_specific_settings": {"gecko": {"id": "reverbify@spotify-reverb.extension", "strict_min_version": "109.0"}}, "browser_action": {"default_popup": "popup.html"}, "background": {"scripts": ["assets/background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://open.spotify.com/*"], "js": ["assets/contentScript.js"]}], "web_accessible_resources": ["icons/*", "assets/injected.js", "assets/exposeSoundtouchUrl.js", "assets/*.css", "assets/soundtouchProcessor.js"], "permissions": ["activeTab"]}