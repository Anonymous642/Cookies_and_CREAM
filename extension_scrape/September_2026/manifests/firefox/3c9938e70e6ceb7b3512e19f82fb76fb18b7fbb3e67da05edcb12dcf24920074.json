{"manifest_version": 2, "name": "YouTube Live Chat Analyzer", "version": "1.0.0", "description": "\u0410\u043d\u0430\u043b\u0438\u0437 \u0447\u0430\u0442\u0430 YouTube \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438: \u0442\u043e\u043f \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a\u043e\u0432, \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430, \u044d\u043a\u0441\u043f\u043e\u0440\u0442 CSV", "permissions": ["storage", "activeTab", "*://*.youtube.com/*"], "browser_action": {"default_popup": "popup.html", "default_title": "YouTube Live Chat Analyzer"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}], "web_accessible_resources": ["dashboard.html", "dashboard.js"], "browser_specific_settings": {"gecko": {"id": "youtube-live-chat-analyzer@firefox.addons", "data_collection_permissions": {"required": ["none"]}}}}