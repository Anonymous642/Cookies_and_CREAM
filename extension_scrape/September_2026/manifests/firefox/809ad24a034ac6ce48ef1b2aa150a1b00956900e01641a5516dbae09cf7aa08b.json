{"manifest_version": 3, "name": "Copy Title to Markdown", "version": "1.1.1", "description": "Copy the current page as a markdown link, using the page title or text you pick from the page.", "permissions": ["activeTab", "clipboardWrite", "scripting"], "icons": {"48": "icon.svg", "96": "icon.svg"}, "action": {"default_title": "Copy as markdown link", "default_icon": "icon.svg", "default_popup": "popup.html"}, "commands": {"copy-page-title": {"suggested_key": {"default": "Ctrl+Alt+L", "mac": "Command+Alt+L"}, "description": "Copy page title as markdown link"}, "pick-element": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Pick element text to copy as markdown link"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "copy-title-to-markdown@joeriddles", "data_collection_permissions": {"required": ["none"]}}}}