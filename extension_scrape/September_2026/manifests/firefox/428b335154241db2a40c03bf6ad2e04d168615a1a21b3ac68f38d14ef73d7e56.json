{"manifest_version": 3, "name": "LinkedIn Learning Course Monitor", "version": "0.1.1", "description": "User-controlled monitor for LinkedIn Learning course progress, player/page errors, recovery and completion status.", "permissions": ["storage", "tabs"], "host_permissions": ["https://www.linkedin.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Learning Monitor", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.linkedin.com/learning/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "learning-monitor@example.local", "strict_min_version": "120.0", "data_collection_permissions": {"required": ["none"]}}}}