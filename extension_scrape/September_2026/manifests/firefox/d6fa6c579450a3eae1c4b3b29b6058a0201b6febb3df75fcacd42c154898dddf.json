{"manifest_version": 3, "name": "Backstop \u2013 Draft Recovery", "short_name": "Backstop", "version": "0.1.0", "description": "Quietly saves substantial drafts and helps restore them after refreshes, crashes, and expired sessions.", "author": "End of the End", "icons": {"16": "icons/backstop.svg", "32": "icons/backstop.svg", "48": "icons/backstop.svg", "64": "icons/backstop.svg", "96": "icons/backstop.svg"}, "permissions": ["storage"], "incognito": "not_allowed", "background": {"scripts": ["src/background.js"]}, "action": {"default_title": "Backstop", "default_icon": "icons/backstop.svg", "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/common.js", "src/field-policy.js", "src/content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}], "browser_specific_settings": {"gecko": {"id": "backstop@endoftheend", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}