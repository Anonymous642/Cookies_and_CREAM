{"manifest_version": 3, "name": "SKARS Audio Skipper", "version": "1.0", "description": "Automatically swipes past Instagram Reels playing SKARS audio.", "browser_specific_settings": {"gecko": {"id": "skars-skipper@yourdomain.com", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"128": "logo.jpg"}, "content_scripts": [{"matches": ["*://*.instagram.com/*"], "js": ["content.js"], "run_at": "document_end"}]}