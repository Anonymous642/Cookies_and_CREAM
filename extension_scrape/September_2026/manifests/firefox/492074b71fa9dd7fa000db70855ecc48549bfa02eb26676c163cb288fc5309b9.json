{"manifest_version": 3, "name": "WordGloss", "version": "2.1.0", "description": "Select a word to see a fast, concise definition and pronunciation without leaving the page.", "permissions": ["menus", "storage", "activeTab"], "host_permissions": ["https://api.dictionaryapi.dev/*", "https://en.wiktionary.org/*", "https://upload.wikimedia.org/*", "https://ssl.gstatic.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "word-gloss@local.example", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_title": "WordGloss site settings", "default_popup": "popup.html"}}