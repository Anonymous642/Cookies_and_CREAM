{"manifest_version": 3, "name": "1000% Sound Booster", "version": "1.0.2", "description": "Simple local-only tab audio booster with a 0-1000 slider. Look the one I used to got banned and the others on the store all requested weird permissions, so i vibecoded one without the ads and tracking", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["tabs", "webNavigation"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "1000% Sound Booster", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/booster.js"], "run_at": "document_start", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "sound-booster@local", "data_collection_permissions": {"required": ["none"]}}}}