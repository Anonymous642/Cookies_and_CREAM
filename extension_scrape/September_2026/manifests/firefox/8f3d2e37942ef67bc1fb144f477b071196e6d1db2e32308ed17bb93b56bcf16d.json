{"manifest_version": 3, "name": "KD SmartFill", "version": "1.0.0", "description": "KD's generic, locally-run form auto-filler for QA/testing: detects form fields, fills them with fresh test data, and maps uploaded files to file inputs. No external server.", "permissions": ["storage", "unlimitedStorage", "activeTab", "scripting"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "smart-form-auto-filler@example.com", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["utils/storage.js", "background/service-worker.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "KD SmartFill", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["utils/logger.js", "utils/storage.js", "utils/file-types.js", "content/form-detector.js", "content/file-uploader.js", "content/form-filler.js", "content/content.js"], "run_at": "document_idle"}]}