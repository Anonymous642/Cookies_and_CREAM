{"manifest_version": 3, "name": "SpendEdge AI", "version": "1.0.0", "description": "Access procurement intelligence, market insights, and supplier analytics directly in your browser.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["https://integration.spendedge.ai/*", "https://spendedge.ai/*"], "sidebar_action": {"default_title": "SpendEdge AI", "default_panel": "sidepanel.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src https://integration.spendedge.ai; img-src 'self' data:; style-src 'self'; font-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "spendedge-procurement-hub@spendedge.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo"]}}}, "action": {"default_title": "SpendEdge AI", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}}