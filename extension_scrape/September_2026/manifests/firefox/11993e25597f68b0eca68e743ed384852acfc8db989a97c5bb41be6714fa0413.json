{"manifest_version": 2, "name": "Tab Manager", "short_name": "Tab Manager", "version": "1.3.0", "description": "Adds a counter that shows you how many tabs you have open, and lets you set a maximum number of tabs you're allowed to open. Clicking the counter opens a page that lists all of your tabs and lets you select tabs to close them, bookmark them, move them, put them to sleep, and more.", "background": {"scripts": ["background.js"]}, "permissions": ["<all_urls>", "bookmarks", "sessions", "storage", "tabs", "tabHide"], "optional_permissions": [], "icons": {"48": "icons/extension_icon.svg", "96": "icons/extension_icon.svg"}, "options_ui": {"browser_style": false, "open_in_tab": true, "page": "tab_manager/index.html"}, "browser_action": {"browser_style": false, "default_area": "tabstrip", "default_icon": "icons/browser_action.svg", "default_title": "Tab Manager", "theme_icons": [{"light": "icons/browser_action_light.svg", "dark": "icons/browser_action_dark.svg", "size": 16}]}, "browser_specific_settings": {"gecko": {"id": "{b836fc99-007d-400b-98ad-abd84efaa7a2}"}}}