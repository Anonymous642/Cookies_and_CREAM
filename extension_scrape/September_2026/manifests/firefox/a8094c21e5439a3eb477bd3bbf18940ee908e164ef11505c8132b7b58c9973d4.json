{"manifest_version": 3, "name": "Gulliver", "version": "1.4", "description": "Navigate a YouTube live stream to an exact on-screen time \u2014 type the time, press Enter, you're there.", "browser_specific_settings": {"gecko": {"id": "gulliver@wildlifecams", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "scripting"], "host_permissions": ["https://www.youtube.com/*"], "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_title": "Gulliver \u2014 show/hide the jump box", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.youtube.com/watch*"], "js": ["page.js"], "world": "MAIN", "run_at": "document_idle"}, {"matches": ["https://www.youtube.com/watch*"], "js": ["content.js"], "world": "ISOLATED", "run_at": "document_idle"}]}