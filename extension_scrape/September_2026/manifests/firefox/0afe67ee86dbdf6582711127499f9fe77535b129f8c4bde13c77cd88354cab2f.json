{"manifest_version": 2, "name": "Focus Blur", "version": "1.0", "description": "Automatically blur images/media in background tabs to reduce distraction. Per-tab toggle and blur intensity.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "storage", "activeTab", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "Focus Blur", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "applications": {"gecko": {"id": "focusblur@example.com"}}}