{"manifest_version": 2, "name": "Distilo", "version": "1.0.1", "description": "Save images, text, and links directly to Distilo - build your second brain with AI", "applications": {"gecko": {"id": "distilo@distilo.com", "strict_min_version": "58.0"}}, "permissions": ["contextMenus", "storage", "activeTab", "notifications", "<all_urls>"], "background": {"scripts": ["background/background.js"]}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "options_ui": {"page": "options/options.html"}}