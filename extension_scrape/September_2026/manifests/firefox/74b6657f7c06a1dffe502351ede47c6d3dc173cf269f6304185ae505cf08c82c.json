{"manifest_version": 3, "name": "SiteSpell", "version": "1.0", "description": "Lets you play with spells on web pages.", "homepage_url": "https://github.com/hekinav/site-spell/", "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png"}, "permissions": ["activeTab", "scripting"], "host_permissions": ["*://*/"], "browser_specific_settings": {"gecko": {"id": "hekinav@site-spell"}}, "action": {"default_icon": "icons/icon-32.png", "default_title": "Speller", "default_popup": "speller/index.html"}}