{"manifest_version": 2, "name": "Bitcoin Halving Countdown", "version": "1.0.0", "description": "Live Bitcoin halving countdown based on current block height from mempool.space.", "browser_specific_settings": {"gecko": {"id": "bitcoin-halving-countdown@extension", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "https://mempool.space/*"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_title": "Bitcoin Halving Countdown", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}}