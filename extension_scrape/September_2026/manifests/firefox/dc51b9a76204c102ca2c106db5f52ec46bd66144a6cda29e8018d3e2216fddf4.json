{"manifest_version": 2, "name": "Amazon SellerFlag", "version": "1.0", "description": "Zeigt das Herkunftsland eines Verk\u00e4ufers auf amazon.de", "icons": {"48": "icon-48.png", "96": "icon-96.png"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "sellerflag@proton.me", "data_collection_permissions": {"required": ["none"]}}}, "options_ui": {"page": "options.html", "open_in_tab": false}, "content_scripts": [{"matches": ["https://www.amazon.de/*"], "js": ["content.js"], "run_at": "document_end"}]}