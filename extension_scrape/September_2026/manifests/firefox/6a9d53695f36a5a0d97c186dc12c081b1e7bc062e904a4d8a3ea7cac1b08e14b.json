{"manifest_version": 3, "name": "PageClick \u2014 Auto Clicker", "version": "1.0.4", "description": "Choisissez un point sur la page et automatisez les clics. Intervalle, r\u00e9p\u00e9titions et enregistrement.", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "64": "icon-64.png", "96": "icon-96.png", "128": "icon-128.png"}, "permissions": ["activeTab", "scripting", "storage"], "action": {"default_popup": "popup.html", "default_title": "PageClick", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "64": "icon-64.png", "96": "icon-96.png", "128": "icon-128.png"}}, "commands": {"toggle": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "D\u00e9marrer ou arr\u00eater les clics sur la page"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "pageclick@local.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}