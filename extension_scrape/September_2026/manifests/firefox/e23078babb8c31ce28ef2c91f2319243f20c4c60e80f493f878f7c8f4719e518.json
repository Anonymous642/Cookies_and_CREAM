{"manifest_version": 3, "name": "re7 Recipe Importer", "version": "1.0.0", "description": "Import recipes from any web page into your re7 account.", "browser_specific_settings": {"gecko": {"id": "recipe-importer@re7.dev", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["websiteContent", "browsingActivity"]}}}, "permissions": ["activeTab", "scripting", "storage", "identity"], "optional_host_permissions": ["*://*/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}}