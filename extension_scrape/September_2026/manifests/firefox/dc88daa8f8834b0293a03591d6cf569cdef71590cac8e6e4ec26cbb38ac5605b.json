{"manifest_version": 3, "name": "YouTube Scroll Speed", "version": "1.0.11", "description": "Change YouTube playback speed by scrolling; shows a speedometer above the title.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/speedometer.png"], "matches": ["https://www.youtube.com/*"]}], "options_ui": {"page": "options.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "youtube-speedometer@example.com"}}}