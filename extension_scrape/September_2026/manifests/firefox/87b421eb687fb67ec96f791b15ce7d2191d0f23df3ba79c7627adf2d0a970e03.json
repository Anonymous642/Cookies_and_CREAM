{"manifest_version": 3, "name": "KnowledgeVault", "version": "1.1.0", "description": "AI-powered personal knowledge collector \u2014 save, summarize, and search the web intelligently.", "permissions": ["storage", "activeTab", "scripting", "contextMenus", "tabs"], "host_permissions": ["https://generativelanguage.googleapis.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "knowledgevault@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}