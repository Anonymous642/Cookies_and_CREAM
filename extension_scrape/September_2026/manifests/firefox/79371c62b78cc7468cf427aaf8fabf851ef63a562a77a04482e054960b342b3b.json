{"manifest_version": 2, "name": "Memory Story Helper", "version": "1.0.0", "description": "Sends active tab URL/title to the Memory Story Mac app (local only).", "homepage_url": "https://kobyofek.com/memory-story", "permissions": ["tabs", "http://127.0.0.1:18765/*"], "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "memorystory-helper@memorystory.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity"]}}}}