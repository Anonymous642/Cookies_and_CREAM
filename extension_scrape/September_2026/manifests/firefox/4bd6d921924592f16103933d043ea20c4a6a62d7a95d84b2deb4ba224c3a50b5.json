{"manifest_version": 2, "name": "SkipIntro \u2014 ADN & Crunchyroll", "version": "1.0.0", "description": "Skip automatiquement les intros, outros et r\u00e9caps sur Crunchyroll et ADN.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "*://*.crunchyroll.com/*", "*://*.animationdigitalnetwork.fr/*", "*://*.animedigitalnetwork.fr/*", "*://*.adn.io/*"], "content_scripts": [{"matches": ["*://*.crunchyroll.com/*", "*://*.animationdigitalnetwork.fr/*", "*://*.animedigitalnetwork.fr/*", "*://*.adn.io/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "browser_specific_settings": {"gecko": {"id": "skip-intro@addon", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}