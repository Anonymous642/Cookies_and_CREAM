{"manifest_version": 3, "name": "Split View", "version": "1.0", "description": "Split your browser window into multiple frames to view several websites simultaneously.", "icons": {"16": "icons/split-16.png", "32": "icons/split-32.png", "64": "icons/split-64.png", "128": "icons/split-128.png", "256": "icons/split-256.png", "512": "icons/split-512.png"}, "permissions": ["activeTab", "tabs"], "action": {"default_popup": "split.html", "default_title": "Split View", "default_icon": {"16": "icons/split-16.png", "32": "icons/split-32.png", "64": "icons/split-64.png", "128": "icons/split-128.png", "256": "icons/split-256.png", "512": "icons/split-512.png"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "splitview.contact@jakobel.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}