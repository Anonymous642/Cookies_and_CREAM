{"manifest_version": 3, "name": "Unofficial AniList Manga Reminder", "version": "0.21.6", "description": "Adds unofficial manga chapter reminder countdowns and release calendars to AniList.", "permissions": ["storage"], "host_permissions": ["https://anilist.co/*", "https://graphql.anilist.co/*"], "browser_specific_settings": {"gecko": {"id": "unofficial-anilist-manga-reminder@gunnerbrown", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "searchTerms"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_title": "Unofficial AniList Manga Reminder", "default_popup": "src/popup/popup.html"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://anilist.co/*"], "js": ["src/shared/ext.js", "src/shared/storage.js", "src/shared/reminders.js", "src/content/content.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}], "background": {"scripts": ["src/background/background.js"]}, "web_accessible_resources": [{"resources": ["src/assets/icons/anilist-logo.svg"], "matches": ["https://anilist.co/*"]}]}