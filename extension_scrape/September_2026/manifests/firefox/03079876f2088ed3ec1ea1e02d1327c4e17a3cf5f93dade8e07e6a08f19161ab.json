{"manifest_version": 2, "name": "Razuna", "version": "1.4.1", "description": "Collect URLs, images, files, or text from any site! Build your library and share with your team in Razuna DAM.", "browser_specific_settings": {"gecko": {"id": "razuna@razuna.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/icon_16.png", "32": "icons/icon_32.png", "48": "icons/icon_48.png", "128": "icons/icon_128.png"}, "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_title": "Razuna", "default_popup": "popup.html"}, "options_page": "options.html", "content_security_policy": "script-src 'self'; object-src 'self';", "permissions": ["activeTab", "contextMenus", "storage", "tabs", "notifications", "https://*/*", "http://*/*"], "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content_script.js"]}]}