{"manifest_version": 2, "name": "MBLOG YouTube Indir", "version": "1.0.6", "description": "YouTube sekmesi, tek video ve oynatma listesi indirme isteklerini MBLOG masaustu uygulamasina 127.0.0.1:5067 uzerinden iletir.", "permissions": ["storage", "tabs", "webRequest", "<all_urls>", "http://127.0.0.1:5067/*"], "background": {"scripts": ["core/bridge.js", "media-filters.js", "youtube-capture.js", "background.js"], "persistent": true}, "browser_action": {"default_title": "MBLOG YouTube Indir", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "mblog-youtube-indir@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "browsingActivity"]}}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}