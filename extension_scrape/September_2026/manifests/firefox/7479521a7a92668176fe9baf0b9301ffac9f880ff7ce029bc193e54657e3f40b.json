{"manifest_version": 3, "name": "Fresh New Tab", "version": "0.1.1", "description": "A fresh new tab page with search, calm backgrounds, and optional shortcuts.", "homepage_url": "https://freshnewtab.com", "icons": {"16": "fresh-new-tab-16.png", "32": "fresh-new-tab-32.png", "48": "fresh-new-tab-48.png", "128": "fresh-new-tab-128.png"}, "chrome_settings_overrides": {"search_provider": {"name": "Focus Search", "keyword": "focus", "search_url": "https://focusafesearch.com/search?q={searchTerms}", "favicon_url": "fresh-new-tab-16.png", "encoding": "UTF-8", "is_default": true}}, "chrome_url_overrides": {"newtab": "newtab.html"}, "options_page": "options.html", "background": {"scripts": ["background.js"]}, "permissions": ["storage", "search"], "optional_permissions": ["bookmarks"], "host_permissions": ["https://wallpapers.newtabextension.com/", "https://api.pexels.com/", "https://www.google.com/"], "browser_specific_settings": {"gecko": {"id": "freshnewtab@freshnewtab.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["searchTerms"], "optional": ["bookmarksInfo"]}}}}