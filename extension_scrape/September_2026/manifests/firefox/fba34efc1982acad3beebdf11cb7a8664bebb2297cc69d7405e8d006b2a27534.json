{"manifest_version": 2, "name": "vSphere Clipboard Bridge", "version": "2.1.4", "description": "Copier/coller dans les consoles VMware vSphere Web Client HTML5 \u2014 injection clavier fid\u00e8le avec support casse et caract\u00e8res sp\u00e9ciaux", "browser_specific_settings": {"gecko": {"id": "vsphere-clipboard-bridge@internal", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["clipboardRead", "activeTab", "storage"], "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "vSphere Clipboard Bridge", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*/*ui/#/console/*", "*://*/*vsphere-client/*", "*://*/*vsphere-ui/*", "*://*/*vmrc*", "*://*/*?console*", "*://*/*.vmware.com/*", "*://*/*webconsole*", "*://*/*screen*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}]}