{"manifest_version": 3, "name": "Dark Mode for Every Website \u2013 NeoReader", "description": "Dark mode for every website, no white flash. Per-site brightness and a schedule. Free, no account, no site access until you ask.", "version": "0.1.2", "short_name": "NeoReader Dark", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "homepage_url": "https://neoreader.com/dark-mode", "permissions": ["activeTab", "scripting", "storage"], "optional_host_permissions": ["*://*/*"], "action": {"default_title": "NeoReader Dark Mode", "default_popup": "popup.html"}, "commands": {"toggle-dark": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Dark Mode on This Site (On/Off)"}, "toggle-pause": {"description": "Pause or Resume Dark Mode Everywhere"}}, "browser_specific_settings": {"gecko": {"id": "darkmode@neoreader.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": true, "page": "options.html"}}