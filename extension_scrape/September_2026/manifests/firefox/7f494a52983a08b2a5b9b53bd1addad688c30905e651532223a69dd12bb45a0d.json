{"manifest_version": 2, "name": "CiteReady Web Importer", "description": "CiteReady Web Importer", "version": "2.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab", "scripting", "tabs", "<all_urls>"], "content_security_policy": "script-src 'self'; object-src 'self';", "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "CiteReady Web Importer", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.google.com/*"], "js": ["content-scripts/content.js"]}], "browser_specific_settings": {"gecko": {"id": "randy@citeready.com"}}}