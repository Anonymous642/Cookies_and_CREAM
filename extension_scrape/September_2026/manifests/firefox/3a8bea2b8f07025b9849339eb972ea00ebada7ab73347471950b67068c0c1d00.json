{"manifest_version": 2, "name": "DownloadLens", "version": "1.3.6", "author": "Arkadiusz Pajda (Artllex)", "description": "Routes downloads from selected websites to chosen local folders, with conversation folders for ChatGPT.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["downloads", "contextMenus", "tabs", "storage", "nativeMessaging", "<all_urls>"], "background": {"scripts": ["privacy.js", "filename-rules.js", "background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["privacy.js", "capture-context.js"], "run_at": "document_start"}], "browser_action": {"default_title": "DownloadLens", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "download-router@artllex", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "websiteActivity", "personallyIdentifyingInfo"]}}}}