{"manifest_version": 3, "name": "Smart Auto Refresher by Ecomzens", "version": "1.0.8", "description": "Refresh tabs automatically with persistent per-tab timers, MV3-safe alarms, and reliable ON/OFF controls.", "permissions": ["activeTab", "alarms", "storage", "tabs"], "action": {"default_popup": "popup.html", "default_title": "Smart Auto Refresher"}, "background": {"scripts": ["background.js"]}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "smart-auto-refresher@ecomzens.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}