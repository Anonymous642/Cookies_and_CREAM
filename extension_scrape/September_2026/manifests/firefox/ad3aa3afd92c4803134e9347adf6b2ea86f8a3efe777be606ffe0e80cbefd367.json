{"manifest_version": 2, "name": "Outline", "version": "1.0.0", "description": "Generate and view an outline of any webpage based on headings (H1\u2013H6).", "permissions": ["activeTab", "storage"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Outline", "default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_scripts/outline.js"], "run_at": "document_idle"}], "web_accessible_resources": ["content_styles/outline.css"], "applications": {"gecko": {"id": "outline@example.com", "strict_min_version": "60.0"}}}