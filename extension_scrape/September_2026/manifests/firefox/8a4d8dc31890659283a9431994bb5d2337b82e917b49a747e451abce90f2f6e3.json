{"manifest_version": 3, "name": "GD Downloader", "version": "1.3", "description": "Paste GDrive link and download video without login", "icons": {"48": "icon_48.png", "128": "icon_128.png"}, "browser_specific_settings": {"gecko": {"id": "gd-downloader@example.com", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_title": "GD Downloader", "default_popup": "index.html", "default_icon": {"48": "icon_48.png", "128": "icon_128.png"}}, "permissions": ["downloads", "*://drive.google.com/*", "*://*.googleusercontent.com/*"]}