{"manifest_version": 3, "name": "The 20s Rule", "version": "1.5.3", "description": "Create a brief pause between an impulse and an action, helping you build better browsing habits.", "permissions": ["storage", "webNavigation"], "host_permissions": ["<all_urls>", "https://20srule.com/"], "action": {"default_popup": "options.html", "default_icon": "/icons/icon-dark.svg", "theme_icons": [{"light": "icons/icon-dark.svg", "dark": "icons/icon-light.svg", "size": 16}]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["pause.html", "browser-polyfill.js"], "matches": ["<all_urls>"]}], "background": {"scripts": ["browser-polyfill.js", "config.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "the-20s-rule@your-email.com", "strict_min_version": "109.0"}, "gecko_android": {"strict_min_version": "113.0"}}}