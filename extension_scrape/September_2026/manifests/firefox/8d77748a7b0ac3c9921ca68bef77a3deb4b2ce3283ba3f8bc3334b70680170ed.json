{"manifest_version": 3, "name": "Clean Copy", "version": "1.0.0", "description": "Copy page URL with or without parameters. Remove trackers from URLs.", "author": "erAbsolute", "permissions": ["activeTab", "storage", "clipboardWrite"], "action": {"default_title": "Clean Copy - Copy URL with/without parameters", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.svg", "32": "icons/icon-32.svg", "48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}}, "commands": {"copy-with-params": {"suggested_key": {"default": "Ctrl+Alt+C"}, "description": "Copy URL with parameters"}, "copy-without-params": {"suggested_key": {"default": "Ctrl+Alt+X"}, "description": "Copy URL without parameters"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "clean-copy@erabsolute", "data_collection_permissions": {"required": ["none"]}}}}