{"manifest_version": 3, "name": "HireProgress Gmail Job Tracker", "version": "0.1.0", "description": "Send the currently viewed Gmail message to HireProgress for tracking via Mailgun webhook.", "privacy_policy": "https://hireprogress.com/privacy", "permissions": ["storage", "tabs"], "host_permissions": ["https://api.hireprogress.com/*", "https://mail.google.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "HireProgress Tracker", "default_icon": {"96": "icons/favicon.png"}, "default_popup": "popup.html"}, "icons": {"96": "icons/favicon.png"}, "web_accessible_resources": [{"resources": ["icons/favicon.png"], "matches": ["https://mail.google.com/*"]}], "browser_specific_settings": {"gecko": {"id": "hireprogress@hireprogress.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "personalCommunications"]}}, "gecko_android": {"strict_min_version": "142.0"}}}