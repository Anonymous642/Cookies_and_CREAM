{"manifest_version": 2, "name": "Idle Tab Sweeper", "version": "0.4.2", "description": "Automatically closes tabs 24 hours after they were last used. Pinned, folder (container), active, and audible tabs are excluded from auto-closing.", "permissions": ["tabs", "alarms", "storage"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "close-unspace-tabs@ease.local", "strict_min_version": "102.0"}}, "browser_action": {"default_title": "Sweep now", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "browser_style": true, "open_in_tab": false}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}