{"manifest_version": 3, "name": "list-buffers", "description": "Navigate tabs, history & bookmarks like a Vimmer (immitates `nnoremap <SPC><SPC> :ls<CR>:b `).", "version": "1.5.1", "icons": {"32": "icons/logo.svg", "64": "icons/logo.svg"}, "permissions": ["storage", "tabs", "activeTab", "search", "bookmarks", "history"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"]}, "id": "vimmers.buffer-list@zumir.firefox-ext.de"}}, "action": {"default_area": "navbar", "default_title": "Toggle buffer-list here as well", "default_icon": {"32": "icons/logo.svg", "64": "icons/logo.svg"}}, "commands": {"toggleBufferList": {"description": "Toggle the buffer list. More details in options page."}}, "options_ui": {"page": "options/page.html"}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/Overlay.js", "content/KeydownHandler.js", "content/extension.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["popup/buffer-list.html", "popup/buffer-list.css", "popup/buffer-list.js", "model/Controller.js", "model/KeyHandler.js.js", "model/SearchMode.js", "model/Renderer.js.js", "model/Store.js.js", "model/data/TabStore.js.js", "model/data/SearchStore.js.js", "model/data/HelpStore.js.js", "model/data/BookmarkStore.js.js", "model/data/HistoryStore.js.js", "model/items/Item.js", "model/items/TabItem.js", "model/items/SearchItem.js", "model/items/HelpItem.js", "icons/logo.svg"], "matches": ["<all_urls>"]}]}