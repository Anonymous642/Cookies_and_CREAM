{"manifest_version": 3, "name": "DreamGirther", "version": "1.1.3", "description": "Batch userpic uploader for Dreamwidth Manage Icons with keyword patterns, common comment/description, and preflight checks.", "browser_specific_settings": {"gecko": {"id": "dreamgirther@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage"], "host_permissions": ["*://*.dreamwidth.org/manage/icons*"], "content_scripts": [{"matches": ["*://*.dreamwidth.org/manage/icons*"], "js": ["content.js"], "run_at": "document_idle"}]}