{"manifest_version": 2, "name": "Ruler Pro", "version": "1.0.2", "description": "Screen-fixed overlay ruler and pixel grid. Stays put across tabs, like a ruler on the glass.", "browser_specific_settings": {"gecko": {"id": "@ruler-pro", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "<all_urls>"], "background": {"scripts": ["shared.js", "background.js"]}, "browser_action": {"default_title": "Ruler Pro", "default_popup": "popup.html", "default_icon": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["shared.js", "content.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"toggle-ruler": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Toggle ruler overlay"}, "toggle-grid": {"suggested_key": {"default": "Alt+Shift+G"}, "description": "Toggle pixel grid"}, "toggle-overlays": {"suggested_key": {"default": "Alt+Shift+H"}, "description": "Hide or show all overlays"}}, "icons": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg"}}