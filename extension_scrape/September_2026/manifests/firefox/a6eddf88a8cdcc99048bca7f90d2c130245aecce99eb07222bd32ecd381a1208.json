{"manifest_version": 3, "name": "Football Tournament Planner", "version": "1.0.0", "description": "Create and manage football tournaments completely offline. Add teams, generate fixtures, enter results, and track standings - all stored locally in your browser.", "author": "Football Tournament Planner", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Football Tournament Planner", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "permissions": ["storage"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "browser_specific_settings": {"gecko": {"id": "football-tournament-planner@example-offline-extension.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}