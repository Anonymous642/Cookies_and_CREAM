{"manifest_version": 2, "name": "Strims Image Paste", "version": "0.1.1", "description": "Upload pasted clipboard images to st.pepog.com and insert the returned URL into Strims chat.", "background": {"scripts": ["background.js"]}, "permissions": ["https://st.pepog.com/*"], "content_scripts": [{"matches": ["https://chat.strims.gg/*", "https://strims.gg/*", "https://www.strims.gg/*", "http://localhost/*", "https://localhost/*", "http://127.0.0.1/*", "https://127.0.0.1/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "pepog-image-paste-firefox@chat-gui.local"}}}