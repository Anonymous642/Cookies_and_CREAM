{"manifest_version": 3, "name": "Unified Chat: Slack, Teams & Zoom", "version": "1.0.0", "description": "Chat with Slack, Microsoft Teams, and Zoom Team Chat from one sidebar, with local history and emoji picker.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage", "identity", "alarms", "notifications"], "host_permissions": ["https://slack.com/*", "https://*.slack.com/*", "https://graph.microsoft.com/*", "https://login.microsoftonline.com/*", "https://api.zoom.us/*", "https://zoom.us/*"], "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidebar/sidebar.html", "default_icon": "icons/icon-48.png", "default_title": "Unified Chat"}, "action": {"default_icon": "icons/icon-48.png", "default_title": "Open Unified Chat sidebar"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "unified-chat@example-extension.local", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}