{"manifest_version": 3, "name": "Qadtal Domain List", "version": "0.1.0", "description": "Append the current site domain to a GitHub-hosted list (scaffold).", "browser_specific_settings": {"gecko": {"id": "domainlist@qadtal.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage", "tabs", "identity"], "host_permissions": ["https://github.com/*", "https://api.github.com/*"], "background": {"scripts": ["background/service-worker.js"]}, "action": {"default_title": "Qadtal Domain List", "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html", "open_in_tab": false}}