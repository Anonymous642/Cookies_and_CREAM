{"manifest_version": 2, "name": "YouTube Focus Mode", "version": "2.0.0", "description": "Hide distracting YouTube elements. Switch between Arabic & English UI. Stay focused. | \u0623\u062e\u0641\u0650 \u0639\u0646\u0627\u0635\u0631 \u064a\u0648\u062a\u064a\u0648\u0628 \u0627\u0644\u0645\u0634\u062a\u062a\u0629 \u0648\u0627\u0628\u0642\u064e \u0645\u0631\u0643\u0632\u0627\u064b.", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "permissions": ["activeTab", "storage", "tabs"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["hider.css"], "run_at": "document_start"}], "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon48.png"}, "default_title": "YouTube Focus Mode"}, "background": {"scripts": ["background.js"], "persistent": false}, "browser_specific_settings": {"gecko": {"id": "youtube-focus-mode@extension", "strict_min_version": "143.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}