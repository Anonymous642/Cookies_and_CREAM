{"manifest_version": 2, "name": "Palette", "version": "1.0.0", "description": "Extract dominant colors from the current page", "permissions": ["activeTab", "storage", "clipboardWrite"], "browser_action": {"default_popup": "palette/palette-popup.html", "default_title": "Palette"}, "background": {"scripts": ["swatch/palette-extract.js"]}, "icons": {"48": "icons/swatch-48.png", "96": "icons/swatch-96.png"}, "browser_specific_settings": {"gecko": {"id": "palette@example.addons", "data_collection_permissions": {"required": ["none"], "description": "This addon collects no user data."}}}}