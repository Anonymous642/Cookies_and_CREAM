{"manifest_version": 2, "name": "Browser Time Tracker", "version": "1.0.0", "description": "Track website usage time with professional visualization and productivity categorization", "permissions": ["tabs", "storage", "activeTab"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_popup": "popup.html", "default_title": "Browser Time Tracker", "default_icon": {"16": "icons/icon-16.svg", "32": "icons/icon-32.svg", "48": "icons/icon-48.svg", "128": "icons/icon-128.svg"}}, "icons": {"16": "icons/icon-16.svg", "32": "icons/icon-32.svg", "48": "icons/icon-48.svg", "128": "icons/icon-128.svg"}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "content_security_policy": "script-src 'self'; object-src 'self'", "browser_specific_settings": {"gecko": {"id": "browser-time-tracker@extension.local", "strict_min_version": "80.0"}}}