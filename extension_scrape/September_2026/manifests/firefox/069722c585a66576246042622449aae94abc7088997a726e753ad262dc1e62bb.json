{"manifest_version": 2, "name": "JSON Viewer Pro By PatilWeb", "version": "7.1", "description": "A powerful JSON viewer and formatter for Firefox built with TypeScript", "icons": {"32": "icons/32.png", "128": "icons/128.png"}, "permissions": ["activeTab", "storage", "contextMenus", "notifications", "http://*/*", "https://*/*", "file://*/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["json-viewer.css"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_title": "JSON Viewer Pro \u00a9 PatilWeb", "default_icon": {"32": "icons/32.png", "128": "icons/128.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "web_accessible_resources": ["json-viewer.css", "json-viewer.html", "*.js"], "commands": {"open-json-viewer": {"suggested_key": {"default": "Ctrl+Shift+J", "mac": "Command+Shift+J"}, "description": "Open JSON Viewer Pro"}, "format-selection": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Format selected JSON text"}, "validate-selection": {"suggested_key": {"default": "Ctrl+Shift+V", "mac": "Command+Shift+V"}, "description": "Validate selected JSON text"}, "detect-json-page": {"suggested_key": {"default": "Ctrl+Shift+D", "mac": "Command+Shift+D"}, "description": "Auto-detect and format JSON on page"}}, "browser_specific_settings": {"gecko": {"id": "json-viewer-pro@patilweb.dev"}}}