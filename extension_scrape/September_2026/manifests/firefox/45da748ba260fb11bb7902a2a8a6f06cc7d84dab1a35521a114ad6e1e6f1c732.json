{"manifest_version": 3, "name": "Insta Clutter Remover", "version": "1.0", "description": "Hides <article> elements that contain a div[role='button'] with the exact text 'Follow'.", "permissions": ["scripting", "activeTab"], "host_permissions": ["https://www.instagram.com/*"], "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@clutterremover", "data_collection_permissions": {"required": ["none"]}}}}