{"manifest_version": 2, "name": "Attention Auditor", "version": "1.0.0", "description": "Measures where your browsing time really goes, asks 'was that worth it?' after long sessions, and gives you a brutally honest weekly report. 100% local & private.", "author": "Attention Auditor", "permissions": ["tabs", "idle", "storage"], "background": {"scripts": ["lib/aa.js", "background.js"], "persistent": true}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["lib/aa.js", "content/toast.js"], "run_at": "document_idle"}], "browser_action": {"default_icon": {"48": "icons/icon.png"}, "default_title": "Attention Auditor", "default_popup": "popup.html"}, "options_ui": {"page": "dashboard.html", "open_in_tab": true}, "icons": {"48": "icons/icon.png", "96": "icons/icon.png", "128": "icons/icon.png"}, "browser_specific_settings": {"gecko": {"id": "attention-auditor@arena.local", "strict_min_version": "89.0", "data_collection_permissions": {"required": ["none"]}}}}