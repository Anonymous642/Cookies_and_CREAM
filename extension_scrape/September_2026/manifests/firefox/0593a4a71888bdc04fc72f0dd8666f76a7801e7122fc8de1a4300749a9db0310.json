{"manifest_version": 3, "name": "De-AI Search", "version": "1.0.2", "description": "Strips away smart assistants and automated overview modules to restore a clean, traditional search layout.", "permissions": ["storage", "tabs"], "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "content_scripts": [{"matches": ["*://*.google.com/search*", "*://*.google.co.uk/search*", "*://*.google.ca/search*", "*://*.google.co.in/search*", "*://*.duckduckgo.com/*"], "js": ["content.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "browser_specific_settings": {"gecko": {"id": "de-ai-search@yourdomain.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}