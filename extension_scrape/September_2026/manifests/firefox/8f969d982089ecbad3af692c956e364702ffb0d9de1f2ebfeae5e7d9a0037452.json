{"version": "2.0.1", "name": "Enoact", "description": "Show what you're doing to others from your browser!", "icons": {"16": "images/icon.png", "32": "images/icon.png", "48": "images/icon.png", "64": "images/icon.png", "128": "images/icon.png"}, "background": {"scripts": ["background/scripts.js"]}, "author": "Lebenoa", "manifest_version": 2, "browser_action": {"default_icon": {"16": "images/icon.png", "32": "images/icon.png", "48": "images/icon.png", "64": "images/icon.png", "128": "images/icon.png"}, "default_title": "Open Side Panel"}, "sidebar_action": {"default_icon": {"16": "images/icon.png", "32": "images/icon.png", "48": "images/icon.png", "64": "images/icon.png", "128": "images/icon.png"}, "default_panel": "sidebar/index.html", "default_title": "Enoact Settings"}, "permissions": ["scripting", "storage", "webNavigation", "*://www.youtube.com/*", "*://music.youtube.com/*", "*://www.twitch.tv/*"], "browser_specific_settings": {"gecko": {"id": "@enoact-browser-extension", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}