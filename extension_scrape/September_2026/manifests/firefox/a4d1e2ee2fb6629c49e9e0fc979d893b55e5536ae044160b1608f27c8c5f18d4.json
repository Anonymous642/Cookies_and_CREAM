{"manifest_version": 2, "name": "GeoWhat?", "version": "1.0.2", "description": "Send the Street View panorama you're looking at to an AI chat and learn what identifies the location.", "permissions": ["storage", "clipboardWrite", "tabs", "webRequest", "webRequestBlocking", "<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.google.com/maps", "*://www.google.com/maps/*", "*://www.google.co.uk/maps", "*://www.google.co.uk/maps/*", "*://maps.google.com/*", "*://maps.google.co.uk/*"], "js": ["content-maps.js"], "css": ["maps.css"], "run_at": "document_idle"}], "browser_action": {"default_title": "GeoWhat settings", "default_popup": "settings.html", "default_icon": "icon.png"}, "icons": {"96": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "geowhat@siriusmart", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}