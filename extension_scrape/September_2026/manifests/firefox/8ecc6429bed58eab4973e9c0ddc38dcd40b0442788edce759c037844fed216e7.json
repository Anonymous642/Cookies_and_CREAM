{"manifest_version": 2, "name": "Travel Language Helper", "version": "1.3", "description": "Save and organize useful travel phrases and translations locally in your browser.", "permissions": ["storage", "activeTab"], "browser_action": {"default_title": "Travel Language Helper", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Travel-Language-Helper", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}