{"manifest_version": 3, "name": "Zikra", "version": "1.0.0", "description": "Zikra \u2014 save pages and find them later with on-device search. Optional Ask uses your own API key. No account; data stays local.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup/index.html", "default_title": "Zikra", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "background": {"scripts": ["src/background/index.js"], "type": "module"}, "permissions": ["storage", "tabs", "alarms", "contextMenus", "bookmarks", "scripting", "unlimitedStorage"], "host_permissions": ["http://*/*", "https://*/*"], "commands": {"save-page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Save current page to Zikra"}}, "browser_specific_settings": {"gecko": {"id": "zikra@frappewizard.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' http: https:"}}