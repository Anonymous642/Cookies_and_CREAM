{"manifest_version": 2, "name": "Vocab Tracker", "version": "1.3.0", "description": "Track vocabulary frequency while reading. Supports English (via Merriam-Webster) and Japanese (via Jisho), with Anki export.", "browser_specific_settings": {"gecko": {"id": "vocab-tracker@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["contextMenus", "storage", "activeTab", "scripting", "*://www.dictionaryapi.com/*", "*://jisho.org/*", "http://127.0.0.1:8765/*", "http://localhost:8765/*"], "background": {"scripts": ["background/service_worker.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["core/event-bus.js", "core/store.js", "core/module-registry.js", "modules/english/english-module.js", "modules/japanese/japanese-module.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": []}