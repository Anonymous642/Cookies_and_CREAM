{"manifest_version": 2, "name": "Ouvrage", "description": "Ajoutez des produits au catalogue Ouvrage depuis un site fournisseur.", "version": "0.1.1", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage", "activeTab", "scripting", "tabs", "*://*/*"], "minimum_chrome_version": "109", "browser_specific_settings": {"gecko": {"id": "ouvrage@ouvrage.art", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Ouvrage", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["http://app.ouvrage.test/*", "https://app.ouvrage.art/*", "https://app.ouvrage.test/*"], "run_at": "document_start", "js": ["content-scripts/ouvrage-app-bridge.js"]}]}