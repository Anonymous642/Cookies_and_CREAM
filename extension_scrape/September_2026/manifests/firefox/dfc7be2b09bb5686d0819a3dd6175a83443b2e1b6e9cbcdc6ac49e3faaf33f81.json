{"manifest_version": 3, "name": "YouTube Extra Search", "version": "1.4", "description": "Deep grid search for YouTube results.", "browser_specific_settings": {"gecko": {"id": "extra-search-results@yourdomain.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "default_title": "YouTube Extra Search"}, "background": {"scripts": ["background.js"]}, "permissions": ["tabs"], "host_permissions": ["*://www.youtube.com/*", "*://youtube.com/*"], "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["results.html"], "matches": ["*://www.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*"]}]}