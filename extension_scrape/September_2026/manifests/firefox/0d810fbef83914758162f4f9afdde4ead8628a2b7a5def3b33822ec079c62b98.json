{"manifest_version": 3, "name": "FXTwitter Link Copier", "version": "1.0", "description": "Automatically replaces x.com with fxtwitter.com when copying links.", "browser_specific_settings": {"gecko": {"id": "fxtwitter-copier@your-own-extension.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["clipboardWrite"], "content_scripts": [{"matches": ["*://*.x.com/*", "*://*.twitter.com/*"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["*://*.x.com/*", "*://*.twitter.com/*"]}]}