{"manifest_version": 3, "name": "Focus Shield", "version": "1.0.1", "browser_specific_settings": {"gecko": {"id": "focus-Shield@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "description": "Block distracting websites with a shared daily focus-time limit and a one-time emergency extension.", "permissions": ["declarativeNetRequest", "storage", "tabs", "alarms"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["data/sites.js", "background.js"], "service_worker": "background.js"}, "action": {"default_title": "Focus Shield", "default_popup": "popup/popup.html", "default_icon": "icon.png"}, "icons": {"128": "icon.png"}, "web_accessible_resources": [{"resources": ["blocked/blocked.html", "blocked/blocked.css", "blocked/blocked.js"], "matches": ["<all_urls>"]}]}