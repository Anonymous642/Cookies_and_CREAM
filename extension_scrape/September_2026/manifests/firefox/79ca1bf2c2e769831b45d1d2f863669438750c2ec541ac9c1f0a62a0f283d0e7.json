{"manifest_version": 3, "name": "Resume AI Agent: ATS & Cover Letter", "short_name": "Resume AI Agent", "version": "1.0.0", "description": "Auto-grab job descriptions from LinkedIn, Naukri & Indeed. Optimize your resume for ATS, generate cover letters, and get ATS scores \u2014 powered by Google Gemini AI. Free forever.", "author": "Braj Bhushan Kumar", "homepage_url": "https://www.linkedin.com/in/braj-bhushan-kumar-30a022267", "browser_specific_settings": {"gecko": {"id": "resume-ai-agent@brajbhushankumar", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["https://generativelanguage.googleapis.com/*", "https://www.linkedin.com/*", "https://www.naukri.com/*", "https://wellfound.com/*", "https://*.indeed.com/*"], "action": {"default_popup": "popup.html", "default_title": "Resume AI Agent", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*", "https://www.linkedin.com/job/*", "https://www.naukri.com/*", "https://wellfound.com/jobs/*", "https://*.indeed.com/viewjob*", "https://*.indeed.com/rc/clk*"], "js": ["content.js"], "run_at": "document_idle"}]}