{"manifest_version": 3, "name": "Vellio", "version": "1.2.1", "description": "Your AI workspace \u2014 prompts and multi-model chat in the browser sidebar.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Open Vellio", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "host_permissions": ["https://vellio.ai/*"], "permissions": ["storage"], "background": {"scripts": ["background.js"], "type": "module"}, "sidebar_action": {"default_panel": "index.html", "default_title": "Vellio", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "vellio@vellio.ai", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}}}