{"manifest_version": 3, "name": "Mivure Timer", "version": "0.2.4", "description": "\u0422\u0430\u0439\u043c\u0435\u0440 \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u043e \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u043c Mivure", "browser_specific_settings": {"gecko": {"id": "mivure-timer@mivure.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_popup": "popup.html", "default_title": "Mivure Timer", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "permissions": ["alarms", "storage"], "host_permissions": ["http://localhost:3000/*", "https://mivure.com/*", "https://*.mivure.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}