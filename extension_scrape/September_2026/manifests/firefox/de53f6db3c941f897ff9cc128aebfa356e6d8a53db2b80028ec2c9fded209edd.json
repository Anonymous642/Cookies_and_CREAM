{"manifest_version": 2, "name": "Currency Auto-Converter", "version": "1.3", "description": "Auto-convert prices on web pages and provide a quick currency converter popup.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["activeTab", "storage", "tabs", "https://api.exchangerate.host/*"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Currency Auto-Converter", "default_icon": "icons/logo_32.png", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"]}], "browser_specific_settings": {"gecko": {"id": "@Currency-Auto-Converter", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}