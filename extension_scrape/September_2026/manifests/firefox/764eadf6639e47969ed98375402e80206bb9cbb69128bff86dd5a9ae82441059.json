{"manifest_version": 3, "name": "Resume Shelf for YouTube\u2122", "version": "0.1.0", "description": "Resume and continue watching YouTube videos from your exact saved position, with a private local shelf.", "icons": {"16": "assets/icon16.png", "32": "assets/icon32.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "permissions": ["storage", "activeTab", "scripting"], "action": {"default_title": "Open Resume Shelf", "default_popup": "popup.html", "default_icon": {"16": "assets/icon16.png", "32": "assets/icon32.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "resume-shelf-youtube@firefox.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"], "js": ["watch-progress.js"]}]}