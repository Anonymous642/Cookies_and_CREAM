{"manifest_version": 2, "name": "healthy-drive", "description": "\u00c9value les additifs des produits pendant vos courses en ligne (donn\u00e9es OpenFoodFacts).", "version": "1.0.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "https://*.cloudfront.net/*"], "browser_specific_settings": {"gecko": {"id": "healthy-drive@axopen.com", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "healthy-drive", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.auchan.fr/*", "*://*.carrefour.fr/*", "*://*.intermarche.com/*", "*://*.leclercdrive.fr/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}