{"manifest_version": 3, "name": "Sensible Slack", "description": "Enhances the Slack web client with manual thread read control and quick message actions.", "version": "0.4.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "webRequest", "webRequestBlocking"], "host_permissions": ["*://*.slack.com/*", "*://api.github.com/*"], "browser_specific_settings": {"gecko": {"id": "sensible-slack@mturley"}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Sensible Slack", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.slack.com/*"], "run_at": "document_start", "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}, {"matches": ["*://*.slack.com/*"], "run_at": "document_idle", "js": ["content-scripts/slack-nav.js"], "world": "MAIN"}, {"matches": ["*://*.slack.com/*"], "run_at": "document_start", "js": ["content-scripts/thread-mark-guard.js"], "world": "MAIN"}]}