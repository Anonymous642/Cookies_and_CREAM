{"manifest_version": 3, "name": "LinkedOut", "version": "1.1.3", "description": "Hide LinkedIn feed posts containing keywords you dont want to see. Block the buzzwords, clean your feed.", "author": "Indigo Development", "homepage_url": "https://github.com/NickTheWilder/linked-out", "permissions": ["storage"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "action": {"default_popup": "popup.html", "default_title": "LinkedOut", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["https://www.linkedin.com/*"], "js": ["browser-polyfill.min.js", "content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "nickwilder@duck.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["browser-polyfill.min.js", "background.js"]}}