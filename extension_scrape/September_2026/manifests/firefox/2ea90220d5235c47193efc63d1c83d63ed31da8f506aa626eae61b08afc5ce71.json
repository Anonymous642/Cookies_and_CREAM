{"manifest_version": 3, "name": "QuickTranslator - Chinese to Vietnamese", "version": "1.0.1", "description": "Translate Chinese to Vietnamese instantly on any webpage", "permissions": ["storage", "activeTab"], "browser_specific_settings": {"gecko": {"id": "quicktranslator@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["service-worker.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"], "css": ["assets/content.css"]}], "action": {"default_popup": "popup/popup.html", "default_title": "QuickTranslator"}, "web_accessible_resources": [{"resources": ["dictionaries/*"], "matches": ["<all_urls>"]}]}