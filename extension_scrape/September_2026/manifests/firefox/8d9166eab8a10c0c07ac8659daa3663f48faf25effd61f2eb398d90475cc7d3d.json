{"manifest_version": 3, "name": "Odoo.sh User Collector", "version": "1.0", "description": "Collects users/collaborators across your Odoo.sh projects as you browse them, so you can copy & paste them elsewhere without hunting through every project.", "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://*.odoo.sh/*"], "action": {"default_popup": "popup.html", "default_title": "Odoo.sh User Collector", "default_icon": {"48": "icon48.png", "96": "icon96.png"}}, "icons": {"48": "icon48.png", "96": "icon96.png"}, "content_scripts": [{"matches": ["https://*.odoo.sh/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "odoosh-user-collector@local.extension", "data_collection_permissions": {"required": ["none"]}}}}