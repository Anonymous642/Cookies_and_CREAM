{"manifest_version": 3, "name": "JoeMonster Visited Videos Marker", "version": "1.0.0", "browser_specific_settings": {"gecko": {"id": "joemonster-visited-videos-marker@local", "data_collection_permissions": {"required": ["none"]}}}, "description": "Marks watched videos on joemonster.org and stores them locally by ID.", "permissions": ["storage"], "host_permissions": ["*://joemonster.org/*", "*://www.joemonster.org/*"], "content_scripts": [{"matches": ["*://joemonster.org/filmy*", "*://www.joemonster.org/filmy*"], "js": ["content-script.js"], "css": ["content-style.css"], "run_at": "document_idle"}]}