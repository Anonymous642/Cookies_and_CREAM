{"manifest_version": 2, "name": "YouTube Color Icon", "version": "1.5.2", "description": "Adds color presets for the YouTube tab icon on youtube.com.", "icons": {"16": "extension-icon.png", "48": "extension-icon.png", "96": "extension-icon.png"}, "web_accessible_resources": ["old-red-icon16-fixed.png", "old-red-mask16.png", "old-red-overlay16.png"], "permissions": ["storage", "webRequest", "webRequestBlocking", "*://*.youtube.com/*", "*://*.ytimg.com/*", "*://*.ggpht.com/*"], "browser_action": {"default_title": "YouTube Color Icon", "default_icon": "extension-icon.png", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "youtube-old-red-logo@local"}}}