{"manifest_version": 2, "name": "DayTruth", "version": "1.0.0", "description": "Track browser time and sync to DayTruth \u2014 know exactly how you spend your day.", "homepage_url": "https://daytruth.app", "author": "DayTruth", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "DayTruth"}, "background": {"scripts": ["background.js"], "persistent": true}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["tabs", "idle", "alarms", "storage", "<all_urls>", "https://devapi.daytruth.app/*", "https://dev.daytruth.app/*", "https://daytruth.app/*", "https://app.daytruth.app/*", "https://www.google.com/s2/favicons*"], "browser_specific_settings": {"gecko": {"id": "tracker@daytruth.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity"], "optional": ["websiteActivity"]}}}, "content_security_policy": "script-src 'self'; object-src 'self'"}