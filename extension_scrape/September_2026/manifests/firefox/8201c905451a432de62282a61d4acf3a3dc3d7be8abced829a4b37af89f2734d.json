{"manifest_version": 3, "name": "YouTube Video Skip", "version": "1.1.0", "description": "Continuously skips ahead by a set number of seconds on YouTube.", "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"], "action": {"default_popup": "html/popup.html", "default_title": "YouTube Video Skip", "default_icon": {"32": "icons/icon32.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"], "js": ["js/content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "youtube-video-skip@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"32": "icons/icon32.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}}