{"manifest_version": 2, "name": "Random Theme Switcher", "version": "1.2", "description": "Randomly switch among your installed themes every hour or on new window open.", "permissions": ["alarms", "management", "storage"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "icons": {"48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "random-theme-switcher@example.com", "data_collection_permissions": {"required": ["none"]}}}}