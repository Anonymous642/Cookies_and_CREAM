{"manifest_version": 2, "name": "Universal QR Code Toolkit", "version": "2.0.0", "description": "Scan and generate QR codes 100% locally. Support for screen area selection, local drag & drop, right-click images, and real-time generation.", "permissions": ["activeTab", "contextMenus", "storage", "notifications", "<all_urls>"], "background": {"scripts": ["lib/jsQR.js", "background.js"], "persistent": false}, "browser_action": {"default_popup": "popup/popup.html", "default_title": "Universal QR Code Toolkit", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": ["lib/jsQR.js", "content.js"], "browser_specific_settings": {"gecko": {"id": "qr-reader@nathan-qr-reader"}}}