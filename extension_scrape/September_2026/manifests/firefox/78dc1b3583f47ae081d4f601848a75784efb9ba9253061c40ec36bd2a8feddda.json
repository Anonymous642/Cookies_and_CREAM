{"manifest_version": 3, "name": "MakerBuddy IoT Controller", "version": "2.6.0", "description": "Monitor and control your MakerBuddy ESP32 IoT Kit from Firefox", "action": {"default_icon": {"16": "images/addon16.png", "48": "images/addon48.png", "128": "images/addon128.png"}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "images/addon16.png", "48": "images/addon48.png", "128": "images/addon128.png"}, "permissions": ["storage"], "host_permissions": ["http://app.makerbuddy.cc/*"], "optional_host_permissions": ["http://*/*", "ws://*/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://app.makerbuddy.cc ws://*"}, "browser_specific_settings": {"gecko": {"id": "makerbuddy@makerbuddy.cc", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}