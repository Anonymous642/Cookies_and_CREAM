{"name": "PlexiEnhancer", "version": "2.4", "description": "Clean up Perplexity answers (hide citations, smart copy answers) keep the model you pick per tab, and optionally enforce thinking.", "permissions": ["activeTab", "clipboardRead", "clipboardWrite", "storage"], "content_scripts": [{"matches": ["*://www.perplexity.ai/*", "*://perplexity.ai/*"], "js": ["content.js"]}], "manifest_version": 2, "browser_specific_settings": {"gecko": {"id": "plexicopy@local", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"32": "icons/icon.svg", "64": "icons/icon.svg", "128": "icons/icon.svg"}, "browser_action": {"default_title": "PlexiEnhancer Settings", "default_popup": "popup.html"}, "web_accessible_resources": ["icons/*"]}