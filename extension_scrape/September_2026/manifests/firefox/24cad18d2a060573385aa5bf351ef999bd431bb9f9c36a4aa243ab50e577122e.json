{"manifest_version": 3, "name": "Dark Mode Everywhere", "version": "1.0", "description": "Forces dark mode on all websites with a global on/off button.", "permissions": ["storage", "tabs"], "action": {"default_popup": "popup.html", "default_title": "Dark Mode Toggle", "default_icon": {"48": "icons/icon-48.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end", "all_frames": true}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "darkmode@redcode.se", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}