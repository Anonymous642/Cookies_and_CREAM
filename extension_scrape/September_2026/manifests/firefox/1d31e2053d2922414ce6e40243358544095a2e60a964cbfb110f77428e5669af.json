{"manifest_version": 3, "name": "CookUnity Helper", "version": "1.0.0", "description": "Permanently hide meals you never want to see, and save/restore filter presets on CookUnity.", "browser_specific_settings": {"gecko": {"id": "cook-unity-helper@local.addon", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "content_scripts": [{"matches": ["*://*.cookunity.com/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle", "all_frames": false}]}