{"manifest_version": 3, "name": "Slowed + Reverb & Pitch", "version": "1.0.1", "description": "Slow down, speed up, and pitch-shift audio on any site, plus reverb, bass, and a lo-fi muffle. Click the toolbar icon to open the panel.", "permissions": ["activeTab", "scripting", "storage"], "action": {"default_title": "Slowed + Reverb \u2014 click to open", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "slowed-reverb-studio@extensions", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}