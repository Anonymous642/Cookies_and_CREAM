{"manifest_version": 2, "name": "Taobao Product Clusterer", "version": "3.2.0", "description": "Groups Taobao / Tmall search results by shared keywords using CSS reordering only.", "icons": {"48": "icons/icon48.svg", "96": "icons/icon96.svg"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.svg", "96": "icons/icon96.svg"}}, "content_scripts": [{"matches": ["*://*.taobao.com/*", "*://*.tmall.com/*", "*://*.tmall.hk/*"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["storage", "activeTab", "https://translate.googleapis.com/*"], "browser_specific_settings": {"gecko": {"id": "taobao-clusterer@custom", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}