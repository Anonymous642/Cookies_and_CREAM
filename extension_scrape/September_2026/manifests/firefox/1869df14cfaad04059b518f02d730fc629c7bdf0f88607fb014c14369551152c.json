{"manifest_version": 3, "name": "PromptVault", "description": "Your prompts, one click away \u2014 search your library in a side panel and insert them into ChatGPT, Claude, Gemini and more.", "version": "1.0.2", "short_name": "PromptVault", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "contextMenus", "activeTab", "scripting"], "host_permissions": ["*://chatgpt.com/*", "*://chat.openai.com/*", "*://claude.ai/*", "*://gemini.google.com/*", "*://copilot.microsoft.com/*", "*://m365.cloud.microsoft/*", "*://github.com/copilot/*", "*://www.perplexity.ai/*", "*://perplexity.ai/*", "*://grok.com/*", "*://chat.deepseek.com/*", "*://chat.mistral.ai/*", "*://kimi.com/*", "*://www.kimi.com/*", "*://poe.com/*", "*://app.apollo.io/*", "https://api.promptvault.us/*", "https://promptvault.us/*"], "optional_host_permissions": ["*://*/*"], "commands": {"open-panel": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Open the PromptVault panel"}, "save-selection": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save the selected text as a prompt"}}, "browser_specific_settings": {"gecko": {"id": "extension@promptvault.app", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "websiteContent"]}}}, "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "PromptVault"}, "content_scripts": [{"matches": ["https://promptvault.us/*", "https://stage.promptvault.us/*"], "run_at": "document_idle", "js": ["content-scripts/bridge.js"]}, {"matches": ["*://chat.deepseek.com/*", "*://chat.mistral.ai/*", "*://chat.openai.com/*", "*://chatgpt.com/*", "*://claude.ai/*", "*://copilot.microsoft.com/*", "*://gemini.google.com/*", "*://github.com/copilot/*", "*://grok.com/*", "*://kimi.com/*", "*://m365.cloud.microsoft/*", "*://perplexity.ai/*", "*://poe.com/*", "*://