{"manifest_version": 3, "name": "TabTone \u2014 Tab Volume Control", "version": "1.4.1", "description": "Control the current tab's media volume and personalize the popup.", "permissions": ["activeTab", "tabs", "storage", "scripting"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "TabTone", "default_popup": "popup.html", "default_icon": {"32": "icons/icon.svg"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}], "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "tabtone@local.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}