{"manifest_version": 3, "name": "APOD New Tab", "description": "NASA's Astronomy Picture of the Day as your new tab background.", "version": "1.0.0", "browser_specific_settings": {"gecko": {"id": "apod-newtab@olehhaugholt.github.io", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "permissions": ["topSites", "storage", "search", "unlimitedStorage"], "host_permissions": ["https://api.nasa.gov/*", "https://apod.nasa.gov/*"]}