{"manifest_version": 2, "name": "ED Histogrammes", "version": "2.0.0", "description": "Affiche des histogrammes locaux des notes sur EcoleDirecte.", "author": "environ314", "browser_specific_settings": {"gecko": {"id": "ehhistoff.of0qx@passmail.net", "strict_min_version": "79.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "https://www.ecoledirecte.com/*"], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": "icons/icon-128.png"}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://www.ecoledirecte.com/*"], "js": ["content-core.js", "content-bridge.js"], "run_at": "document_idle", "all_frames": true}], "background": {"scripts": ["bg.js"]}, "commands": {"toggle-ed": {"suggested_key": {"default": "Ctrl+Shift+H"}, "description": "Afficher/masquer les histogrammes"}, "show-multi-histogram": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Afficher l'analyse multi-mati\u00e8re"}}}