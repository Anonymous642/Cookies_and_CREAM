{"manifest_version": 3, "name": "Reddit Contextualizer", "version": "1.0.0", "description": "Adds instant context to your Reddit experience by showing historical behavior for any user.", "permissions": [], "host_permissions": ["https://redditcontextualizer-api.sigpwned.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.reddit.com/*", "https://old.reddit.com/*"], "js": ["purify.min.js", "content.js"], "css": ["style.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://www.reddit.com/*", "https://old.reddit.com/*"]}], "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png", "256": "icons/256.png"}, "browser_specific_settings": {"gecko": {"id": "@reddit-contextualizer", "data_collection_permissions": {"required": ["none"]}}}}