{"manifest_version": 3, "name": "Twitter Dislikes", "version": "1.1", "browser_specific_settings": {"gecko": {"id": "@twitter_dislikes", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "description": "Adds a dislike button to twitter", "icons": {"48": "public/icon.png"}, "permissions": ["webRequest", "nativeMessaging", "activeTab"], "host_permissions": ["*://*.x.com/*", "*://*.twitter.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["*://*.x.com/*", "*://*.twitter.com/*"], "js": ["content_script.js"]}]}