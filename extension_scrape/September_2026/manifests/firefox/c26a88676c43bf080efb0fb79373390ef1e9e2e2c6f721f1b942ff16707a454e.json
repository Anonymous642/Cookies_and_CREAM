{"manifest_version": 3, "name": "ExtRenew", "version": "1.1.0", "description": "Every 30 days, review what your other extensions can access and confirm you still want to keep them. Runs entirely locally.", "permissions": ["management", "alarms", "storage", "notifications"], "background": {"service_worker": "background.js", "scripts": ["common.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "extrenew@extrenew.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}