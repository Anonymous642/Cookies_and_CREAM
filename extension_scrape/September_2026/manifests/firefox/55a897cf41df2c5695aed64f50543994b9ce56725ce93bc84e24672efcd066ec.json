{"manifest_version": 2, "name": "Mimiran Connector", "version": "0.3.45", "description": "Add contacts from LinkedIn or Gmail to Mimiran in one click.", "browser_action": {"default_title": "Mimiran Connector", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png"}}, "sidebar_action": {"default_panel": "src/simple-sidepanel.html", "default_title": "Mimiran Connector"}, "browser_specific_settings": {"gecko": {"id": "mimiran-connector@mimiran.com", "strict_min_version": "79.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/MimiranIcon128.png"}, "permissions": ["storage", "activeTab", "tabs", "https://*.linkedin.com/*", "https://mail.google.com/*", "https://calendar.google.com/*", "https://app.mimiran.com/*", "https://*.licdn.com/*", "https://gravatar.com/*"], "optional_permissions": ["https://*/*", "http://*/*"], "background": {"scripts": ["src/background-firefox.js"], "persistent": false}, "content_scripts": [{"matches": ["https://*.linkedin.com/*"], "js": ["src/content.js"], "run_at": "document_idle", "all_frames": true}, {"matches": ["https://mail.google.com/*"], "js": ["src/gmail-content.js"], "run_at": "document_idle"}, {"matches": ["https://calendar.google.com/*"], "js": ["src/gcal-content.js"], "run_at": "document_idle"}], "web_accessible_resources": ["assets/*"]}