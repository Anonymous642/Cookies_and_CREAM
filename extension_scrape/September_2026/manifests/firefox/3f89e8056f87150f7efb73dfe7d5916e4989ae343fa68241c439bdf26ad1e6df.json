{"manifest_version": 3, "name": "Job Scraper", "version": "1.0.3", "description": "Detect and automatically saves job offers shown on the page that contains your keywords !", "action": {"default_title": "Job Scraper", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle", "all_frames": false}], "permissions": ["storage", "downloads", "notifications", "activeTab", "contextMenus", "alarms"], "host_permissions": ["<all_urls>", "https://nominatim.openstreetmap.org/"], "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+J", "mac": "Command+Shift+J"}, "description": "Ouvrir Job Scraper Pro"}, "scan_page": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Scanner la page actuelle"}}, "browser_specific_settings": {"gecko": {"id": "job-scraper-contact@gmail.com", "strict_min_version": "142.0", "data_collection_permissions": {"browsing_history": false, "formfill": false, "passwords": false, "preferences": false, "social_data": false, "health_data": false, "financial_data": false, "other": false, "required": ["none"]}}}}