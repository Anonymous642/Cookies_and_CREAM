{"manifest_version": 3, "name": "Pinterest Google Search Excluder", "version": "1.0", "description": "Automatically removes Pinterest results from Google Search results.", "author": "t0ast", "icons": {"32": "icons/no-pinterest32.png", "64": "icons/no-pinterest64.png"}, "browser_specific_settings": {"gecko": {"id": "pinterest-excluder@t0ast", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.google.com/search*"], "js": ["content.js"], "run_at": "document_idle"}]}