{"manifest_version": 3, "name": "PlayDeck", "version": "1.0.0", "description": "Control media playing in your browser tabs from the toolbar, without switching tabs.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "PlayDeck", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+M"}, "description": "Open the PlayDeck popup"}}, "permissions": ["storage", "tabs", "scripting", "alarms"], "optional_permissions": ["notifications"], "optional_host_permissions": ["*://*/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "playdeck@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "113.0"}}}