{"manifest_version": 3, "name": "Peekly: Preview, AI & Video", "version": "1.3.1", "description": "A new way to browse: read any link in place, step to the next one, and never lose your results to a pile of tabs.", "permissions": ["storage", "declarativeNetRequest", "tabs"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Peekly settings", "default_popup": "options.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["config.js", "parsers.js", "parse-html.js", "background.js"]}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["config.js", "content.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["<all_urls>"], "js": ["frame-relay.js"], "run_at": "document_idle", "all_frames": true, "match_origin_as_fallback": true}, {"matches": ["*://*.youtube.com/*"], "js": ["yt-player.js"], "run_at": "document_idle", "all_frames": true, "world": "MAIN"}], "web_accessible_resources": [{"resources": ["fonts/DMSans.woff2", "fonts/DMSansBlack.woff2", "fonts/JetBrainsMono.woff2", "fonts/Roboto.woff2"], "matches": ["<all_urls>"]}], "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Peekly settings", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "browser_specific_settings": {"gecko": {"id": "peekly@peekly.dev", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo"], "optional": ["websiteContent"]}}}}