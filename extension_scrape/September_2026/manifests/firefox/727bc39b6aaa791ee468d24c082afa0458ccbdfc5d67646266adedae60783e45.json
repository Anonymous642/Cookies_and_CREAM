{"manifest_version": 3, "name": "Spam Comment Remover", "version": "1.0.5", "description": "Automatically removes spam comments from web pages using configurable weight-based detection", "action": {"default_title": "Spam Filter Settings", "default_popup": "./popup.html"}, "background": {"service_worker": "background.global.js", "scripts": ["background.global.js"]}, "icons": {"16": "icons/icons/icon16.png", "48": "icons/icons/icon48.png", "128": "icons/icons/icon128.png"}, "permissions": ["activeTab", "storage"], "browser_specific_settings": {"gecko": {"id": "remove-spam@yourdomain", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://learncpp.com/*"], "js": ["content.global.js"], "run_at": "document_idle"}]}