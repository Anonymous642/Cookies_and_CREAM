{"manifest_version": 2, "name": "PixAI Reaper", "description": "Download your PixAI task generation images progressively", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "downloads", "https://api.pixai.art/*", "https://duckduckgo.com/*"], "web_accessible_resources": ["assets/*", "icon/*", "content-scripts/content.css"], "browser_specific_settings": {"gecko": {"id": "pixai-reaper@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://pixai.art/*"], "js": ["content-scripts/content.js"]}]}