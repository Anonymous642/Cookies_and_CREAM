{"manifest_version": 3, "name": "Folders for Gemini", "version": "2.1.6", "description": "Organize your Gemini chats into folders. Drag & drop, custom colors, and native integration.", "author": "RaymonDev", "browser_specific_settings": {"gecko": {"id": "folders-for-gemini-v1@ramong.dev", "strict_min_version": "109.0"}}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "permissions": ["storage"], "host_permissions": ["https://gemini.google.com/*"], "content_scripts": [{"matches": ["https://gemini.google.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["https://gemini.google.com/*"]}]}