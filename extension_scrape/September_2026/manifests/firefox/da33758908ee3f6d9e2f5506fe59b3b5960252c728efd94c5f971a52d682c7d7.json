{"manifest_version": 3, "name": "YouTube Unit Converter", "version": "2.2", "description": "Converts units in YouTube video subtitles in real time. Toggle between imperial to metric or metric to imperial.", "permissions": ["activeTab", "storage"], "host_permissions": ["*://*.youtube.com/*", "*://youtube.com/*", "*://*.youtube-nocookie.com/*"], "action": {"default_popup": "popup.html", "default_title": "Unit Converter Settings"}, "browser_specific_settings": {"gecko": {"id": "youtube-unit-converter@example.com", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "120.0"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtube.com/*", "*://*.youtube-nocookie.com/*"], "js": ["content.js"], "run_at": "document_end"}], "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}}