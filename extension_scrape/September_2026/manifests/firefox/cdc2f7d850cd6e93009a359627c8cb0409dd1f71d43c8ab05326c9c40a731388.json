{"manifest_version": 2, "name": "Timber Tabs", "version": "1.0.3", "description": "Turn your open tabs into a Timber reading list. Works on Windows, Mac and Linux. Sorted right on your computer.", "permissions": ["tabs", "storage", "http://localhost/*", "alarms"], "browser_action": {"default_popup": "popup.html", "default_title": "Send tabs to Timber", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "timber-tabs@timberreader.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["browser-name.js", "platform.js", "background.js"], "persistent": false}}