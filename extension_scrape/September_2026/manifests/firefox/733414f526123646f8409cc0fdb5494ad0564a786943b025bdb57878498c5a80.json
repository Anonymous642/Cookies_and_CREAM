{"manifest_version": 3, "name": "Kanji Lookup \u2014 Manga Reader's Dictionary", "version": "1.2.2", "description": "Instant kanji and Japanese word lookup, built for manga readers. Includes a screenshot crop + OCR tool.", "browser_specific_settings": {"gecko": {"id": "kanji-lookup@asil.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["searchTerms"]}}}, "action": {"default_popup": "popup.html", "default_title": "Kanji Lookup (Alt+Shift+K)", "default_icon": {"16": "icons/icon.svg", "32": "icons/icon.svg", "48": "icons/icon.svg", "96": "icons/icon.svg"}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+K"}, "description": "Open Kanji Lookup"}}, "background": {"scripts": ["background.js"]}, "permissions": ["storage", "clipboardRead", "activeTab"], "host_permissions": ["https://jisho.org/*", "https://kanjiapi.dev/*", "https://cdn.jsdelivr.net/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}}