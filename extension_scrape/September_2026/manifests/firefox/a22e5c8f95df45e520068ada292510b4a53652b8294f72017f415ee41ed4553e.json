{"manifest_version": 3, "name": "LYRA \u2014 gouvernance de l'IA", "short_name": "LYRA", "description": "Encadre l'usage des outils d'IA au travail. Analyse locale : le contenu de vos messages ne quitte jamais votre poste.", "version": "1.0.2", "homepage_url": "https://lyra.herahub.fr", "icons": {"16": "icons/icone-16.png", "32": "icons/icone-32.png", "48": "icons/icone-48.png", "128": "icons/icone-128.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["https://lyra.herahub.fr/*"], "background": {"scripts": ["dist/background.js"]}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://copilot.microsoft.com/*", "https://m365.cloud.microsoft/*", "https://chat.mistral.ai/*", "https://*.perplexity.ai/*"], "js": ["dist/content.js"], "run_at": "document_start", "all_frames": true}], "action": {"default_popup": "popup.html", "default_title": "LYRA", "default_icon": {"16": "icons/icone-16.png", "32": "icons/icone-32.png"}}, "browser_specific_settings": {"gecko": {"id": "lyra@herahub.fr", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteActivity"], "optional": ["technicalAndInteraction"]}}}}