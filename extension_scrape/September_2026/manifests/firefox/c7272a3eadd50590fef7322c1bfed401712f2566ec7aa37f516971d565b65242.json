{"manifest_version": 3, "name": "TabSlicer", "version": "2.0", "description": "Queue arbitrary tabs, duplicate the active tab, and tile selected tabs into left and right Firefox windows.", "permissions": ["menus", "nativeMessaging", "storage", "tabs"], "background": {"scripts": ["src/background/entry.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "tabslicer@extension.local", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/tabslicer-icon-16.png", "32": "icons/tabslicer-icon-32.png", "48": "icons/tabslicer-icon-48.png", "64": "icons/tabslicer-icon-64.png", "96": "icons/tabslicer-icon-96.png", "128": "icons/tabslicer-icon-128.png"}, "action": {"default_icon": {"16": "icons/tabslicer-icon-16.png", "32": "icons/tabslicer-icon-32.png", "48": "icons/tabslicer-icon-48.png"}, "default_title": "TabSlicer", "default_popup": "src/popup/popup.html"}, "sidebar_action": {"default_icon": {"16": "icons/tabslicer-icon-16.png", "32": "icons/tabslicer-icon-32.png", "48": "icons/tabslicer-icon-48.png"}, "default_panel": "src/sidebar/sidebar.html", "default_title": "TabSlicer Queue", "open_at_install": false}, "commands": {"toggle-current-tab-selection": {"suggested_key": {"default": "F8"}, "description": "Toggle the active tab in the TabSlicer selection"}, "duplicate-current-tab": {"suggested_key": {"default": "Shift+F8"}, "description": "Duplicate the active tab"}, "confirm-split-selection": {"suggested_key": {"default": "F9"}, "description": "Split selected tabs into tiled windows"}, "cancel-split-selection": {"suggested_key": {"default": "Shift+F9"}, "description": "Cancel the current TabSlicer selection"}, "revert-recent-split": {"suggested_key": {"default": "F10"}, "description": "Revert the most recent TabSlicer split"}, "open-sidebar-queue": {"suggested_key": {"default": "Shift+F10"}, "description": "Open the TabSlicer sidebar queue"}}}