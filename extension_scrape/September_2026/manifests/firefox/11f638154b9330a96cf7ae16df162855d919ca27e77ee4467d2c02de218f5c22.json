{"manifest_version": 2, "name": "Tab Title Renamer", "version": "1.0.0", "description": "Instantly rename any browser tab title. Changes persist across page refreshes.", "icons": {"16": "icons/icon16.svg", "48": "icons/icon48.svg", "128": "icons/icon128.svg"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.svg", "48": "icons/icon48.svg", "128": "icons/icon128.svg"}, "default_title": "Tab Title Renamer"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["tabs", "storage", "activeTab"], "browser_specific_settings": {"gecko": {"id": "tab-title-renamer@firefox-extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}