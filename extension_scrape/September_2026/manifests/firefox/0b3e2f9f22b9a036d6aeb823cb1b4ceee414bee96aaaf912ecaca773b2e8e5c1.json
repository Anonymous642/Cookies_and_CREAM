{"manifest_version": 3, "name": "Copy Code Button", "version": "1.0.0", "description": "Add a one-click \u201cCopy\u201d button to every code block on the current page.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "clipboardWrite"], "action": {"default_title": "Add Copy buttons to code blocks", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png"}}, "browser_specific_settings": {"gecko": {"id": "copy-code-button@yourdomain.example", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}