{"manifest_version": 3, "name": "Reddit Redgifs Viewport Loader", "version": "0.4.2", "description": "Delays Redgifs embeds on Reddit until they are near the viewport, with optional offscreen unload and request-level blocking.", "browser_specific_settings": {"gecko": {"id": "reddit-redgifs-viewport-loader@example.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage", "webRequest", "webRequestBlocking", "tabs"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "action": {"default_title": "Redgifs Loader", "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://reddit.com/*", "*://*.reddit.com/*"], "js": ["content/bridge.js"], "run_at": "document_start"}, {"matches": ["*://reddit.com/*", "*://*.reddit.com/*"], "js": ["content/main.js"], "run_at": "document_start", "world": "MAIN"}], "host_permissions": ["*://redgifs.com/*", "*://*.redgifs.com/*", "*://reddit.com/*", "*://*.reddit.com/*"], "background": {"scripts": ["background.js"]}}