{"manifest_version": 3, "name": "OxygenPDF", "description": "Open the PDF you are looking at in any OxygenPDF tool, without downloading it first.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["contextMenus", "storage", "alarms", "activeTab", "scripting"], "optional_host_permissions": ["<all_urls>", "file:///*"], "web_accessible_resources": [{"resources": ["bridge.html"], "matches": ["<all_urls>"]}], "action": {"default_title": "Open in OxygenPDF", "default_popup": "popup.html"}, "options_ui": {"page": "grant.html", "open_in_tab": true}, "commands": {"open-in-oxygenpdf": {"suggested_key": {"default": "Alt+Shift+O"}, "description": "Open the PDF on this tab in OxygenPDF"}}, "browser_specific_settings": {"gecko": {"id": "extension@oxygenpdf.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"type": "module", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://oxygenpdf.com/*", "https://www.oxygenpdf.com/*"], "run_at": "document_start", "js": ["content-scripts/handoff.js"]}]}