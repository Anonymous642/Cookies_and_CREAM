{"manifest_version": 3, "name": "TailScan", "version": "1.0.0", "description": "Hover any element. Copy as Tailwind CSS or React JSX.", "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "permissions": ["activeTab", "scripting", "storage", "sidePanel", "contextMenus", "identity"], "host_permissions": ["https://*.supabase.co/*"], "browser_specific_settings": {"gecko": {"id": "tailscan@tailscan.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "side_panel": {"default_path": "sidepanel.html"}, "commands": {"toggle-inspector": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Toggle TailScan inspector"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src https://*.supabase.co wss://*.supabase.co https://accounts.google.com;"}, "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["<all_urls>"]}]}