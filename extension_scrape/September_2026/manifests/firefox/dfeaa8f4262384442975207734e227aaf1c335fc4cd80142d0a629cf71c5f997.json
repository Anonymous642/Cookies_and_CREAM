{"manifest_version": 2, "name": "Quick Copy URL", "version": "2.0", "description": "Adds a button to the toolbar to quickly copy the current tab's URL.", "browser_specific_settings": {"gecko": {"id": "{f0b85509-347c-4e85-be56-89e0620674b7}"}}, "icons": {"16": "icon-light.png", "32": "icon-light.png", "48": "icon-light.png"}, "permissions": ["activeTab", "clipboardWrite"], "browser_action": {"default_icon": {"16": "icon-light.png", "32": "icon-light.png"}, "default_title": "Copy Current URL (Toolbar)"}, "page_action": {"default_icon": {"16": "icon-light.png", "32": "icon-light.png"}, "default_title": "Copy Current URL (Address Bar)", "show_matches": ["<all_urls>"]}, "background": {"scripts": ["background.js"], "persistent": false}}