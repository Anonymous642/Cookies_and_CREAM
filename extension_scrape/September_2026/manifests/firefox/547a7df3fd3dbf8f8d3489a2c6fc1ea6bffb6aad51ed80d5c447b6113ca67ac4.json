{"manifest_version": 3, "name": "LiveFaceSwap AI \u2014 Web Image to Face Swap", "short_name": "LiveFaceSwap", "description": "Right-click an HTTPS image to send it securely to the LiveFaceSwap real-time face swap workspace.", "version": "0.1.2", "permissions": ["alarms", "contextMenus", "storage"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://livefaceswap.ai/*"], "js": ["firefox-content.js"], "run_at": "document_start"}], "action": {"default_title": "Open LiveFaceSwap", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "browser-extension@livefaceswap.ai", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}