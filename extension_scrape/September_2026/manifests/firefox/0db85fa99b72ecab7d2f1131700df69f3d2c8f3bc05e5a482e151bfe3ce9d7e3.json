{"manifest_version": 3, "name": "Hare", "description": "Control HTML5 video/audio playback speed with keyboard shortcuts", "version": "1.7.0", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "webNavigation"], "host_permissions": ["http://*/*", "https://*/*", "file:///*"], "action": {"default_icon": {"19": "icons/icon19.png", "38": "icons/icon38.png"}, "default_title": "Hare", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "hare@anthonyy232.github.io", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["file:///*", "http://*/*", "https://*/*"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}