{"manifest_version": 2, "name": "Web Image Categorizer", "description": "A browser extension to save webpage images to cloud storage using customizable naming templates.", "version": "0.4.1", "short_name": "WIC", "icons": {"32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png", "512": "icon/512.png"}, "permissions": ["activeTab", "storage", "contextMenus", "notifications", "*://*/*"], "browser_specific_settings": {"gecko": {"id": "{8276cdb0-d7d9-4e1b-87a0-1f5f1726d806}", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Web Image Categorizer", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "sidebar_action": {"default_panel": "sidepanel.html", "browser_style": true, "default_title": "Web Image Categorizer", "open_at_install": false}}