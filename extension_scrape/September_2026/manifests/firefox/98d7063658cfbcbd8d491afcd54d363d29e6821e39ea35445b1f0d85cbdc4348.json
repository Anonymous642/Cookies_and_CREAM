{"manifest_version": 3, "name": "Cardmarket Offers Grid", "version": "0.0.1", "description": "Replaces a Cardmarket seller's offers table with an image grid.", "browser_specific_settings": {"gecko": {"id": "cardmarket-offers-grid@mtg-tools.local", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background/service-worker.js"]}, "host_permissions": ["https://api.scryfall.com/*"], "content_scripts": [{"matches": ["https://www.cardmarket.com/*/Users/*"], "js": ["content-scripts/seller-offers.js"], "run_at": "document_idle"}]}