{"manifest_version": 3, "name": "markfolio-extension", "description": "This extension allows you to easily manage all your bookmarks.\nIt integrates with your daily search workflow by directly searching within the website content of your saved bookmarks.", "version": "0.16.1", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_popup": "popup.html", "default_title": "Popup"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_start", "js": ["content-scripts/content.js"]}], "permissions": ["storage", "tabs", "bookmarks", "scripting"], "host_permissions": ["*://*/*"], "externally_connectable": {"matches": ["https://markfolio.fabmation.de/*", "https://markfolio.app/*", "http://localhost:3000/*"]}, "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["assets/*"]}, {"resources": ["content-scripts/content.css"], "matches": ["<all_urls>"]}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "markfolio@fabmation.de", "strict_min_version": "109.0"}}, "chrome_url_overrides": {"newtab": "newtab.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}}