{"manifest_version": 3, "name": "Sightline Fold", "version": "1.0.0", "description": "Measure fixed and sticky page occlusion, then fold or fade only the elements blocking your viewport.", "permissions": ["activeTab", "scripting"], "action": {"default_title": "Sightline Fold", "default_popup": "popup.html"}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "browser_specific_settings": {"gecko": {"id": "sightline-fold@threshold.tools", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"}}