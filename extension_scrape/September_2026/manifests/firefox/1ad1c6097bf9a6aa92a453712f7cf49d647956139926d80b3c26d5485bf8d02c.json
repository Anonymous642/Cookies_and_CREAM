{"manifest_version": 2, "name": "Bookmark AI", "description": "Save the current tab to Bookmark AI for automatic categorization and tagging.", "version": "0.1.4", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "browser_action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "default_title": "Bookmark AI", "default_popup": "popup.html"}, "permissions": ["activeTab", "tabs", "storage", "alarms", "cookies", "bookmarks", "webRequest", "webRequestBlocking", "https://bookmark-ai.cloud/*", "https://www.bookmark-ai.cloud/*", "https://clerk.bookmark-ai.cloud/*", "https://live.bookmark-ai.cloud/*"], "browser_specific_settings": {"gecko": {"id": "bookmark-ai@bookmark-ai.cloud", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "bookmarksInfo", "browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Open the Bookmark AI popup"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://bookmark-ai.cloud/*", "https://www.bookmark-ai.cloud/*"], "js": ["content-scripts/marker.js"]}]}