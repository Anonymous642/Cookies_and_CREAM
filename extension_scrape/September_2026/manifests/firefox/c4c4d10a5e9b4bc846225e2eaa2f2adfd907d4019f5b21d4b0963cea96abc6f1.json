{"manifest_version": 3, "name": "Bookmark Saver", "version": "1.0", "description": "Addon Firefox MV3 l\u01b0u trang hi\u1ec7n t\u1ea1i v\u00e0o bookmark v\u00e0 m\u1edf nhanh t\u1eeb popup.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["bookmarks", "tabs"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "bookmarksaver@example.com", "strict_min_version": "109.0"}}}