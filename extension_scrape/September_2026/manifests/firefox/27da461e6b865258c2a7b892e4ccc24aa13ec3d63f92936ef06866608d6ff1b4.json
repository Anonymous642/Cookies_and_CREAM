{"name": "Inbox-AI", "description": "An AI email assistant, delivered as a FireFox Extension, to help users draft replies based on email context ", "version": "2.0", "manifest_version": 3, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "192": "icons/icon192.png", "512": "icons/icon512.png"}, "action": {"default_title": "Inbox-AI", "default_icon": "icons/icon32.png", "default_popup": "index.html"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://inbox-ai-4syt.onrender.com/*", "*://mail.google.com/*"], "content_scripts": [{"js": ["content.js"], "matches": ["*://mail.google.com/*"], "css": ["content.css"]}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["*://mail.google.com/*"]}], "browser_specific_settings": {"gecko": {"id": "inbox-ai@your-domain.com"}}}