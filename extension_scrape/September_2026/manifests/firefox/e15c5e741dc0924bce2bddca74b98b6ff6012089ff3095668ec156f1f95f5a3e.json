{"manifest_version": 3, "name": "Shorts Pilot", "version": "1.0.0", "description": "Auto-scroll YouTube Shorts avec dashboard, statistiques, limite quotidienne et graphique int\u00e9gr\u00e9.", "author": "MonstxR", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage", "alarms"], "host_permissions": ["*://*.youtube.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Shorts Pilot"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background/background.js"]}, "browser_specific_settings": {"gecko": {"id": "shorts-pilot@kevin", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}