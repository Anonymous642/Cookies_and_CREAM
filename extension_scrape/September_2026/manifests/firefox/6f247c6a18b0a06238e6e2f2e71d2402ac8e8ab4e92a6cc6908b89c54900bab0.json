{"manifest_version": 3, "name": "Reflect Bookmark", "author": "Ross Timson", "version": "1.1.3", "license": "ISC", "description": "Unofficial add-on for adding links to your Reflect notes", "homepage_url": "https://git.sr.ht/~rosstimson/firefox-reflect", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "activeTab", "storage", "identity", "scripting"], "host_permissions": ["https://reflect.app/*"], "action": {"default_title": "Add to Reflect", "default_popup": "popup/popup.html"}, "background": {"scripts": ["shared/utils.js", "background/oauth.js", "background/background.js"]}, "options_ui": {"page": "options/options.html"}, "browser_specific_settings": {"gecko": {"id": "reflect-bookmark@rosstimson.com"}}}