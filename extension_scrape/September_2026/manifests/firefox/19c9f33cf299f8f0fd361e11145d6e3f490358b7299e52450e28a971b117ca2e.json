{"manifest_version": 3, "name": "Offer Relay", "description": "Relay offer copy between approved Points Console variations.", "version": "1.1.0", "author": "Team Pormotions", "minimum_chrome_version": "102", "permissions": ["activeTab", "storage"], "host_permissions": ["https://console.points.com/*", "https://console-st.internal.st.lcr.points.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "offer-relay@example.com", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Offer Relay", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://console.points.com/offers/*/variations/*/edit*", "https://console-st.internal.st.lcr.points.com/offers/*/variations/*/edit*"], "js": ["shared.js", "content-script.js"], "run_at": "document_idle"}]}