{"manifest_version": 3, "name": "Pomodoro Timer", "version": "1.2", "description": "A stunning, offline-first Pomodoro timer for productivity.", "homepage_url": "https://github.com/virejdasani/pomodoro-timer", "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "permissions": ["storage", "alarms", "tabs"], "background": {"scripts": ["background/background.js"]}, "action": {"default_icon": "assets/icons/icon-32.png", "default_title": "Pomodoro Timer"}, "browser_specific_settings": {"gecko": {"id": "pomodoro-timer@virejdasani.github.io", "strict_min_version": "109.0"}}, "web_accessible_resources": [{"resources": ["assets/*", "main-tab/*"], "matches": ["<all_urls>"]}]}