{"manifest_version": 3, "name": "Always Show Likes for Instagram", "version": "1.0.1", "description": "See likes and comments on any Instagram profile's posts without hovering. Works on the Posts, Reels, Tagged, and Reposts tabs.", "icons": {"16": "icons/ext/icon-16.png", "48": "icons/ext/icon-48.png", "128": "icons/ext/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "always-show-likes-for-instagram@dmitrii-volkov.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://www.instagram.com/*", "*://instagram.com/*"], "js": ["src/lib.js", "src/content.js"], "css": ["src/content.css"], "run_at": "document_idle"}]}