{"manifest_version": 2, "name": "RedlibRedirect", "version": "1.1.1", "description": "Redirects Reddit to a redlib instance in private windows, and auto-applies your redlib settings there.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "redlib-redirect@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["webRequest", "webRequestBlocking", "storage", "*://*.reddit.com/*", "https://safereddit.com/*", "https://redlib.catsarch.com/*", "https://red.artemislena.eu/*", "https://redlib.privadency.com/*"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_popup": "options.html", "default_title": "RedlibRedirect", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "content_scripts": [{"matches": ["https://safereddit.com/*", "https://redlib.catsarch.com/*", "https://red.artemislena.eu/*", "https://redlib.privadency.com/*"], "js": ["gate.js"], "run_at": "document_start", "all_frames": false}], "options_ui": {"page": "options.html", "open_in_tab": false, "browser_style": true}}