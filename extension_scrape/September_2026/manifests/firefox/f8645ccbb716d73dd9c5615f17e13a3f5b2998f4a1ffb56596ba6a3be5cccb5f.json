{"name": "ezRetime", "description": "A speedrun video retimer for Twitch, YouTube, and more! Click the extension icon on a page to run it.", "permissions": ["activeTab", "scripting"], "icons": {"128": "/icon.png"}, "action": {"default_title": "Run ezRetime on current page."}, "background": {"scripts": ["/worker.js"]}, "web_accessible_resources": [{"resources": ["scripts/*.js"], "matches": ["<all_urls>"]}], "version": "1.0.5", "manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "@ezretime", "data_collection_permissions": {"required": ["none"]}}}}