{"manifest_version": 2, "name": "Scribbly", "version": "1.0.0", "description": "Jot down thoughts without leaving the page.", "browser_specific_settings": {"gecko": {"id": "scribbly@example.com", "strict_min_version": "102.0"}}, "icons": {"48": "icons/scribbly-48.png", "128": "icons/scribbly-128.png"}, "permissions": ["activeTab", "tabs", "storage"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Scribbly", "default_popup": "popup.html", "default_icon": {"48": "icons/scribbly-48.png", "128": "icons/scribbly-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_security_policy": "script-src 'self'; object-src 'self'"}