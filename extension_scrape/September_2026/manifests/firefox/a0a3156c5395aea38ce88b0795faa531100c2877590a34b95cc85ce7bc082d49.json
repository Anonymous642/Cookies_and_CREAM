{"manifest_version": 3, "name": "Adept", "version": "1.0.2", "description": "Convert YouTube playlist into a course", "icons": {"128": "icon.png"}, "action": {"default_title": "Open on Adept", "default_icon": "icon-grey.png"}, "host_permissions": ["*://*.youtube.com/playlist*", "*://*.youtube.com/watch*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "extension@withadept.com", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}}