{"manifest_version": 3, "name": "Revvest", "description": "Capture TripAdvisor reviews from GraphQL responses and export them as JSON or CSV.", "version": "0.1.0", "action": {"default_title": "Revvest", "default_popup": "popup.html"}, "background": {"scripts": ["assets/background.js"], "type": "module"}, "permissions": ["downloads", "scripting", "storage", "tabs", "webRequest", "webRequestBlocking", "webRequestFilterResponse"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["assets/inpage.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"]}, "id": "revvest@revvest.local"}}}