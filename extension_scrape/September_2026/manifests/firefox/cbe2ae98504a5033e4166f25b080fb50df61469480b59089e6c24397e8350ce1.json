{"manifest_version": 2, "name": "Color_switch", "version": "1.1", "description": "This addon tries to make websites more soft and warm to us!", "author": "Nekodef", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["activeTab", "storage", "https://api.example.com/*"], "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "Color_swith", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "nekodeff@gmail.com", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}