{"manifest_version": 3, "name": "Cybereinforce Threat Enforcement", "version": "1.2.1", "description": "Enterprise-controlled URL/domain blocking enforced via Azure backend rules.", "permissions": ["declarativeNetRequest", "declarativeNetRequestWithHostAccess", "declarativeNetRequestFeedback", "storage", "alarms", "webNavigation"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["service_worker.js"]}, "options_page": "options.html", "action": {"default_title": "Cybereinforce Threat Enforcement", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://cybereinforce.com/join*"], "js": ["content_join.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "support@cybereinforce.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "personallyIdentifyingInfo"], "optional": ["technicalAndInteraction"]}}}}