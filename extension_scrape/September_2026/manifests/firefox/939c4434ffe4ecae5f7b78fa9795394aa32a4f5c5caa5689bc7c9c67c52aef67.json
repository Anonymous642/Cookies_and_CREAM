{"manifest_version": 3, "name": "Focus Site Blocker", "version": "1.0", "description": "Blocks distracting sites and removes YouTube Shorts & Recommendations. Part of the CRIH Project, 2026 Xr7-Code", "browser_specific_settings": {"gecko": {"id": "focusblocker-2026@xr7-code.crih", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "allows_telemetry": false, "allows_errors": false}}}, "permissions": ["declarativeNetRequest"], "host_permissions": ["*://*.tiktok.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*", "*://*.x.com/*", "*://*.twitter.com/*", "*://*.reddit.com/*", "*://*.twitch.tv/*", "*://*.kick.com/*", "*://*.pornhub.com/*", "*://*.xvideos.com/*", "*://*.9gag.com/*", "*://*.youtube.com/*"], "background": {"scripts": ["background.js"]}, "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["content/youtube.css"], "js": ["content/youtube.js"], "run_at": "document_idle"}]}