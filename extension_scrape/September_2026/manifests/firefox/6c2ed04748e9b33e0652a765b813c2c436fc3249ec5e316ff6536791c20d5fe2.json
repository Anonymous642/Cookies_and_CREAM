{"manifest_version": 3, "name": "Asterly \u2014 Focus Familiar", "version": "0.210.0", "description": "An animated focus companion with one-click rituals, reliable blocking, private insights, and encrypted sync.", "incognito": "spanning", "permissions": ["alarms", "declarativeNetRequest", "notifications", "storage", "tabs"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"service_worker": "src/background.js", "type": "module", "scripts": ["src/background.js"]}, "action": {"default_popup": "src/popup.html", "default_title": "Open Asterly"}, "options_page": "src/options.html", "commands": {"toggle-focus": {"suggested_key": {"default": "Alt+Shift+L", "mac": "Alt+Shift+L"}, "description": "Start or pause a focus session"}, "open-side-panel": {"suggested_key": {"default": "Alt+Shift+O", "mac": "Alt+Shift+O"}, "description": "Open Asterly's focus companion"}, "start-next-chapter": {"suggested_key": {"default": "Alt+Shift+N", "mac": "Alt+Shift+N"}, "description": "Start the next queued Asterly chapter"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "asterly@ryonixlabs.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personalCommunications", "personallyIdentifyingInfo", "websiteActivity"]}}}}