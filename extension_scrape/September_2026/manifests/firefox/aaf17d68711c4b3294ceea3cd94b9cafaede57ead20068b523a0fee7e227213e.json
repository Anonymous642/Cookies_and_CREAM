{"manifest_version": 2, "name": "X to XCancel Redirect", "version": "1.0", "description": "Automatically redirects x.com links to xcancel.com", "permissions": ["webRequest", "webRequestBlocking", "*://x.com/*", "*://www.x.com/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "x-to-xcancel@example.com", "data_collection_permissions": {"required": ["none"], "collects_personal_data": false, "collects_user_activity": false}}}}