{"manifest_version": 3, "name": "Tab Saver", "version": "1.0.5", "description": "Saves all open tabs when Firefox closes and lets you restore them on next launch.", "permissions": ["tabs", "storage", "downloads"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Tab Saver", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "web_accessible_resources": [{"resources": ["restore.html"], "matches": ["<all_urls>"]}], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "tab-saver@jessup", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}