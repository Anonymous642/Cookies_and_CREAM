{"manifest_version": 3, "name": "Axis MSRP Price Overlay", "version": "4.2.5", "description": "Axis MSRP prices, chipset info, FOV filtering, a map FOV camera selector, Japanese UI, and an option to hide prices.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage", "alarms", "scripting"], "host_permissions": ["https://camstreamer.com/*", "https://api.frankfurter.dev/*", "https://*.tile.openstreetmap.org/*", "https://get.geojs.io/*", "https://www.axis.com/*"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.axis.com/support/tools/product-selector*", "https://www.axis.com/*/support/tools/product-selector*"], "js": ["i18n.js", "catalog-data.js", "chipset-data.js", "fov-data.js", "vendor/leaflet.js", "content.js"], "css": ["vendor/leaflet.css", "content.css"], "run_at": "document_idle"}, {"matches": ["https://www.axis.com/search*", "https://www.axis.com/*/search*"], "js": ["i18n.js", "catalog-data.js", "chipset-data.js", "search-content.js"], "css": ["search-content.css"], "run_at": "document_idle"}, {"matches": ["https://www.axis.com/products/*", "https://www.axis.com/*/products/*"], "js": ["i18n.js", "catalog-data.js", "chipset-data.js", "products-content.js"], "css": ["products-content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["vendor/images/*"], "matches": ["https://www.axis.com/*"]}], "browser_specific_settings": {"gecko": {"id": "axis-msrp-price-overlay@camstreamer.local", "strict_min_version": "127.0"}}}