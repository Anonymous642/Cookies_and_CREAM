{"manifest_version": 2, "name": "SpeedTap \u2014 Playback Speed Controller", "version": "1.0.0", "description": "T\u0103ng/gi\u1ea3m t\u1ed1c \u0111\u1ed9 ph\u00e1t nhanh (0.5x \u2192 2.0x) cho m\u1ecdi HTML5 player, c\u00f3 ph\u00edm t\u1eaft v\u00e0 l\u01b0u m\u1eb7c \u0111\u1ecbnh theo domain.", "permissions": ["activeTab", "storage", "tabs"], "browser_action": {"default_popup": "popup.html", "default_title": "SpeedTap"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"], "persistent": false}, "commands": {"increase_speed": {"suggested_key": {"default": "Alt+Up"}, "description": "T\u0103ng t\u1ed1c \u0111\u1ed9 ph\u00e1t"}, "decrease_speed": {"suggested_key": {"default": "Alt+Down"}, "description": "Gi\u1ea3m t\u1ed1c \u0111\u1ed9 ph\u00e1t"}}, "browser_specific_settings": {"gecko": {"id": "speedtap@local", "data_collection_permissions": {"required": ["none"], "optional": []}}}}