{"manifest_version": 3, "name": "Linksley: Shared Bookmark & Link Manager", "version": "0.5.6", "description": "Bookmark manager with shared boards \u2014 save, organize & share links with your team or family. Search everything. New-tab start page.", "action": {"default_title": "Save to Linksley", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "minimum_chrome_version": "102", "chrome_url_overrides": {"newtab": "newtab.html"}, "permissions": ["storage", "activeTab", "contextMenus", "bookmarks", "alarms", "tabs"], "host_permissions": ["https://linksley.com/*", "https://*.linksley.com/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": false, "css": ["print.css"]}, {"matches": ["<all_urls>"], "js": ["frame.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["icons/icon48.png"], "matches": ["<all_urls>"]}], "commands": {"toggle-sessions": {"suggested_key": {"default": "Alt+S"}, "description": "Open/close the Sessions drawer"}, "toggle-bookmarks": {"suggested_key": {"default": "Alt+B"}, "description": "Open/close the Bookmarks drawer"}, "save-session": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Save this window as a session"}}, "browser_specific_settings": {"gecko": {"id": "linksley@linksley.com", "strict_min_version": "118.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "bookmarksInfo"], "optional": ["technicalAndInteraction"]}}}}