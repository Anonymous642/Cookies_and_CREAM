{"manifest_version": 3, "name": "Old Reddit Redirect", "version": "1.0.0", "description": "Redirects reddit.com and www.reddit.com to old.reddit.com.", "icons": {"48": "icon.svg", "96": "icon.svg"}, "permissions": ["declarativeNetRequest"], "host_permissions": ["*://reddit.com/*", "*://www.reddit.com/*"], "declarative_net_request": {"rule_resources": [{"id": "redirect_reddit", "enabled": true, "path": "rules.json"}]}, "browser_specific_settings": {"gecko": {"id": "oldreddit@rdeeson.com", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_title": "Old Reddit Redirect", "default_icon": {"48": "icon.svg", "96": "icon.svg"}}}