{"manifest_version": 3, "name": "ClickUp Homepage Widget", "version": "1.0.2", "description": "Display ClickUp tasks and time tracking on Firefox new tab page", "author": "ClickUp Widget Developer", "permissions": ["storage", "tabs"], "host_permissions": ["https://api.clickup.com/*", "https://app.clickup.com/*"], "chrome_url_overrides": {"newtab": "homepage.html"}, "options_ui": {"page": "options.html", "open_in_tab": false}, "background": {"scripts": ["background.js"]}, "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "browser_specific_settings": {"gecko": {"id": "clickup-widget@firefox.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}