{"manifest_version": 3, "name": "Site Blocker", "version": "1.0.0", "description": "Block distracting websites to stay focused. Add any domain to your blocklist and get redirected to a calm blocked page instead.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "site-blocker-027@mozillamaker.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["tabs", "storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Site Blocker"}}