{"manifest_version": 3, "name": "Discogs MyWants Auto-Filter", "version": "1.0.0", "description": "Automatically shows generic sleeves and sleeveless media when viewing your Discogs wantlist. Perfect for collectors who want to see all available options.", "author": "Format", "homepage_url": "https://github.com/whatformat/betterwants", "icons": {"32": "icons/icon-32.png", "128": "icons/icon-128.png"}, "permissions": [], "host_permissions": ["https://www.discogs.com/*"], "content_scripts": [{"matches": ["https://www.discogs.com/shop/mywants*"], "js": ["content.js"], "run_at": "document_start"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "betterwantsfilter@whatformat.github.io", "strict_min_version": "109.0"}}, "minimum_chrome_version": "88", "categories": ["productivity"], "short_name": "Discogs Wants Filter"}