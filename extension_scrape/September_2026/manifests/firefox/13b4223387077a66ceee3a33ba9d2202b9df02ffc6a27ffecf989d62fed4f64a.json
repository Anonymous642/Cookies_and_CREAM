{"manifest_version": 2, "name": "EnqueueAll", "version": "1.0.1", "description": "Add all new videos from your YouTube to the Watch Queue with one click (or Alt+Q). Works on any YouTube page; ignores Shorts and Playlists.", "permissions": ["activeTab", "tabs", "https://www.youtube.com/*"], "browser_action": {"default_title": "Queue new subscription videos"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "commands": {"queue-new-subscription-videos": {"suggested_key": {"default": "Alt+Q", "mac": "Alt+Q"}, "description": "Queue all new subscription videos"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{b6471f97-6038-45b2-acd6-1f4746a14bf2}"}}}