{"manifest_version": 3, "name": "MiraPre\u00e7o \u2014 Monitor de Pre\u00e7os", "version": "1.6.0", "description": "Mire um pre\u00e7o e seja avisado quando chegar. Monitora Mercado Livre, Magalu e Shopee abrindo abas em segundo plano no seu navegador.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "alarms", "tabs", "notifications"], "host_permissions": ["*://*.mercadolivre.com.br/*", "*://*.magazineluiza.com.br/*", "*://*.magalu.com.br/*", "*://*.shopee.com.br/*", "https://api.mirapreco.com.br/*"], "background": {"scripts": ["browser-polyfill.js", "background.js"]}, "content_scripts": [{"matches": ["*://*.mercadolivre.com.br/*", "*://*.magazineluiza.com.br/*", "*://*.magalu.com.br/*", "*://*.shopee.com.br/*"], "js": ["browser-polyfill.js", "extractor.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "MiraPre\u00e7o", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "browser_specific_settings": {"gecko": {"id": "extensao@mirapreco.com.br", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo"], "optional": ["technicalAndInteraction"]}}}}