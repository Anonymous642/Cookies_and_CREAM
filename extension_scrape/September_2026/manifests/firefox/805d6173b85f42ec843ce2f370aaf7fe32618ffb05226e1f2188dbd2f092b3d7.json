{"manifest_version": 3, "name": "Auto Workflow Builder", "version": "1.3", "description": "Detects repetitive browsing patterns and helps users create reusable workflows locally.", "permissions": ["tabs", "storage", "notifications", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Auto Workflow Builder"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Auto-Workflow-Builder", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}