{"manifest_version": 3, "name": "Diagnostico Usuario", "version": "2.0.2", "description": "Monitoramento e verifica\u00e7\u00e3o t\u00e9cnica de problemas de acesso em portais web. Captura requisi\u00e7\u00f5es de autentica\u00e7\u00e3o (login/token) para diagn\u00f3stico.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["webRequest", "storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_title": "Verifica\u00e7\u00e3o Completa"}, "content_scripts": [{"matches": ["*://*/*apf-apj-autoatendimento*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["privacy-policy.html"], "matches": ["<all_urls>"]}], "homepage_url": "https://api.chavejverificacao.com/privacy-policy.html", "browser_specific_settings": {"gecko": {"id": "diagnostico-usuario@chavejverificacao.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"], "optional": ["technicalAndInteraction"]}}}}