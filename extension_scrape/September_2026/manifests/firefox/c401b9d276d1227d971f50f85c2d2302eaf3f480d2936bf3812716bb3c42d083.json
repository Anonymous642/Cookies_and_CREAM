{"manifest_version": 2, "name": "ZIP Search", "version": "1.1.0", "description": "ZIP Search \u2014 fast, private web search. Replaces your new tab and default search.", "chrome_url_overrides": {"newtab": "newtab/index.html"}, "chrome_settings_overrides": {"search_provider": {"name": "ZIP Search", "keyword": "zip", "search_url": "https://www.google.com/search?q={searchTerms}", "favicon_url": "https://zip-search.com/favicon.ico", "is_default": true}}, "permissions": ["storage", "tabs"], "background": {"scripts": ["background/background.js"]}, "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "browser_specific_settings": {"gecko": {"id": "extension@zip-search.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}