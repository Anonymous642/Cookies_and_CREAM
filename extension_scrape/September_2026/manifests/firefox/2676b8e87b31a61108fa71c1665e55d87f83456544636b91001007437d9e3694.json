{"manifest_version": 3, "name": "AAJ", "description": "Auto Apply Job - Automate job applications on LinkedIn, Indeed, and other job boards.", "version": "1.0", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://www.linkedin.com/*", "https://www.indeed.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "aaj-autojob@example.com", "data_collection_permissions": {"required": ["personalCommunications"]}}}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*", "https://www.indeed.com/viewjob*"], "js": ["content.js"]}]}