{"manifest_version": 3, "name": "Memex", "version": "1.0.3", "description": "Your multi-AI memory: search, group & ask across ChatGPT, Claude & Perplexity \u2014 local-first and private to you.", "homepage_url": "https://api.getmemex.app", "permissions": ["storage", "alarms"], "content_security_policy": {"extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://api.getmemex.app; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"}, "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*", "https://www.perplexity.ai/*", "https://perplexity.ai/*", "https://api.getmemex.app/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://claude.ai/*"], "js": ["content/claude.js"], "run_at": "document_idle"}, {"matches": ["https://chatgpt.com/*"], "js": ["content/chatgpt.js"], "run_at": "document_idle"}, {"matches": ["https://www.perplexity.ai/*", "https://perplexity.ai/*"], "js": ["content/perplexity.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "src/popup/index.html", "default_title": "Memex", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Q"}, "description": "Open the Memex popup"}, "open-panel": {"suggested_key": {"default": "Alt+A"}, "description": "Open the Memex in-page panel"}}, "browser_specific_settings": {"gecko": {"id": "memex-firefox@getmemex.app", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent", "personallyIdentifyingInfo"]}}}}