{"manifest_version": 3, "name": "myClipr \u2014 Bookmark Manager", "version": "1.20.1", "description": "Save bookmarks with AI summaries + auto-tags, side-panel boards, right-click 'Save with highlight', optional bookmark-bar sync.", "permissions": ["activeTab", "tabs", "storage", "contextMenus", "notifications", "scripting", "bookmarks", "alarms"], "host_permissions": ["https://ws.myclipr.app/*", "https://api.myclipr.app/*", "https://myclipr.app/*", "https://www.myclipr.app/*"], "sidebar_action": {"default_panel": "sidebar.html", "default_title": "myClipr", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://api.myclipr.app https://ws.myclipr.app https://myclipr.app https://www.myclipr.app"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "chrome_url_overrides": {"newtab": "newtab.html"}, "background": {"scripts": ["bookmark-mirror.js", "sync-engine.js", "badge-status.js", "background.js"]}, "content_scripts": [{"matches": ["https://myclipr.app/*", "https://www.myclipr.app/*"], "js": ["content-script.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "clipper@centr.dev", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}}}