{"manifest_version": 3, "name": "PocketCreds \u2014 Instant Credential Clipboard", "version": "1.0.0", "description": "Store your most-used credentials, IDs, and license images in labeled slots. One click copies to clipboard. Nothing leaves your machine.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}, "action": {"default_popup": "src/popup.html", "default_title": "PocketCreds", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}}, "background": {"scripts": ["background/background.js"]}, "permissions": ["storage", "clipboardWrite"], "browser_specific_settings": {"gecko": {"id": "pocketcreds@notavello.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}