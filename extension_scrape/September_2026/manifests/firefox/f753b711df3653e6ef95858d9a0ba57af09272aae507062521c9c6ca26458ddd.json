{"manifest_version": 3, "name": "CookieClear", "version": "1.0.0", "description": "Simple cookie cleaner. Clear cookies and cache with one click.", "icons": {"48": "assets/icon-48.png", "96": "assets/icon-96.png", "128": "assets/icon-128.png"}, "action": {"default_icon": {"48": "assets/icon-48.png", "96": "assets/icon-96.png"}, "default_title": "CookieClear", "default_popup": "interface/clean.html"}, "permissions": ["cookies", "browsingData"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "cookieclear@privacy.cleaner", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}