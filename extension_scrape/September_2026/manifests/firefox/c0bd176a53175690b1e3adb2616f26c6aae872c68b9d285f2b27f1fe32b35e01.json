{"manifest_version": 3, "name": "Pinquiet", "version": "0.2.0", "author": "Stranyer", "description": "A quieter Pinterest: dark mode, fewer distractions, and image-first pin viewing. Independent and unofficial.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "pinterest-zen@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["*://*.pinterest.com/*"], "action": {"default_title": "Pinquiet", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "background": {"scripts": ["src/background.js"]}, "commands": {"toggle-zen-mode": {"suggested_key": {"default": "Alt+Shift+Z"}, "description": "Toggle Pinquiet Zen mode"}}, "content_scripts": [{"matches": ["*://*.pinterest.com/*"], "css": ["src/content.css"], "js": ["src/content.js"], "run_at": "document_start"}]}