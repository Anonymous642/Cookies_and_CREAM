{"manifest_version": 3, "name": "YouTube Video Scaler", "version": "1.0", "description": "YouTube Video Scaler adds a scale slider directly to the YouTube player controls.", "permissions": ["storage"], "host_permissions": ["https://*.youtube.com/*"], "icons": {"128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*.youtube.com/watch*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "youtube-video-scaler@yourdomain.com", "data_collection_permissions": {"required": ["none"]}}}}