{"manifest_version": 2, "name": "MyBB Super Filter Toolkit", "version": "2.3", "description": "Block users, specific threads, sections, filter 'New Posts', plus Export/Import and Badge Counters.", "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "permissions": ["storage", "*://*.mybroadband.co.za/*"], "browser_action": {"default_popup": "popup.html", "default_title": "MyBB Filter Settings", "default_icon": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://mybroadband.co.za/forum/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "mybb-super-filter@local", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"]}}}}