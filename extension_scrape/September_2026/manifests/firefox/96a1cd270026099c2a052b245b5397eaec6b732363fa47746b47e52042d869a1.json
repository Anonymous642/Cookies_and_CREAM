{"manifest_version": 2, "name": "YouTube Auto Quality and Audio", "version": "1.0.0", "description": "Automatically selects the highest YouTube video quality and prefers the main/default audio track.", "icons": {"32": "icon.svg", "48": "icon.svg", "96": "icon.svg"}, "browser_action": {"default_title": "YouTube Auto Quality and Audio", "default_popup": "popup.html", "default_icon": {"32": "icon.svg", "48": "icon.svg", "96": "icon.svg"}}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": ["page-bridge.js"], "permissions": ["storage", "*://www.youtube.com/*", "*://m.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "youtube-auto-quality-audio@example.local", "data_collection_permissions": {"required": ["none"]}}}}