{"manifest_version": 2, "name": "Eye Care Reminder", "version": "1.3", "description": "Periodically reminds you to take short eye-rest breaks (20-20-20 style) with customizable intervals and snooze.", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["storage", "notifications", "alarms"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Eye Care Reminder", "default_popup": "popup.html"}, "options_ui": {"page": "popup.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "@Eye-Care-Reminder", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}