{"manifest_version": 2, "name": "BrowserSync Spaces", "version": "0.2.0", "description": "Sync spaces, open tabs, and pinned URLs with your self-hosted BrowserSync server.", "permissions": ["tabs", "tabGroups", "storage", "alarms", "contextMenus", "http://*/*", "https://*/*"], "background": {"scripts": ["background.js"]}, "icons": {"48": "icon.svg", "96": "icon.svg"}, "browser_action": {"default_popup": "popup.html", "default_title": "BrowserSync Spaces"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "browser-sync-spaces@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity"]}}}}