{"manifest_version": 3, "name": "YouTube True OLED Black", "version": "1.0.7", "description": "Replaces YouTube's grey dark theme with true #000000 black to prevent OLED burn-in, especially helpful for Theater mode.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "youtube-true-oled-black@melvilmariette.tutanota.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "css": ["oled.css"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "action": {"default_popup": "popup.html", "default_title": "YouTube True OLED Black", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}}