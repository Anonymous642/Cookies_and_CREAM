{"manifest_version": 3, "name": "TrackTheDeal - Amazon Price Checker", "version": "2.1", "description": "Checks Amazon product prices against TrackTheDeal and shows history chart.", "permissions": [], "icons": {"128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "hello@trackthedeal.com", "strict_min_version": "109.0"}}, "action": {"default_icon": {"48": "icons/icon128.png"}, "default_popup": "popup.html", "default_title": "TrackTheDeal"}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.co.jp/*", "*://*.amazon.in/*", "*://*.amazon.ca/*", "*://*.amazon.com.au/*", "*://*.amazon.nl/*", "*://*.amazon.com.mx/*", "*://*.amazon.com.br/*", "*://*.amazon.sg/*"], "js": ["content.js", "chart.js", "chartjs-adapter-date-fns.js"], "css": ["styles.css"], "run_at": "document_idle"}]}