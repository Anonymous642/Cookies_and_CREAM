{"manifest_version": 3, "name": "Index Dark View", "version": "1.2.0", "description": "Dark theme for index.hu: white text on a black background. Toggle from the toolbar.", "homepage_url": "https://index.hu/", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "action": {"default_title": "Index Dark View", "default_popup": "src/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}, "permissions": ["storage"], "host_permissions": ["*://index.hu/*", "*://*.index.hu/*"], "browser_specific_settings": {"gecko": {"id": "index-dark-view@addon", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["*://index.hu/*", "*://*.index.hu/*"], "css": ["src/dark.css"], "js": ["src/content.js"], "run_at": "document_start"}]}