{"manifest_version": 3, "name": "YouTube Smart Ad Blocker Ultimate", "version": "4.0", "description": "Professional YouTube ad blocker and productivity extension.", "author": "Md. Abdur Rob (abdur.rob43@gmail.com)", "browser_specific_settings": {"gecko": {"id": "youtube-ad-blocker@abdurrob.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["*://*.youtube.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}]}