{"manifest_version": 3, "name": "Good Ass Proxy", "version": "0.1.0", "description": "Firefox proxy switcher with SOCKS/HTTP pools, health scoring, failover, sticky sessions, and local diagnostics.", "browser_specific_settings": {"gecko": {"id": "proxy-reliability-console@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["alarms", "contextualIdentities", "proxy", "storage", "tabs", "webRequest", "webRequestBlocking"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["src/background/background.js"], "type": "module"}, "action": {"default_title": "Good Ass Proxy", "default_popup": "src/popup/popup.html"}, "commands": {"toggle-on-off": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Toggle proxy switching on or off"}, "rotate-proxy": {"suggested_key": {"default": "Ctrl+Shift+R"}, "description": "Rotate the active proxy"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}}