{"manifest_version": 3, "name": "FireGPT", "version": "1.0", "description": "FireGPT sets ChatGPT as your default search engine, enables an Omnibox keyword and adds a context menu search facility for highlighted text.", "icons": {"16": "icons/FireGPT-16.png", "32": "icons/FireGPT-32.png", "48": "icons/FireGPT-48.png", "64": "icons/FireGPT-64.png", "96": "icons/FireGPT-96.png", "128": "icons/FireGPT-128.png", "256": "icons/FireGPT-256.png"}, "permissions": ["contextMenus"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "firegpt@eleventy8.com"}}, "chrome_settings_overrides": {"search_provider": {"name": "FireGPT", "keyword": "@chatgpt", "favicon_url": "icons/FireGPT-256.png", "search_url": "https://chatgpt.com/?q={searchTerms}&hints=search", "encoding": "UTF-8", "is_default": true}}, "omnibox": {"keyword": "gpt"}}