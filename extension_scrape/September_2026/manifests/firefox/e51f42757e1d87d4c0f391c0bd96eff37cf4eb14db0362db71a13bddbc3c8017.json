{"manifest_version": 3, "name": "Bkmker", "version": "0.1.4", "description": "Save, tag, and organize bookmarks with end-to-end encryption. Every link is encrypted on your device \u2014 only you can read them.", "homepage_url": "https://bkmker.com", "permissions": ["activeTab", "contextMenus", "scripting", "storage", "cookies"], "host_permissions": ["https://bkmker.com/*", "https://*/*", "http://*/*"], "browser_specific_settings": {"gecko": {"id": "extension@bkmker.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background/worker.js"], "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "Bkmker", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "content_scripts": [{"matches": ["https://bkmker.com/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}