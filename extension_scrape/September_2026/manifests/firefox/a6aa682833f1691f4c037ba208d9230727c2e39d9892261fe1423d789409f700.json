{"manifest_version": 3, "name": "Mandubun", "version": "1.0.4.0", "description": "Learn Korean by reading Naver Webtoons! Read, listen, speak, type, grammar, practice, learn!", "homepage_url": "https://mandubun.com", "browser_specific_settings": {"gecko": {"id": "mandubun@mandubun.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent", "websiteActivity", "personallyIdentifyingInfo"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["storage"], "host_permissions": ["*://comic.naver.com/*", "*://image-comic.pstatic.net/*", "https://api.mandubun.com/*"], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Mandubun", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_popup": "login.html"}, "content_scripts": [{"matches": ["*://comic.naver.com/*"], "css": ["content-reset.css"], "js": ["sentry.bundle.js", "content.js"], "run_at": "document_idle"}], "background": {"scripts": ["sentry.bundle.js", "background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "web_accessible_resources": [{"resources": ["bridge.js", "callback.html", "callback.js", "icons/mascot/*.webp"], "matches": ["*://comic.naver.com/*"]}]}