{"manifest_version": 3, "name": "Site Unblocker", "version": "2.0", "description": "Bypass ISP DNS blocking. Switches browser to DNS-over-HTTPS (Cloudflare/Google).", "permissions": ["storage", "privacy", "tabs"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_title": "Site Unblocker", "default_popup": "popup.html", "default_icon": {"48": "icon.svg"}}, "icons": {"48": "icon.svg"}, "browser_specific_settings": {"gecko": {"id": "site-unblocker@fixed", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}