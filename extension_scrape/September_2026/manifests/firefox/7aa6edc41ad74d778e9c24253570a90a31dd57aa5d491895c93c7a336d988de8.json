{"manifest_version": 3, "name": "Fantasy Cycling Rider Highlighter", "version": "0.2.0", "description": "Highlights riders on a cycling stats site that you have selected for a race in a fantasy cycling game.", "browser_specific_settings": {"gecko": {"id": "fantasy-cycling-highlighter@taldra.in", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "scripting"], "host_permissions": ["https://www.velogames.com/*", "https://www.procyclingstats.com/*", "https://procyclingstats.com/*"], "action": {"default_popup": "popup.html", "default_title": "Fantasy Cycling Highlighter", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://www.procyclingstats.com/*", "https://procyclingstats.com/*"], "js": ["slugify.js", "content_pcs.js"], "css": ["content_pcs.css"], "run_at": "document_idle"}]}