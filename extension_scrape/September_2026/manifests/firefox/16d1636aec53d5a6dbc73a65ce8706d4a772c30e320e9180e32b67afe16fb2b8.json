{"manifest_version": 3, "name": "Zendesk Admin Shortcuts", "version": "1.1.0", "description": "Alt+K spotlight search for Zendesk Admin Center \u2014 admin pages, triggers, macros, views, automations, and more.", "author": "Robert Schwarz", "homepage_url": "https://github.com/robertschwarz/zendesk-admin-shortcuts", "browser_specific_settings": {"gecko": {"id": "zendesk-admin-shortcuts@robertschwarz.io", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "host_permissions": ["https://*.zendesk.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "commands": {"toggle-spotlight": {"suggested_key": {"default": "Alt+K", "mac": "Alt+K"}, "description": "Toggle Zendesk Admin Shortcuts"}}, "content_scripts": [{"matches": ["https://*.zendesk.com/*"], "exclude_matches": ["https://www.zendesk.com/*", "https://support.zendesk.com/*", "https://community.zendesk.com/*", "https://developer.zendesk.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["spotlight.html"], "matches": ["https://*.zendesk.com/*"]}]}