{"manifest_version": 3, "name": "Floating Focus Timer - Tempo Blocks", "short_name": "Tempo Blocks", "version": "1.0.1", "description": "Run editable Focus Cycles and custom timers in a movable browser widget with alarms, toolbar countdowns, and notifications.", "icons": {"16": "icons/timer-16.png", "32": "icons/timer-32.png", "48": "icons/timer-48.png", "128": "icons/timer-128.png"}, "permissions": ["activeTab", "alarms", "notifications", "scripting", "storage"], "background": {"scripts": ["shared.js", "background.js"]}, "action": {"default_title": "Toggle Tempo Blocks widget", "default_icon": {"16": "icons/timer-16.png", "32": "icons/timer-32.png"}}, "options_page": "popup.html", "browser_specific_settings": {"gecko": {"id": "tempo-blocks@wiplash.ai", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}