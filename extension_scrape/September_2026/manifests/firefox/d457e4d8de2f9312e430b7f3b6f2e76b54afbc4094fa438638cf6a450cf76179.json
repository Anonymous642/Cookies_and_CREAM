{"manifest_version": 3, "name": "SearchLens for YouTube", "version": "1.2.30", "description": "Advanced YouTube search controls for custom dates, strict matching, duration, views, channels, and cleaner results.", "permissions": ["storage", "scripting"], "action": {"default_popup": "popup.html", "default_title": "SearchLens for YouTube"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "searchlens-youtube@ericmaina.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "background": {"scripts": ["background.js"]}, "host_permissions": ["https://www.youtube.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}]}