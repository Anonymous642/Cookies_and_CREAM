{"manifest_version": 3, "name": "LibSpace Boox Connector", "version": "2.0.1", "description": "Send any file to your Onyx Boox e-reader in 2 seconds. Drag, drop, done.", "permissions": ["storage", "cookies"], "host_permissions": ["https://push.boox.com/*", "https://send2boox.com/*", "https://eur.boox.com/*", "https://*.aliyuncs.com/*", "https://api.mixpanel.com/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["lib/boox-client.js", "background/background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "connector@libspace.io", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}