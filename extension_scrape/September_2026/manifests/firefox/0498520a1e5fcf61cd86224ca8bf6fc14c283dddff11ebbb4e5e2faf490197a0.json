{"manifest_version": 3, "name": "G-Shop \u2014 Live Shopping Notifications", "short_name": "G-Shop", "version": "0.1.0", "description": "Get instant notifications when shops you follow on G-Shop feature a product live. Add to cart in one click \u2014 no need to keep G-Shop open.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "G-Shop \u2014 Live shopping", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"service_worker": "background/sw.js", "scripts": ["background/sw.js"], "type": "module"}, "permissions": ["notifications", "storage", "alarms"], "host_permissions": ["https://gsell.gennexs.com/*", "https://gsellapi.gennexs.com/*", "https://*.gennexs.com/*", "http://localhost:3001/*", "http://localhost:5173/*"], "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["https://gsell.gennexs.com/*", "https://gsellapi.gennexs.com/*", "https://*.google.com/*", "https://accounts.google.com/*", "https://*.googleusercontent.com/*", "https://*.facebook.com/*", "https://*.line.me/*", "https://www.tiktok.com/v2/auth/*"], "js": ["content/widget.js"], "css": ["content/widget.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "gshop@gennexs.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo"], "optional": ["websiteActivity"]}}}, "minimum_chrome_version": "109"}