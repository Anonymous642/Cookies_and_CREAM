{"manifest_version": 2, "name": "PrintSmart \u2014 WYSIWYG Print", "version": "1.2.1", "author": "PrintSmart", "description": "One-click pixel-perfect print. Captures the page exactly as you see it \u2014 backgrounds, colors, fonts, layout \u2014 then opens the print dialog. No site can mangle the output with hostile print CSS.", "homepage_url": "https://printsmart.app", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab"], "browser_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_title": "PrintSmart \u2014 WYSIWYG Print"}, "background": {"scripts": ["background.js"], "persistent": true}, "browser_specific_settings": {"gecko": {"id": "wysiwyg-print@printsmart.app", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"]}}}}