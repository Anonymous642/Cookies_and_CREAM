{"manifest_version": 3, "name": "MyFavKey Autofill", "version": "0.1.3", "description": "Remplissage automatique depuis votre coffre MyFavKey local.", "permissions": ["storage", "activeTab", "scripting", "notifications"], "host_permissions": ["http://127.0.0.1/*", "https://*/*", "http://*/*"], "background": {"scripts": ["background-firefox.js"]}, "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_title": "MyFavKey", "default_popup": "popup.html", "default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["autofill.js", "capture.js"], "run_at": "document_idle"}], "commands": {"fill-credentials": {"suggested_key": {"default": "Ctrl+Shift+L"}, "description": "Remplir les identifiants MyFavKey"}}, "browser_specific_settings": {"gecko": {"id": "myfavkey-autofill@myfav.tech", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}