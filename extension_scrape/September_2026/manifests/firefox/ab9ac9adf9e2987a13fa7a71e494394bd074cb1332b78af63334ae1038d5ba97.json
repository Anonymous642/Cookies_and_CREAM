{"name": "Pop Tab", "version": "1.1.4", "description": "Experimental: Pop a tab into a new window, or the move it to the next window.", "key": "", "icons": {"16": "images/icon16.png", "32": "images/icon32.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "permissions": ["tabs"], "background": {"scripts": ["worker.js"]}, "commands": {"pop-out": {"suggested_key": {"default": "Alt+P", "mac": "Alt+P"}, "description": "Pop tab out to new window"}, "pop-in": {"suggested_key": {"default": "Alt+Shift+P", "mac": "Alt+Shift+P"}, "description": "Pop tab into the next window"}, "toggle-is-pinned": {"suggested_key": {"default": "Ctrl+Shift+X", "mac": "MacCtrl+Shift+X"}, "description": "Toggle tab's pinned state"}}, "manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "pop-tab-extension@boadway.net"}}}