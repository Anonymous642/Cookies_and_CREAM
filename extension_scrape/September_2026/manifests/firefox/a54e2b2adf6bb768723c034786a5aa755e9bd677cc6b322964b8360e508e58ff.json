{"manifest_version": 3, "name": "Minimal YouTube", "version": "1.5.0", "description": "Clean up YouTube. Toggleable features: black background, dislike count, hide Shorts, Mixes, sidebar clutter and more.", "permissions": ["storage", "tabs"], "host_permissions": ["https://www.youtube.com/*", "https://returnyoutubedislikeapi.com/*", "https://sponsor.ajay.app/*"], "action": {"default_popup": "popup.html", "default_title": "Minimal YouTube", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_start", "css": ["background.css"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "minimal-youtube@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}}