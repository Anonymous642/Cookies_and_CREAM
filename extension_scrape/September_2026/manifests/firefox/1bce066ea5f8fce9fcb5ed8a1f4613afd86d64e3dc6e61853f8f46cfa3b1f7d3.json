{"manifest_version": 3, "name": "CELUS Feedback", "version": "0.6.0", "description": "Report bugs, ideas and feedback on the CELUS platform \u2014 with screenshots and technical context attached automatically.", "permissions": ["activeTab", "tabs", "storage", "scripting"], "host_permissions": ["https://*.celus.io/*", "https://celus.io/*", "https://*.celus.co/*", "https://celus.co/*"], "optional_host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_title": "CELUS Feedback \u2014 report a bug or idea", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "sidebar_action": {"default_panel": "sidepanel/panel.html", "default_title": "CELUS Feedback", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://*.celus.io/*", "https://celus.io/*", "https://*.celus.co/*", "https://celus.co/*"], "js": ["content/content.js"], "run_at": "document_start"}, {"matches": ["https://*.celus.io/*", "https://celus.io/*", "https://*.celus.co/*", "https://celus.co/*"], "js": ["content/page-hook.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "feedback@celus.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteActivity", "websiteContent"], "optional": ["technicalAndInteraction"]}}}}