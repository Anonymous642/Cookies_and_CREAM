{"manifest_version": 3, "name": "Webpage to Markdown & AI Context", "version": "1.0.0", "description": "Turn any webpage into clean Markdown for ChatGPT, Claude, Gemini, and Cursor. Strips ads and nav. Private, local, no account.", "browser_specific_settings": {"gecko": {"id": "clean-context@local", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png"}, "action": {"default_title": "AI Context \u2014 capture this page", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "sidebar_action": {"default_title": "AI Context", "default_panel": "src/sidepanel/sidepanel.html", "default_icon": "icon-32.png"}, "background": {"scripts": ["src/background/service-worker.js"], "type": "module"}, "permissions": ["activeTab", "storage", "scripting", "contextMenus", "clipboardWrite"], "commands": {"capture-page": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Capture page to AI Context"}, "capture-selection": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Capture selection to AI Context"}}}