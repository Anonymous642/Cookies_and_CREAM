{"manifest_version": 3, "name": "nothx", "version": "1.0.1", "description": "Remove unwanted web features \u2014 Shorts, Reels, AI answers, distracting sites.", "permissions": ["storage", "declarativeNetRequest", "declarativeNetRequestFeedback", "alarms", "tabs"], "host_permissions": ["https://www.youtube.com/*", "https://www.instagram.com/*", "https://www.google.com/*", "https://api.polar.sh/*", "https://sandbox-api.polar.sh/*", "https://*/*", "http://*/*"], "background": {"service_worker": "background.js", "scripts": ["config.js", "background.js"]}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content/youtube.js"], "run_at": "document_start"}, {"matches": ["https://www.instagram.com/*"], "js": ["content/instagram.js"], "run_at": "document_start"}, {"matches": ["https://www.google.com/search*", "https://www.google.co.kr/search*"], "js": ["content/google.js"], "run_at": "document_start"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "options/options.html", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "nothx@arrghsoft.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}