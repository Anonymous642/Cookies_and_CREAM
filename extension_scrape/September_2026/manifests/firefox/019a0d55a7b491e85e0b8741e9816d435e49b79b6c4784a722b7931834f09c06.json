{"manifest_version": 3, "name": "Canvas Find&Replace", "version": "1.0.0", "description": "Find and replace text and dates across all Canvas course content in one pass, with preview before applying.", "author": "Osman Sayginer", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting"], "host_permissions": ["*://*.instructure.com/*"], "action": {"default_popup": "popup.html", "default_title": "Canvas Find&Replace", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["*://*.instructure.com/courses/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "canvas-find-replace@local.dev", "data_collection_permissions": {"required": ["none"]}}}}