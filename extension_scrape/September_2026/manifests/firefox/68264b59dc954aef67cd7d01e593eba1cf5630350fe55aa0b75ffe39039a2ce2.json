{"manifest_version": 2, "name": "Ikaros Browser Bridge for Zen", "version": "0.1.0", "description": "Sends explicitly enabled Zen browser summaries to Ikaros through native messaging.", "permissions": ["tabs", "downloads", "storage", "nativeMessaging"], "background": {"scripts": ["background.js"], "persistent": false}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "ikaros-browser-bridge@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": ["browsingActivity"]}}}}