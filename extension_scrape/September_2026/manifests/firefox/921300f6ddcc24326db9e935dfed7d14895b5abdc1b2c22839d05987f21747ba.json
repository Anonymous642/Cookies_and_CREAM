{"manifest_version": 2, "name": "Hidden Tracker Detector", "version": "1.3", "description": "Detect hidden trackers, tracking pixels, and suspicious scripts on webpages. No tracking, no data collection.", "author": "Your Name", "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "permissions": ["tabs", "activeTab"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}], "browser_action": {"default_title": "Hidden Tracker Detector", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "@Hidden-Tracker-Detector", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}