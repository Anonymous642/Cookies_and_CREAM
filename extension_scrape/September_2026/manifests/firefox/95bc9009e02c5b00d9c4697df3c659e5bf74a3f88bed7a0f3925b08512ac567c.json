{"manifest_version": 3, "name": "Mindflare Arena Guard", "short_name": "Arena Guard", "version": "1.1.9", "description": "The official browser client for participating in Mindflare-managed Codeforces contests.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "arena-guard@mindflare.mait.ac.in", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteActivity"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["storage", "idle", "alarms", "tabs", "notifications", "downloads"], "host_permissions": ["https://codeforces.com/*", "https://api.mindflare.tech/*", "https://mindflare.tech/*"], "background": {"scripts": ["dist/background/index.js"], "type": "module"}, "content_scripts": [{"matches": ["https://codeforces.com/*"], "js": ["dist/content/index.js"], "run_at": "document_end"}, {"matches": ["https://codeforces.com/problemset/problem/*", "https://codeforces.com/contest/*/problem/*", "https://codeforces.com/gym/*/problem/*", "https://codeforces.com/group/*/contest/*/problem/*", "https://codeforces.com/problemset/customtest*", "https://codeforces.com/contest/*/customtest*", "https://codeforces.com/gym/*/customtest*", "https://codeforces.com/group/*/customtest*", "https://codeforces.com/customtest*", "https://codeforces.com/problemset/submit*", "https://codeforces.com/contest/*/submit*", "https://codeforces.com/gym/*/submit*", "https://codeforces.com/group/*/contest/*/submit*", "https://codeforces.com/group/*/submit*", "https://codeforces.com/submit*", "https://codeforces.com/contest/*/standings*", "https://codeforces.com/gym/*/standings*", "https://codeforces.com/group/*/contest/*/standings*", "https://codeforces.com/group/*/standings*", "https://codeforces.com/problemset/standings*", "https://codeforces.com/standings*", "https://codeforces.com/contest/*/status*", "https://codeforces.com/contest/*/my*