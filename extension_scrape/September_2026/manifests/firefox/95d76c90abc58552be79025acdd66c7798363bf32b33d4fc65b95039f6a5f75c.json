{"manifest_version": 2, "name": "FlipHTML5 to PDF", "version": "1.0.1", "description": "Save a FlipHTML5 flipbook you're currently viewing as a PDF, page by page.", "browser_specific_settings": {"gecko": {"id": "fliphtml5-to-pdf@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "downloads", "webRequest", "webRequestBlocking", "*://*.fliphtml5.com/*"], "background": {"scripts": ["lib/jspdf.umd.min.js", "background.js"], "persistent": true}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_action": {"default_popup": "popup.html", "default_title": "Download FlipHTML5 as PDF", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}}