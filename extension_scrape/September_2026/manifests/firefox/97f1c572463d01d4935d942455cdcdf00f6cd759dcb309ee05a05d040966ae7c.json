{"manifest_version": 3, "name": "Very Advanced Bookmarks", "version": "1.6", "description": "Search bookmarks and folders with subfolder drill-down. Save bookmarks to any folder fast.", "author": "Nat", "homepage_url": "https://github.com/thegitmate/advanced-firefox-bookmarks", "permissions": ["bookmarks", "tabs"], "browser_specific_settings": {"gecko": {"id": "{6d9e529b-51da-4d92-8698-937f1722abc7}", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "action": {"default_title": "Very Advanced Bookmarks", "default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+B", "mac": "Alt+Shift+B"}, "description": "Open Very Advanced Bookmarks"}}, "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}