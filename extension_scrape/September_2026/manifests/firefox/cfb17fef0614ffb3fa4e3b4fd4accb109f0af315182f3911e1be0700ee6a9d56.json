{"manifest_version": 3, "name": "SongFinder \u2013 Real-Time Synced Lyrics", "version": "1.0.0", "description": "Detect any song playing in your browser and display synced lyrics in real-time. 100% free.", "browser_specific_settings": {"gecko": {"id": "songfinder@yasir.xyz", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["activeTab", "tabs", "storage", "sidePanel", "scripting"], "host_permissions": ["*://*.youtube.com/*", "*://*.music.youtube.com/*", "*://*.spotify.com/*", "*://*.soundcloud.com/*", "*://*.music.apple.com/*", "*://itunes.apple.com/*", "*://*/*"], "background": {"scripts": ["background/service-worker.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/detector.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "side_panel": {"default_path": "sidepanel/panel.html"}, "sidebar_action": {"default_panel": "sidepanel/panel.html", "default_icon": "icons/icon16.png"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}