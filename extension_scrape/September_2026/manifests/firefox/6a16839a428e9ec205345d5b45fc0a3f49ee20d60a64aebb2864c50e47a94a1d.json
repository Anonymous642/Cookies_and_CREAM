{"manifest_version": 2, "name": "ShortNews", "short_name": "ShortNews", "description": "Preview linked news articles on public HTTPS pages before opening them.", "version": "0.4.5", "homepage_url": "https://github.com/goku1248/ShortNews", "browser_specific_settings": {"gecko": {"id": "shortnews-firefox-android@goku1248.github", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"], "optional": ["personalCommunications", "technicalAndInteraction"]}, "strict_min_version": "142.0"}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_action": {"default_title": "ShortNews", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "permissions": ["activeTab", "clipboardWrite", "storage", "tabs", "https://*/*"], "background": {"scripts": ["browser-polyfill.js", "config.js", "site-policy.js", "background.js"], "persistent": false}, "web_accessible_resources": ["icons/shortnews-popup-logo.png"]}