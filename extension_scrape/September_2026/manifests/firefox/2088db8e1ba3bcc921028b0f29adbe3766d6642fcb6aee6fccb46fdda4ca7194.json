{"manifest_version": 3, "name": "Radio Spannenburg Player", "version": "1.0.2", "description": "Speel/pauzeer Radio Spannenburg.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_title": "Radio afspelen"}, "host_permissions": ["https://stream.radiospannenburg.nl/*"], "browser_specific_settings": {"gecko": {"id": "app@radiospannenburg.nl", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "commands": {"toggle-stream": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Radio Spannenburg starten/stoppen"}}}