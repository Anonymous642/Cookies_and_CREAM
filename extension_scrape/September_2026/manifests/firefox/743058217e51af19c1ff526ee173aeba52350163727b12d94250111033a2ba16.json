{"manifest_version": 2, "name": "AMOLED Forcer Pro", "version": "1.0.0", "description": "Force l'AMOLED noir profond sur tous les sites avec mode intelligent et gestion par domaine. Cette extension ne collecte aucune donn\u00e9e personnelle vers des serveurs externes.", "author": "AMOLED Team", "browser_specific_settings": {"gecko": {"id": "amoled-forcer-pro@extension.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "tabs", "storage", "<all_urls>", "webNavigation"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start", "all_frames": true}], "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.svg", "32": "icons/icon-32.svg"}, "default_title": "AMOLED Forcer"}, "icons": {"16": "icons/icon-16.svg", "32": "icons/icon-32.svg", "48": "icons/icon-48.svg", "96": "icons/icon-96.svg"}, "options_ui": {"page": "popup/popup.html", "open_in_tab": false}, "web_accessible_resources": ["styles.css", "icons/*.svg"]}