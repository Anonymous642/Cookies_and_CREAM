{"manifest_version": 3, "name": "Unsplash New Tab", "version": "1.2.1", "description": "Shows a beautiful random Unsplash photo every time you open a new tab, with an option to lock in your favorite.", "chrome_url_overrides": {"newtab": "newtab.html"}, "permissions": ["storage", "alarms"], "background": {"scripts": ["background.js"]}, "host_permissions": ["https://api.unsplash.com/*", "https://images.unsplash.com/*"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "unsplash-newtab@example-extension.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}}