{"manifest_version": 3, "version": "1.9.92.1", "author": "Javad Motallebi", "description": "Sends Download Links to Neat Download Manager (with per-site block)", "name": "NeatDownloadManager Extension (Block)", "browser_specific_settings": {"gecko": {"id": "ndm-block@neatdownloadmanager.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_icon": {"16": "img/icon16.png"}}, "background": {"scripts": ["bg.js"]}, "content_scripts": [{"js": ["ct.js"], "matches": ["http://*/*", "https://*/*"], "all_frames": true, "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["img/icon16.png", "img/icon16_2x.png", "img/close16.png", "img/close16_2x.png"], "matches": ["<all_urls>"]}], "permissions": ["webRequest", "webRequestBlocking", "webNavigation", "cookies", "contextMenus", "storage", "downloads"], "host_permissions": ["<all_urls>"], "icons": {"16": "img/icon16.png", "48": "img/icon48.png", "128": "img/icon128.png"}, "homepage_url": "https://www.neatdownloadmanager.com/", "options_ui": {"page": "options.html", "open_in_tab": false}}