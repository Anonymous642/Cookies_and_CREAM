{"manifest_version": 3, "name": "NebulaLock", "version": "1.0", "description": "Lock tabs with cosmic nebula and password", "icons": {"64": "icon.png"}, "action": {"default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["activeTab", "scripting", "storage", "alarms"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "nebulalock@unique.com", "data_collection_permissions": {"required": ["none"]}}}}