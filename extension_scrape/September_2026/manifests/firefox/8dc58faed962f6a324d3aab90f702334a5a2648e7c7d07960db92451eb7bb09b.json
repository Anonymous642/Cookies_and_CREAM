{"manifest_version": 3, "name": "Word Counter for Web Pages", "version": "1.0", "description": "Easily count the number of words on the current web page.", "permissions": ["activeTab", "scripting"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "wordcounter@example.com", "strict_min_version": "109.0"}}}