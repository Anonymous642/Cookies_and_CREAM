{"manifest_version": 2, "name": "zOOmX - custom zoom manager", "version": "1.0.2", "description": "Precise zoom control per URL with 1% increments, custom settings, and lock feature.", "permissions": ["tabs", "storage", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icon_48_color.png"}}, "options_ui": {"page": "settings.html", "open_in_tab": true}, "icons": {"48": "icon_48_color.png", "96": "icon_96_color.png"}, "browser_specific_settings": {"gecko": {"id": "@zOOmX-custom-zoom-manager", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}