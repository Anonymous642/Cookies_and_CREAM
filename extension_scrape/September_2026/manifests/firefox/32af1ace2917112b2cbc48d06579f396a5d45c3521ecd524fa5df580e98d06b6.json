{"manifest_version": 2, "name": "Ferna Tabs", "version": "1.8.0", "description": "Ferna Tabs pops up your open tabs right where the mouse pointer is: switch, close, pin, open bookmarks or type an address.", "author": "TGI Fernando", "browser_specific_settings": {"gecko": {"id": "tab-list-at-pointer@tgifernando", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["tabs", "bookmarks", "menus", "search", "storage", "<all_urls>"], "background": {"scripts": ["common.js", "background.js"], "persistent": true}, "browser_action": {"default_title": "Ferna Tabs", "default_popup": "list.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "commands": {"show-tab-list": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Show the tab list at the mouse pointer"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["pointer.js"], "run_at": "document_start", "all_frames": true}, {"matches": ["<all_urls>"], "js": ["common.js", "ui.js", "content.js"], "run_at": "document_start", "all_frames": false}], "options_ui": {"page": "options.html", "open_in_tab": true}}