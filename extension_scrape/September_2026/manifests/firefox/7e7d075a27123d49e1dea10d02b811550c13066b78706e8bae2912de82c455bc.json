{"manifest_version": 3, "name": "Nimblist Recipe Capture", "version": "1.2.0", "description": "Capture recipes from any website and save them directly to Nimblist", "browser_specific_settings": {"gecko": {"id": "recipe-capture@nimblist.app", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}}, "permissions": ["activeTab", "identity", "scripting", "storage"], "host_permissions": ["https://nimblist.app/*"], "background": {"scripts": ["background/background.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "Nimblist Recipe Capture"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}