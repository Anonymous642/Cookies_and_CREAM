{"manifest_version": 2, "name": "SnapAnnotate", "version": "0.1.0", "description": "Capture, annotate, and share screenshots instantly. No uploads unless you want them.", "permissions": ["activeTab", "storage", "tabs"], "background": {"scripts": ["background.js"]}, "content_scripts": [], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"capture-screenshot": {"suggested_key": {"default": "Ctrl+Shift+4", "mac": "Ctrl+Shift+4"}, "description": "Capture a screenshot region"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "snapannotate@yourdomain.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}