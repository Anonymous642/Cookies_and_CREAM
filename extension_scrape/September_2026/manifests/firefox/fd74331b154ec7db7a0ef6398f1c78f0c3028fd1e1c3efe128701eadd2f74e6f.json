{"manifest_version": 3, "name": "CacheTray - Smart Clipboard Manager", "description": "Auto-save copied links, images, code, tasks, and notes into a tray. Workspaces, bulk share, capture toggle, and keyboard shortcut.", "version": "1.2.0", "browser_specific_settings": {"gecko": {"id": "cachetray@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "CacheTray", "default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "permissions": ["storage", "contextMenus", "activeTab", "scripting", "clipboardRead", "clipboardWrite"], "optional_host_permissions": ["https://*/*", "http://*/*"], "web_accessible_resources": [{"resources": ["injected.js"], "matches": ["https://*/*", "http://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open Quick Notes Drop"}}}