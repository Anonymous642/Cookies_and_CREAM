{"manifest_version": 3, "name": "DirectYtDownloader", "version": "1.0.0", "description": "Download YouTube videos in any quality. Paste a link, pick quality, download instantly \u2014 no ads, no sign-up.", "browser_specific_settings": {"gecko": {"id": "directytdownloader@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "default_title": "DirectYtDownloader"}, "background": {"scripts": ["background/service-worker.js"]}, "permissions": ["downloads", "contextMenus", "activeTab"], "host_permissions": ["https://directytdownloader.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}