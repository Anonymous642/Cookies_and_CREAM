{"manifest_version": 3, "name": "Roblox Logo Changer", "version": "1.2", "description": "Replaces the Roblox logo with a custom image.", "permissions": ["storage"], "content_scripts": [{"matches": ["https://*.roblox.com/*"], "js": ["content.js"]}], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "logo-changer@example.com"}}}