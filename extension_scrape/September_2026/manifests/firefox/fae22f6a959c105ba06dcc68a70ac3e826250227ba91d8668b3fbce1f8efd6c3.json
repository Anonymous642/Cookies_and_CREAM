{"manifest_version": 3, "name": "Venus Medical Data Extractor", "version": "1.2.0", "description": "Professional medical data extractor for Venus software. Automatically calculates appointment end times based on examination types. Compatible with hospital management systems.", "author": "Votre Organisation", "homepage_url": "https://github.com/votre-org/venus-extractor", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "storage", "downloads"], "host_permissions": ["https://*.venus-medical.fr/*", "https://*/*/*venus*", "https://*/*/*liste_de_travail*", "https://*/*/*planning*", "<all_urls>"], "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["https://*.venus-medical.fr/*", "https://*/*/*venus*", "https://*/*/*liste_de_travail*", "https://*/*/*planning*"], "js": ["utils/exam-duration-mapper.js", "content/content.js"], "css": ["content/venus-overlay.css"], "run_at": "document_end"}], "action": {"default_popup": "popup/popup.html", "default_title": "Venus Medical Data Extractor", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["icons/*", "utils/*"], "matches": ["https://*/*", "<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "venus-extractor@votre-org.com", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["none"]}}}}