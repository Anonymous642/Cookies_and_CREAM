{"manifest_version": 2, "name": "YouTube Lyrics Viewer", "version": "1.0.1", "description": "Shows the lyrics of the song you're currently watching on YouTube in a floating panel.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "permissions": ["storage", "https://api.lyrics.ovh/*", "*://www.youtube.com/*", "*://music.youtube.com/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "default_title": "Toggle YouTube Lyrics panel"}, "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://music.youtube.com/*"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "yt-lyrics-viewer@local.extension", "strict_min_version": "78.0", "data_collection_permissions": {"required": ["none"]}}}}