{"manifest_version": 3, "name": "z.WebKeyBind", "version": "1.0.3", "description": "Use Custom Shortcut key to Trigger the button of the page. ", "permissions": ["storage", "activeTab", "scripting", "tabs", "notifications"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "index.html", "default_title": "z.WebKeyBind Settings"}, "browser_specific_settings": {"gecko": {"id": "z-webkeybind@yourdomain.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["language.js", "content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["index.html", "style.css", "popup.js", "language.js", "import_export.js"], "matches": ["<all_urls>"]}], "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+Z", "mac": "Alt+Shift+Z"}, "description": "Open WebKeyBind Settings"}}}