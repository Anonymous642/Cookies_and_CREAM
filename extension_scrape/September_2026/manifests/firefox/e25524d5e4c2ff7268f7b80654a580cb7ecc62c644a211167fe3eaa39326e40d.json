{"manifest_version": 2, "name": "OmniTranslate", "description": "Companion extension for OmniTranslate's web translator.", "version": "0.1.14", "icons": {"16": "icon-16.png", "24": "icon-24.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}, "permissions": ["tabs", "scripting", "activeTab", "storage", "declarativeNetRequest", "https://*/*", "http://*/*", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "omni@omni.app", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "developer": {"name": "Omni", "url": "https://readomni.com"}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "OmniTranslate", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-scripts/content.js"]}]}