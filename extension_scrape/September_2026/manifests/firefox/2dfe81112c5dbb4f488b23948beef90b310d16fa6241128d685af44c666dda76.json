{"manifest_version": 3, "name": "Bingy", "description": "Intelligent bilingual subtitles for language learning on Netflix and YouTube.", "version": "1.4.2", "icons": {"128": "ic-128.png"}, "permissions": ["storage", "activeTab", "webRequest"], "host_permissions": ["*://www.netflix.com/*", "*://www.youtube.com/*", "https://*.youtube.com/*", "https://staging-subly-extension.vercel.app/*", "https://www.bingy.cc/*"], "action": {"default_title": "Bingy - Smart Subtitles"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.netflix.com/*", "*://www.youtube.com/*", "https://*.youtube.com/*"], "js": ["content-script.js"], "run_at": "document_end"}, {"matches": ["*://www.netflix.com/*", "*://www.youtube.com/*", "https://*.youtube.com/*"], "js": ["page-script.js"], "run_at": "document_end", "world": "MAIN"}, {"matches": ["https://staging-subly-extension.vercel.app/*", "https://www.bingy.cc/*"], "js": ["webapp-bridge.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["page-script.js"], "matches": ["*://www.netflix.com/*", "*://www.youtube.com/*", "https://*.youtube.com/*"]}], "browser_specific_settings": {"gecko": {"id": "bingy@bingy.cc", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"], "optional": ["technicalAndInteraction"]}}}}