{"manifest_version": 3, "name": "Web No AI", "version": "1.0.2", "description": "Ajoute automatiquement -ai aux recherches Google pour desactiver les resumes generes par IA.", "permissions": ["declarativeNetRequest"], "host_permissions": ["https://www.google.com/*", "https://google.com/*"], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "browser_specific_settings": {"gecko": {"id": "google-no-ai@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/web-no-ai-16.png", "48": "icons/web-no-ai-48.png", "96": "icons/web-no-ai-96.png"}}