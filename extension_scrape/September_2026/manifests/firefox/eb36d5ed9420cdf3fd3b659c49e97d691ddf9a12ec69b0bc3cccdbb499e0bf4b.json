{"manifest_version": 3, "name": "Scanix URL Safety", "version": "6.0.8", "description": "Browser security and privacy protection with URL intelligence and threat detection.", "browser_specific_settings": {"gecko": {"id": "scanix-safety@diana.com", "data_collection_permissions": {"required": ["browsingActivity"]}, "strict_min_version": "142.0"}}, "permissions": ["activeTab", "storage", "webNavigation", "notifications", "tabs", "contextMenus", "scripting", "downloads", "webRequest"], "host_permissions": ["https://safebrowsing.googleapis.com/*", "https://dns.google/*", "https://ipqualityscore.com/*", "<all_urls>"], "background": {"scripts": ["config.js", "i18n.js", "background.js"], "persistent": false}, "action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/neutral.png"}}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "icons": {"48": "icons/neutral.png"}}