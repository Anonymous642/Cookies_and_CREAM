{"manifest_version": 2, "name": "bcEvernote", "version": "1.1.0", "description": "Quickly save current web page to Evernote via Email. Direct and simple.", "author": "Antigravity", "permissions": ["storage", "activeTab", "notifications", "clipboardWrite"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "default_title": "Save to Evernote"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "bcenote@evernote-quick-save.addon", "strict_min_version": "79.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}