{"manifest_version": 2, "name": "NewTab Studio", "version": "0.1.6", "description": "Custom Firefox new tab and home page dashboard with floating widgets, wallpapers, RSS, weather, and glass effects.", "browser_specific_settings": {"gecko": {"id": "@newtab-studio", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["searchTerms", "locationInfo"]}}}, "icons": {"48": "addon-icon.svg", "96": "addon-icon.svg"}, "permissions": ["storage", "unlimitedStorage", "notifications", "geolocation", "*://*/*"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Add current tab to Quick Links", "default_icon": {"32": "addon-icon.svg"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "chrome_url_overrides": {"newtab": "newtab.html"}, "chrome_settings_overrides": {"homepage": "newtab.html"}, "web_accessible_resources": ["assets/*", "wallpapers/*", "icons/*", "fonts/*"]}