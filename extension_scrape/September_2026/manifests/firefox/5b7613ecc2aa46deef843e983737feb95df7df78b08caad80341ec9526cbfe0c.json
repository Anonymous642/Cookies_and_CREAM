{"manifest_version": 3, "name": "Personal Link Curator", "version": "0.5.0", "description": "Local-first recommender that scans links on the current page, starts randomly with an empty profile, and learns from your feedback.", "icons": {"48": "assets/icons/icon-48.png", "96": "assets/icons/icon-96.png", "128": "assets/icons/icon-128.png"}, "action": {"default_title": "Personal Link Curator", "default_popup": "src/popup/popup.html", "default_icon": {"48": "assets/icons/icon-48.png", "96": "assets/icons/icon-96.png"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "permissions": ["activeTab", "scripting", "storage"], "browser_specific_settings": {"gecko": {"id": "personal-link-curator@local-first.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}