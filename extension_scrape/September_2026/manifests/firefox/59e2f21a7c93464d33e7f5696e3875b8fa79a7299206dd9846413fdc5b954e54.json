{"manifest_version": 3, "name": "Tab Suspender", "version": "15.2.7", "description": "Suspend les onglets inactifs pour lib\u00e9rer la m\u00e9moire. Garde le logo du site et la position des vid\u00e9os. Z\u00e9ro donn\u00e9e collect\u00e9e.", "permissions": ["tabs", "storage", "alarms", "scripting", "contextMenus", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["compat.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"suspend-tab": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Suspendre / restaurer l'onglet actif"}, "suspend-all": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Suspendre tous les autres onglets"}}, "web_accessible_resources": [{"resources": ["suspended.html"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "tab-suspender@anthoprivacy", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "options_ui": {"page": "options.html", "open_in_tab": true}}