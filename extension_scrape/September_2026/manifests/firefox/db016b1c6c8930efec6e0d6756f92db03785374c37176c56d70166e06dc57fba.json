{"manifest_version": 3, "name": "100KB Photo & PDF Compressor", "version": "1.1.1", "description": "Compress images & PDFs to 20KB, 50KB, 100KB, or 200KB instantly. 100% private, free, and fast browser-based compression.", "browser_specific_settings": {"gecko": {"id": "compressor@100kb.in", "strict_min_version": "109.0"}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage"], "web_accessible_resources": [{"resources": ["icon16.png", "icon48.png", "icon128.png"], "matches": ["*://*.google.com/*", "*://*.google.co.in/*", "*://*.google.co.uk/*", "*://*.google.ca/*", "*://*.google.com.au/*", "*://*.google.de/*", "*://*.google.fr/*", "*://*.google.es/*", "*://*.google.pt/*", "*://*.google.co.jp/*", "*://*.google.ru/*", "*://*.google.com.br/*", "*://*.google.it/*", "*://*.google.nl/*", "*://*.google.co.id/*"]}], "content_scripts": [{"matches": ["https://*.google.com/search*", "https://*.google.co.in/search*", "https://*.google.co.uk/search*", "https://*.google.ca/search*", "https://*.google.com.au/search*", "https://*.google.de/search*", "https://*.google.fr/search*", "https://*.google.es/search*", "https://*.google.pt/search*", "https://*.google.co.jp/search*", "https://*.google.ru/search*", "https://*.google.com.br/search*", "https://*.google.it/search*", "https://*.google.nl/search*", "https://*.google.co.id/search*"], "js": ["content_script.js"], "css": ["content_script.css"], "run_at": "document_idle"}]}