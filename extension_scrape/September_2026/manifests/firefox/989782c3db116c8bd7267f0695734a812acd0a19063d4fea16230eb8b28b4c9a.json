{"manifest_version": 3, "name": "Quick Reads", "version": "1.1.1", "description": "Save articles to your Quick Reads queue with one click", "permissions": ["storage", "activeTab", "contextMenus", "notifications", "scripting"], "host_permissions": ["https://quickreads.app/*"], "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Save to Quick Reads"}, "options_ui": {"page": "settings/settings.html", "open_in_tab": true}, "background": {"scripts": ["save-helpers.js", "background.js"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"save-current-page": {"suggested_key": {"default": "Alt+R", "mac": "Alt+R"}, "description": "Save current page to Quick Reads"}}, "browser_specific_settings": {"gecko": {"id": "quick-reads@quickreads.app", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent", "browsingActivity"]}}}}