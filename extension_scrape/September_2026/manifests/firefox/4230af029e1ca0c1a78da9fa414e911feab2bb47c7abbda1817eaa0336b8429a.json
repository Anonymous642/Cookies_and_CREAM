{"manifest_version": 3, "name": "Round Robin Tab", "version": "1.1.0", "description": "Cycles through your browser tabs and refreshes each one on a timer. Great for dashboards and monitoring screens.", "homepage_url": "https://github.com/esdy/tab-cycler", "permissions": ["tabs", "alarms", "storage"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_title": "Round Robin Tab", "default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png"}}, "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "browser_specific_settings": {"gecko": {"id": "round-robin-tab@dwanjala.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}