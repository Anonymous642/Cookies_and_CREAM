{"manifest_version": 2, "name": "Frontend Scraper", "version": "1.0.0", "description": "Scrape any page's frontend code and download it as a structured ZIP archive.", "author": "Frontend Scraper", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "tabs", "downloads", "<all_urls>"], "background": {"scripts": ["lib/fflate.umd.js", "background/background.js"], "persistent": true}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/content.js"], "run_at": "document_idle", "all_frames": false}], "browser_specific_settings": {"gecko": {"id": "frontend-scraper@extension", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}