{"manifest_version": 3, "name": "xHamster Subscription Manager", "version": "0.1.1", "description": "Filter out Moments and Watched Videos from My Subscriptions on xHamster and set a minimum video length. Allows the page to auto-fill with videos.", "browser_specific_settings": {"gecko": {"id": "xHSM@spacegoblins", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"512": "icons/xhsm-icon.png"}, "permissions": ["storage"], "options_ui": {"page": "src/options/options.html"}, "content_scripts": [{"matches": ["*://*.xhamster.com/my/subscriptions*"], "css": ["src/content/styles.css"], "js": ["src/config.js", "src/content/payload.js", "src/content/card.js", "src/content/backfill.js", "src/content/content.js"], "run_at": "document_start"}]}