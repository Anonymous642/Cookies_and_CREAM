{"manifest_version": 3, "name": "WordToDeck", "version": "0.2.15", "description": "Turn words from any webpage into visual Anki flashcards in one click.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "contextMenus", "activeTab"], "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*", "http://localhost:3000/*", "https://api.dictionaryapi.dev/*", "https://api.datamuse.com/*", "https://commons.wikimedia.org/*", "https://upload.wikimedia.org/*", "https://translate.google.com/*", "https://www.wordtodeck.ink/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html"}, "commands": {"capture-word-ocr": {"suggested_key": {"default": "Alt+Shift+O"}, "description": "Capture a word from the page with OCR"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "extension@wordtodeck.ink", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}