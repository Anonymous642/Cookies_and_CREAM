{"manifest_version": 3, "name": "Meli Direct Link Cleaner", "version": "1.3.0", "description": "Limpia y resuelve enlaces de Mercado Libre en Chrome, Firefox y navegadores compatibles.", "permissions": ["webNavigation", "tabs", "clipboardWrite"], "host_permissions": ["https://meli.la/*", "https://mercadolibre.com.ar/*", "https://*.mercadolibre.com.ar/*", "https://mercadolibre.com/*", "https://*.mercadolibre.com/*"], "background": {"scripts": ["cleaner.js", "background.js"]}, "action": {"default_title": "Limpiar link de Mercado Libre", "default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "meli-direct-link-cleaner@psboxxx.github.io", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}