{"manifest_version": 2, "name": "Emoji Sprinkler", "version": "2.2.1.4", "description": "Give web pages a cheerful upgrade by sprinkling relevant emoji after keywords such as pizza, music, star and more. Dial the amount up or down with a slider and revert to the original whenever you like.", "icons": {"32": "assets/icon-32.png", "48": "assets/icon-48.png", "64": "assets/icon-64.png", "96": "assets/icon-96.png", "128": "assets/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{9c500eb5-1e38-467a-a2c3-692da0397cb8}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab"], "browser_action": {"default_title": "Emoji Sprinkler", "default_popup": "app/popup.html", "default_icon": {"32": "assets/icon-32.png", "48": "assets/icon-48.png", "64": "assets/icon-64.png"}}}