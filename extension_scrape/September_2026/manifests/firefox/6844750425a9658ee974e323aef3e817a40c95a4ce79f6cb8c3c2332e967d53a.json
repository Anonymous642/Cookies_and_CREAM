{"manifest_version": 3, "name": "FreeTTS \u2014 Free Text to Speech", "version": "1.5.3", "description": "Read any web page aloud with 400+ AI voices. AI Summary, Theatre Mode, listen queue, HD voices, background play.", "homepage_url": "https://freetts.org", "browser_specific_settings": {"gecko": {"id": "freetts@freetts.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["contextMenus", "storage", "downloads", "scripting", "activeTab"], "host_permissions": ["https://freetts.org/*"], "content_scripts": [{"matches": ["https://freetts.org/*"], "js": ["auth-bridge.js"], "run_at": "document_idle"}], "background": {"scripts": ["shared.js", "sentry-init.js", "background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' https://freetts.org https://o4511343445344256.ingest.de.sentry.io; media-src 'self' https://freetts.org blob:; img-src 'self' https://cdn.jsdelivr.net data:"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "commands": {"read-selection": {"suggested_key": {"default": "Alt+Shift+S", "mac": "MacCtrl+Shift+S"}, "description": "Read selected text aloud"}, "read-page": {"suggested_key": {"default": "Alt+Shift+R", "mac": "MacCtrl+Shift+R"}, "description": "Read this page aloud"}}}