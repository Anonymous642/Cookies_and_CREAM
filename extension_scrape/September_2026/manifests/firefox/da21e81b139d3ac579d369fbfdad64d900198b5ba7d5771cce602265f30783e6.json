{"manifest_version": 3, "name": "Save to Kodokyo", "version": "1.0.0", "description": "Save any webpage, email, or content to your Kodokyo project", "browser_specific_settings": {"gecko": {"id": "extension@kodokyo.ai", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent", "personallyIdentifyingInfo"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["contextMenus", "activeTab", "storage"], "host_permissions": ["https://kodokyo.ai/*", "https://*.kodokyo.ai/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}