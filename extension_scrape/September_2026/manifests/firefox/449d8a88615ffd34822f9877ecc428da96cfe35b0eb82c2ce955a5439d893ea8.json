{"manifest_version": 2, "name": "ZeroAnuncios Youtube", "version": "1.0.2", "description": "Pula propagandas do YouTube automaticamente em milissegundos \u2014 Edi\u00e7\u00e3o Android \ud83e\udd77", "author": "Araken Carmo Neto", "browser_specific_settings": {"gecko": {"id": "zeromark-youtube@android", "strict_min_version": "113.0"}}, "permissions": ["activeTab", "storage", "*://*.youtube.com/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "browser_action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "default_popup": "src/popup.html", "default_title": "ZeroAnuncios Youtube"}, "background": {"scripts": ["src/background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["src/content.js"], "run_at": "document_start", "all_frames": true}]}