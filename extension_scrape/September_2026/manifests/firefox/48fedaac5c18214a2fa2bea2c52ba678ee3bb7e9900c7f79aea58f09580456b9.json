{"manifest_version": 3, "name": "Genealogy Site Helper", "version": "0.1.0", "description": "Side-panel helper for citing web pages as FamilySearch sources. No API key required.", "homepage_url": "https://github.com/kelsjon3/genealogy-site-helper", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "genealogy-site-helper@kelsjon3", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs"], "host_permissions": ["*://www.familysearch.org/*/tree/person/*"], "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_title": "Genealogy Helper", "default_panel": "sidebar/sidebar.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "content_scripts": [{"matches": ["*://www.familysearch.org/*/tree/person/*"], "js": ["content/familysearch.js", "content/fs-autofill.js"], "run_at": "document_idle"}]}