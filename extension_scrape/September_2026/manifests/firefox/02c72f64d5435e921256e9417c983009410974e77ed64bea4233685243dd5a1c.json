{"manifest_version": 3, "name": "Navio", "version": "1.0", "description": "Fully Automate Sales Navigator Reachouts with Navio", "permissions": ["scripting", "activeTab", "storage"], "host_permissions": ["*://*.linkedin.com/*", "https://script.google.com/*", "https://api.ipify.org/*"], "background": {"scripts": ["background.js"], "persistent": false}, "action": {"default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "default_title": "LinkedIn Bot"}, "content_scripts": [{"matches": ["*://*.linkedin.com/*"], "js": ["botLogic.js"]}], "web_accessible_resources": [{"resources": ["icon.png"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "navio-bot@pacecode.in", "strict_min_version": "109.0"}}}