{"manifest_version": 2, "name": "Ward", "description": "Vision denied. Spoilers concealed. Browse the web without accidentally discovering who won before you've watched the game.", "version": "0.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"]}, "id": "ward@dahrte.me"}}, "permissions": ["storage"], "browser_action": {"default_title": "Ward", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "run_at": "document_start", "js": ["content-scripts/youtube.js"]}]}