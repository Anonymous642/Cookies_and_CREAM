{"manifest_version": 2, "name": "Thought Loop Breaker", "version": "1.3", "description": "Detects repetitive browsing behavior and helps interrupt unhealthy thought loops.", "permissions": ["tabs", "storage", "notifications", "activeTab"], "browser_action": {"default_title": "Thought Loop Breaker", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Thought-Loop-Breaker", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}