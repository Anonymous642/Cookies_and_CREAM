{"manifest_version": 3, "name": "BargainifyAI - Smart Deal Finder", "version": "1.0", "description": "Automatically scans for the cheapest price across the internet whenever you view a product online.", "action": {"default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "permissions": ["activeTab", "storage"], "host_permissions": ["*://*/*"], "browser_specific_settings": {"gecko": {"id": "admin@bargainifyai.shop", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}