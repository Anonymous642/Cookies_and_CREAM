{"manifest_version": 2, "name": "TOKP - The Only Known Photograph", "version": "1.0.0", "description": "Replaces images on web pages with one image for giggles.", "permissions": ["storage", "<all_urls>"], "browser_action": {"default_popup": "settings.html", "default_title": "TOKP"}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "web_accessible_resources": ["assets/tokp.png", "assets/tokp-icon.png"], "browser_specific_settings": {"gecko": {"id": "tokp@tokp-extension", "strict_min_version": "142.0", "strict_min_version_android": "142.0", "data_collection_permissions": {"required": ["none"]}}}}