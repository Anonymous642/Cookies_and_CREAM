{"manifest_version": 3, "name": "YouTube Shorts Volume Control", "version": "1.1.0", "description": "Control volume on YouTube Shorts using Shift + Mouse Wheel.", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "shorts-volume-controller@your-email.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}]}