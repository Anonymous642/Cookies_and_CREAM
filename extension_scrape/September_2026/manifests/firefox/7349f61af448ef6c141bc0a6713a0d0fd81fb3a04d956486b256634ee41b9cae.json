{"manifest_version": 3, "name": "Kick $boss Dashboard", "version": "0.1.0", "description": "Comfort dashboard for the Chimera $boss chat game on Kick.", "browser_specific_settings": {"gecko": {"id": "kick-boss-dashboard@local", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs", "scripting"], "host_permissions": ["https://*.kick.com/*"], "action": {"default_title": "Kick $boss Dashboard", "default_popup": "src/popup.html"}, "background": {"scripts": ["src/background.js"]}, "web_accessible_resources": [{"resources": ["src/injected.js"], "matches": ["https://kick.com/*"]}], "content_scripts": [{"matches": ["https://kick.com/*"], "run_at": "document_start", "js": ["src/logic.js", "src/storage.js", "src/content.js"]}]}