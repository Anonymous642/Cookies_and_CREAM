{"manifest_version": 3, "name": "SW4.org Compatibility Layer", "version": "3.0.12", "description": "SW4.org layer to export marks to NOOR and import students data from Madrasati", "permissions": ["activeTab", "storage"], "host_permissions": ["*://sw4.org/*"], "browser_specific_settings": {"gecko": {"id": "complayer@sw4.org"}}, "action": {"default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["*://noor.moe.gov.sa/*", "*://sw4.org/*", "*://schools.madrasati.sa/*"], "js": ["content.js"]}]}