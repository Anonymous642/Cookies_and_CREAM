{"manifest_version": 3, "name": "Murl.gg - Short Links", "short_name": "Murl", "description": "Create QR codes, shorten links, and track scan and click statistics. A simple and convenient tool for managing your links.", "version": "1.0.0", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://murl.gg/*", "https://dev.murl.gg/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}], "permissions": ["activeTab", "tabs", "identity", "scripting"], "host_permissions": ["https://api.murl.gg/*", "https://murl.gg/*", "https://dev.murl.gg/*", "https://accounts.google.com/*"], "browser_specific_settings": {"gecko": {"id": "murl-gg@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}