{"manifest_version": 2, "name": "Ayuta - Your Knowledge Universe", "version": "1.0.1", "description": "Save articles, videos, and links to your Ayuta collection. Your knowledge universe awaits.", "permissions": ["activeTab", "storage", "contextMenus", "notifications", "alarms", "https://*.firebaseapp.com/*", "https://*.googleapis.com/*", "https://app.ayuta.me/*"], "content_scripts": [{"matches": ["https://app.ayuta.me/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "commands": {"save-article": {"suggested_key": {"default": "Alt+Shift+S", "mac": "MacCtrl+Shift+S"}, "description": "Save current page to Ayuta"}, "_execute_browser_action": {"suggested_key": {"default": "Alt+Shift+R", "mac": "MacCtrl+Shift+R"}, "description": "Open Ayuta popup"}}, "browser_specific_settings": {"gecko": {"id": "ayuta@ayuta.me", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteActivity"], "optional": ["technicalAndInteraction"]}}}}