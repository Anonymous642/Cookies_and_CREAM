{"manifest_version": 3, "name": "Zoom Sesame", "version": "1.0.0", "description": "Remember Zoom recording passcodes and auto-fill them when you open a recording link.", "browser_specific_settings": {"gecko": {"id": "zoom-sesame.hoosinyong@gmail.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Zoom Sesame", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"service_worker": "src/background/service-worker.js", "scripts": ["src/background/service-worker.js"], "type": "module"}, "content_scripts": [{"matches": ["*://*.zoom.us/rec/*", "*://*.zoom.us/recording/*"], "js": ["src/content/content.js"], "css": ["src/content/content.css"], "run_at": "document_idle"}], "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.zoom.us/*"]}