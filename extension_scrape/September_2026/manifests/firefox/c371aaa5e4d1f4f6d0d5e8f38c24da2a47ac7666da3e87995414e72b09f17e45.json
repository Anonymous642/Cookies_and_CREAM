{"manifest_version": 3, "name": "Zen Pause", "version": "0.1.3", "description": "Pause before you watch. Blocks YouTube videos behind a 60 second wait.", "browser_specific_settings": {"gecko": {"id": "zen-pause@patricio", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "webNavigation", "webRequest", "webRequestBlocking", "tabs", "alarms"], "host_permissions": ["*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/watch*"], "js": ["src/content/watch-position.js"], "run_at": "document_idle", "all_frames": false}], "background": {"scripts": ["src/background/index.js"], "type": "module"}, "web_accessible_resources": [{"resources": ["src/pages/block/block.html"], "matches": ["<all_urls>"]}], "icons": {"48": "assets/icons/icon.svg", "96": "assets/icons/icon.svg"}}