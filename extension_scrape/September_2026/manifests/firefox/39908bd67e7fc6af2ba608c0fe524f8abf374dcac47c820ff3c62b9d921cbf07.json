{"name": "Map Data Exporter", "version": "1.0.5", "manifest_version": 2, "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "browser_specific_settings": {"gecko": {"id": "map-data-exporter@yourdomain.com", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "browsingActivity"]}}}, "browser_action": {"default_popup": "src/index.html"}, "background": {"scripts": ["src/background.js"]}, "permissions": ["cookies", "storage", "tabs", "identity", "activeTab", "https://www.google.com/maps/*", "https://google.com/maps/*", "https://maps.google.com/*", "<all_urls>"], "content_scripts": [{"matches": ["https://www.google.com/maps/*", "https://google.com/maps/*", "https://maps.google.com/*"], "js": ["src/_lib/Scraper.js"]}], "content_security_policy": "script-src 'self'; object-src 'self';"}