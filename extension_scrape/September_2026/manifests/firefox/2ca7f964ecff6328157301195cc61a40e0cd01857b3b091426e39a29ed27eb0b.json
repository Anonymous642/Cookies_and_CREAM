{"manifest_version": 2, "name": "MP3 Catcher", "version": "1.0.0", "description": "Detecte les fichiers audio (mp3, m4a, ogg, wav, flac...) d'une page et les envoie a MP3 Catcher.", "browser_specific_settings": {"gecko": {"id": "mp3catcher@bebou.local", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["webRequest", "tabs", "storage", "notifications", "<all_urls>", "http://127.0.0.1/*"], "background": {"scripts": ["background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "browser_action": {"default_title": "MP3 Catcher", "default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}}