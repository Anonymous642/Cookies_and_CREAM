{"manifest_version": 3, "name": "A11yInspect Accessibility Testing Tool", "version": "1.7.0", "description": "Your fastest path from accessibility issues to clean, shippable code. Test for WCAG, EN 301 549, and more.", "action": {"default_title": "A11yInspect Accessibility Testing Tool", "default_popup": "src/popup/index.html"}, "icons": {"16": "favicon.png", "32": "favicon.png", "48": "favicon.png", "128": "favicon.png"}, "host_permissions": ["http://*/*", "https://*/*", "file:///*", "<all_urls>"], "permissions": ["scripting", "tabs", "activeTab", "downloads"], "devtools_page": "src/devtools/devtools.html", "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "support@barrierbreak.net"}}, "content_scripts": [{"js": ["contentScript.js"], "matches": ["http://*/*", "https://*/*", "file:///*", "<all_urls>"]}], "web_accessible_resources": [{"resources": ["src/devtools/index.html", "assets/*", "scally.js", "*.ttf", "*.woff2"], "matches": ["http://*/*", "https://*/*", "file:///*", "<all_urls>"]}]}