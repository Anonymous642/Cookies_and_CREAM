{"manifest_version": 3, "name": "MyVidster Video Bookmark", "version": "1.0.1", "description": "Bookmark the video on the current website to your MyVidster collection.", "icons": {"16": "icons/myvidster.svg", "32": "icons/myvidster.svg", "48": "icons/myvidster.svg", "96": "icons/myvidster.svg"}, "permissions": ["activeTab"], "action": {"default_area": "navbar", "default_title": "Bookmark this video on MyVidster", "default_icon": {"16": "icons/myvidster.svg", "32": "icons/myvidster.svg"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "video-bookmark@myvidster.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["websiteActivity"]}}}}