{"manifest_version": 3, "name": "veepick", "version": "2.1.3", "description": "Dodawaj produkty z ka\u017cdego sklepu internetowego do list zakupowych w veedeck \u2014 bez kopiowania, wklejania i prze\u0142\u0105czania zak\u0142adek.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Veepick"}, "permissions": ["storage", "activeTab", "scripting", "contextMenus"], "host_permissions": ["https://veedeck.vercel.app/*", "https://app.veedeck.com/*"], "background": {"scripts": ["background.js"]}, "web_accessible_resources": [{"resources": ["icons/*.png", "privacy-policy.html", "privacy-policy.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "veepick@veedeck.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}