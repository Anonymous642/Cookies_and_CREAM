{"manifest_version": 3, "name": "ChatLasso", "version": "2.5.1", "description": "Capture and export AI responses from ChatGPT, Claude, Gemini, Mistral, Perplexity, DeepSeek, Grok, NotebookLM, and Copilot", "permissions": ["activeTab", "scripting", "storage", "sidePanel"], "side_panel": {"default_path": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "chatlasso@intisor", "data_collection_permissions": {"required": ["none"]}}}, "host_permissions": ["*://*.chatgpt.com/*", "*://*.openai.com/*", "*://*.gemini.google.com/*", "*://*.claude.ai/*", "*://*.mistral.ai/*", "*://*.perplexity.ai/*", "*://*.notebooklm.google.com/*", "*://*.grok.com/*", "*://*.x.com/*", "*://*.deepseek.com/*", "*://*.copilot.microsoft.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.chatgpt.com/*", "*://*.openai.com/*", "*://*.gemini.google.com/*", "*://*.claude.ai/*", "*://*.mistral.ai/*", "*://*.perplexity.ai/*", "*://*.notebooklm.google.com/*", "*://*.grok.com/*", "*://*.x.com/*", "*://*.deepseek.com/*", "*://*.copilot.microsoft.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}