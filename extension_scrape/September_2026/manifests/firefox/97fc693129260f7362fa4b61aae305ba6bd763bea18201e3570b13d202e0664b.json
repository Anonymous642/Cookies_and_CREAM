{"manifest_version": 2, "name": "Twitch Pins", "version": "0.9.4", "description": "Pin Twitch streamers into a Telegram-like group on twitch.tv.", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["storage", "https://gql.twitch.tv/*", "https://www.twitch.tv/*", "https://twitch.tv/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.twitch.tv/*", "https://twitch.tv/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_action": {"default_title": "Twitch Pins", "default_popup": "popup.html", "default_icon": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "twitch-pins@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}