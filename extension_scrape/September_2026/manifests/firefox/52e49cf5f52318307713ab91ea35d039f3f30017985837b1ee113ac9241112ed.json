{"manifest_version": 2, "name": "Omni Copy", "description": "Copy on select or via a button. Collect to an editable file. Control where it works \u2014 your clipboard, your rules.", "version": "1.1.4", "icons": {"16": "icon-16.png", "19": "icon-19.png", "38": "icon-38.png", "48": "icon-48.png", "128": "icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "omni-copy@local.dev", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "clipboardWrite", "downloads", "*://*/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Omni Copy", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content-scripts/content.js"]}]}