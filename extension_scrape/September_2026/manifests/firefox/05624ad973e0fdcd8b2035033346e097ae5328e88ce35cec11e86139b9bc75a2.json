{"manifest_version": 3, "name": "YouTube Watch Time Tracker & Sync", "version": "1.0", "description": "Measures daily watch time on YouTube and syncs it across devices via GitHub Gist.", "permissions": ["storage", "alarms"], "host_permissions": ["*://*.youtube.com/*", "https://api.github.com/*"], "background": {"scripts": ["config.js", "background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["config.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}], "icons": {"48": "icon.svg", "96": "icon.svg", "128": "icon.svg"}, "browser_specific_settings": {"gecko": {"id": "yt-watch-tracker@om.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}