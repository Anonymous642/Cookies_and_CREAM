{"manifest_version": 2, "name": "YouTube Queue Manager", "version": "1.3.0", "description": "Collect, manage, and sync YouTube video queues across Firefox devices.", "browser_specific_settings": {"gecko": {"id": "com.ff-youtube-queue-manager@samba.com", "data_collection_permissions": {"required": ["websiteContent", "browsingActivity"]}}}, "permissions": ["tabs", "storage", "activeTab", "*://*.youtube.com/*"], "background": {"scripts": ["src/background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtu.be/*"], "js": ["src/content/content_script.js"], "run_at": "document_idle"}], "browser_action": {"default_icon": {"16": "src/icons/icon_16.png", "32": "src/icons/icon_32.png", "48": "src/icons/icon_48.png", "64": "src/icons/icon_64.png", "128": "src/icons/icon_128.png"}, "default_popup": "src/popup/popup.html"}, "options_ui": {"page": "src/options/options.html", "open_in_tab": false}, "icons": {"16": "src/icons/icon_16.png", "32": "src/icons/icon_32.png", "48": "src/icons/icon_48.png", "64": "src/icons/icon_64.png", "128": "src/icons/icon_128.png"}}