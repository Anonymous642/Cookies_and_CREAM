{"manifest_version": 3, "name": "AskWax", "version": "1.0.3", "description": "Vinyl pricing analytics for Discogs sellers. See price suggestions, lowest price, and competitor count instantly.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "AskWax"}, "background": {"service_worker": "background/service-worker.js", "scripts": ["background/service-worker.js"]}, "content_scripts": [{"matches": ["*://*.discogs.com/*"], "js": ["content/inject.js"], "css": ["content/inject.css"], "run_at": "document_end"}], "host_permissions": ["*://api.discogs.com/*", "https://askwax.vercel.app/*"], "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "askwax@askwax.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteActivity"]}}}}