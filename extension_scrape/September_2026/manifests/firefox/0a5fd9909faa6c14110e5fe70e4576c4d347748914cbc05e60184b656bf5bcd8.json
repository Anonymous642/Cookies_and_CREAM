{"manifest_version": 2, "name": "TubeFinder", "version": "2.0.2", "description": "TubeFinder : Recherchez des vid\u00e9os YouTube en un clic. Rapide, simple et personnalisable.", "author": "Voyzix", "permissions": ["activeTab", "storage"], "icons": {"16": "img/youtube_16.png", "32": "img/youtube_32.png", "48": "img/youtube_48.png", "128": "img/youtube_128.png"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "img/youtube_16.png", "32": "img/youtube_32.png", "48": "img/youtube_48.png", "128": "img/youtube_128.png"}}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Alt+Y"}, "description": "Open TubeFinder"}}, "browser_specific_settings": {"gecko": {"id": "tubefinder@voyzix.example.com", "strict_min_version": "79.0"}}}