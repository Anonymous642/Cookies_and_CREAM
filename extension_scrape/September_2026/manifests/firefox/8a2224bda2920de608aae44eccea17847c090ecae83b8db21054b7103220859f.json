{"manifest_version": 3, "browser_specific_settings": {"gecko": {"id": "perplexity-search-helper@example.com"}}, "name": "Perplexity Search Helper", "version": "1.2", "description": "Quickly search on Perplexity with copied text", "permissions": ["clipboardRead", "clipboardWrite", "tabs", "activeTab", "storage", "contextMenus"], "host_permissions": ["https://www.perplexity.ai/*"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["*://www.perplexity.ai/*"], "js": ["content.js"]}], "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Search on Perplexity"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}