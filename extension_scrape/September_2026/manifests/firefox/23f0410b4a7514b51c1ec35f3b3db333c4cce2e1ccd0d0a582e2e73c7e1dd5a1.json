{"manifest_version": 3, "name": "iWordCraft - AI Writing Coach", "version": "1.0.1", "description": "Detect AI-generated text and improve writing authenticity. Instant originality scoring directly in your browser.", "homepage_url": "https://iwordcraft.com/extensions", "permissions": ["activeTab", "scripting", "clipboardRead", "clipboardWrite"], "host_permissions": ["https://iwordcraft.com/*"], "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["content.js"]}], "action": {"default_popup": "popup.html", "default_title": "Analyze Text", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "iwordcraft-extension@iwordcraft.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}