{"manifest_version": 3, "name": "Yossune LIVE", "short_name": "Yossune LIVE", "description": "Affiche si Yossune est en live et envoie une notification au demarrage du stream.", "version": "1.0.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Statut Twitch", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"], "type": "module"}, "permissions": ["alarms", "notifications", "storage"], "host_permissions": ["https://api.twitch.tv/*", "https://www.twitch.tv/*", "https://*.vercel.app/*", "https://*.netlify.app/*"], "browser_specific_settings": {"gecko": {"id": "twitch-live-notifier@example.com", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "121.0"}}}