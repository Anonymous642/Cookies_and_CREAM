{"manifest_version": 3, "name": "Tab Volume Slider", "version": "2.1.1", "description": "Per-tab media volume slider in the pinned icon popup (supports iframes).", "browser_specific_settings": {"gecko": {"id": "tab-volume-slider@evilduck", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage", "activeTab"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Tab Volume", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}]}