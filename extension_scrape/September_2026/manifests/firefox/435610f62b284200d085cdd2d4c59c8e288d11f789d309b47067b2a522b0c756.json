{"manifest_version": 3, "name": "Hanzi Decomp Helper", "version": "1.0.0", "browser_specific_settings": {"gecko": {"id": "hanzi-decomp-helper@whenwehadfaces", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "description": "Shows character decomposition and stroke order when you forget a word on HackChinese.", "permissions": ["storage"], "options_ui": {"page": "options/options.html"}, "host_permissions": ["*://*.hackchinese.com/*"], "content_scripts": [{"matches": ["*://*.hackchinese.com/*"], "js": ["content/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["data/*.json", "data/graphics/*.json", "content/panel.css"], "matches": ["*://*.hackchinese.com/*"]}]}