{"manifest_version": 3, "name": "Affine Highlights Filter", "version": "1.0.0", "description": "Filter Affine notes to show only highlighted sections with keyboard shortcut", "permissions": ["activeTab", "storage"], "host_permissions": ["https://app.affine.pro/*", "*://localhost/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://app.affine.pro/*", "*://localhost/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "commands": {"toggle-highlights": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Toggle highlights-only view"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "affine-highlights-filter@peeps.biz", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}