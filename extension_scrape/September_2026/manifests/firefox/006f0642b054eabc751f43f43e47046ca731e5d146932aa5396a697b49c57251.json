{"manifest_version": 2, "name": "Tab Switcher (Alt+W / Alt+S)", "version": "1.0", "description": "Switch tabs using Alt+W and Alt+S", "permissions": ["tabs"], "browser_specific_settings": {"gecko": {"id": "tab-switcher@example.com", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "commands": {"switch-to-previous-tab": {"suggested_key": {"default": "Alt+W"}, "description": "Go to previous tab"}, "switch-to-next-tab": {"suggested_key": {"default": "Alt+S"}, "description": "Go to next tab"}}}