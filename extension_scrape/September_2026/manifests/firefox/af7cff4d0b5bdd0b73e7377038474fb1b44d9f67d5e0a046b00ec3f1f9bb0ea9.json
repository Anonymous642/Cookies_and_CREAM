{"manifest_version": 3, "name": "ImageFocus Tracker", "version": "1.0.0", "description": "Theo d\u00f5i \u0111i\u1ec3m ch\u00fa \u00fd d\u1ef1a tr\u00ean chu\u1ed9t v\u00e0 t\u1ea1o heatmap cho \u1ea3nh.", "permissions": ["activeTab", "storage"], "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@imagefocus-tracker", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}