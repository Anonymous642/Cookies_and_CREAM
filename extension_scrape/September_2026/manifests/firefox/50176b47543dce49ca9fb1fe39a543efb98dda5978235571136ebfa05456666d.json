{"manifest_version": 3, "name": "Open in Steam", "version": "1.4.0", "description": "Opens Steam store and optional Steam Community links in Steam.", "permissions": ["storage", "tabs"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "action": {"default_title": "Open in Steam", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "open-in-steam@storz.local", "data_collection_permissions": {"required": ["none"]}}}}