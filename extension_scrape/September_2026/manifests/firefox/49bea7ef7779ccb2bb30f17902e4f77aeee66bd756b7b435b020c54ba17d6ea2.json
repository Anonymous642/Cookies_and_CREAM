{"manifest_version": 3, "name": "LingoFlash - Learn English Every New Tab", "version": "1.0.0", "description": "Master English vocabulary effortlessly every time you open a new tab. Beautiful design, daily goals, and 8 interface languages.", "author": "ThomasLimited", "homepage_url": "https://t.me/thomaslimited", "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "lingoflash@thomaslimited.app", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html"}, "chrome_url_overrides": {"newtab": "newtab.html"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["data/*"], "matches": ["<all_urls>"]}]}