{"manifest_version": 3, "name": "FitEdit Training Data Manager", "description": "Companion browser extension for FitEdit", "author": "EnduraByte LLC", "version": "0.4", "permissions": ["cookies", "alarms", "notifications"], "host_permissions": ["*://*.garmin.com/*", "*://*.strava.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "content_security_policy": {"extension_pages": "script-src 'self'"}, "action": {"default_popup": "popup.html", "default_title": "FitEdit"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}, "id": "support@fitedit.io"}}}