{"manifest_version": 3, "name": "F1 Session Countdown", "description": "Displays F1 session countdown as a pop-up.", "version": "1.3.0", "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "index.html", "default_title": "F1 Countdown"}, "permissions": ["storage", "notifications", "alarms"], "background": {"scripts": ["background.js"]}, "web_accessible_resources": [{"resources": ["ical.min.js", "f1.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "f1count@silentdragoon.github.io"}}}