{"manifest_version": 2, "name": "Nipate Bookmark", "version": "1.0.2", "description": "Sync your bookmarks to Nipate and get configurable reminders", "permissions": ["bookmarks", "storage", "alarms", "http://localhost/*", "https://*/*"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/logo16.png", "48": "icons/logo48.png", "128": "icons/logo128.png"}}, "icons": {"16": "icons/logo16.png", "48": "icons/logo48.png", "128": "icons/logo128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "nipate-bookmark@nipate.africa", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["bookmarksInfo", "authenticationInfo"], "optional": []}}}}