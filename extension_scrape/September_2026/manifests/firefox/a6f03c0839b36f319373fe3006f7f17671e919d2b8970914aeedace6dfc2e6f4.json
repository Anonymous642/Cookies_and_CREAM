{"manifest_version": 3, "name": "QuizPause Pro", "description": "Improve knowledge retention with interactive quizzes that automatically appear every time you pause your favorite streaming videos.", "version": "1.0.0", "author": "StreamLearning Labs", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.youtube.com/*", "https://www.netflix.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "quizpausepro@streamlearninglabs.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}