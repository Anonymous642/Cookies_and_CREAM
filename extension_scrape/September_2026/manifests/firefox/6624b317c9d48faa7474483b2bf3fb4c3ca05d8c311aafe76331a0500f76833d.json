{"manifest_version": 3, "name": "Mir Fb Tool", "version": "2.0.0", "description": "Extract Email, Name, URL, Bio & Instagram from Facebook pages with premium UI. Two-clip system optimized.", "author": "Wajahat Ali Mir", "homepage_url": "https://github.com/wajahat-ali-mir-dev", "browser_specific_settings": {"gecko": {"id": "wam-extractor@wajahat-ali-mir", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://www.facebook.com/*", "https://facebook.com/*", "https://web.facebook.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"js": ["content.js"], "matches": ["https://www.facebook.com/*", "https://facebook.com/*", "https://web.facebook.com/*"], "run_at": "document_idle", "all_frames": false}], "action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_popup": "popup.html", "default_title": "Mir Fb Tool \u2014 Alt+C to copy"}, "commands": {"trigger-copy": {"suggested_key": {"default": "Alt+C", "mac": "Alt+C", "windows": "Alt+C", "linux": "Alt+C"}, "description": "Extract & copy all page details instantly"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*.png", "assets/*"], "matches": ["https://www.facebook.com/*", "https://facebook.com/*", "https://web.facebook.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'"}, "incognito": "spanning"}