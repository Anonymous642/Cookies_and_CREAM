{"manifest_version": 3, "name": "Twitter Media Only", "version": "1.1", "description": "Strips text from Twitter/X. Photos and video only. Toggle button included.", "browser_specific_settings": {"gecko": {"id": "twitter-media-only@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage"], "content_scripts": [{"matches": ["*://twitter.com/*", "*://x.com/*", "*://mobile.twitter.com/*"], "css": ["hide-text.css"], "js": ["content.js"], "run_at": "document_start", "all_frames": false}]}