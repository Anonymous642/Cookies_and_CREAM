{"manifest_version": 3, "name": "FeedBun", "version": "1.2.30", "description": "Decode food labels and recipes.", "permissions": ["activeTab", "scripting", "storage"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "background": {"scripts": ["js/shared/auth-session.js", "js/shared/url-privacy.js", "js/background/api-config.js", "js/background/api-client.js", "js/background/page-evidence.js", "js/background/page-snapshot-core.js", "js/background/page-snapshot.js", "js/background/service.js", "background.js"]}, "action": {"default_title": "FeedBun", "default_popup": "popup.html", "default_icon": {"16": "icon.svg", "48": "icon.svg", "128": "icon.svg"}, "theme_icons": [{"dark": "icon.svg", "light": "icon-toolbar-dark.svg", "size": 16}, {"dark": "icon.svg", "light": "icon-toolbar-dark.svg", "size": 32}]}, "icons": {"16": "icon.svg", "48": "icon.svg", "128": "icon.svg"}, "browser_specific_settings": {"gecko": {"id": "feedbun@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "healthInfo", "authenticationInfo", "browsingActivity", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "host_permissions": ["https://feedbun.com/*"]}