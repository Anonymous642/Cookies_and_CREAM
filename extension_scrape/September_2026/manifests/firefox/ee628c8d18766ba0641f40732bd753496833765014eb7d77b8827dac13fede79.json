{"manifest_version": 3, "name": "QRGenerator", "version": "1.0.0", "description": "Generate customizable QR codes from text and URLs. Create, customize colors, download as images, and save QR code history.", "icons": {"48": "imgs/icon-48.png", "96": "imgs/icon-96.png", "128": "imgs/icon-128.png"}, "action": {"default_icon": {"48": "imgs/icon-48.png", "96": "imgs/icon-96.png"}, "default_title": "QRGenerator", "default_popup": "ui/qr.html"}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "qrgenerator@utility.tools", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}