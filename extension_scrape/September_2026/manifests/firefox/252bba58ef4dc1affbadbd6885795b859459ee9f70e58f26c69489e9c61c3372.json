{"manifest_version": 3, "name": "Breathe: Screen Apnea", "version": "1.9.3", "description": "Guided breathing rituals, calming sounds, and an on-screen overlay that reminds you to breathe while you browse.", "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "alarms", "scripting", "tabs", "offscreen"], "host_permissions": ["<all_urls>"], "commands": {"toggle-ambient": {"suggested_key": {"default": "Ctrl+Shift+F"}, "description": "Toggle overlay breathing"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["ritual.html", "ritual.js", "ritual.css", "config.js", "audio.js", "logo.svg", "icons/*", "sounds/*", "fonts/*"], "matches": ["<all_urls>"]}], "background": {"service_worker": "background.js", "scripts": ["config.js", "audio.js", "audio-session.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "screen-apnea@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": ["personallyIdentifyingInfo"]}}}}