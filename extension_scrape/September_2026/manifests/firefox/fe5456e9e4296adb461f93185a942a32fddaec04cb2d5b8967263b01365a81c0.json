{"manifest_version": 3, "name": "Cleanup Console", "version": "1.0.0", "description": "Painel para limpar seus pr\u00f3prios posts e coment\u00e1rios do Reddit via API oficial, e acesso r\u00e1pido \u00e0s ferramentas oficiais de exclus\u00e3o de dados de outras redes.", "icons": {"48": "assets/icon-48.png", "96": "assets/icon-96.png"}, "permissions": ["storage", "identity"], "host_permissions": ["https://oauth.reddit.com/*", "https://www.reddit.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.reddit.com/*", "https://discord.com/*", "https://x.com/*", "https://twitter.com/*", "https://www.instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["popup/style.css", "assets/icon-48.png"], "matches": ["https://www.reddit.com/*", "https://discord.com/*", "https://x.com/*", "https://twitter.com/*", "https://www.instagram.com/*"]}], "browser_specific_settings": {"gecko": {"id": "cleanup-console@example.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "113.0"}}}