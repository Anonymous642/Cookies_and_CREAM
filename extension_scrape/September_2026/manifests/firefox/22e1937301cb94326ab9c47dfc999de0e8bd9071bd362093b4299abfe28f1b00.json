{"name": "Fantasy Points Browser Extension", "description": "League import bridge for FantasyPoints.com #ScoreMore.", "version": "3.0.1", "manifest_version": 3, "short_name": "FPBE", "browser_specific_settings": {"gecko": {"id": "{e5552d16-7a96-455c-83dd-927327ca3ac6}"}}, "homepage_url": "https://www.fantasypoints.com", "icons": {"16": "icon/16.png", "19": "icon/19.png", "32": "icon/38.png", "38": "icon/38.png", "48": "icon/48.png", "128": "icon/128.png"}, "action": {"default_popup": "src/popup.html", "default_title": "Fantasy Points", "default_icon": {"19": "icon/19.png", "38": "icon/38.png"}}, "background": {"scripts": ["src/background.js"]}, "permissions": ["scripting", "tabs", "cookies", "storage", "activeTab"], "host_permissions": ["*://*.cbssports.com/*", "*://*.fantasypoints.com/*"], "content_scripts": [{"matches": ["*://*.cbssports.com/*"], "js": ["src/content-script.js"]}], "web_accessible_resources": [{"resources": ["img/logo-wordmark-gray-black.svg"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}}