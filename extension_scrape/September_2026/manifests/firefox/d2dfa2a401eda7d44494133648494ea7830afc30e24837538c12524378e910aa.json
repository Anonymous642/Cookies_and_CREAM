{"manifest_version": 3, "name": "Balanced Auto-Clicker", "version": "3.1.0", "description": "A fast, stable auto-clicker controlled from the Firefox toolbar.", "browser_specific_settings": {"gecko": {"id": "balanced-autoclicker-30@jigyashu-firefox", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "140.0"}}, "action": {"default_title": "Balanced Auto-Clicker", "default_popup": "popup.html", "default_area": "navbar"}, "permissions": ["storage"], "icons": {"48": "icons/icon.svg"}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["autoclicker.js"], "run_at": "document_idle"}]}