{"manifest_version": 3, "name": "SFMC Helper", "version": "1.0.0", "description": "A toolbox for Salesforce Marketing Cloud power users: encode/decode, code reference, generators, and page context detection.", "browser_specific_settings": {"gecko": {"id": "sfmc-helper@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"48": "icons/sfmc-power-tools-48.png", "96": "icons/sfmc-power-tools-96.png"}, "action": {"default_title": "SFMC Power Tools", "default_popup": "popup.html", "default_icon": {"48": "icons/sfmc-power-tools-48.png", "96": "icons/sfmc-power-tools-96.png"}}, "permissions": ["activeTab", "storage", "clipboardWrite", "tabs"], "background": {"scripts": ["js/background.js"]}, "commands": {"toggle-panel": {"suggested_key": {"default": "Alt+S"}, "description": "Toggle the SFMC Power Tools panel"}, "command-palette": {"suggested_key": {"default": "Alt+A"}, "description": "Open the SFMC command palette (quick navigation)"}}, "host_permissions": ["*://*.marketingcloudapis.com/*", "*://*.exacttarget.com/*", "*://*.marketingcloudapps.com/*"], "web_accessible_resources": [{"resources": ["popup.html", "popup.css", "js/*", "icons/*"], "matches": ["*://*.exacttarget.com/*", "*://*.marketingcloudapps.com/*"]}], "content_scripts": [{"matches": ["*://*.exacttarget.com/*", "*://*.marketingcloudapps.com/*"], "js": ["js/content.js"], "css": ["inpage.css"], "run_at": "document_idle"}]}