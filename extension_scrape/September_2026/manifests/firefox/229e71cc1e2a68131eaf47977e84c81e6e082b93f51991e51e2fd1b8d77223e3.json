{"manifest_version": 3, "name": "FormSolver GPT5 Nano", "version": "2.0.0", "description": "Reads Google & Microsoft Forms and shows AI answers using ApiKey.", "browser_specific_settings": {"gecko": {"id": "FormSolver-gpt5-nano@local-addon", "data_collection_permissions": {"required": ["none"], "collected_data": [], "data_usage": [], "data_retention": []}}}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://docs.google.com/forms/*", "https://docs.google.com/*", "https://forms.office.com/*"], "content_scripts": [{"matches": ["https://docs.google.com/forms/*", "https://forms.office.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html"}, "icons": {"128": "icon.png"}}