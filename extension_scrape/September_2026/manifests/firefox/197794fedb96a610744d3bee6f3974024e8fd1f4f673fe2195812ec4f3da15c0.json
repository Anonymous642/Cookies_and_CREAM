{"manifest_version": 2, "name": "Quick Tab Saver", "version": "1.0.0", "description": "Save the current tab's title and URL to a tidy list you can copy or export.", "browser_specific_settings": {"gecko": {"id": "{b5012cd0-ddf4-4192-be60-107bdfcb776e}", "strict_min_version": "91.0"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "tabs", "activeTab", "clipboardWrite"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Quick Tab Saver", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true, "browser_style": true}, "content_security_policy": "script-src 'self'; object-src 'self'"}