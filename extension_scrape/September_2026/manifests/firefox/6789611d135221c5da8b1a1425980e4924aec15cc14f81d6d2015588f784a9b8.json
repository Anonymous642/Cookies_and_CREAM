{"manifest_version": 3, "name": "Vidi - Save design inspiration to Notion", "version": "1.0.1", "description": "As quick as a bookmark, but accessible everywhere. Capture design inspiration straight to Notion.", "permissions": ["activeTab", "scripting", "storage", "identity"], "host_permissions": ["https://api.notion.com/*"], "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "web_accessible_resources": [{"resources": ["content/snip-overlay.js", "content/url-detector.js", "content/url-bar.js", "content/toast.js", "content/snip-overlay.css"], "matches": ["<all_urls>"]}], "commands": {"capture-shortcut": {"suggested_key": {"default": "Alt+Shift+Z", "mac": "Command+Shift+Z"}, "description": "Quick save"}, "precision-snip": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Command+Shift+X"}, "description": "Section snip"}}, "browser_specific_settings": {"gecko": {"id": "vidi@simplify.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}