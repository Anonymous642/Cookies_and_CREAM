{"manifest_version": 3, "name": "Webpage To Pdf", "version": "1.0.0", "description": "Save any webpage as clean PDF. Full page, article-only, or selected content. Preview before downloading. No account needed.", "permissions": ["activeTab", "scripting", "storage", "downloads", "tabs", "notifications", "unlimitedStorage"], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "webpagetopdf@yourdomain.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["libs/Readability.js", "libs/html2canvas.min.js", "libs/jspdf.umd.min.js", "content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["preview.html", "history.html"], "matches": ["<all_urls>"]}]}