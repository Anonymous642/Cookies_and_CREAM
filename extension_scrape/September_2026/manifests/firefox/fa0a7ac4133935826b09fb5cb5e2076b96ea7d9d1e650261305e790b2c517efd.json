{"manifest_version": 2, "name": "NBN Property Checker", "version": "2.0.2", "description": "Shows NBN tech, speed and upgrade status on Domain and Realestate listings, plus Opticomm coverage for non-NBN estates.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["webRequest", "webRequestBlocking", "https://places.nbnco.net.au/", "https://online.telco.opticomm.com.au/"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "nbn-checker@yourdomain.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["https://www.domain.com.au/*", "https://www.realestate.com.au/*"], "js": ["content.js"]}]}