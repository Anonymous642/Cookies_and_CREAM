{"manifest_version": 2, "name": "Atmomo Companion", "description": "Embed gifs from your Atmomo library on Bluesky and X.", "version": "1.0", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "https://atmomo.xyz/*", "https://*.atmomo.xyz/*"], "browser_specific_settings": {"gecko": {"id": "atmomo@atmomo.xyz", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Atmomo Companion", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://bsky.app/*"], "js": ["content-scripts/bluesky.js"]}, {"matches": ["*://*.twitter.com/*", "*://*.x.com/*", "*://twitter.com/*", "*://x.com/*"], "js": ["content-scripts/twitter.js"]}]}