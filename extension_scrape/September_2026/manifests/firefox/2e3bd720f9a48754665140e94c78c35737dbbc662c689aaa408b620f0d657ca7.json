{"manifest_version": 3, "name": "Bato Image URL Overrider", "version": "1.0", "description": "Overrides image URLs based on a specified base URL.", "icons": {"16": "images/icon.svg", "48": "images/icon.svg", "128": "images/icon.svg"}, "permissions": ["activeTab", "downloads", "storage"], "browser_specific_settings": {"gecko": {"id": "url-overrider@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon.svg", "48": "images/icon.svg", "128": "images/icon.svg"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}