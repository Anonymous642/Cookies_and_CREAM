{"manifest_version": 3, "name": "PDF Max", "version": "2.0.0", "description": "Advanced PDF viewer with native form rendering and dual-view support", "browser_specific_settings": {"gecko": {"id": "pdfmax@example.com", "strict_min_version": "109.0"}}, "permissions": ["storage", "tabs", "webNavigation", "downloads"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "PDF Max - Advanced PDF Viewer"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["viewer.html", "viewer_init.js", "native-pdf-renderer.js", "native-pdf-renderer.css", "dark-mode-toggle.js", "view-switcher.js", "print.css", "print.js", "pdfjs/build/*"], "matches": ["<all_urls>"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}}