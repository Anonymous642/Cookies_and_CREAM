{"manifest_version": 2, "name": "YouTube Brodie Robertsonify", "version": "1.0.0", "icons": {"96": "icon.png"}, "description": "Modify YouTube thumbnails to include Brodie Robertson", "browser_action": {"default_popup": "settings.html"}, "browser_specific_settings": {"gecko": {"id": "@youtube-brodie-robertsonify", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["brodieify.js"], "run_at": "document_idle"}], "web_accessible_resources": ["images/*.png", "images/*.json"]}