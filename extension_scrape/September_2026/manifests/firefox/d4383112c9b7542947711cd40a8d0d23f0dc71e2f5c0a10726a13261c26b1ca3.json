{"manifest_version": 2, "name": "URL to Discord", "version": "1.0", "description": "Sends the current page URL to a Discord webhook", "permissions": ["activeTab", "storage", "notifications", "tabs"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "assets/disurlicon16.png", "32": "assets/disurlicon32.png", "48": "assets/disurlicon48.png", "96": "assets/disurlicon96.png"}}, "icons": {"16": "assets/disurlicon16.png", "32": "assets/disurlicon32.png", "48": "assets/disurlicon48.png", "96": "assets/disurlicon96.png"}, "background": {"scripts": ["background.js"]}, "commands": {"send_url": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Send URL to Discord"}}, "browser_specific_settings": {"gecko": {"id": "url-to-discord@example.com", "strict_min_version": "79.0"}}}