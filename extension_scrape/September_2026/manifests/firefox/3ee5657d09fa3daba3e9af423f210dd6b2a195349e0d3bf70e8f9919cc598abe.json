{"manifest_version": 2, "name": "Consent Crusher", "version": "3.2.4.4", "description": "Recognises 15 consent platforms and dismisses their banners without accepting tracking.", "browser_specific_settings": {"gecko": {"id": "{76d10345-e74c-4686-b1f2-d212aa626139}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"32": "images/icon32.png", "48": "images/icon48.png", "64": "images/icon64.png", "96": "images/icon96.png", "128": "images/icon128.png"}, "permissions": ["storage", "activeTab", "<all_urls>"], "background": {"scripts": ["app/background.js"], "persistent": false}, "browser_action": {"default_popup": "app/popup.html", "default_title": "Consent Crusher", "default_icon": {"32": "images/icon32.png", "48": "images/icon48.png", "64": "images/icon64.png", "96": "images/icon96.png", "128": "images/icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["app/core.js", "app/content.js"], "run_at": "document_idle", "all_frames": false}]}