{"manifest_version": 3, "name": "Memory App Companion (Timely)", "version": "26.3.166", "description": "Companion extension for the Memory desktop app. Shares the active tab URL and title with Memory for activity tracking.", "permissions": ["tabs"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_security_policy": {"extension_pages": "script-src 'self'; connect-src ws://localhost:19847 ws://127.0.0.1:19847;"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "memory-browser-url@timely.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity"], "optional": []}}}}