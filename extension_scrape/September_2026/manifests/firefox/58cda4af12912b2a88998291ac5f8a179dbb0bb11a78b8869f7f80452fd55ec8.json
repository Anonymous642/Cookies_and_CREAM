{"manifest_version": 2, "name": "Barficient Helper", "description": "A browser extension to assist with Barficient's cookie auto-filling and CSV file management.", "version": "2.0.0", "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "permissions": ["cookies", "storage", "tabs", "downloads", "activeTab", "https://app.provi.com/*", "https://app.barficient.com/*", "http://*.sculpturehospitality.com/*"], "optional_permissions": ["https://*/*", "http://*/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["injector.js"]}], "browser_action": {"default_popup": "index.html", "default_title": "Cookie Auto-Filler"}, "browser_specific_settings": {"gecko": {"id": "barficient-helper@extension.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}