{"manifest_version": 3, "name": "YouTube Commentary", "version": "1.0.0", "description": "Read YouTube comments directly inside the video player with live timestamp sync.", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*", "https://www.googleapis.com/*"], "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["content.js"]}], "action": {"default_popup": "popup.html"}, "web_accessible_resources": [{"resources": ["onboarding.html"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "ytcommentary@anantpathak.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}