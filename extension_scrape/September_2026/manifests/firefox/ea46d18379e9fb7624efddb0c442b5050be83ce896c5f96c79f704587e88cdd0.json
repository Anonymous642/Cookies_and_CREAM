{"manifest_version": 3, "name": "Continue Watching for YouTube", "version": "1.0.1", "description": "Automatically confirms YouTube's continue-watching prompt.", "icons": {"32": "icons/continue-watching.svg", "64": "icons/continue-watching.svg", "128": "icons/continue-watching-128.png"}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"], "js": ["continue-watching.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "youtube-continue-watching@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}