{"manifest_version": 3, "name": "VisualRunner", "version": "0.2.7", "description": "Configure and launch localization screenshot QA capture jobs from the current page.", "browser_specific_settings": {"gecko": {"id": "extension@visualrunner.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["personallyIdentifyingInfo", "authenticationInfo", "websiteContent", "browsingActivity"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://visualrunner.com/projects/*/captures*", "https://visualrunner.com/projects/*/brand-rules*"], "js": ["web-capture-bridge.js"], "run_at": "document_start"}], "host_permissions": ["https://visualrunner.com/*"], "sidebar_action": {"default_panel": "index.html", "default_title": "VisualRunner", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "permissions": ["activeTab", "scripting", "storage", "tabs", "downloads", "cookies", "notifications", "alarms"], "optional_host_permissions": ["<all_urls>"]}