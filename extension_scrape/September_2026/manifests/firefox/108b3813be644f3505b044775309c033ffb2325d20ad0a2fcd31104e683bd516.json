{"manifest_version": 3, "name": "Movie Tracker List", "version": "9.1.20", "description": "Find out when a movie is available on torrents.", "permissions": ["identity", "storage", "notifications", "activeTab", "alarms", "declarativeNetRequest"], "host_permissions": ["*://*.tibi.is-a.dev/*", "*://api.themoviedb.org/*", "*://*.strem.fun/*", "*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"], "declarative_net_request": {"rule_resources": [{"id": "yt_embed_rules", "enabled": true, "path": "yt_embed_rules.json"}]}, "options_page": "settings.html", "background": {"scripts": ["browser-polyfill.js", "background.js"], "type": "module"}, "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}}, "content_scripts": [{"matches": ["https://www.imdb.com/title/tt*/*"], "js": ["addfromIMDB.js"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "movietracker@example.com", "strict_min_version": "109.0"}}}