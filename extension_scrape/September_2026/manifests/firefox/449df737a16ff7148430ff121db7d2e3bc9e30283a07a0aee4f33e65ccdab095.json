{"manifest_version": 3, "name": "Copy Link", "version": "1.1.0", "description": "Copy the current page URL with a shortcut, with optional tracking-parameter removal.", "browser_specific_settings": {"gecko": {"id": "copy-link@zlnk.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "background": {"scripts": ["clean-url.js", "background.js"]}, "action": {"default_title": "Copy Link", "default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "commands": {"copy-link": {"suggested_key": {"default": "Alt+Shift+C"}, "description": "Copy the current page link"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "permissions": ["activeTab", "clipboardWrite", "storage", "scripting", "notifications"]}