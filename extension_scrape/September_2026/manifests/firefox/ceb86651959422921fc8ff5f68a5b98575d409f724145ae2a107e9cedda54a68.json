{"manifest_version": 2, "name": "Scraps", "version": "1.0", "description": "Right-click to clip text from any page and view your collection in a popup.", "browser_specific_settings": {"gecko": {"id": "asevetkuluna@outlook.com", "data_collection_permissions": {"required": ["none"], "description": "Scraps collects no data. All clipped text remains on your device in local storage."}}}, "browser_action": {"default_popup": "clipper/panel.html", "default_title": "Scraps", "default_icon": {"16": "icons/scrap-clip-16.png", "48": "icons/scrap-clip-48.png", "128": "icons/scrap-clip-128.png"}}, "background": {"scripts": ["bin/collector.js"], "persistent": false}, "icons": {"16": "icons/scrap-clip-16.png", "48": "icons/scrap-clip-48.png", "128": "icons/scrap-clip-128.png"}, "permissions": ["contextMenus", "storage", "clipboardWrite"]}