{"manifest_version": 2, "name": "BrowseWiki", "description": "Save webpages, organized into folders\u2014complete with search, AI report generation with references, and easy sharing", "version": "0.8.9", "icons": {"128": "icon/128.png"}, "permissions": ["tabs", "storage", "https://api.browsewiki.com/*"], "web_accessible_resources": ["icon/*.png", "content-scripts/*", "content-scripts/content.css"], "browser_specific_settings": {"gecko": {"id": "hi@browsewiki.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "BrowseWiki browser extension", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}