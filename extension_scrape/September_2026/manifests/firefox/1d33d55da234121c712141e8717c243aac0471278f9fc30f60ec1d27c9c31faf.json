{"manifest_version": 2, "name": "Temporal.ist", "version": "1.0.0", "description": "View and control active time tracking sessions on temporal.ist", "browser_specific_settings": {"gecko": {"id": "temporalist@temporal.ist", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["websiteActivity", "authenticationInfo"]}}, "gecko_android": {"strict_min_version": "101.0"}}, "permissions": ["storage", "tabs", "https://temporal.ist/*"], "optional_permissions": ["*://*/*"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}}