{"manifest_version": 3, "name": "AI Form Assistant", "description": "AI-powered helper that explains form fields and suggests answers instantly \u2014 fully on-device, no data leaves your browser.", "version": "1.1.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage"], "host_permissions": ["https://huggingface.co/*"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "david.bledowski@gmx.de", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"type": "module", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}]}