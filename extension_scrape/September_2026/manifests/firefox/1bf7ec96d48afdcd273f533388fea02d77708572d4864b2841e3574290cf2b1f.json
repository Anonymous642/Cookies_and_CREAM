{"manifest_version": 2, "name": "Bookmark Organizer \u2014 Local & Private", "short_name": "Bookmark Organizer", "version": "1.0.1", "description": "Privately organize Firefox bookmarks into logical folders with preview, backup, undo, and clearly labeled sponsor and support links.", "author": "Wilkens Brisenold", "permissions": ["bookmarks", "storage", "downloads"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_title": "Bookmark Organizer", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "local-bookmark-organizer@wilkensbrisenold", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}