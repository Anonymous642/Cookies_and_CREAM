{"manifest_version": 2, "name": "KeyBock Autofill", "description": "Autofill for KeyBock credentials via plugin API.", "version": "0.1.2", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "tabs", "activeTab", "https://password.test/*", "http://password.test/*"], "optional_permissions": ["<all_urls>"], "browser_action": {"default_title": "KeyBock Autofill", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}, "default_popup": "popup.html"}, "background": {"scripts": ["vendor/libsodium/libsodium-sumo.js", "vendor/libsodium/libsodium-wrappers.js", "background.js"], "persistent": false}, "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'", "web_accessible_resources": ["icons/*.png"], "content_scripts": [], "browser_specific_settings": {"gecko": {"id": "keybock-autofill@keybock.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity"]}}}}