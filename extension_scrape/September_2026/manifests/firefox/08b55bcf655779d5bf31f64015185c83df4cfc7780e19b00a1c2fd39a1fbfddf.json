{"manifest_version": 2, "name": "URL to Steam", "version": "1.85", "description": "URL to Steam is a lightweight, user-friendly Firefox extension that lets you open Steam-related URLs directly in the Steam app while your browser loads the page normally.", "permissions": ["activeTab", "storage", "tabs", "contextMenus"], "browser_action": {"default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "default_popup": "popup.html", "default_title": "URL to Steam Options"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "{7c995e03-1587-48c0-afdf-cb2bf4d6cd3a}"}}}