{"manifest_version": 3, "name": "Volume Booster 300", "version": "1.0.12", "description": "Enhances and fine-tunes audio in the active tab, with boost support up to 300% and a convenient popout control window.", "browser_specific_settings": {"gecko": {"id": "volume-booster-300@outofthejack", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "permissions": ["activeTab", "scripting", "storage", "tabs"], "incognito": "not_allowed", "action": {"default_title": "Volume Booster 300", "default_icon": {"16": "icon.png", "32": "icon.png"}, "default_popup": "popup.html"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}