{"manifest_version": 3, "name": "Amazon Cart Links to Clipboard", "version": "1.0.0", "description": "Copy all links of the items in your Amazon cart to the clipboard in one click.", "browser_specific_settings": {"gecko": {"id": "amazon-cart-link@fdesi.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "clipboardWrite"], "action": {"default_title": "Amazon Cart Links", "default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon-48.png"}}, "icons": {"48": "icons/icon-48.png"}, "content_scripts": [{"matches": ["*://*.amazon.com/*", "*://*.amazon.com.br/*", "*://*.amazon.ca/*", "*://*.amazon.com.mx/*", "*://*.amazon.com.tr/*", "*://*.amazon.com.au/*", "*://*.amazon.co.jp/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.fr/*", "*://*.amazon.it/*", "*://*.amazon.es/*", "*://*.amazon.nl/*", "*://*.amazon.se/*", "*://*.amazon.pl/*", "*://*.amazon.be/*", "*://*.amazon.in/*", "*://*.amazon.sg/*", "*://*.amazon.ae/*", "*://*.amazon.sa/*", "*://*.amazon.eg/*"], "js": ["content/cart.js"], "run_at": "document_idle"}]}