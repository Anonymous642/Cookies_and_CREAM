{"manifest_version": 2, "name": "Starshelf", "description": "Auto-categorize GitHub starred repos with AI", "version": "0.1.4", "icons": {"256": "icon-256.png"}, "permissions": ["storage", "https://github.com/*", "https://api.github.com/*", "https://api.anthropic.com/*", "https://api.openai.com/*", "https://opencode.ai/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "starshelf@mariodian", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_title": "Starshelf", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://github.com/*"], "css": ["content-scripts/content.css"], "js": ["content-scripts/content.js"]}]}