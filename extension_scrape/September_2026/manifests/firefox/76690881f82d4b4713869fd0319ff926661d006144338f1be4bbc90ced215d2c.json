{"manifest_version": 3, "name": "eMAG Buddy - Advance Filtering Options", "version": "2.0.1", "description": "Hides eMAG marketplace listings that aren't actually sold and shipped by eMAG itself \u2014 verified against eMAG's own seller/shipping info on each product page, not guesswork. Available in English, Romanian, Bulgarian and Hungarian.", "browser_specific_settings": {"gecko": {"id": "doar-emag@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_popup": "popup.html", "default_title": "eMAG Buddy - Advance Filtering Options", "default_icon": {"16": "icon_16_inactive.png", "48": "icon_48_inactive.png", "128": "icon_128_inactive.png"}}, "icons": {"16": "icon_16.png", "48": "icon_48.png", "128": "icon_128.png"}, "permissions": ["storage"], "host_permissions": ["*://*.emag.ro/*", "*://*.emag.bg/*", "*://*.emag.hu/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.emag.ro/*", "*://*.emag.bg/*", "*://*.emag.hu/*"], "js": ["content.js"], "run_at": "document_idle"}]}