{"manifest_version": 3, "name": "Stubbly", "short_name": "Stubbly", "version": "1.0.5", "description": "Shorten any URL in one click. Toolbar shortening, right-click menu, instant QR codes, and click tracking.", "author": "Stubbly", "homepage_url": "https://stubb.ly", "permissions": ["activeTab", "contextMenus", "storage"], "host_permissions": ["https://stubb.ly/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "action": {"default_title": "Stubbly \u2014 Shorten this page", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "stubbly@stubbly.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}