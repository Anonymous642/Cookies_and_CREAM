{"manifest_version": 3, "name": "NeedToWatch \u2014 NTW", "version": "1.1.0", "description": "You spot it while doomscrolling, you forget it by dinner. NeedToWatch saves the title, poster, and rating in one click \u2014 so \"I'll watch that later\" actually happens.", "icons": {"16": "src/icons/icon-16.png", "32": "src/icons/icon-32.png", "48": "src/icons/icon-48.png", "96": "src/icons/icon-96.png", "128": "src/icons/icon-128.png"}, "permissions": ["storage", "downloads", "alarms", "notifications"], "host_permissions": ["https://need-to-watch-20.needtowatch000.workers.dev/*", "https://kitsu.io/*"], "action": {"default_title": "NeedToWatch \u2014 click to open sidebar", "default_icon": {"16": "src/icons/icon-16.png", "32": "src/icons/icon-32.png"}}, "background": {"scripts": ["src/background/background.js"]}, "sidebar_action": {"default_title": "NeedToWatch", "default_panel": "src/sidebar/sidebar.html", "default_icon": {"16": "src/icons/icon-16.png", "32": "src/icons/icon-32.png"}, "open_at_install": false}, "browser_specific_settings": {"gecko": {"id": "needtowatch-ntw@local.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["searchTerms"]}}}}