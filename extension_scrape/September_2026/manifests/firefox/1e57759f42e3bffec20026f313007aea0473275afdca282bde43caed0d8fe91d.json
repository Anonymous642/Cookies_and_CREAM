{"manifest_version": 3, "name": "Recallio", "version": "2.18.7", "description": "Save and organise bookmarks with Recallio.", "permissions": ["activeTab", "tabs", "storage", "scripting", "contextMenus", "alarms"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content/progress.js", "content/highlight.js"], "run_at": "document_idle"}], "commands": {"save-current-page": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Save current page to Recallio"}, "_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K"}, "description": "Open Recallio popup"}}, "action": {"default_popup": "popup/popup.html", "default_title": "Recallio", "default_icon": {"16": "icons/logo_16x16.png", "32": "icons/logo_32x32.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "recallio@bookmark-manager", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "usages": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/logo_16x16.png", "32": "icons/logo_32x32.png", "48": "icons/logo_48x48.png", "128": "icons/logo_128x128.png"}}