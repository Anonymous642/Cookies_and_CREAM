{"manifest_version": 3, "name": "Compact Link Lists for Reddit", "version": "1.2.1", "description": "Rebuilds Reddit's card feed as a compact old.reddit.com-style link list and removes promoted posts.", "browser_specific_settings": {"gecko": {"id": "{7e77cd28-1272-4441-82de-d352b47d8ff2}", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "120.0"}}, "content_scripts": [{"matches": ["*://*.reddit.com/*"], "exclude_matches": ["*://old.reddit.com/*", "*://i.reddit.com/*", "*://mod.reddit.com/*", "*://ads.reddit.com/*", "*://business.reddit.com/*", "*://accounts.reddit.com/*", "*://chat.reddit.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start", "all_frames": false}]}