{"manifest_version": 3, "name": "FormFill \u2014 Smart Form Capture & Autofill", "version": "1.0.1", "description": "Capture form fields from any page and autofill them in one click. Supports text, dropdowns, checkboxes, and SPA frameworks.", "permissions": ["activeTab", "storage", "scripting"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["service_worker.js"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "formfill-smart@listifyhub.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}