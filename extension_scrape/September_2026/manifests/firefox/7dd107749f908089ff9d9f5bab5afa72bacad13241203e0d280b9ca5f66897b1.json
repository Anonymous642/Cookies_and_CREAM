{"manifest_version": 3, "name": "TCGplayer Card Dimension Filter", "version": "1.0.0", "description": "Filter TCGplayer listings by the actual physical dimensions of the cards, so you only see cards that fit your sleeves, binders, and loaders.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage"], "host_permissions": ["*://*.tcgplayer.com/*"], "content_scripts": [{"matches": ["*://*.tcgplayer.com/*"], "css": ["src/styles/panel.css"], "js": ["src/content/logger.js", "src/data/dimensions.js", "src/data/overrides.js", "src/content/identity-resolver.js", "src/content/dimension-resolver.js", "src/content/product-detector.js", "src/content/filter-engine.js", "src/content/ui-panel.js", "src/content/dynamic-loader.js", "src/content/index.js"], "run_at": "document_idle"}], "background": {"scripts": ["src/background.js"]}, "browser_specific_settings": {"gecko": {"id": "tcg-dimension-filter@yeegy.dev", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}