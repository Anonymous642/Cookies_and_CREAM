{"manifest_version": 3, "name": "Miftah", "version": "1.1.1", "description": "Convert text typed in the wrong keyboard layout between English and Arabic", "permissions": ["contextMenus", "scripting", "activeTab"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "keyboard-exchange@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"convert-to-arabic": {"suggested_key": {"default": "Alt+Shift+A"}, "description": "Convert selected text to Arabic"}, "convert-to-english": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Convert selected text to English"}}}