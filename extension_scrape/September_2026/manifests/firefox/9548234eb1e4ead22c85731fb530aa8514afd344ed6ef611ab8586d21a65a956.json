{"manifest_version": 3, "name": "DynamicSpeed for YouTube", "description": "Automatically match YouTube playback speed to your target words-per-minute.", "version": "1.4.0", "short_name": "DynamicSpeed", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage"], "host_permissions": ["*://www.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*", "*://music.youtube.com/*", "*://www.youtube-nocookie.com/*", "*://youtube-nocookie.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self';"}, "browser_specific_settings": {"gecko": {"id": "dynamicspeed-for-youtube@dynamicspeed", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "commands": {"toggle-enabled": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Toggle DynamicSpeed"}, "wpm-up": {"suggested_key": {"default": "Alt+Shift+W"}, "description": "Increase target WPM by 10"}, "wpm-down": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Decrease target WPM by 10"}, "force-1x": {"description": "Pause automation and set 1\u00d7"}, "toggle-broll": {"description": "Toggle b-roll acceleration"}}, "action": {"default_title": "DynamicSpeed", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["*://m.youtube.com/*", "*://music.youtube.com/*", "*://www.youtube-nocookie.com/*", "*://www.youtube.com/*", "*://youtube-nocookie.com/*", "*://youtube.com/*"], "run_at": "document_start", "js": ["content-scripts/youtube-player.js"], "world": "MAIN"}, {"matches": ["*://m.youtube.com/*", "*://music.youtube.com/*", "*://www.youtube-nocookie.com/*", "*://www.youtube.com/*", "*://youtube-nocookie.com/*", "*://youtube.com/*"], "run_at": "document_idle", "js": ["content-scripts/youtube.js"]}]}