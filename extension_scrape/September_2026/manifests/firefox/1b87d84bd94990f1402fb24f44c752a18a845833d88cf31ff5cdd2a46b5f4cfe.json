{"manifest_version": 2, "name": "SafeSession Privacy Shield", "version": "1.0.0", "description": "Review and apply Firefox privacy settings locally. SafeSession makes no network requests and does not claim to change your public IP.", "browser_specific_settings": {"gecko": {"id": "safesession@privacy-shield.local", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}, "permissions": ["privacy", "storage"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "SafeSession Privacy Shield", "default_popup": "popup.html", "default_icon": {"32": "icons/shield-32.svg", "64": "icons/shield-64.svg"}}, "icons": {"32": "icons/shield-32.svg", "64": "icons/shield-64.svg"}, "options_ui": {"page": "dashboard.html", "open_in_tab": true}, "content_security_policy": "script-src 'self'; object-src 'none'"}