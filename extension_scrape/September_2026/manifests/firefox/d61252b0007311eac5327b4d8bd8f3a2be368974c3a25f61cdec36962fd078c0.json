{"manifest_version": 3, "name": "Ruhrbarone Browser Suite", "short_name": "Ruhrbarone", "version": "1.6", "description": "Neue Ruhrbarone-Artikel, Faktencheck, Melder und Kontext fuer Nachrichtenseiten.", "action": {"default_title": "Ruhrbarone", "default_popup": "src/popup/popup.html", "default_icon": {"16": "src/icons/icon16.png", "32": "src/icons/icon32.png", "48": "src/icons/icon48.png", "128": "src/icons/icon128.png"}}, "background": {"scripts": ["src/assets/serviceWorker.js"], "type": "module"}, "options_page": "src/options/options.html", "permissions": ["storage", "alarms", "notifications", "contextMenus", "activeTab"], "host_permissions": ["http://*/*", "https://*/*"], "icons": {"16": "src/icons/icon16.png", "32": "src/icons/icon32.png", "48": "src/icons/icon48.png", "128": "src/icons/icon128.png"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["https://chromewebstore.google.com/*", "https://addons.mozilla.org/*", "https://microsoftedge.microsoft.com/*", "https://addons.opera.com/*", "https://appstoreconnect.apple.com/*", "https://apps.apple.com/*", "https://www.ruhrbarone.de/wp-admin/*"], "js": ["src/assets/contextOverlay.js", "src/assets/contextDetector.js"], "css": ["src/assets/context.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/icons/icon48.png"], "matches": ["http://*/*", "https://*/*"]}], "browser_specific_settings": {"gecko": {"id": "ruhrbarone-browser-suite@ruhrbarone.de", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "searchTerms", "personallyIdentifyingInfo"]}}}}