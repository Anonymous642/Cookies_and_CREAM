{"manifest_version": 3, "name": "LeetCode Time Tracker", "version": "1.0.0", "description": "Automatically tracks how long you spend on each LeetCode problem, syncs across your devices, and counts down your 10,000 hours.", "browser_specific_settings": {"gecko": {"id": "leetcode-time-tracker@mutony", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "unlimitedStorage", "alarms", "idle", "tabs"], "host_permissions": ["*://leetcode.com/*", "*://*.leetcode.com/*"], "background": {"scripts": ["src/common/constants.js", "src/common/util.js", "src/common/store.js", "src/common/sync.js", "src/common/stats.js", "src/background/background.js"]}, "content_scripts": [{"matches": ["*://leetcode.com/*", "*://*.leetcode.com/*"], "js": ["src/common/constants.js", "src/common/util.js", "src/content/content.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_title": "LeetCode Time Tracker", "default_popup": "src/popup/popup.html", "default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}, "options_ui": {"page": "src/options/options.html", "open_in_tab": true}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}