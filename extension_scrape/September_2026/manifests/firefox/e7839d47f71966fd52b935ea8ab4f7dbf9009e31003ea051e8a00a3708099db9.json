{"manifest_version": 2, "name": "Sentinel ID", "version": "0.3.0", "description": "A better MFA experience \u2014 replace Duo Universal Prompt with your chosen auth style.", "author": "Sentinel ID", "browser_specific_settings": {"gecko": {"id": "sentinel-id@sentinelid.io", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": "icons/icon48.png", "default_title": "Sentinel ID"}, "background": {"scripts": ["background/background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://*.rit.edu/*", "*://*.mycourses.rit.edu/*", "*://*.shibboleth.main.ad.rit.edu/*", "*://*.login.microsoftonline.com/*"], "js": ["content/passkey.js", "content/content.js"], "css": ["content/sentinel.css"], "run_at": "document_idle", "all_frames": false}, {"matches": ["*://*.duosecurity.com/*", "*://duosecurity.com/*"], "js": ["content/duo-bridge.js"], "run_at": "document_start", "all_frames": true}], "permissions": ["storage", "activeTab", "tabs", "*://*.duosecurity.com/*", "*://*.rit.edu/*", "*://*.mycourses.rit.edu/*", "*://*.shibboleth.main.ad.rit.edu/*"], "web_accessible_resources": ["content/sentinel.css", "content/passkey.js", "icons/icon48.png"]}