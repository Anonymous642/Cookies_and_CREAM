{"manifest_version": 3, "name": "Vivya PDF", "version": "1.0.6", "description": "Open PDF links directly in Vivya PDF viewer instead of the browser viewer.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "vivyapdf@vivya.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "webNavigation", "webRequest", "webRequestBlocking", "downloads", "storage", "nativeMessaging"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https: http: file:;"}, "background": {"scripts": ["browser-polyfill.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["browser-polyfill.js", "content.js"], "run_at": "document_start", "all_frames": false}], "web_accessible_resources": [{"resources": ["viewer.html", "viewer.js", "viewer.css", "lib/*", "browser-polyfill.js"], "matches": ["<all_urls>"]}], "action": {"default_popup": "popup.html", "default_title": "Open in Vivya PDF", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}