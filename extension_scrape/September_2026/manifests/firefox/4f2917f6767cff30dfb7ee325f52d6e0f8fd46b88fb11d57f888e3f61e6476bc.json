{"manifest_version": 2, "name": "BibleVerse Gate", "version": "1.1.0", "description": "Block distracting sites with a mindful Bible verse typing challenge.", "author": "Alfred Xavier", "browser_specific_settings": {"gecko": {"id": "bibleversegate@alfredxavier.com", "strict_min_version": "88.0"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage", "tabs", "contextMenus", "notifications", "webNavigation", "<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content-blocker.js"], "run_at": "document_idle"}], "web_accessible_resources": ["icons/*", "verses.min.json", "quotes.min.json", "dashboard_build/*"], "offline_enabled": true}