{"manifest_version": 3, "name": "Price Finder Extension", "version": "1.0", "description": "Find best price deals and price history across multiple stores.", "permissions": ["storage", "activeTab", "tabs"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.amazon.in/*", "*://*.flipkart.com/*", "*://*.ajio.com/*", "*://*.myntra.com/*", "*://*.meesho.com/*"], "js": ["content.js"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "price-finder-extension@example.com", "data_collection_permissions": {"required": ["none"]}}}}