{"manifest_version": 2, "name": "20-20-20 Lookaway", "version": "1.1.1", "description": "Every 20 minutes a gentle beep reminds you to look away for 20 seconds, then another beep tells you when to look back.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "menus"], "background": {"scripts": ["sound.js", "background.js"], "persistent": true}, "browser_action": {"default_icon": "icons/stopwatch-grey.svg", "default_title": "20-20-20 Lookaway: click to start", "default_area": "navbar"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "lookaway@dailyrushes.store", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}