{"manifest_version": 3, "name": "ApplyCandid", "version": "1.2.8", "description": "AI-powered job application assistant for LinkedIn, Indeed, and Naukri. Auto-scores, tailors resume, and applies to matching jobs.", "permissions": ["storage", "activeTab", "scripting", "alarms", "webNavigation"], "host_permissions": ["https://www.linkedin.com/*", "https://www.naukri.com/*", "https://*.indeed.com/*", "<all_urls>"], "background": {"scripts": ["background/service-worker.js"], "type": "module"}, "content_scripts": [{"matches": ["https://www.linkedin.com/jobs/*"], "js": ["content/linkedin.js"], "run_at": "document_idle"}, {"matches": ["https://www.naukri.com/*"], "js": ["content/naukri.js"], "run_at": "document_idle"}, {"matches": ["https://*.indeed.com/*"], "js": ["content/indeed.js"], "run_at": "document_idle"}], "sidebar_action": {"default_panel": "sidepanel/sidepanel.html", "default_title": "ApplyCandid", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": [{"resources": ["lib/pdfjs/pdf.worker.min.js"], "matches": ["<all_urls>"]}], "externally_connectable": {"matches": ["https://applycandid.com/*"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "applycandid@applycandid.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent", "personallyIdentifyingInfo"], "optional": ["technicalAndInteraction"]}}}}