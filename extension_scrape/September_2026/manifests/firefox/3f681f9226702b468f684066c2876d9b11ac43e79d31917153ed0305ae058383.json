{"manifest_version": 2, "name": "SiteCut", "version": "1.0.0", "description": "Instantly open any URL with a custom keyboard shortcut.", "author": "SiteCut", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "default_title": "SiteCut"}, "background": {"scripts": ["background.js"], "persistent": false}, "options_ui": {"page": "settings/settings.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "sitecut@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage", "tabs", "commands"], "commands": {"shortcut-1": {"suggested_key": {"default": "Ctrl+Shift+1"}, "description": "Open shortcut 1"}, "shortcut-2": {"suggested_key": {"default": "Ctrl+Shift+2"}, "description": "Open shortcut 2"}, "shortcut-3": {"suggested_key": {"default": "Ctrl+Shift+3"}, "description": "Open shortcut 3"}, "shortcut-4": {"suggested_key": {"default": "Ctrl+Shift+4"}, "description": "Open shortcut 4"}, "shortcut-5": {"suggested_key": {"default": "Ctrl+Shift+5"}, "description": "Open shortcut 5"}, "shortcut-6": {"suggested_key": {"default": "Ctrl+Shift+6"}, "description": "Open shortcut 6"}, "shortcut-7": {"suggested_key": {"default": "Ctrl+Shift+7"}, "description": "Open shortcut 7"}, "shortcut-8": {"suggested_key": {"default": "Ctrl+Shift+8"}, "description": "Open shortcut 8"}, "shortcut-9": {"suggested_key": {"default": "Ctrl+Shift+9"}, "description": "Open shortcut 9"}}}