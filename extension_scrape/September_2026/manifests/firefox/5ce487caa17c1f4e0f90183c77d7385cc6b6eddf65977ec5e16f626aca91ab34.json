{"manifest_version": 3, "name": "Domain Download Organizer", "version": "1.1.1", "description": "Automatically organizes downloads into subfolders based on the domain they came from.", "browser_specific_settings": {"gecko": {"id": "DanDeGagne@gmail.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["downloads", "storage", "tabs", "notifications"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Domain Download Organizer", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "host_permissions": ["*://*/*"], "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["page-hook.js"], "matches": ["*://*/*"]}]}