{"author": "sasa cocic-banjanac", "manifest_version": 3, "name": "Cap", "version": "1.1.23", "description": "A way to block websites that you don't want to visit, because they are destorying your life", "icons": {"16": "icons/hat-16.png", "48": "icons/hat-48.png", "128": "icons/hat-128.png"}, "action": {"default_popup": "popup.html"}, "permissions": ["tabs", "storage", "alarms", "idle", "scripting"], "host_permissions": ["*://*/*"], "browser_specific_settings": {"gecko": {"id": "failsafe@failsafe.id", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "web_accessible_resources": [{"resources": ["bw.html", "fonts/Poppins/Poppins-Regular.ttf"], "matches": ["*://*/*"]}], "content_scripts": [{"matches": ["*://*/*"], "js": ["block-website.js"], "css": ["bw.css"]}]}