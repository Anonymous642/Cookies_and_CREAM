{"manifest_version": 2, "name": "FormSpackle", "description": "Fill every input on any page with realistic mock data \u2014 one click.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab", "scripting", "storage", "contextMenus", "<all_urls>"], "page_action": {"default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "formspackle@formspackle.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Default Popup Title", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["*://*/*", "file://*/*"], "js": ["content-scripts/content.js"]}]}