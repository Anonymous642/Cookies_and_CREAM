{"manifest_version": 2, "name": "browlighter", "version": "0.1.5", "description": "Save highlighted page text and images in Firefox local storage.", "permissions": ["unlimitedStorage", "storage", "contextMenus", "tabs"], "background": {"scripts": ["core.js", "background.js"]}, "commands": {"save-selected-text": {"suggested_key": {"default": "Ctrl+Shift+I", "mac": "Command+Shift+I"}, "description": "Save the current text selection"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["core.js", "content-script.js"]}], "browser_action": {"default_title": "Save highlighted text and images locally", "default_icon": {"16": "icons/browlighter-16.png", "32": "icons/browlighter-32.png", "48": "icons/browlighter-48.png"}}, "icons": {"48": "icons/browlighter-48.png", "96": "icons/browlighter-96.png", "128": "icons/browlighter-128.png"}, "browser_specific_settings": {"gecko": {"id": "firefox-browlighter@sci2pro.com", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}}}}