{"manifest_version": 3, "name": "Second Thought", "version": "0.0.3", "browser_specific_settings": {"gecko": {"id": "@second-thought", "data_collection_permissions": {"required": ["none"]}}}, "description": "Before you dive in, Second Thought shows how often you've visited a site today and this week \u2014 then lets you decide.", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "action": {"default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "default_popup": "popup/popup.html", "default_title": "Second Thought"}, "background": {"service_worker": "background.js", "scripts": ["browser-polyfill.min.js", "background.js"]}, "permissions": ["storage", "tabs"], "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["browser-polyfill.min.js", "content.js"], "run_at": "document_start"}]}