{"manifest_version": 3, "name": "neuro-rsvp", "version": "3.0.0", "description": "Select any text and speed-read it with an in-page RSVP reader (red-pivot, smart pacing, custom WPM).", "browser_specific_settings": {"gecko": {"id": "neuro-rsvp@local", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "scripting", "storage", "contextMenus"], "host_permissions": ["<all_urls>"], "icons": {"16": "icon.svg", "32": "icon.svg", "48": "icon.svg", "128": "icon.svg"}, "action": {"default_title": "neuro-rsvp \u2014 toggle reader (Alt+Shift+R)", "default_icon": "icon.svg"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["panel.js"], "run_at": "document_idle"}], "commands": {"read-selection": {"suggested_key": {"default": "Alt+R"}, "description": "Read the current selection with RSVP"}, "toggle-panel": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Toggle the RSVP panel"}, "read-page": {"suggested_key": {"default": "Alt+Shift+P"}, "description": "Extract and read the main article on the page"}}}