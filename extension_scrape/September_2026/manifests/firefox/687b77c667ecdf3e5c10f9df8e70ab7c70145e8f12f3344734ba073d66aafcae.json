{"manifest_version": 3, "name": "wantzIt", "version": "0.1.11", "description": "Save products to your wantzIt wishlists from any shopping site.", "browser_specific_settings": {"gecko": {"id": "wantzit@wantzit.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "src/popup.html", "default_title": "wantzIt", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["src/popup.html", "popup.js", "assets/*", "icons/*"], "matches": ["<all_urls>"]}]}