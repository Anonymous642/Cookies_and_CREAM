{"manifest_version": 3, "name": "Run Python Script", "version": "1.0.3", "description": "Runs a Python script. The user specifies the Python interpreter and script filepaths in the extension's options. When the extension runs, it gets the page's element with ID `global-data-shared-with-python-script-running-extension` and passes that element's dataset as a JSON-formatted string to the Python script as the only argument.", "permissions": ["activeTab", "downloads", "nativeMessaging", "notifications", "storage", "tabs"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"]}], "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["Example.zip", "HandlerChainFiles/com.calan.hugh.run_python_script.bat", "HandlerChainFiles/com.calan.hugh.run_python_script.firefox.json", "HandlerChainFiles/com.calan.hugh.run_python_script.native_message_interpreter.py", "HandlerChainFiles/SetUpHandlerChain.py"], "matches": ["<all_urls>"]}], "icons": {"48": "icons/icon_48.png", "64": "icons/icon_64.png", "96": "icons/icon_96.png", "128": "icons/icon_128.png"}, "action": {"default_icon": {"48": "icons/icon_48.png", "64": "icons/icon_64.png", "96": "icons/icon_96.png", "128": "icons/icon_128.png"}, "default_title": "Run Python Script"}, "browser_specific_settings": {"gecko": {"id": "RunPythonScript@Hugh.Calan.com", "data_collection_permissions": {"required": ["websiteContent"]}}}}