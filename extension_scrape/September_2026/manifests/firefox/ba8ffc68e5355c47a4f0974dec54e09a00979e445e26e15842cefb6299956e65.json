{"manifest_version": 3, "name": "Arithmetic Tracker for Zetamac", "version": "1.3.0", "description": "Track scores on arithmetic.zetamac.com, visualize progress locally, and sync runs to Google Sheets.", "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "Zetamac Tracker"}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "permissions": ["storage", "scripting", "tabs", "webNavigation", "webRequest"], "host_permissions": ["*://zetamac.com/*", "*://*.zetamac.com/*", "https://script.google.com/*", "https://*.googleusercontent.com/*"], "content_scripts": [{"matches": ["*://zetamac.com/*", "*://*.zetamac.com/*"], "all_frames": true, "match_about_blank": true, "js": ["content/content.js"], "run_at": "document_end"}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "{980781c8-7830-45dd-9b95-8995690fa9c8}", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "websiteActivity", "websiteContent"]}}}}