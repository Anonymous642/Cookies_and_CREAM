{"manifest_version": 3, "name": "Smart Tab Hibernator", "version": "1.0", "description": "An automated utility designed to reduce browser memory usage by unloading background processes and stale web infrastructure.", "permissions": ["tabs", "browsingData", "storage", "alarms", "scripting"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "smart-tab-hibernator@local-extension", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}}