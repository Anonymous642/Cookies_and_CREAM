{"manifest_version": 3, "name": "Tab Wallpaper Previewer", "version": "1.0", "description": "Generate quick wallpaper previews from the current tab's background image. Crops 16:9, 9:16, 1:1.", "action": {"default_title": "Wallpaper Preview", "default_popup": "popup.html"}, "permissions": ["tabs", "activeTab", "scripting"], "browser_specific_settings": {"gecko": {"id": "tabwallpaperpre@local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}