{"manifest_version": 2, "name": "MarkSift", "version": "1.0.0", "description": "Send selected text to MarkSift and convert it to clean Markdown for AI workflows.", "permissions": ["contextMenus", "storage", "https://mark-sift.com/*", "https://www.mark-sift.com/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "MarkSift", "default_popup": "popup.html"}, "icons": {"16": "icon.svg", "32": "icon.svg", "48": "icon.svg", "128": "icon.svg"}, "browser_specific_settings": {"gecko": {"id": "marksift@local", "data_collection_permissions": {"required": ["websiteContent"]}}}}