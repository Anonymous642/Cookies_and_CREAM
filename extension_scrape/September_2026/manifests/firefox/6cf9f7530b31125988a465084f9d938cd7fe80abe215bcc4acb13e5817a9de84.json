{"manifest_version": 3, "name": "OffDuty Planner", "version": "1.0.5", "description": "Save any page \u2014 a map, a review, a video, a booking \u2014 into a shared plan so your group can see it and decide together.", "permissions": ["activeTab", "storage", "scripting"], "action": {"default_popup": "popup/popup.html", "default_title": "OffDuty Planner", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "background": {"type": "module", "scripts": ["background.js"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "offduty-planner@rosterarchitect.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "personallyIdentifyingInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "host_permissions": ["https://rosterarchitect.com/*", "https://www.rosterarchitect.com/*"], "content_scripts": [{"matches": ["https://rosterarchitect.com/extension/*", "https://www.rosterarchitect.com/extension/*"], "js": ["relay.js"], "run_at": "document_idle"}]}