{"manifest_version": 2, "name": "buyPal", "version": "1.1.0", "description": "buyPal - Dein Shopping Assistant. Erfasst automatisch deine Eink\u00e4ufe und hilft dir, deine Ausgaben im Blick zu behalten.", "browser_specific_settings": {"gecko": {"id": "buypal@mybuypal.com", "strict_min_version": "58.0"}, "gecko_android": {"strict_min_version": "113.0"}}, "permissions": ["activeTab", "tabs", "storage", "cookies", "<all_urls>", "webNavigation", "alarms"], "background": {"scripts": ["buypalback.js"], "persistent": false}, "browser_action": {"default_icon": {"36": "icons/android-icon-36x36.png", "48": "icons/android-icon-48x48.png", "72": "icons/android-icon-72x72.png", "96": "icons/android-icon-96x96.png", "144": "icons/android-icon-144x144.png", "192": "icons/android-icon-192x192.png"}, "default_title": "buypal"}, "icons": {"36": "icons/android-icon-36x36.png", "48": "icons/android-icon-48x48.png", "72": "icons/android-icon-72x72.png", "96": "icons/android-icon-96x96.png", "144": "icons/android-icon-144x144.png", "192": "icons/android-icon-192x192.png"}, "content_scripts": [{"matches": ["<all_urls>", "*://*/*", "file:///*"], "js": ["buypalfront.js"], "all_frames": true, "match_about_blank": true}], "web_accessible_resources": ["*"], "content_security_policy": "script-src 'self'; object-src 'self';", "options_ui": {"page": "options.html", "browser_style": true}, "author": "Lumiflow UG", "homepage_url": "https://mybuypal.com", "developer": {"name": "Lumiflow UG", "url": "https://mybuypal.com"}}