{"manifest_version": 3, "name": "YTMusicGenius", "version": "1.0.1", "description": "It gives you the Genius URL for the song you are listening to right now on YT Music", "permissions": ["tabs", "scripting"], "host_permissions": ["https://music.youtube.com/*", "https://genius.com/*", "https://pitchfork.com/*"], "action": {"default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "ytmusicgenius@example.com", "strict_min_version": "109.0"}}}