{"manifest_version": 3, "name": "Lofi Player", "version": "2.1.0", "description": "A calm lofi player in its own window: bundled royalty-free tracks and loops, crossfade, EQ, sleep timer and media-key support.", "permissions": ["storage"], "action": {"default_title": "Open Lofi Player"}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"play-pause": {"suggested_key": {"default": "Ctrl+Shift+Space"}, "description": "Play or pause"}, "next-track": {"description": "Next track"}, "prev-track": {"description": "Previous track"}}, "browser_specific_settings": {"gecko": {"id": "lofi-player@quizthespire.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}