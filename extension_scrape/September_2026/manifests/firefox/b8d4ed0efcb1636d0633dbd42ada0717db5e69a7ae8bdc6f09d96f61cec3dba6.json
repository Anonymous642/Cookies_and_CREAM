{"manifest_version": 2, "name": "Remy", "description": "Set tab reminders with a right-click or keyboard shortcut", "version": "0.1.0", "icons": {"16": "icon/16.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "alarms", "contextMenus", "notifications", "scripting", "storage", "tabs", "identity"], "commands": {"set-reminder": {"suggested_key": {"default": "Alt+Shift+R", "mac": "MacCtrl+Shift+R"}, "description": "Set a reminder for the current tab"}}, "omnibox": {"keyword": "remy"}, "optional_permissions": ["https://api.todoist.com/api/v1/*", "https://tasks.googleapis.com/tasks/v1/*"], "browser_specific_settings": {"gecko": {"id": "remy@reminders.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["websiteContent"]}}}, "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidepanel.html", "default_title": "Remy"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/toast.js"]}], "web_accessible_resources": ["content-scripts/toast.css"], "browser_action": {"default_title": "Remy - Tab Reminders"}}