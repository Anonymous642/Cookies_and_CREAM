{"manifest_version": 3, "name": "Mangas Origines Filtre", "version": "2.0.0", "description": "Filtre les mangas/manhwa selon un seuil de chapitre choisi et utilise un catalogue local optimis\u00e9.", "browser_specific_settings": {"gecko": {"id": "mangas-origines-filtre@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"16": "icons/Origines_16x16.png", "48": "icons/Origines_48x48.png", "128": "icons/Origines_128x128.png"}, "permissions": ["storage"], "host_permissions": ["https://mangas-origines.fr/*"], "background": {"scripts": ["dist/background.js"]}, "content_scripts": [{"matches": ["https://mangas-origines.fr/catalogues/*", "https://mangas-origines.fr/manga-genres/*"], "js": ["dist/content.js"], "run_at": "document_idle"}]}