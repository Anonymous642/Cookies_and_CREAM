{"manifest_version": 3, "name": "Hibernating Tabs", "version": "1.0", "description": "Automatically hibernate inactive tabs to save system resources.", "permissions": ["storage", "tabs", "activeTab", "scripting"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "hibernatingTabs@correia.extensions", "strict_min_version": "128.0"}}}