{"manifest_version": 3, "name": "ReddiTab", "version": "1.0.1", "description": "Open Reddit posts in a new background tab when you click them, instead of navigating the current tab.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "{0eab0214-1e43-4f95-8934-355a09233ef0}", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.reddit.com/*", "*://reddit.com/*"], "js": ["content.js"]}]}