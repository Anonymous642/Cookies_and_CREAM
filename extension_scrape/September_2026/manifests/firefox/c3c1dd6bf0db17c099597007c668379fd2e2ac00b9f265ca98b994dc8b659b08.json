{"manifest_version": 2, "name": "HLSify++", "default_locale": "en_US", "description": "Native HLS playback for any HTML5 video element. Fork of HLSify with additional features and fixes.", "author": "cyan-n1d3", "version": "1.1", "homepage_url": "https://github.com/cyan-n1d3/hlsify-fork", "browser_specific_settings": {"gecko": {"id": "hlsifyplus@cyan-n1d3.github.com", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["<all_urls>", "webRequest", "webRequestBlocking"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"js": ["content.js"], "run_at": "document_start", "matches": ["<all_urls>"]}], "web_accessible_resources": ["hls.js", "plyr.js", "plyr.css", "plyr.svg"], "content_security_policy": "script-src 'self'; object-src 'self'; worker-src blob: 'self'"}