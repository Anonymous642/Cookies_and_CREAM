{"manifest_version": 2, "name": "NightRide FM", "version": "2.0.0", "description": "Play NightRide FM and sister channels from your toolbar.", "icons": {"48": "icons/icon48.svg"}, "browser_specific_settings": {"gecko": {"id": "whatever@whatever.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "browser_action": {"default_popup": "popup.html", "default_title": "NightRide FM", "default_icon": {"48": "icons/icon48.svg"}}, "background": {"scripts": ["background.js"], "persistent": true}, "permissions": ["storage", "https://nightride.fm/*"], "commands": {"_execute_browser_action": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Open NightRide FM"}, "volume-up": {"suggested_key": {"default": "Ctrl+Shift+Up"}, "description": "Volume up (+10%)"}, "volume-down": {"suggested_key": {"default": "Ctrl+Shift+Down"}, "description": "Volume down (-10%)"}, "next-channel": {"suggested_key": {"default": "Ctrl+Shift+Right"}, "description": "Next channel"}, "prev-channel": {"suggested_key": {"default": "Ctrl+Shift+Left"}, "description": "Previous channel"}, "toggle-play": {"suggested_key": {"default": "Ctrl+Shift+Space"}, "description": "Play / Pause"}}}