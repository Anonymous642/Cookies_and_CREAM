{"manifest_version": 3, "name": "ChatGPT Search for Firefox", "version": "1.0.1", "description": "Make ChatGPT Search your default Firefox search engine.", "icons": {"16": "images/icon16.png", "19": "images/icon19.png", "38": "images/icon38.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "chrome_settings_overrides": {"search_provider": {"name": "ChatGPT", "keyword": "chatgpt.com", "favicon_url": "images/icon16.png", "search_url": "https://chatgpt.com/?q={searchTerms}&hints=search&ref=ext", "encoding": "UTF-8", "is_default": true}}, "content_scripts": [{"matches": ["https://*.chatgpt.com/*"], "js": ["content_script.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "chatgpt-search-for-firefox@extension.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["searchTerms"]}}, "gecko_android": {"strict_min_version": "142.0"}}}