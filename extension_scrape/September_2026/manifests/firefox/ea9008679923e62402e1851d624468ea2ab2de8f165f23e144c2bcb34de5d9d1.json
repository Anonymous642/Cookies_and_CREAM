{"manifest_version": 3, "name": "YouTube Extra", "version": "1.3.2", "description": "Custom UI changes for YouTube + keyboard shortcuts", "permissions": ["storage", "activeTab"], "host_permissions": ["*://www.youtube.com/*"], "icons": {"20": "icons/icon_20.png", "80": "icons/icon_80.png", "160": "icons/icon_160.png"}, "action": {"default_popup": "popup.html", "default_icon": {"20": "icons/icon_20.png", "80": "icons/icon_80.png", "160": "icons/icon_160.png"}}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "youtube-ui-enhancer@yourdomain.com"}}}