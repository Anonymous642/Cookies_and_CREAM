{"manifest_version": 3, "name": "Miguelnut Watchtime", "version": "3.1.0", "description": "Conta seu tempo nas lives do Miguelnut no YouTube e no Kick e abre as lives sozinha quando entram no ar (Auto Check).", "permissions": ["tabs", "storage", "alarms", "scripting"], "host_permissions": ["*://*.youtube.com/*", "*://*.kick.com/*", "*://miguelnut.com.br/*", "*://www.miguelnut.com.br/*"], "optional_host_permissions": ["*://*.twitch.tv/*"], "background": {"service_worker": "background.js", "scripts": ["background.js", "autofarm.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content-youtube.js"], "run_at": "document_idle"}, {"matches": ["*://*.kick.com/*"], "js": ["content-kick.js"], "run_at": "document_idle"}, {"matches": ["*://miguelnut.com.br/*", "*://www.miguelnut.com.br/*"], "js": ["content-site.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Miguelnut Watchtime", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "watchtime@miguelnut.com.br", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteActivity"], "optional": ["technicalAndInteraction"]}}}}