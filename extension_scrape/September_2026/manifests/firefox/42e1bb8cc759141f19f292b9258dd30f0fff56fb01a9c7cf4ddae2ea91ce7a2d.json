{"manifest_version": 3, "name": "Play Store Review Finder", "version": "1.0", "description": "Automatically find and highlight Play Store reviews", "browser_specific_settings": {"gecko": {"id": "review-finder@rupeek.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["https://play.google.com/*"], "content_scripts": [{"matches": ["https://play.google.com/store/apps/details*"], "js": ["content.js"], "run_at": "document_end"}], "icons": {"48": "icon48.png", "128": "icon128.png"}}