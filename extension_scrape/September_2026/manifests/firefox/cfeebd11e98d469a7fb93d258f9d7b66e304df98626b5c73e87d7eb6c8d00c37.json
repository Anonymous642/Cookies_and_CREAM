{"manifest_version": 2, "name": "Tab Vault", "description": "Sweep, search and restore tab sessions.", "version": "0.0.5", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "storage", "downloads"], "content_scripts": [{"matches": ["https://tab-vault.hexd.space/*"], "js": ["content-scripts/public-proxy.js"], "run_at": "document_end"}, {"matches": ["https://tab-vault.hexd.space/*"], "js": ["content-scripts/public-proxy.js"]}], "commands": {"open-search": {"suggested_key": {"default": "Ctrl+Shift+F", "mac": "Command+Shift+F"}, "description": "Open Tab Vault dashboard"}, "sweep-tabs": {"suggested_key": {"default": "Ctrl+Shift+L", "mac": "Command+Shift+L"}, "description": "Sweep open tabs"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "tab-vault@hexd.space", "strict_min_version": "115.0"}}, "browser_action": {"default_popup": "popup.html"}}