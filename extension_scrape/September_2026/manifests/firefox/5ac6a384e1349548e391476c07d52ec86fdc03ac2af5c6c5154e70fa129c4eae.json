{"manifest_version": 3, "name": "No Shorts Video", "description": "Boost productivity by blocking Shorts & Reels. Redirects Shorts, hides distractions, and offers one-click customizable blocking.", "version": "1.0.0", "browser_specific_settings": {"gecko": {"id": "noshorts@vortech"}}, "action": {"default_popup": "index.html", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["storage"], "host_permissions": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.instagram.com/*", "*://*.tiktok.com/*"], "js": ["content.js"], "run_at": "document_start"}]}