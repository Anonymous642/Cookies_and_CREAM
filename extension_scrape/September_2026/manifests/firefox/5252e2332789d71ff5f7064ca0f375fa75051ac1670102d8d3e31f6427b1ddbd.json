{"manifest_version": 3, "name": "PostSpark - Screenshot Editor & Mockup Tool", "version": "1.0.0", "description": "A screenshot editor and mockup tool for designers. Capture a selected area, one element, or the full scrolling page, then finish it with backgrounds, effects, and annotations.", "browser_specific_settings": {"gecko": {"id": "extension@postspark.app", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "permissions": ["activeTab", "scripting", "contextMenus"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "host_permissions": ["https://postspark.app/*"], "web_accessible_resources": [{"resources": ["assets/content.css", "assets/popup.css", "fonts/*"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}