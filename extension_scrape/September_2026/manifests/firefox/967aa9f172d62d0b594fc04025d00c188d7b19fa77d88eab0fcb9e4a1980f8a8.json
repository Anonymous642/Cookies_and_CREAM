{"manifest_version": 2, "name": "ReClyp - Screen recordings and Video Editor", "description": "Record your screen, edit with cuts & zoom, and export in seconds", "version": "1.0.5", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs", "activeTab"], "web_accessible_resources": ["preview.html", "icon/*", "content-scripts/content.css"], "commands": {"toggle-recording": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "Start/Stop recording"}}, "browser_specific_settings": {"gecko": {"id": "reclyp@reclyp.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"]}], "browser_action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}}}