{"manifest_version": 2, "name": "Old Reddit Plus", "version": "3.1.34", "description": "A modern overhaul for old.reddit.com: inline images, galleries and videos like card view, themes (incl. Hacker News), a built-in reader, mobile layout and lots of optional cleanup.", "author": "butterboat", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "old-reddit-cardview@migtorr.local", "strict_min_version": "89.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["<all_urls>", "webRequest", "webRequestBlocking", "storage"], "web_accessible_resources": ["sprite-reddit.png"], "background": {"scripts": ["defaults.js", "background.js"], "persistent": false}, "options_ui": {"page": "options.html"}, "browser_action": {"default_title": "Old Reddit Plus preferences", "default_popup": "options.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["*://old.reddit.com/*"], "js": ["early.js"], "css": ["content.css", "dark.css", "hn.css", "mobile.css"], "run_at": "document_start"}, {"matches": ["*://old.reddit.com/*"], "js": ["defaults.js", "content.js"], "run_at": "document_idle"}]}