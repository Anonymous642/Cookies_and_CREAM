{"manifest_version": 3, "name": "Open Page in Popup", "version": "1.0", "description": "Adds a top left button to open the current page in a clean, minimal interface popup window.", "permissions": ["tabs", "activeTab"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"32": "icons/icon_32.png", "64": "icons/icon_64.png", "128": "icons/icon_128.png"}, "browser_specific_settings": {"gecko": {"id": "popup-opener@zbra.com", "strict_min_version": "91.0"}}}