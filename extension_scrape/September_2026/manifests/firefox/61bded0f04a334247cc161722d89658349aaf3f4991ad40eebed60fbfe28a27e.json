{"manifest_version": 2, "name": "Tab Dock", "version": "1.0.0", "description": "Groups all of your open tabs into a taskbar-style dock at the bottom of every page, on mobile and desktop. Tap a chip to jump to a tab.", "author": "you", "browser_specific_settings": {"gecko": {"id": "tab-dock@local", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}, "permissions": ["tabs", "storage", "<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["dock.css"], "run_at": "document_idle"}], "browser_action": {"default_title": "Tab Dock"}}