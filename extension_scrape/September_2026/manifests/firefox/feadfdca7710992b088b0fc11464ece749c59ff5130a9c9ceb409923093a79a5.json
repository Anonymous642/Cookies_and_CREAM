{"manifest_version": 2, "name": "SimpliCEFR", "version": "1.0.0", "description": "Simplify any text or webpage to your target CEFR level.", "homepage_url": "https://www.simplicefr.me", "icons": {"48": "icons/icon.png", "96": "icons/icon.png", "128": "icons/icon.png"}, "browser_action": {"default_icon": {"48": "icons/icon.png", "96": "icons/icon.png"}, "default_title": "SimpliCEFR", "default_popup": "popup/popup.html"}, "permissions": ["activeTab", "storage", "https://www.simplicefr.me/*", "https://identitytoolkit.googleapis.com/*", "https://securetoken.googleapis.com/*"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "background": {"scripts": ["background/background.js"], "persistent": false}, "web_accessible_resources": ["icons/icon.png", "icons/icon.png", "icons/icon.png"], "browser_specific_settings": {"gecko": {"id": "simplicefr@simplicefr.me", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}, "data_collection_policy": "https://simplicefr.me/privacy"}