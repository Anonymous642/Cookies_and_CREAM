{"manifest_version": 3, "name": "Defendshield VulnTrace", "version": "1.0.0", "description": "Scans websites for vulnerable JavaScript libraries (jQuery, Bootstrap, Angular, etc.) and server versions using a comprehensive vulnerability database. Generates detailed security reports.", "author": "sabareesh@defendshieldcybersecurity.com", "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "vulntrace@defendshieldcybersecurity.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["activeTab", "scripting", "webRequest", "storage", "downloads"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["common/vuln_db.js", "background.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "Defendshield VulnTrace", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_scripts/scanner.js"], "run_at": "document_end"}]}