{"manifest_version": 3, "name": "CardTradeMate", "version": "2.2.1", "description": "Import Cardmarket orders with one click, see your own purchase prices while browsing, and check off shipments as you unpack.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["*://cardtrademate.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://cardtrademate.com/*", "*://*.cardtrademate.com/*"], "js": ["content_ctm.js"], "run_at": "document_start"}, {"matches": ["*://*.cardmarket.com/*/*/Orders/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["*://www.cardmarket.com/*/ShoppingCart*"], "js": ["content_cart.js"], "run_at": "document_idle"}, {"matches": ["*://www.cardmarket.com/*/Products/Singles/*/*"], "js": ["content_product.js"], "run_at": "document_idle"}, {"matches": ["*://*.cardmarket.com/*/*/Account/*"], "js": ["content_statement.js"], "run_at": "document_idle"}, {"matches": ["*://www.cardmarket.com/*/Users/*/Offers*"], "js": ["content_seller.js"], "run_at": "document_idle"}, {"matches": ["*://www.cardmarket.com/*/Orders/*/Articles*"], "js": ["content_conditions.js", "content_locations.js", "content_orderarticles.js"], "run_at": "document_idle"}, {"matches": ["*://www.cardmarket.com/*/Orders/*"], "js": ["content_conditions.js", "content_locations.js", "content_orderdetail.js"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "@CardTradeMate", "data_collection_permissions": {"required": ["websiteActivity"]}, "strict_min_version": "140.0"}}}