{"manifest_version": 3, "name": "ivx/ai Chat", "version": "0.2.2", "description": "A lightweight, browser-based chat client designed for users who want total control over their data and their AI interactions.", "homepage_url": "https://ai.ivx.run/chat", "icons": {"16": "icons/ext-16.png", "32": "icons/ext-32.png", "48": "icons/ext-48.png", "128": "icons/ext-128.png"}, "action": {"default_title": "ivx/ai Chat", "default_icon": {"16": "icons/ext-16.png", "32": "icons/ext-32.png", "48": "icons/ext-48.png", "128": "icons/ext-128.png"}}, "optional_host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "sidebar_action": {"default_panel": "index.html", "default_title": "ivx/ai Chat", "default_icon": {"16": "icons/ext-16.png", "32": "icons/ext-32.png", "48": "icons/ext-48.png", "128": "icons/ext-128.png"}}, "permissions": ["webRequest", "webRequestBlocking"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "chat@ivx.run", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}