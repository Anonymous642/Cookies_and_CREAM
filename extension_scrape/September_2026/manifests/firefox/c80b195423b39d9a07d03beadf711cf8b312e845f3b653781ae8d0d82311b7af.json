{"manifest_version": 3, "name": "MP4 Network Downloader", "version": "1.2.0", "description": "Detects video files in network traffic, converts them to MP4, and downloads them.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["webRequest", "downloads", "storage", "tabs", "notifications"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "MP4 Downloader", "default_popup": "popup/popup.html"}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "mp4-downloader@firefox-addon", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}}