{"manifest_version": 3, "name": "Auto Tab Group", "version": "3.2.0", "description": "Automatically group tabs by opener, auto-collapse inactive groups, custom rules, saved groups, and more.", "permissions": ["tabs", "tabGroups", "storage", "contextMenus", "alarms"], "commands": {"toggle-group": {"suggested_key": {"default": "Alt+G"}, "description": "Group or ungroup the current tab"}}, "background": {"scripts": ["defaults.js", "background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "Auto Tab Group"}, "browser_specific_settings": {"gecko": {"id": "tab-grouper@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}