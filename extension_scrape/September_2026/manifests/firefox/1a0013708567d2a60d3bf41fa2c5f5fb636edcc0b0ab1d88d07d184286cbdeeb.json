{"manifest_version": 3, "name": "ReelNotes", "version": "0.1.3", "description": "Save Reels like notes, not links. Connect and save direct from your desktop.", "permissions": ["storage", "contextMenus", "activeTab", "cookies"], "host_permissions": ["https://app.reel-notes.com/*", "https://*.instagram.com/"], "browser_specific_settings": {"gecko": {"id": "extension@reel-notes.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo"], "optional": ["technicalAndInteraction"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "ReelNotes"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}