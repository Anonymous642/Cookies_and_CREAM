{"manifest_version": 3, "name": "djinn", "version": "0.1.0", "description": "Turn a click on a component into a bug report your AI agent can act on.", "permissions": ["scripting", "activeTab"], "optional_host_permissions": ["http://*/*", "https://*/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "djinn \u2014 pick a component", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"toggle-picker": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Arm or disarm the djinn picker"}}, "content_scripts": [{"matches": ["http://localhost/*", "http://127.0.0.1/*", "http://*.localhost/*", "https://localhost/*"], "js": ["relay.js"], "run_at": "document_start"}, {"matches": ["http://localhost/*", "http://127.0.0.1/*", "http://*.localhost/*", "https://localhost/*"], "js": ["main.js"], "world": "MAIN", "run_at": "document_start"}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "djinn@thinato.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}