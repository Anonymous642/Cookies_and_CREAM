{"manifest_version": 2, "name": "Aether Scraper", "version": "1.0.0", "description": "Extract table/list data from any webpage. Auto-scroll, pagination, keyword automation. By anujawad@", "permissions": ["activeTab", "tabs", "storage", "downloads", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "aether-scraper@anujawad", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "content_security_policy": "script-src 'self'; object-src 'self'"}