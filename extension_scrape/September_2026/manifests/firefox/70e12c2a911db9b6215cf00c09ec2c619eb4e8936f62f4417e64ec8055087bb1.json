{"manifest_version": 2, "name": "URL Tracker - by guelfoweb", "version": "1.0", "description": "Track all URLs navigated in the active tab", "icons": {"48": "icons/icon-tracking-on-48.png", "96": "icons/icon-tracking-on-96.png"}, "permissions": ["webRequest", "webNavigation", "<all_urls>", "tabs", "storage", "clipboardWrite"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_icon": {"48": "icons/icon-tracking-off-48.png", "96": "icons/icon-tracking-off-96.png"}, "default_title": "URL Tracker: Disabled (click to enable)", "default_popup": "popup/popup.html"}, "browser_specific_settings": {"gecko": {"id": "url-tracker@example.com", "strict_min_version": "58.0"}}}