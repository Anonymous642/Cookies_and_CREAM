{"manifest_version": 2, "name": "Jira & Confluence Auto Login", "version": "0.3.3", "description": "Auto-login helper for Atlassian Cloud in Firefox. Saves one Atlassian URL + email and auto-completes login flow.", "author": "Kodam Adam Hrycenko", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "tabs", "*://*.atlassian.net/*", "*://id.atlassian.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "default_title": "Jira & Confluence Auto Login", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://id.atlassian.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "atlassian-quick-connect@kodam-developer", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"]}}}}