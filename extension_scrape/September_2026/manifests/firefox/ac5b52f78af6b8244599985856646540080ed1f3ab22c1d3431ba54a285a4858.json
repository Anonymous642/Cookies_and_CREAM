{"manifest_version": 3, "name": "CVE Lookup", "version": "0.1.0", "description": "Shows known CVEs for the company behind the site you are visiting.", "browser_specific_settings": {"gecko": {"id": "cvefinder@parthk.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "storage", "activeTab"], "host_permissions": ["https://www.cisa.gov/*", "https://services.nvd.nist.gov/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup/popup.html", "default_title": "CVE Lookup", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "options_ui": {"page": "options/options.html", "open_in_tab": false}}