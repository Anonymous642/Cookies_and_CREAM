{"manifest_version": 3, "name": "Zaya - URL Shortner", "version": "3.5.1", "description": "Click, Shorten, Share!", "browser_specific_settings": {"gecko": {"id": "zaya-url-shortener@zaya.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteActivity"]}}, "gecko_android": {"strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteActivity"]}}}, "host_permissions": ["https://zaya.io/api/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/logo/Zaya16.png", "32": "icons/logo/Zaya32.png", "48": "icons/logo/Zaya48.png"}}, "icons": {"16": "icons/logo/Zaya16.png", "32": "icons/logo/Zaya32.png", "48": "icons/logo/Zaya48.png", "128": "icons/logo/Zaya128.png"}, "permissions": ["activeTab", "clipboardRead", "clipboardWrite", "contextMenus", "storage", "notifications", "scripting"]}