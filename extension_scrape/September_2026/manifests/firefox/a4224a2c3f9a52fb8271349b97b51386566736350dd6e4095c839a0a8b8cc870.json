{"manifest_version": 2, "name": "ClipMemo", "version": "2.1.0", "description": "Your clipboard never forgets. Saves your last 50 copied items with search, pins, stars, themes, stats and instant re-copy.", "author": "brian", "homepage_url": "https://ko-fi.com/espressocontext", "icons": {"48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/48.png", "96": "icons/96.png", "128": "icons/128.png"}, "default_title": "ClipMemo \u2014 clipboard history"}, "background": {"scripts": ["background.js"], "persistent": true}, "permissions": ["clipboardRead", "storage", "activeTab", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "clipmemo@espressocontext", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}