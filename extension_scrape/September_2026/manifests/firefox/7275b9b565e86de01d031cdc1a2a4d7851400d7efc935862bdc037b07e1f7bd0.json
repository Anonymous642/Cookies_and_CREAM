{"manifest_version": 3, "name": "TabSpot", "version": "1.0.1", "description": "A Spotlight-style command palette for quickly switching browser tabs and opening URLs.", "permissions": ["tabs", "storage", "activeTab", "scripting"], "optional_permissions": ["bookmarks", "history", "sessions"], "background": {"scripts": ["palette-logic.js", "background.js"], "service_worker": "background.js"}, "action": {"default_title": "Open TabSpot", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "commands": {"open-spotlight": {"suggested_key": {"default": "Alt+Shift+K", "mac": "Command+Shift+K"}, "description": "Open TabSpot"}, "quick-switch": {"suggested_key": {"default": "Alt+Shift+J", "mac": "MacCtrl+Shift+J"}, "description": "Cycle through recently used tabs"}}, "web_accessible_resources": [{"resources": ["palette.html"], "matches": ["<all_urls>"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{0f6b28db-0d8a-4438-b2e8-de15884d20d2}", "data_collection_permissions": {"required": ["none"]}}}}