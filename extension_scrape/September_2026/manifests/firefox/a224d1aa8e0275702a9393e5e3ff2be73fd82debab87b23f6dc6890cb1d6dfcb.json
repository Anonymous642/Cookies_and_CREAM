{"manifest_version": 3, "name": "Reddit Gif Converter", "version": "1.0", "description": "A simple Firefox extension that will search for a .gif in a reddit post and download it.", "permissions": ["activeTab", "scripting", "downloads"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.reddit.com/r/*/comments/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "reddit-gif-converter@example.com"}}}