{"manifest_version": 2, "name": "Tab Sleeper", "version": "1.0.1", "description": "Closes inactive tabs based on a user-defined list and timeout. Usefull for closing Youtube when inactive to get Windows to go to sleep. Vibed with Gemini 2.5", "homepage_url": "about:blank", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["tabs", "storage", "alarms", "notifications"], "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "Tab Sleeper", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "{a8f807a0-5a43-4536-adc2-6e25b02efc16}"}}}