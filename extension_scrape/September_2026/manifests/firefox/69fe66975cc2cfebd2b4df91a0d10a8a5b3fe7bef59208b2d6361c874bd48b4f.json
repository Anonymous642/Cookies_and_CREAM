{"manifest_version": 2, "name": "Marcus", "version": "1.0.0", "description": "Convert web pages to clean markdown files for AI models. Doing this reduces the tokens and context for AI Agents, vectorization, and generative AI.", "icons": {"48": "icon-48.png", "96": "icon-96.png"}, "permissions": ["activeTab", "storage"], "browser_action": {"default_icon": {"16": "icon-16.png", "32": "icon-32.png"}, "default_title": "Convert to Markdown"}, "browser_specific_settings": {"gecko": {"id": "{a7f4e8c9-2b1d-4f6a-9e3c-5b8d7a4c9f1e}", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["libs/jszip.js", "libs/jspdf.js", "libs/turndown.js", "libs/readability.js", "content.js"], "css": ["panel.css"], "run_at": "document_idle"}], "web_accessible_resources": ["libs/*", "data_privacy.html"]}