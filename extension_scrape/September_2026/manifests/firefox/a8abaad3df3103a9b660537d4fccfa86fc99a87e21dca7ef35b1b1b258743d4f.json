{"manifest_version": 3, "name": "Patlas", "version": "1.0.1", "description": "Finds the research papers among your open tabs and files them into a searchable atlas \u2014 categories, labels, de-duplication.", "permissions": ["tabs", "storage", "alarms", "unlimitedStorage", "scripting"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["src/background/main.js"], "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["src/content/extract.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_title": "Patlas", "default_popup": "src/popup/popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["lexicon.json"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "paper-tabs@wenyan.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["websiteActivity"]}}}}