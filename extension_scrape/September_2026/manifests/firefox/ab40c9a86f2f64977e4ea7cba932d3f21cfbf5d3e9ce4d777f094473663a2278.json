{"manifest_version": 3, "name": "Archidekt Scryfall Helper", "version": "1.0.0", "description": "Bulk-select cards on Scryfall search results and export them as a decklist to Archidekt.", "browser_specific_settings": {"gecko": {"id": "scryfall-archidekt-export@bsroot.local", "data_collection_permissions": {"required": ["authenticationInfo"]}}}, "permissions": ["storage", "clipboardWrite", "contextMenus", "identity"], "host_permissions": ["https://scryfall.com/*", "https://scryfall2archidekt-auth.bsroot.workers.dev/*"], "background": {"scripts": ["config.js", "background.js"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_title": "Archidekt Scryfall Helper"}, "content_scripts": [{"matches": ["https://scryfall.com/search*", "https://scryfall.com/*/search*", "https://scryfall.com/card/*"], "js": ["config.js", "content.js"], "css": ["content.css"], "run_at": "document_idle"}]}