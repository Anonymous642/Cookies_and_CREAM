{"manifest_version": 3, "name": "WP Blog Counter", "version": "1.0", "description": "WordPress\u6295\u7a3f\u753b\u9762\u3067\u6587\u5b57\u6570\u3092\u30ab\u30a6\u30f3\u30c8\u3057\u307e\u3059", "browser_specific_settings": {"gecko": {"id": "wp-blog-counter@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "scripting"], "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "icons": {"128": "icon.png"}, "content_scripts": [{"matches": ["*://*/wp-admin/post.php*", "*://*/wp-admin/post-new.php*"], "js": ["content.js"], "run_at": "document_end"}]}