{"manifest_version": 3, "name": "Slow & Reverb for YouTube", "description": "Real-time speed and reverb controls for YouTube. Create the perfect vibe as you listen.", "version": "0.2.1", "action": {"default_title": "Open Slow & Reverb", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["service-worker.js"]}, "permissions": ["tabs", "storage"], "host_permissions": ["*://www.youtube.com/*", "*://youtube.com/*", "*://music.youtube.com/*"], "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://youtube.com/*", "*://music.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*", "assets/*"], "matches": ["*://www.youtube.com/*", "*://youtube.com/*", "*://music.youtube.com/*"]}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "slow-and-reverb@slowandreverb.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}