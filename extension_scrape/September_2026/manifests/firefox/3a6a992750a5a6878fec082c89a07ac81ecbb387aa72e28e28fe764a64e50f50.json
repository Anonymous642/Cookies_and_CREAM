{"manifest_version": 3, "name": "SkipBro \u2014 AI Gaming Video Guide", "version": "1.0.1", "description": "Tired of scrubbing through hours of gaming videos? SkipBro instantly finds the exact moments you need\u2014boss strategies, build guides, patch notes, and epic plays\u2014in seconds, not minutes. Stop wasting time and get back to gaming faster.", "permissions": ["storage", "activeTab", "tabs", "scripting", "webRequest", "webRequestBlocking"], "host_permissions": ["https://*.youtube.com/*", "https://youtube.com/*", "https://www.youtube.com/*", "https://skipbro.com/*", "https://*.skipbro.com/*", "https://*.clerk.accounts.dev/*", "https://*.clerk.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/watch*", "https://youtube.com/watch*", "https://*.youtube.com/watch*"], "js": ["browser-polyfill.min.js", "content/content-script.js"], "css": ["content/content.css"], "run_at": "document_idle"}, {"matches": ["https://skipbro.com/*", "https://*.skipbro.com/*"], "js": ["browser-polyfill.min.js", "content/webapp-auth-sync.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true}], "background": {"scripts": ["browser-polyfill.min.js", "background/service-worker.js"]}, "browser_specific_settings": {"gecko": {"id": "{ed3cfc94-827a-47a5-93ed-8149dde9942f}", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}}}, "action": {"default_popup": "popup/popup.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["content/*", "chunks/*", "assets/*", "page/get-clerk-token.js"], "matches": ["<all_urls>"]}], "optional_host_permissions": ["https://*.youtube.com/*", "https://youtube.com/*", "https://www.youtube.com/*", "https://skipbro.com/*", "https://*.skipbro.com/*", "https://*.clerk.accounts.dev/*", "https://*.clerk.com/*"]}