{"version": "3.9.2", "manifest_version": 2, "name": "Ghostly Chatter", "description": "Make the web social, see other users browsing the same page as floating ghost avatars, chat ephemerally, leave permanent comments, and send emoji balloon reactions. Ghostly Chatter turns any webpage into a shared space. Hottest Active/visited sites list", "permissions": ["storage", "activeTab", "tabs", "<all_urls>"], "browser_action": {"default_icon": {"16": "icon/icon-16.png", "32": "icon/icon-32.png", "48": "icon/icon-48.png", "64": "icon/icon-64.png"}, "default_title": "Ghostly Chatter"}, "background": {"scripts": ["lib/browser-polyfill.js", "js/config.js", "js/logger.js", "js/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/browser-polyfill.js", "js/config.js", "js/logger.js", "js/content/pageId.js", "js/content/identity.js", "js/content/fingerprint.js", "js/content/socket.js", "js/content/avatars.js", "js/content/chat.js", "js/content/reactions.js", "js/content/comments.js", "js/content/hottest.js", "js/content/main.js"], "css": ["css/content.css"], "run_at": "document_idle"}], "web_accessible_resources": ["css/content.css", "lib/browser-polyfill.js"], "icons": {"16": "icon/icon-16.png", "32": "icon/icon-32.png", "48": "icon/icon-48.png", "64": "icon/icon-64.png"}, "browser_specific_settings": {"gecko": {"strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}, "id": "@ghost-social"}, "gecko_android": {"strict_min_version": "113.0"}}}