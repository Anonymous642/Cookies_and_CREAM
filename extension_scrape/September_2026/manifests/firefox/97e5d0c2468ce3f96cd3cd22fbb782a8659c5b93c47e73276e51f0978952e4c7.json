{"manifest_version": 2, "name": "ADO Work Item Autocomplete", "version": "1.5", "description": "Autocomplete Azure DevOps work items in GitHub PR descriptions", "applications": {"gecko": {"id": "ado-autocomplete@promaton.com"}}, "permissions": ["storage", "https://dev.azure.com/*", "https://github.com/*", "https://*.ghe.com/*"], "content_scripts": [{"matches": ["https://github.com/*/pull/*", "https://github.com/*/compare/*", "https://*.ghe.com/*/pull/*", "https://*.ghe.com/*/compare/*"], "js": ["content.js"], "css": ["styles.css"]}], "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": ["styles.css"], "content_security_policy": "script-src 'self'; object-src 'self';"}