{"manifest_version": 3, "name": "nvim-urlbar", "version": "0.3.1", "description": "An nvim-style statusline at the bottom (or top) of every page: powerline segments show the site, path breadcrumbs, and page title. Click any segment to copy it. Themeable and configurable.", "author": "djchsu11", "homepage_url": "https://github.com/djchsu11/nvim-urlbar", "browser_specific_settings": {"gecko": {"id": "nvim-urlbar@dclark.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "webNavigation", "storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["themes.js", "content.js"], "run_at": "document_idle", "all_frames": false}], "options_ui": {"page": "options.html", "open_in_tab": false, "browser_style": false}, "commands": {"toggle-bar": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Toggle the nvim URL bar"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}