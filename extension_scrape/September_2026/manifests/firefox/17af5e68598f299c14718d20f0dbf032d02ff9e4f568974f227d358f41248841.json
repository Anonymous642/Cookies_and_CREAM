{"manifest_version": 3, "name": "The Fan Fiction Library", "description": "Save AO3 works to your Fan Fiction Library collections.", "version": "0.3.0", "browser_specific_settings": {"gecko": {"id": "extension@ff-library.com", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "121.0"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_title": "The Fan Fiction Library"}, "background": {"scripts": ["background.js"]}, "permissions": ["storage"], "host_permissions": ["https://*.ff-library.com/*"], "content_scripts": [{"matches": ["https://archiveofourown.org/*"], "js": ["content.js"], "css": ["content.css"]}]}