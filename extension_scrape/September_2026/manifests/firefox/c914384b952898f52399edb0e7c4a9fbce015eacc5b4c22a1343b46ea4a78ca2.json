{"manifest_version": 3, "name": "Agentic Email Assistant", "version": "1.0.0", "description": "Secure, AI-powered email drafting directly inside Gmail.", "permissions": ["activeTab"], "host_permissions": ["https://mail.google.com/*"], "browser_specific_settings": {"gecko": {"id": "agentic-email-assistant@yourdomain.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["https://mail.google.com/*"], "js": ["content.js"]}], "action": {"default_popup": "popup.html", "default_title": "Agentic Email Assistant"}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}}