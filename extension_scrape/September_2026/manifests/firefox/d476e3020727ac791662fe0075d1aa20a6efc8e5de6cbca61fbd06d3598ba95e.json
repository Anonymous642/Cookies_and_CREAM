{"manifest_version": 2, "name": "Audileo TTS: Read Aloud & Text to Speech", "short_name": "Audileo TTS", "version": "2.0.0", "description": "Listen to any webpage with high-quality, natural-sounding voices. Select text or read entire pages aloud.", "permissions": ["activeTab", "storage", "contextMenus"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"]}], "browser_specific_settings": {"gecko": {"id": "audileo-tts@example.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}