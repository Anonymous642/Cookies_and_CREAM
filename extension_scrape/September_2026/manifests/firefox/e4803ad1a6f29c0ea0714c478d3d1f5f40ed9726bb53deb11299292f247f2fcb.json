{"manifest_version": 2, "name": "QuickBubble Translate", "version": "1.3.1", "description": "Hit a shortcut and a translation bubble pops up right on your page. Type any word or phrase and get an instant translation via DeepL or Google Translate.", "browser_specific_settings": {"gecko": {"id": "{508fb0b1-c7c0-4945-a8ff-08a2f2444f77}", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "https://translate.googleapis.com/*", "https://api-free.deepl.com/*", "https://api.deepl.com/*"], "icons": {"128": "icon.svg"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "commands": {"toggle-translate-panel": {"suggested_key": {"default": "Ctrl+Alt+O", "mac": "Command+Shift+Y"}, "description": "Open/close the floating translation panel"}}, "browser_action": {"default_title": "QuickBubble Translate (Ctrl+Shift+Y)", "default_icon": "icon.svg"}}