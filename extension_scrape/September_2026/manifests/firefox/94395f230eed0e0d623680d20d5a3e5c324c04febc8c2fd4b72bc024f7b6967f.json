{"manifest_version": 2, "name": "Podhoc - Save to Wishlist", "version": "1.3.3", "description": "Save any webpage to your Podhoc podcast wishlist", "browser_specific_settings": {"gecko": {"id": "extension@podhoc.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"], "description": "Podhoc collects anonymous usage analytics (popup opened, wishlist item added) via Google Analytics 4 Measurement Protocol. No personally identifiable information is collected."}}}, "browser_action": {"default_popup": "popup.html", "default_title": "Podhoc"}, "permissions": ["storage", "activeTab", "tabs", "cookies", "https://app.podhoc.com/*", "https://api.podhoc.com/*", "https://*.podhoc.com/*", "https://www.google-analytics.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://app.podhoc.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}