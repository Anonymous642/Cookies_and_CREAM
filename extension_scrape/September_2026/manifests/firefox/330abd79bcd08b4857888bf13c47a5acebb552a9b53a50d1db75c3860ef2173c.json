{"manifest_version": 2, "name": "Markdown Scratchpad", "description": "A markdown notepad in your toolbar with live preview, several notes, word count and a .md export. The preview is rendered by a parser written for this addon, so pasted text can never inject markup.", "version": "2.7.4.1", "browser_specific_settings": {"gecko": {"id": "{144e6473-689e-46df-87b5-ac7716702c7d}", "strict_min_version": "101.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_action": {"default_title": "Markdown Scratchpad", "default_popup": "popup.html", "default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png"}}, "permissions": ["storage"]}