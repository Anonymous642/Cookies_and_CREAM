{"manifest_version": 3, "name": "LangUp for Firefox", "version": "2.2", "description": "Save words from web pages to LangUp and learn them in context.", "permissions": ["storage", "identity", "contextMenus"], "host_permissions": ["https://langup.piatek-magazyn.com/*"], "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "background": {"scripts": ["config.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_title": "LangUp \u2014 save a word", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "langup@piatek-magazyn.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "websiteActivity", "websiteContent"]}}}}