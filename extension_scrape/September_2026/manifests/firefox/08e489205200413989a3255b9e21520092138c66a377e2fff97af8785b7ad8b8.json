{"manifest_version": 3, "name": "IRA - Interface for Responsive Access", "short_name": "IRA", "version": "0.1.1", "description": "A reader interface that adapts web pages to your intent: skimming, debugging, or learning. No tracking. No machine learning.", "author": "Doby Baxter", "browser_specific_settings": {"gecko": {"id": "ira@dobybaxter.dev", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/favicon-16x16.png", "32": "icons/favicon-32x32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_title": "IRA", "default_popup": "popup/popup.html"}, "permissions": ["storage"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/base.css", "content/modes/skim.css", "content/modes/debug.css", "content/modes/learn.css"], "run_at": "document_idle"}]}