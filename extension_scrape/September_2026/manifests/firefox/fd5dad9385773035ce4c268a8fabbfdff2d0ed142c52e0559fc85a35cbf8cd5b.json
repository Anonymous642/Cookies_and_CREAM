{"manifest_version": 3, "name": "Minimalist Tube - Focus Mode", "version": "1.2", "description": "Supprime les recommandations et distractions pour une exp\u00e9rience YouTube productive.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["*://*.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "Minimalist_Tube@proton.me", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}