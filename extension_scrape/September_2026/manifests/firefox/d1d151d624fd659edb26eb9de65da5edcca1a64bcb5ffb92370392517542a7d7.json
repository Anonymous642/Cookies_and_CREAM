{"manifest_version": 3, "name": "Page Modeller (Playwright, Selenium, etc.)", "description": "Browser DevTools extension for modelling web pages for automation.", "version": "3.0.1", "short_name": "PageModeller", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["activeTab", "tabs", "storage", "contextMenus"], "action": {"default_title": "Page Modeller"}, "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "{1e34b9b3-8f45-415e-9586-c7d5de0d0aff}", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "devtools_page": "devtools.html", "options_ui": {"open_in_tab": true, "page": "options.html"}, "sidebar_action": {"default_panel": "sidepanel.html", "default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "default_title": "Page Modeller"}, "content_scripts": [{"matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "js": ["content-scripts/content.js"]}]}