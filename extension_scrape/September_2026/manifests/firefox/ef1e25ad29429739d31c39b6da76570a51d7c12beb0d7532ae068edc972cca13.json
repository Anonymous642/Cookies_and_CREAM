{"manifest_version": 3, "name": "TunnelOFF", "version": "1.0.1", "description": "Noise cancelling for your eyes: draw a box around what matters, the rest of the page blurs out.", "permissions": ["storage", "activeTab", "scripting"], "optional_host_permissions": ["*://*/*"], "action": {"default_popup": "popup/popup.html", "default_title": "TunnelOFF", "default_icon": {"16": "images/icon_16X16.png", "32": "images/icon_32X32.png", "48": "images/icon_48X48.png", "128": "images/icon_128X128.png"}}, "icons": {"16": "images/icon_16X16.png", "32": "images/icon_32X32.png", "48": "images/icon_48X48.png", "128": "images/icon_128X128.png"}, "commands": {"toggle-noise-markers": {"suggested_key": {"default": "Alt+N"}, "description": "Toggle noise markers (arrows on links, rings around images)"}}, "web_accessible_resources": [{"resources": ["images/motte-80.png", "images/motte-64.png", "images/motte-56.png", "images/red-arrow.svg"], "matches": ["<all_urls>"]}], "background": {"scripts": ["js/browser-polyfill.min.js", "js/license.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "tunneloff@sebba20.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo"], "optional": ["technicalAndInteraction"]}}}}