{"manifest_version": 3, "name": "AnimeTracker", "version": "1.0.0", "description": "Track your anime on AnimeTracker.co directly from MAL and Crunchyroll.", "permissions": ["storage", "identity"], "host_permissions": ["https://myanimelist.net/*", "https://www.crunchyroll.com/*", "https://animetracker.co/*"], "background": {"service_worker": "dist/background.js", "scripts": ["dist/background.js"]}, "action": {"default_popup": "popup.html", "default_title": "AnimeTracker"}, "content_scripts": [{"matches": ["https://myanimelist.net/anime/*/*"], "js": ["dist/content/mal.js"], "run_at": "document_idle"}, {"matches": ["https://www.crunchyroll.com/*"], "js": ["dist/content/crunchyroll.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "extension@animetracker.co", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}