{"manifest_version": 2, "name": "Price Explorer - History Tracker", "version": "1.0.0", "description": "Track and view historical price data for bol.com products", "browser_specific_settings": {"gecko": {"id": "price-explorer@priceexplorer.app", "data_collection_permissions": {"required": ["websiteContent"]}}}, "permissions": ["activeTab", "storage", "contextMenus", "<all_urls>"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_action": {"default_icon": "icons/icon-48.png", "default_title": "Price Explorer", "default_popup": "popup/popup.html"}, "content_scripts": [{"matches": ["*://*.bol.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options/options.html", "browser_style": true}}