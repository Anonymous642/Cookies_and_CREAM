{"manifest_version": 3, "name": "Acculi", "version": "0.1.0", "description": "Show correspondence stats in Lichess user popups.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "acculi@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["https://lichess.org/*"], "js": ["content-script.js"], "css": ["content-style.css"], "run_at": "document_idle"}]}