{"manifest_version": 2, "name": "CyberKeyVault", "version": "1.0.1", "description": "Gestor de contrase\u00f1as CyberKeyVault \u2014 autocompletar seguro para Firefox", "author": "CyberKeyVault Team", "browser_specific_settings": {"gecko": {"id": "cyberkeyvault@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "scripting", "alarms", "https://cyberkeyvault.duckdns.org/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup/popup.html", "default_title": "CyberKeyVault", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": "script-src 'self'; object-src 'self'; connect-src 'self' https://cyberkeyvault.duckdns.org", "web_accessible_resources": ["icons/*.png"]}