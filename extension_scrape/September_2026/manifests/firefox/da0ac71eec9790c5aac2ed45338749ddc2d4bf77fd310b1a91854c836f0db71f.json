{"manifest_version": 3, "name": "YouTube Custom Filter", "version": "1.0", "description": "Filtere YouTube nach Datum, Musik, Playlist, entferne Shelves und Shorts.", "permissions": ["storage", "scripting"], "host_permissions": ["*://www.youtube.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content-script.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "lupus.atque.corvus@gmail.com", "strict_min_version": "109.0"}}}