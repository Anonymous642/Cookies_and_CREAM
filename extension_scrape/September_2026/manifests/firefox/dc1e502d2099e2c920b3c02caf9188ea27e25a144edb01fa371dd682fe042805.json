{"manifest_version": 3, "name": "Cosmo Job Assistant", "version": "1.0.1", "description": "Naukri job co-pilot \u2014 scan and assist Easy Apply from your preferences, synced to Cosmo", "permissions": ["storage", "alarms", "tabs"], "host_permissions": ["https://atlas-ai-job-apply-extension-1.onrender.com/*", "https://www.cosmovai.in/*", "https://atlas-ai-job-apply-extension-client-roan.vercel.app/*", "https://www.naukri.com/*", "https://naukri.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "Cosmo", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://www.naukri.com/*", "https://naukri.com/*"], "js": ["content.js"], "run_at": "document_idle"}, {"matches": ["https://www.cosmovai.in/*", "https://atlas-ai-job-apply-extension-client-roan.vercel.app/*"], "js": ["webBridge.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["https://www.naukri.com/*", "https://naukri.com/*"]}], "browser_specific_settings": {"gecko": {"id": "cosmo-job-assistant@cosmovai.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "personallyIdentifyingInfo", "websiteActivity", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}}