{"manifest_version": 3, "name": "YouTube Lyrics", "version": "1.0.0", "description": "Displays song lyrics on YouTube using the free LRCLIB API.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.youtube.com/*", "https://lrclib.net/*"], "background": {"service_worker": "background.js", "scripts": ["browser-polyfill.js", "background.js"]}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["browser-polyfill.js", "content.js"], "css": ["lyrics.css"], "run_at": "document_idle"}], "action": {"default_title": "YouTube Lyrics", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "youtube-lyrics@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}