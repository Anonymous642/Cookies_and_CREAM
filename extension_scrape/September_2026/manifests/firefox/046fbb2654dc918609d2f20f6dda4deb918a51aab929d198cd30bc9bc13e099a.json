{"manifest_version": 3, "name": "FullPageRoll - Full Page Screen Capture", "short_name": "FullPageRoll", "version": "1.7.17", "description": "Capture an entire webpage in one click and save it as an HD PNG or a continuous single-page PDF. Everything stays on your device.", "permissions": ["activeTab", "scripting", "unlimitedStorage"], "host_permissions": ["http://*/*", "https://*/*"], "background": {"scripts": ["background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "fullpageroll@fullpageroll.com", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "FullPageRoll - Full Page Screen Capture", "default_popup": "popup.html", "default_icon": {"16": "icons/action-icon-toolbar-16.png", "32": "icons/action-icon-toolbar-32.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Capture the full page with FullPageRoll"}}}