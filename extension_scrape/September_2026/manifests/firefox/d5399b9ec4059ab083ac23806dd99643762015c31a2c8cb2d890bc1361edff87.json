{"manifest_version": 2, "name": "IP Hover Lookup (Geo & ASN)", "version": "1.5.7", "description": "Hover an IPv4/IPv6 to see geo, ASN & rDNS. Parses Polish results; UI in your language. Detects private IP.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"], "persistent": false}, "permissions": ["https://mail.etop.pl/*"], "browser_specific_settings": {"gecko": {"id": "ip-hover-lookup@etop.pl", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}