{"manifest_version": 3, "name": "WebHighlighter", "version": "1.0.0", "description": "Web page text highlighter. Highlight and save important text on any page.", "icons": {"48": "highlighter-icons/icon-48.png", "96": "highlighter-icons/icon-96.png", "128": "highlighter-icons/icon-128.png"}, "action": {"default_icon": {"48": "highlighter-icons/icon-48.png", "96": "highlighter-icons/icon-96.png"}, "default_title": "WebHighlighter", "default_popup": "highlighter-ui/panel.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-scripts/content.js"], "css": []}], "permissions": ["activeTab", "storage"], "browser_specific_settings": {"gecko": {"id": "webhighlighter@highlight.tool", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}