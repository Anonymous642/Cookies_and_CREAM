{"manifest_version": 3, "name": "OutlierLabs \u2014 Detector de Outliers YouTube", "version": "2.8.5", "description": "Detector de outliers en YouTube: marca los v\u00eddeos que rompen la media de su canal mientras haces scroll y analiza canales al vuelo.", "permissions": ["storage", "activeTab", "cookies"], "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://outlierlabs.app/*"], "background": {"scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["https://www.youtube.com/*", "https://youtube.com/*"], "js": ["src/rpm_table.js", "src/bundle.js"], "css": ["src/ui/styles.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/logo.webp"], "matches": ["https://www.youtube.com/*", "https://youtube.com/*"]}], "icons": {"16": "icons/icono_extension_16.png", "48": "icons/icono_extension_48.png", "128": "icons/icono_extension_128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icono_extension_16.png", "48": "icons/icono_extension_48.png"}}, "browser_specific_settings": {"gecko": {"id": "extension@outlierlabs.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}}