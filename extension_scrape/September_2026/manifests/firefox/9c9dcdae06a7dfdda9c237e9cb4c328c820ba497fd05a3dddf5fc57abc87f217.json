{"manifest_version": 3, "name": "Tweet Copy", "short_name": "TweetCopy", "version": "1.1.1", "description": "Copy tweet/X post text with one click - with local history, search, tags, image previews, favorites, and export tools.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "clipboardWrite"], "host_permissions": ["https://twitter.com/*", "https://www.twitter.com/*", "https://x.com/*", "https://www.x.com/*"], "content_scripts": [{"matches": ["https://twitter.com/*", "https://www.twitter.com/*", "https://x.com/*", "https://www.x.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png"}}, "browser_specific_settings": {"gecko": {"id": "tweet-copy@addon", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}