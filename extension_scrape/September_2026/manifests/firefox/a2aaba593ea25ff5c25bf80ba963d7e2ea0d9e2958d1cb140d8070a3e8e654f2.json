{"manifest_version": 3, "name": "ImageFilter", "version": "1.0.0", "description": "Simple image filter tool. Apply grayscale, sepia, blur, and brightness filters to all images on page.", "icons": {"48": "res/icon-48.png", "96": "res/icon-96.png", "128": "res/icon-128.png"}, "action": {"default_icon": {"48": "res/icon-48.png", "96": "res/icon-96.png"}, "default_title": "ImageFilter", "default_popup": "control/filter.html"}, "permissions": ["activeTab", "scripting"], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "imagefilter@photo.effects", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}