{"manifest_version": 3, "name": "Miraculous Custom Watch Order", "version": "1.1.0", "description": "Replaces the end-of-episode popup on miraculous.to with a custom chronological watch order.", "author": "Michal Wittmayer", "homepage_url": "https://github.com/krasavic3-wittmayer/MTO-watcher", "browser_specific_settings": {"gecko": {"id": "@mto-watcher", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png"}, "content_scripts": [{"matches": ["*://miraculous.to/*"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["page.js"], "matches": ["*://miraculous.to/*"]}]}