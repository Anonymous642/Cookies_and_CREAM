{"manifest_version": 3, "name": "Layer Keys", "version": "1.0.1", "description": "Layered keyboard shortcuts for tabs, pages, and browser actions", "permissions": ["tabs", "activeTab", "storage"], "background": {"scripts": ["defaults.js", "background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "commands": {"toggle-layer-mode": {"suggested_key": {"default": "Ctrl+Comma"}, "description": "Toggle layer mode"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["overlay.css"], "run_at": "document_start"}], "action": {"default_title": "Layer Keys", "default_popup": "popup.html", "default_icon": "icons/icon.svg"}, "browser_specific_settings": {"gecko": {"id": "layerkeys@plucafs", "data_collection_permissions": {"required": ["none"]}}}}