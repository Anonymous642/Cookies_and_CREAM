{"manifest_version": 3, "name": "Reddit Subreddit Hider", "version": "1.2.2", "description": "Permanently hide chosen subreddits and post-title keywords (exact name or wildcard, e.g. Blorptown*) from Reddit's Home and Popular feeds.", "permissions": ["storage", "clipboardWrite"], "host_permissions": ["*://www.reddit.com/*", "*://old.reddit.com/*", "*://new.reddit.com/*"], "content_scripts": [{"matches": ["*://www.reddit.com/*", "*://old.reddit.com/*", "*://new.reddit.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start", "all_frames": false}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "Reddit Subreddit Hider", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "browser_specific_settings": {"gecko": {"id": "redsub-hider@anton.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}