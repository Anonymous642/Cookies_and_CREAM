{"manifest_version": 2, "name": "MyDealz Ref-URL Cleaner", "version": "1.0", "description": "Dekodiert die aktuelle, von MyDealz verlinkte, vom Nutzer aufgerufene und von PiHole geblockte Deal-URL, entfernt Tracking-Parameter und ruft anschliessend die saubere Produkt-URL auf.", "author": "Lippe", "homepage_url": "https://lip.pe", "permissions": ["tabs", "activeTab", "contextMenus"], "browser_action": {"default_title": "URL bereinigen", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon.svg"}}, "background": {"scripts": ["background.js"]}, "commands": {"clean-url": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Alt+Y"}, "description": "URL dekodieren und bereinigen"}}, "browser_specific_settings": {"gecko": {"id": "ff_mydealz-ref-cleaner@lip.pe", "data_collection_permissions": {"required": ["none"]}}}}