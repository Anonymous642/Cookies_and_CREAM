{"manifest_version": 3, "name": "Twitter Puzzle Blocker", "version": "1.0", "description": "Blocks Twitter until you solve a daily puzzle", "browser_specific_settings": {"gecko": {"id": "twitter-puzzle-blocker@example.com"}}, "permissions": ["storage", "declarativeNetRequest"], "host_permissions": ["*://*.twitter.com/*", "*://*.x.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}