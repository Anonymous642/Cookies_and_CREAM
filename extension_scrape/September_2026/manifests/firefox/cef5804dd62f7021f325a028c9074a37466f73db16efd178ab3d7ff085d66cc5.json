{"manifest_version": 2, "name": "Thetix", "description": "Connect Robinhood and view your Thetix trading cart.", "version": "0.2.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "webNavigation", "http://127.0.0.1/*", "https://thetix.ai/*", "https://*.thetix.ai/*"], "browser_specific_settings": {"gecko": {"id": "extension@thetaedge.ai", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "financialAndPaymentInfo"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Thetix", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://*.thetix.ai/*", "https://thetix.ai/*"], "js": ["content-scripts/thetaedge.js"]}]}