{"manifest_version": 2, "name": "YouTube Willy", "version": "1.0", "description": "Opens multiple YouTube windows.", "permissions": ["tabs", "storage", "windows", "*://*.youtube.com/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Start Multi Open"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"48": "icon.png", "128": "icon.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["injector.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "youtube-willy@stepnest", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}}