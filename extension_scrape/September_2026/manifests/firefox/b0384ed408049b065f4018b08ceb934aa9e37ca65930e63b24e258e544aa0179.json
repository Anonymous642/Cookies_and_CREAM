{"manifest_version": 3, "name": "Anti-Toxicity Twitter", "version": "1.0", "description": "Twitter toxicity prevention", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "tabs"], "host_permissions": ["https://*.twitter.com/*", "https://*.x.com/*"], "action": {"default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["https://*.twitter.com/*", "https://*.x.com/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "antitoxi@twitter.com", "strict_min_version": "109.0"}}}