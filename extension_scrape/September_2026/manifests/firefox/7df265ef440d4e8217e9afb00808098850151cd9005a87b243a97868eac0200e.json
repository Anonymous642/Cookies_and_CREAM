{"manifest_version": 3, "name": "Synline \u2013 YouTube Filter", "version": "1.0.0", "description": "Filter YouTube with keywords, block Shorts, or describe exactly what you want to watch using AI.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["https://www.youtube.com/*", "https://api.groq.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "background": {"scripts": ["background/background.js"]}, "browser_specific_settings": {"gecko": {"id": "synline@synline-extension.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}