{"manifest_version": 2, "name": "FAL Safety Modifier", "version": "1.0.0", "description": "Automatically modifies safety_checker parameter on fal.ai to disable content filtering for your image generation requests.", "author": "freQuensy23", "homepage_url": "https://github.com/freQuensy23-coder/fal_nsfw", "browser_specific_settings": {"gecko": {"id": "fal-safety-modifier@frequensy23.dev", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["webRequest", "*://*.fal.ai/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.fal.ai/*"], "js": ["content.js"], "run_at": "document_start"}]}