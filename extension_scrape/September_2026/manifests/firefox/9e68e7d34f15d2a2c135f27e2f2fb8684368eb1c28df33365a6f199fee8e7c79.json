{"manifest_version": 3, "name": "LumaTab for Firefox", "version": "1.0.0", "description": "A calm, beautiful, fast new tab page. Living backgrounds, automatic theming, widgets and privacy-first personalization.", "default_locale": "en", "browser_specific_settings": {"gecko": {"id": "lumata-tab@thesajidalam.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "chrome_url_overrides": {"newtab": "src/newtab/index.html"}, "options_ui": {"page": "src/settings/index.html", "open_in_tab": true}, "background": {"scripts": ["src/background/background.js"], "type": "module"}, "permissions": ["storage", "unlimitedStorage"], "optional_permissions": ["bookmarks", "history", "downloads", "sessions", "clipboardRead", "topSites", "geolocation"], "optional_host_permissions": ["https://api.open-meteo.com/*", "https://geocoding-api.open-meteo.com/*"], "action": {"default_title": "LumaTab", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}}