{"manifest_version": 3, "name": "BestJobs Preference Reloader", "version": "1.0.0", "description": "Save your BestJobs.eu filter preferences and instantly reopen the jobs page with them applied.", "permissions": ["storage", "tabs", "activeTab", "scripting"], "host_permissions": ["https://www.bestjobs.eu/*"], "browser_specific_settings": {"gecko": {"id": "bestjobs-helper@example.com", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}, "action": {"default_popup": "popup.html", "default_title": "BestJobs Preferences", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.bestjobs.eu/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}]}