{"manifest_version": 3, "name": "GitLab Open Locally", "version": "1.3.0", "description": "Open GitLab files locally in your IDE (also supports GitHub and Bitbucket)", "permissions": ["activeTab", "storage", "scripting", "clipboardWrite"], "host_permissions": ["https://gitlab.com/*", "https://*.gitlab.com/*", "https://github.com/*", "https://bitbucket.org/*"], "background": {"scripts": ["service_worker.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://gitlab.com/*/blob/*", "https://gitlab.com/*/blame/*", "https://gitlab.com/*/edit/*", "https://gitlab.com/*/raw/*", "https://gitlab.com/*/-/blob/*", "https://gitlab.com/*/-/blame/*", "https://gitlab.com/*/-/edit/*", "https://gitlab.com/*/-/raw/*", "https://*.gitlab.com/*/blob/*", "https://*.gitlab.com/*/blame/*", "https://*.gitlab.com/*/edit/*", "https://*.gitlab.com/*/raw/*", "https://*.gitlab.com/*/-/blob/*", "https://*.gitlab.com/*/-/blame/*", "https://*.gitlab.com/*/-/edit/*", "https://*.gitlab.com/*/-/raw/*", "https://github.com/*/blob/*", "https://github.com/*/blame/*", "https://github.com/*/edit/*", "https://bitbucket.org/*/src/*", "https://bitbucket.org/*/annotate/*", "https://gitlab.com/*/merge_requests/*/diffs", "https://gitlab.com/*/-/merge_requests/*/diffs", "https://*.gitlab.com/*/merge_requests/*/diffs", "https://*.gitlab.com/*/-/merge_requests/*/diffs", "https://gitlab.com/*/merge_requests/*", "https://gitlab.com/*/-/merge_requests/*", "https://*.gitlab.com/*/merge_requests/*", "https://*.gitlab.com/*/-/merge_requests/*", "https://gitlab.com/*/-/commit/*", "https://*.gitlab.com/*/-/commit/*"], "js": ["content_script.js"], "run_at": "document_idle"}], "commands": {"open-file": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Open current Git fi