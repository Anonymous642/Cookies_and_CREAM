{"manifest_version": 3, "name": "Tap Tooltips for Stepik", "version": "1.4.0", "description": "Shows Stepik HTML title tooltips in a compact light-green bubble near the tapped word, especially on Firefox for Android.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "{2a7db4e8-1a5d-4637-917b-f9abac2acdc8}", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "128.0"}}, "content_scripts": [{"matches": ["https://stepik.org/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}]}