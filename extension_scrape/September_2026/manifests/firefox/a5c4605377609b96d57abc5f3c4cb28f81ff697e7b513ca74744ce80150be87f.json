{"manifest_version": 3, "name": "Sokrates Browser Proctoring", "version": "1.0.0", "description": "Browser extension untuk proctoring ujian di LMS.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["declarativeNetRequest", "tabs", "activeTab", "storage", "scripting", "tabCapture", "webNavigation"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_scripts/content.js"]}], "action": {"default_popup": "action/popup.html", "default_icon": {"16": "action/icon-16.png", "48": "action/icon-48.png"}}, "options_ui": {"page": "options_ui/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "sokrates-proctoring@sokrates.co.id", "strict_min_version": "58.0"}}, "externally_connectable": {"matches": ["*://*/*"]}, "web_accessible_resources": [{"resources": ["web_accessible_resources/*", "permissions/*", "models/*", "services/*", "utils/*", "utils/face-detection-browser.js"], "matches": ["<all_urls>"]}]}