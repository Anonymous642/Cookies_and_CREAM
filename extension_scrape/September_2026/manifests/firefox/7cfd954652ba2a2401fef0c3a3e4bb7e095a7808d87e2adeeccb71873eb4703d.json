{"manifest_version": 2, "name": "Glass New Tab Dashboard", "version": "1.0.5", "description": "Glass-style new tab dashboard.", "browser_specific_settings": {"gecko": {"id": "glass-new-tab-dashboard@yourdomain.local", "data_collection_permissions": {"required": ["none"]}}}, "chrome_url_overrides": {"newtab": "newtab.html"}, "browser_action": {"default_title": "Quick add bookmark", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["bg.js"], "persistent": false}, "permissions": ["storage", "tabs", "contextMenus", "https://api.open-meteo.com/*"], "content_security_policy": "script-src 'self'; object-src 'self'; frame-src https://www.openstreetmap.org https://*.openstreetmap.org"}