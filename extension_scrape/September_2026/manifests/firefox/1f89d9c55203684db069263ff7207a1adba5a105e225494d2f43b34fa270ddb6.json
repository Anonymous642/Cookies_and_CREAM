{"manifest_version": 3, "name": "News Template Presets", "version": "1.0", "description": "A browser extension to manage and apply presets for WordPress news templates.", "permissions": ["storage", "scripting", "activeTab"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}}, "icons": {"16": "icon.png", "32": "icon.png", "48": "icon.png", "128": "icon.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content-script.js"]}], "host_permissions": ["<all_urls>"], "browser_specific_settings": {"gecko": {"id": "newstemplatepresets@craigo.live"}}}