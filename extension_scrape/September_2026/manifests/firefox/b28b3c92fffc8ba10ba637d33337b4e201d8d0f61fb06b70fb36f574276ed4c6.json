{"manifest_version": 3, "name": "Youtube Timely Search", "version": "1.0", "description": "This extension enables you to search on youtube between a particular time period", "browser_specific_settings": {"gecko": {"id": "youtube-search@jdfj.com", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "all_frames": false}], "permissions": ["storage", "activeTab"]}