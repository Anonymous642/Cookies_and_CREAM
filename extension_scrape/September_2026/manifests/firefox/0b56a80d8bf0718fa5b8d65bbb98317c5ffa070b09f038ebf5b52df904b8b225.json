{"manifest_version": 3, "version": "0.1.2", "name": "Wikicasa", "description": "Descrizione plugin wikicasa", "icons": {"32": "icons/wikicasa.svg"}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Q"}, "description": "Open Wikicasa popup"}}, "action": {"default_icon": "icons/wikicasa.svg", "default_title": "Wikicasa", "default_popup": "index.html"}, "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "permissions": ["activeTab", "tabs", "scripting", "storage"], "host_permissions": ["*://devs.wikicasa.it/*", "*://www.wikicasa.it/*"], "browser_specific_settings": {"gecko": {"id": "wikicasa-extension@wikicasa.it", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}