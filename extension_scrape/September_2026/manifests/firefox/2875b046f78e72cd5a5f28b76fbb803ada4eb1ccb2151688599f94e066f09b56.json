{"manifest_version": 3, "name": "Penguin Check", "version": "0.1.0", "description": "Shows Linux compatibility for Steam games directly on the store page.", "default_locale": "en", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "johanfr4@gmail.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["storage"], "host_permissions": ["https://store.steampowered.com/*", "http://127.0.0.1:8000/*", "https://api.penguin-check.fly.dev/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://store.steampowered.com/app/*"], "js": ["content.js"]}]}