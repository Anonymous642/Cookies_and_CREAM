{"manifest_version": 2, "name": "Whisper Voice to Text", "version": "1.0.0", "description": "Record your voice and insert transcribed text into any input field using OpenAI Whisper or compatible APIs", "permissions": ["activeTab", "storage", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Whisper Voice to Text"}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Ctrl+Alt+S", "mac": "Command+Alt+S"}, "description": "Activate voice recording"}}, "options_ui": {"page": "settings/settings.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "voice-to-text@extension.local", "strict_min_version": "58.0"}}}