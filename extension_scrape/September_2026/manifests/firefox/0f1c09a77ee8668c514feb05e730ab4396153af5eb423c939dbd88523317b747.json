{"manifest_version": 3, "name": "Second Life Friends Monitor", "description": "Get notified when Second Life friends go online/offline. View online friends, access profiles, and customize notifications.", "version": "1.0", "permissions": ["cookies", "alarms", "storage", "notifications"], "host_permissions": ["https://secondlife.com/*", "https://*.secondlife.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon-16.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}}, "icons": {"16": "images/icon-16.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "slfriends@moonbunny.uk", "strict_min_version": "109.0"}}}