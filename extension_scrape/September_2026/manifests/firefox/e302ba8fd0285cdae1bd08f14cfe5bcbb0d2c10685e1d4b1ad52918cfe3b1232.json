{"manifest_version": 3, "name": "PageWarp: Retro Website Themes", "version": "1.3.1", "description": "Transform any website into nostalgic 1980s, 1990s GeoCities, Y2K, MySpace, and Windows 95 styles.", "author": "Think App Labs", "browser_specific_settings": {"gecko": {"id": "geocities-mode@thinkapplabs.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Toggle PageWarp", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}}, "background": {"scripts": ["background.js"]}, "commands": {"toggle-geocities": {"suggested_key": {"default": "Ctrl+Shift+G", "mac": "MacCtrl+Shift+G"}, "description": "Toggle PageWarp on the current tab"}}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["content/content.css"], "js": ["content/content.js"], "run_at": "document_start"}]}