{"manifest_version": 3, "name": "+EV Sharps Odds Converter", "version": "0.1.1", "description": "Converts prediction market odds (%, cents, American) into American, Decimal, Fractional, or Implied Probability format, in place, on Polymarket, ProphetX, Kalshi, and Novig.", "browser_specific_settings": {"gecko": {"id": "odds-converter@ff-extension.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "host_permissions": ["*://*.polymarket.com/*", "*://*.kalshi.com/*", "*://*.novig.us/*", "*://*.novig.com/*", "*://*.prophetx.co/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Odds Format", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["*://*.polymarket.com/*"], "js": ["content/conv.js", "content/sites/polymarket.js", "content/core.js"], "run_at": "document_idle"}, {"matches": ["*://*.kalshi.com/*"], "js": ["content/conv.js", "content/sites/kalshi.js", "content/core.js"], "run_at": "document_idle"}, {"matches": ["*://*.novig.us/*", "*://*.novig.com/*"], "js": ["content/conv.js", "content/sites/novig.js", "content/core.js"], "run_at": "document_idle"}, {"matches": ["*://*.prophetx.co/*"], "js": ["content/conv.js", "content/sites/prophetx.js", "content/core.js"], "run_at": "document_idle"}]}