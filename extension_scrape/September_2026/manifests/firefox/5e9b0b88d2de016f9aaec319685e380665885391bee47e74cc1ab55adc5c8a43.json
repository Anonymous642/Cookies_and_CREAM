{"manifest_version": 3, "name": "S&F Advisor", "description": "Helps you fill the scrapbook in Shakes and Fidget by showing you the players with the most items, that you have not found yet", "version": "1.2", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["storage"], "host_permissions": ["*://sfgame.net/*", "*://*.sfgame.net/*", "https://mfbot-api.marenga.dev/*"], "web_accessible_resources": [{"resources": ["injected_page_hook.js"], "matches": ["*://sfgame.net/*", "*://*.sfgame.net/*"]}], "browser_specific_settings": {"gecko": {"id": "@sf-advisor.marenga"}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "S&F Advisor", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.sfgame.net/*", "*://sfgame.net/*"], "run_at": "document_start", "js": ["content-scripts/content.js"]}]}