{"manifest_version": 3, "name": "LeagueSeer Draft Assistant", "version": "1.0.2", "description": "Live pick suggestions, snipe alerts, and survival odds from LeagueSeer, overlaid on your Sleeper and ESPN draft rooms.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}}, "content_scripts": [{"matches": ["https://sleeper.com/*", "https://*.sleeper.com/*", "https://fantasy.espn.com/*"], "js": ["content.js"], "css": ["panel.css"], "run_at": "document_idle"}], "host_permissions": ["https://leagueseer.com/*", "https://www.leagueseer.com/*"], "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "draft-assistant@leagueseer.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}