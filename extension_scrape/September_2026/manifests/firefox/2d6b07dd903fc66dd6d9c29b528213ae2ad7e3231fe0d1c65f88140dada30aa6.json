{"manifest_version": 2, "name": "AI Chat Enter Modifier", "version": "1.0.0", "description": "Change Enter to newline and Ctrl+Enter to send in AI chat services (ChatGPT, Claude, Gemini)", "author": "yudil", "browser_specific_settings": {"gecko": {"id": "ai-chat-enter-modifier@yudil", "strict_min_version": "109.0", "data_collection_permissions": {"data_not_collected": true, "required": ["none"]}}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage"], "content_scripts": [{"matches": ["*://chatgpt.com/*", "*://chat.openai.com/*", "*://claude.ai/*", "*://gemini.google.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "browser_action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "AI Chat Enter Modifier", "default_popup": "popup.html"}}