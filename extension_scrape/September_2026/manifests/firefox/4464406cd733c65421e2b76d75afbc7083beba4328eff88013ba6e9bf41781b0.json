{"manifest_version": 3, "name": "DesktopPiP Connector", "version": "1.7", "description": "Lets DesktopPiP auto-open your tabs in their own windows when you load a preset.", "permissions": ["tabs", "alarms", "scripting", "storage"], "host_permissions": ["http://*/*", "https://*/*"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "background": {"scripts": ["background.js"]}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:8770 ws://127.0.0.1:8771 ws://127.0.0.1:8772 ws://127.0.0.1:8773 ws://127.0.0.1:8774 ws://127.0.0.1:8775 ws://127.0.0.1:8776 ws://127.0.0.1:8777 ws://127.0.0.1:8778 ws://127.0.0.1:8779"}, "browser_specific_settings": {"gecko": {"id": "desktoppip@desktoppip.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteActivity", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}}