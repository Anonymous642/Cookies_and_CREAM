{"manifest_version": 3, "name": "Colorway", "version": "0.1.0", "description": "Recolors picked elements of any site and marks the tab so instances are told apart", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "scripting", "activeTab"], "optional_host_permissions": ["*://*/*"], "action": {"default_title": "Colorway", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "web_accessible_resources": [{"resources": ["panel.html"], "matches": ["<all_urls>"]}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "colorway@arturminchukov", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}