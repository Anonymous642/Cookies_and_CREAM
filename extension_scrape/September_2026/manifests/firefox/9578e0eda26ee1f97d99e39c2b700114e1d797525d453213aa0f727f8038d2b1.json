{"manifest_version": 3, "name": "Pop Up Highlighter", "version": "1.1", "description": "Firefox add-on untuk menyorot teks pilihan dengan toggle ON/OFF yang tersimpan secara lokal.", "permissions": ["storage"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "action": {"default_title": "Pop Up Highlighter (ON)", "default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}}, "browser_specific_settings": {"gecko": {"id": "highlighter@bimbim.local", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"]}]}