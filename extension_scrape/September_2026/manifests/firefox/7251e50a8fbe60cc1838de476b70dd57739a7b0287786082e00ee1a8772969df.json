{"manifest_version": 3, "name": "BeHai", "version": "1.0.91", "description": "Auto reply Messenger inbox using AI", "icons": {"48": "icon48.png", "128": "icon128.png"}, "permissions": ["activeTab", "storage", "tabs"], "host_permissions": ["https://*.facebook.com/*", "https://*.messenger.com/*", "https://*.genjutsu.ai/*"], "content_scripts": [{"matches": ["https://business.facebook.com/*"], "js": ["assets/content.js"], "run_at": "document_idle"}], "background": {"scripts": ["assets/background.js"], "service_worker": "assets/background.js", "type": "module"}, "action": {"default_popup": "popup.html", "default_title": "BeHai", "default_icon": {"48": "icon48.png", "128": "icon128.png"}}, "browser_specific_settings": {"gecko": {"id": "behai-extension@genjutsu.ai", "data_collection_permissions": {"required": ["personalCommunications", "websiteContent", "authenticationInfo"]}}}}