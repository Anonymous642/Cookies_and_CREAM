{"manifest_version": 2, "name": "Tabby \u2013 Tab-Listen-Export", "version": "1.0.0", "description": "Tabby bringt Ordnung in deine offenen Tabs: Titel und URLs aller Tabs (alle Fenster, ausgew\u00e4hlte Fenster oder nur das aktuelle Fenster) lassen sich als TXT, CSV, XLSX oder DOCX exportieren. Inklusive Tab-Z\u00e4hler-Badge und optionaler Erinnerung, wenn zu viele Tabs offen sind.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["tabs", "alarms", "notifications", "storage", "downloads"], "background": {"scripts": ["lib/jszip.min.js", "popup/export.js", "background.js"], "persistent": true}, "browser_action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_popup": "popup/popup.html", "default_title": "Tabby \u2013 Tab-Liste exportieren"}, "browser_specific_settings": {"gecko": {"id": "tabby-tabs-export@local.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}