{"manifest_version": 3, "name": "FYERS Live Positions Widget", "version": "0.3.2", "description": "Floating Firefox extension widget and sidebar for FYERS positions, funds, quotes, grouping and quick exit using _FYERS cookie auth.", "permissions": ["storage", "cookies", "tabs", "notifications"], "host_permissions": ["https://*.fyers.co.in/*", "https://fyers.co.in/*", "https://fyers.in/*", "https://assets.fyers.in/*", "https://*/*", "http://*/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["contentScript.js"], "run_at": "document_idle"}], "sidebar_action": {"default_title": "FYERS Live", "default_panel": "sidepanel.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "action": {"default_title": "FYERS Live", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "fyers-live-positions-widget@fyers.in", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["authenticationInfo", "financialAndPaymentInfo"]}}}}