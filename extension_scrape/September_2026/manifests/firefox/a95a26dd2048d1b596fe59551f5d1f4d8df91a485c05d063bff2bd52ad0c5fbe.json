{"manifest_version": 3, "name": "Tweet to Image, Video & GIF \u2014 tweet.download", "description": "Open any X post in the tweet.download editor in one click, then save it as a PNG, JPG, WebP, MP4, GIF or WebM.", "version": "1.0.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["activeTab"], "action": {"default_title": "Open this tweet in tweet.download"}, "browser_specific_settings": {"gecko": {"id": "extension@tweet.download", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}}