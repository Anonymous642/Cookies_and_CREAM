{"manifest_version": 3, "name": "iBookmarkIt", "description": "Save pages you like, add notes, and organize them with optional iBookmarkIt Pro tools.", "version": "1.3.1", "author": "ibookmarkit.com", "browser_specific_settings": {"gecko": {"id": "ibookmarkit@ibookmarkit.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "action": {"default_title": "iBookmarkIt", "default_popup": "popup/popup.html"}, "options_page": "options/options.html", "permissions": ["storage", "tabs", "scripting"], "host_permissions": ["<all_urls>"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/icon16.png", "icons/icon32.png", "icons/icon48.png", "icons/icon128.png"], "matches": ["<all_urls>"]}]}