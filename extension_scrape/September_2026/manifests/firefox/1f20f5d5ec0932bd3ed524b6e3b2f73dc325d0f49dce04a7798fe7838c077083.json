{"manifest_version": 3, "name": "FairReact - Dual Sync Reaction Player", "version": "1.0.4", "browser_specific_settings": {"gecko": {"id": "fairreact-dualsync@suryakrishna.org", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "description": "Plays original videos in synchronized PiP overlay on YouTube reaction videos, ensuring fair views and eliminating copyright issues.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "default_title": "FairReact Controls & Sync"}, "permissions": ["storage", "activeTab", "scripting", "declarativeNetRequest", "declarativeNetRequestFeedback"], "host_permissions": ["*://*.youtube.com/*", "*://*.googlevideo.com/*"], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://youtube.com/*"], "js": ["content/sync_engine.js", "content/overlay.js", "content/content.js"], "css": ["content/overlay.css"], "all_frames": true, "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["icons/*", "content/*"], "matches": ["*://*.youtube.com/*", "*://youtube.com/*"]}]}