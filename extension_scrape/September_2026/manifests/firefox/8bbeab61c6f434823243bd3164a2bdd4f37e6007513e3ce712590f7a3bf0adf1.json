{"manifest_version": 2, "name": "Ossi Browser Bridge for Firefox", "short_name": "Ossi Browser Bridge", "version": "0.1.1", "description": "Sends explicitly requested Firefox page state and actions through an authenticated local connection to the Firefox Codex plugin.", "author": "Ossi", "homepage_url": "https://github.com/Ossi-1337/firefox-codex-plugin", "icons": {"32": "icons/bridge.svg", "64": "icons/bridge.svg", "96": "icons/bridge.svg", "128": "icons/bridge.svg"}, "permissions": ["storage", "tabs", "webRequest", "webRequestBlocking", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": true}, "content_security_policy": "default-src 'self'; connect-src ws://127.0.0.1:*; img-src 'self'; style-src 'self'; script-src 'self'; object-src 'none'", "options_ui": {"page": "onboarding.html", "open_in_tab": true}, "browser_action": {"default_title": "Open Firefox bridge setup", "default_icon": "icons/bridge.svg"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false}], "browser_specific_settings": {"gecko": {"id": "firefox-codex@ossi.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteActivity", "websiteContent"]}}}}