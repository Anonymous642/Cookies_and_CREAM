{"manifest_version": 2, "name": "Chess Helper", "version": "1.9.2", "description": "Chess analysis helper for Chess.com", "permissions": ["activeTab", "https://www.chess.com/*", "https://lichess.org/*", "http://localhost:5000/*"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "content_scripts": [{"matches": ["https://www.chess.com/*", "https://lichess.org/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "chess-helper@gmail.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}