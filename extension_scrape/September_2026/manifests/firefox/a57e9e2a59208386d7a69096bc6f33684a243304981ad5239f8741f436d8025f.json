{"manifest_version": 3, "name": "Astagfirullah - Islamic Remembrance", "version": "1.0.0", "description": "Transform browsing waiting time into spiritual reflection with Islamic praises and supplications.", "homepage_url": "https://afappssystem.4fdev.com/", "browser_specific_settings": {"gecko": {"id": "astagfirullah@4fdev.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "alarms", "webNavigation", "scripting", "tabs"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["src/background/wrapper.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/content/content-bundled.js"], "css": ["src/content/styles.css"], "run_at": "document_start"}], "action": {"default_popup": "src/popup/popup.html", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "default_title": "Astagfirullah"}, "options_page": "src/options/options.html", "chrome_url_overrides": {"newtab": "src/newtab/newtab.html"}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["assets/audio/*", "src/content/styles.css", "src/content/content-bundled.js", "src/fonts/*"], "matches": ["<all_urls>"]}], "commands": {"show-phrase": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Command+Shift+A"}, "description": "Show a praise phrase"}}}