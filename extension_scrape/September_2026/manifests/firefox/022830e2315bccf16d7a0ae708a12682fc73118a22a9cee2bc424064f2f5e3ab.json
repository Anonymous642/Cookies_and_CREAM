{"manifest_version": 3, "name": "Quick URL & Title Copier", "version": "1.0.0", "description": "Copy the current page URL and title quickly from a simple Firefox popup.", "action": {"default_title": "Quick URL & Title Copier", "default_popup": "popup.html", "default_icon": {"48": "icon-48.png", "96": "icon-96.png"}}, "permissions": ["activeTab", "clipboardWrite"], "browser_specific_settings": {"gecko": {"id": "quick-url-title-copier@addon.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icon-48.png", "96": "icon-96.png"}}