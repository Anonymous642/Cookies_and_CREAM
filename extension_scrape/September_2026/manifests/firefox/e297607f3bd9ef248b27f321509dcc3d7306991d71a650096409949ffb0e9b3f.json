{"manifest_version": 3, "name": "Budling Clipper", "version": "1.1.0", "description": "Save English words from any webpage to your Budling flashcard sets in one click. Right-click or press the shortcut.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "permissions": ["activeTab", "contextMenus", "scripting", "storage"], "host_permissions": ["https://budling.net/*"], "commands": {"clip-selection": {"suggested_key": {"default": "Ctrl+B", "mac": "Command+B"}, "description": "Add the selected text to Budling"}}, "browser_specific_settings": {"gecko": {"id": "clipper@budling.net", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["websiteContent", "authenticationInfo"]}}}}