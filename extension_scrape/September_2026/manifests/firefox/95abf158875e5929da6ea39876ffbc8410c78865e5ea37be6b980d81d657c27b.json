{"manifest_version": 2, "name": "Hypervault", "description": "A password manager for teams. Check out hypervault.com for more information.", "version": "2.0.35", "icons": {"16": "offlineIcon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "homepage_url": "https://hypervault.com", "permissions": ["storage", "alarms", "tabs", "cookies", "clipboardWrite", "clipboardRead", "scripting", "https://*/*", "http://*/*"], "web_accessible_resources": ["icon16.png", "popup.html", "assets/*", "chunks/*", "hypervault-logo.png"], "browser_specific_settings": {"gecko": {"id": "{8ed841ec-4a3e-4549-a276-0c63d9e3b7df}", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo"], "optional": ["technicalAndInteraction"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Hypervault", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}