{"manifest_version": 2, "name": "YT Controller", "version": "1.2.0", "description": "Right-click the toolbar icon to play/pause any YouTube tab. Toolbar icon also toggles playback.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_action": {"default_icon": {"48": "icons/icon-play-48.png"}, "default_title": "YT Controller \u2014 Click to Play/Pause"}, "permissions": ["tabs", "contextMenus"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "yt-controller@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}