{"manifest_version": 3, "name": "RegattAlly", "version": "1.0.0", "author": "Bitsailor", "homepage_url": "https://bitsailor.net/regattally", "description": "Recording race timings for regattas managed on manage2sail. Automatically compute Rankings. Includes yardstick support.", "browser_specific_settings": {"gecko": {"id": "regattally@bitsailor.net"}}, "experimental": true, "permissions": ["tabs", "activeTab", "scripting"], "host_permissions": ["https://manage2sail.com/*", "https://www.manage2sail.com/*/event/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://manage2sail.com/*/event/*", "https://www.manage2sail.com/*/event/*"], "js": ["content.js"]}], "action": {"default_icon": {"32": "icons/timer_32dp_F_0_opsz40.png", "48": "icons/timer_48dp_F_0_opsz48.png"}, "theme_icons": [{"dark": "icons/timer_32dp_F_1_opsz40.png", "light": "icons/timer_32dp_F_0_opsz40.png", "size": 32}, {"dark": "icons/timer_48dp_F_1_opsz48.png", "light": "icons/timer_48dp_F_0_opsz48.png", "size": 48}], "default_title": "Record Regatta Timings"}, "icons": {"16": "icons/timer_16dp_opsz20.png", "24": "icons/timer_24dp_opsz24.png", "48": "icons/timer_48dp_opsz48.png", "128": "icons/timer_128dp_opsz48.png"}}