{"manifest_version": 3, "name": "XpressNotes \u2014 Your Thinking Space", "version": "1.7.12", "description": "Capture ideas, take notes and stay organized with a distraction-free note editor in the sidebar, popup or in-page editor.", "homepage_url": "https://xpressnotes.com", "browser_specific_settings": {"gecko": {"id": "xpressnotes@xpressnotes.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo"]}}}, "permissions": ["storage", "activeTab", "scripting", "tabs", "identity", "contextMenus"], "sidebar_action": {"default_title": "XpressNotes", "default_panel": "panel/dist/index.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "open_at_install": true}, "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https: data: blob:; connect-src 'self' https: data: blob:;"}, "action": {"default_title": "Toggle XpressNotes", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.bundle.js"]}, "options_ui": {"page": "panel/dist/options.html", "open_in_tab": true}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "web_accessible_resources": [{"resources": ["panel/dist/index.html", "panel/dist/options.html", "panel/dist/assets/*"], "matches": ["<all_urls>"]}]}