{"manifest_version": 2, "name": "Haspit", "version": "1.1", "description": "Haspit | Secure Your Email with Blockchain", "icons": {"16": "haspit_16.png", "48": "haspit_48.png", "128": "haspit_128.png"}, "content_scripts": [{"matches": ["*://mail.google.com/*", "https://mail.google.com/mail/*", "https://mail.google.com/mail/u/0/#inbox?compose=new", "*://mail.yahoo.com/*", "https://in.mail.yahoo.com/*", "https://outlook.cloud.microsoft/*", "https://outlook.office.com/*"], "css": ["modalpopuphaspit.css"], "js": ["gmail.js", "function.js", "content.js", "outlook.js", "config.js"], "all_frames": true, "run_at": "document_idle"}], "permissions": ["webRequest", "<all_urls>", "webRequestBlocking"], "licenses": [{"name": "MIT", "url": "https://opensource.org/licenses/MIT"}], "browser_specific_settings": {"gecko": {"id": "admin@scalarat.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "personalCommunications", "authenticationInfo", "locationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}