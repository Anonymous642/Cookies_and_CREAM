{"manifest_version": 3, "name": "YouTube Timestamp Updater", "version": "1.3", "description": "Automatically updates YouTube URL with current playback timestamp at a configurable interval", "browser_specific_settings": {"gecko": {"id": "youtube-timestamp-updater@example.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["scripting", "storage", "history"], "host_permissions": ["*://*.youtube.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}]}