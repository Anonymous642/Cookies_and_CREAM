{"manifest_version": 2, "name": "Briked LastFM YoutubeMusic Scrobbler", "description": "A browser extension to keep your Youtube Music listening activity up to date with your LastFM.", "version": "2.0.4", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "tabs", "scripting", "https://music.youtube.com/*", "https://ws.audioscrobbler.com/", "https://www.last.fm/api/*"], "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"]}, "id": "{db4d3665-83be-478f-8ff0-4d17052b465a}"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Last FM Scrobbler", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.last.fm/api/*"], "js": ["content-scripts/lastfm.js"]}, {"matches": ["*://music.youtube.com/*"], "js": ["content-scripts/youtube-music.js"]}]}