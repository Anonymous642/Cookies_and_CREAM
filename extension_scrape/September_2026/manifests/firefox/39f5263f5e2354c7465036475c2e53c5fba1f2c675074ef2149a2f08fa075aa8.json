{"manifest_version": 3, "name": "touchgrass", "short_name": "touchgrass", "version": "1.0.0", "description": "Keeps YouTube Shorts out of your homepage, sidebar, and search \u2014 and sends you back if you ever land on one. Go touch grass instead.", "icons": {"16": "icons/active/icon16.png", "32": "icons/active/icon32.png", "48": "icons/active/icon48.png", "128": "icons/active/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/active/icon16.png", "32": "icons/active/icon32.png", "48": "icons/active/icon48.png", "128": "icons/active/icon128.png"}}, "background": {"scripts": ["settings.js", "background.js"]}, "permissions": ["storage", "webNavigation"], "host_permissions": ["*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"], "css": ["content.css"], "js": ["settings.js", "content.js"], "run_at": "document_start", "all_frames": false}], "browser_specific_settings": {"gecko": {"id": "touchgrass@touchgrass.ext", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}