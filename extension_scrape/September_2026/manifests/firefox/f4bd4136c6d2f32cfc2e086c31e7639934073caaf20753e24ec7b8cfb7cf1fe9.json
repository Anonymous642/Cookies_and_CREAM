{"manifest_version": 2, "name": "Snapchat Web Fix for Firefox", "version": "1.0.0", "description": "Makes Snapchat Web treat Firefox as a supported browser (desktop and Android) by presenting a Chrome identity to Snapchat's servers and page scripts.", "permissions": ["webRequest", "webRequestBlocking", "*://*.snapchat.com/*", "*://*.sc-cdn.net/*", "*://*.snap.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.snapchat.com/*", "*://*.sc-cdn.net/*"], "js": ["inject.js"], "run_at": "document_start", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "snapchat-web-fix@local.extension", "strict_min_version": "60.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "113.0"}}}