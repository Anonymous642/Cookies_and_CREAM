{"manifest_version": 2, "name": "Micro-Learning Injector", "version": "1.3", "description": "Injects short learning cards into webpages to reinforce knowledge and encourage continuous learning.", "permissions": ["storage", "tabs", "activeTab", "notifications"], "background": {"scripts": ["learningEngine.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"], "css": ["styles.css"], "run_at": "document_idle"}], "browser_action": {"default_title": "Micro-Learning Injector", "default_popup": "popup.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Micro-Learning-Injector", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}