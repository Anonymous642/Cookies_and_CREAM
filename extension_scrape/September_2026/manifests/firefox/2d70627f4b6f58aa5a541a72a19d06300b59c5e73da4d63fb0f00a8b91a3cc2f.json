{"manifest_version": 3, "name": "ThumbGrabber Pro", "short_name": "ThumbGrabber", "version": "1.0.0", "description": "Download public YouTube thumbnails and preview video frames in multiple resolutions.", "action": {"default_title": "ThumbGrabber Pro", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["downloads", "clipboardRead"], "host_permissions": ["https://img.youtube.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "thumbgrabberpro@thumbnaildownloaderpro.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}