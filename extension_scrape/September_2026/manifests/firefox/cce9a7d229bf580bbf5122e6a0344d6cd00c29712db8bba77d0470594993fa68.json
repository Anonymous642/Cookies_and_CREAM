{"manifest_version": 3, "name": "Reaction Rush", "version": "1.0.0", "description": "A fast, accessible reaction-time mini-game.", "action": {"default_title": "Reaction Rush", "default_popup": "popup.html", "default_icon": {"16": "image/icon-16.png", "32": "image/icon-32.png", "48": "image/icon-48.png", "128": "image/icon-128.png"}}, "permissions": ["storage"], "browser_specific_settings": {"gecko": {"id": "reaction-rush@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "icons": {"16": "image/icon-16.png", "32": "image/icon-32.png", "48": "image/icon-48.png", "128": "image/icon-128.png"}}