{"manifest_version": 3, "name": "Download Sorter", "version": "1.0.0", "description": "Sort downloads by file type and URL using customizable rules", "permissions": ["downloads", "storage"], "background": {"scripts": ["background/background.js"], "type": "module"}, "options_ui": {"page": "settings/index.html", "open_in_tab": true}, "icons": {"48": "icons/icon-48.svg", "96": "icons/icon-96.svg", "128": "icons/icon-128.svg"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none';"}, "browser_specific_settings": {"gecko": {"id": "@download-sorter.mitori", "data_collection_permissions": {"required": ["none"]}}}}