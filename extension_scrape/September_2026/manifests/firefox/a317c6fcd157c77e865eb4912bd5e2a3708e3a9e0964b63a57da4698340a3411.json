{"manifest_version": 3, "name": "Scroll Darkener", "version": "1.1", "description": "Darkens the screen on Reddit based on scroll distance and disables comment links if set.", "permissions": ["storage"], "host_permissions": ["https://www.reddit.com/*"], "content_scripts": [{"matches": ["https://www.reddit.com/*"], "js": ["content.js"], "css": ["styles.css"]}], "action": {"default_popup": "popup.html", "default_title": "Scroll Darkener Settings"}, "browser_specific_settings": {"gecko": {"id": "scroll-darkener@local"}}}