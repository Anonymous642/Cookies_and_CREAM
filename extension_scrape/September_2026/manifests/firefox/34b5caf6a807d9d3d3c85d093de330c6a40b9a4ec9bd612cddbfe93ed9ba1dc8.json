{"manifest_version": 3, "name": "Temporary Chat Shortcut for ChatGPT", "version": "1.0.0", "description": "Toggle ChatGPT Temporary Chat mode with Ctrl+Alt+T.", "browser_specific_settings": {"gecko": {"id": "temporary-chat-shortcut-chatgpt@sentiments.tools", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png"}, "action": {"default_title": "Toggle Temporary Chat", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "background": {"scripts": ["src/background.js"]}, "commands": {"toggle-temporary-chat": {"suggested_key": {"default": "Ctrl+Alt+T"}, "description": "Toggle Temporary Chat mode on ChatGPT"}}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["src/content-script.js"], "run_at": "document_idle"}]}