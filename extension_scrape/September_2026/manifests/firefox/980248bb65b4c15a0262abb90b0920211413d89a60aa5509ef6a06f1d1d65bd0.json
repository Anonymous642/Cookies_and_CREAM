{"manifest_version": 2, "name": "PriceScan", "description": "Shows price context for bazos, aukro, tipcars, and carvago listings.", "version": "0.1.118", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "browser_specific_settings": {"gecko": {"id": "pricescan@pavel.jegoskin", "data_collection_permissions": {"required": ["websiteContent"]}}}, "permissions": ["storage"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.aukro.cz/*"], "js": ["content-scripts/aukro-price.js"]}, {"matches": ["*://*.bazos.cz/pridat-inzerat.php*"], "js": ["content-scripts/bazos-add-listing.js"]}, {"matches": ["*://*.bazos.cz/*"], "js": ["content-scripts/bazos-price.js"]}, {"matches": ["*://*.carvago.com/*"], "js": ["content-scripts/carvago-price.js"]}, {"matches": ["*://*.tipcars.com/*"], "js": ["content-scripts/tipcars-price.js"]}], "web_accessible_resources": ["content-scripts/aukro-price.css", "content-scripts/bazos-add-listing.css", "content-scripts/bazos-price.css", "content-scripts/carvago-price.css", "content-scripts/tipcars-price.css"]}