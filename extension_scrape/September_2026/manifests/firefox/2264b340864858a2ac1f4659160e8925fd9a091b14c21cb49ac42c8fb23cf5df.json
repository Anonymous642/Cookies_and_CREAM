{"manifest_version": 2, "name": "EasyWeather", "version": "1.0.0", "description": "Quick weather at a glance + site overlay widget.", "browser_action": {"default_title": "EasyWeather", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "permissions": ["geolocation", "storage"], "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "96": "icon96.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "easyweather@example.com", "strict_min_version": "91.0"}}}