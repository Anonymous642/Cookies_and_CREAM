{"manifest_version": 2, "name": "Fuuk Filter", "version": "1.1", "description": "Replaces all instances of 'fuck' with 'fuuk'.", "permissions": ["storage"], "host_permissions": ["*://*.twitter.com/*", "*://*.x.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_specific_settings": {"gecko": {"id": "fuuk-filter@example.com"}}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "content_scripts": [{"matches": ["*://*.twitter.com/*", "*://*.x.com/*"], "js": ["content.js"]}], "web_accessible_resources": ["yay!.mp3", "disable.mp3"]}