{"manifest_version": 3, "name": "JSK ClipKeep \u2014 Clipboard Manager & History", "description": "Clipboard history that detects and protects the secrets you copy. Encrypted on your device, never sent anywhere.", "version": "0.1.0", "short_name": "ClipKeep", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "clipboardRead", "clipboardWrite", "unlimitedStorage", "alarms", "activeTab", "scripting", "tabs"], "host_permissions": ["http://*/*", "https://*/*"], "action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png"}, "default_title": "ClipKeep", "default_popup": "popup.html"}, "commands": {"open_panel": {"description": "Open ClipKeep"}, "paste_last": {"description": "Paste the most recent clip"}, "toggle_capture": {"description": "Pause or resume capture"}}, "browser_specific_settings": {"gecko": {"id": "clipkeep@jskapps.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "sidebar_action": {"default_panel": "sidepanel.html", "default_icon": {"16": "icon/16.png", "32": "icon/32.png"}, "default_title": "ClipKeep"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "all_frames": true, "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}