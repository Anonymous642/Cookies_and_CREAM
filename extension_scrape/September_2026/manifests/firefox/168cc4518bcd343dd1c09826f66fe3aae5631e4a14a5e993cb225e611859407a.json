{"manifest_version": 3, "name": "Tabnetic", "version": "1.0.8", "description": "Smart tab consolidation: pull all your tabs together, auto-group by domain, remove duplicates, snapshot your layout for undo, and split groups back out.", "permissions": ["tabs", "tabGroups", "storage", "contextMenus", "cookies"], "action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Tabnetic", "default_popup": "popup/popup.html", "default_area": "navbar"}, "background": {"scripts": ["background/background.js"]}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "tabnetic@burnsie", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}