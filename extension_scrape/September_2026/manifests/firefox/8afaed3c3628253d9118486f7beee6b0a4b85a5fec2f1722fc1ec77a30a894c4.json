{"manifest_version": 3, "name": "Tab Sync", "version": "2026.8.17.4", "description": "Mirror open tabs across Chrome, Firefox and Safari via a GitHub state repo.", "permissions": ["tabs", "storage", "alarms", "sessions"], "host_permissions": ["https://api.github.com/*", "https://github.com/*", "https://tab-sync-setup.cloudflare-setup-worker.workers.dev/*"], "content_scripts": [{"matches": ["https://tab-sync-setup.cloudflare-setup-worker.workers.dev/*"], "js": ["src/cloudflare-callback.js"], "run_at": "document_idle"}], "background": {"service_worker": "src/background.js", "scripts": ["src/background.js"], "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_area": "navbar", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "tab-sync@patrickwilliams2345.github.io", "strict_min_version": "115.0"}}}