{"manifest_version": 3, "name": "Orwellix Readability Checker", "version": "1.0.1", "description": "Check readability grade level, hard sentences, and writing style issues from your browser.", "action": {"default_popup": "popup.html", "default_title": "Orwellix Readability Checker", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "storage"], "host_permissions": ["https://app-server.orwellix.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "orwellix-readability-checker@orwellix.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": []}}}}