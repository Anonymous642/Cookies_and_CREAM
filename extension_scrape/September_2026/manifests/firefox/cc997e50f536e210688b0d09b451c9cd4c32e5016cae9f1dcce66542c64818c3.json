{"manifest_version": 3, "name": "X Webhook Sender Discord", "version": "1.1.4", "description": "Send tweets to Discord webhooks", "permissions": ["storage", "downloads"], "host_permissions": ["https://discord.com/*", "https://x.com/*", "https://twitter.com/*", "https://pbs.twimg.com/*"], "background": {"scripts": ["shared.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["shared.js", "content.js"], "css": ["styles.css"], "run_at": "document_end"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://x.com/*", "https://twitter.com/*"]}], "browser_specific_settings": {"gecko": {"id": "X-Webhook-Sender-Discord@omenoftheraven.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}}