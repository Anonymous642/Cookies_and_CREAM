{"manifest_version": 3, "name": "AccessGuardian", "version": "1.0", "description": "Monitors and notifies about accessibility issues on web pages", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "accessguardian@example.com"}}, "permissions": ["activeTab", "storage", "notifications"], "action": {"default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "AccessGuardian", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}]}