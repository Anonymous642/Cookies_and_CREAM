{"manifest_version": 3, "name": "Wiktionary Simplified to Traditional Redirect", "version": "1.0", "description": "Automatically redirects Simplified Chinese entries to their Traditional counterparts on English Wiktionary.", "permissions": ["storage"], "action": {"default_popup": "popup.html", "default_title": "Redirect Settings"}, "browser_specific_settings": {"gecko": {"id": "wiktionary-simp-chinese-redirect@saccharine_sky", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://en.wiktionary.org/wiki/*"], "js": ["content.js"], "run_at": "document_idle"}]}