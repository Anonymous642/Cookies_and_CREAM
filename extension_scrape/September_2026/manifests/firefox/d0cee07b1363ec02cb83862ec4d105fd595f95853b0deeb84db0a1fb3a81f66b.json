{"manifest_version": 3, "name": "Bookmark Explorer: God Mode", "version": "8.0.0", "version_name": "8.0.0 (Visual & AI Update)", "description": "The ultimate visual bookmark workspace.", "permissions": ["bookmarks", "storage", "alarms", "notifications", "contextMenus", "tabGroups", "identity", "tabs"], "optional_permissions": ["downloads"], "optional_host_permissions": ["<all_urls>"], "host_permissions": ["https://generativelanguage.googleapis.com/*", "https://www.googleapis.com/*"], "content_scripts": [{"matches": ["<all_urls>"], "css": ["content_style.css"], "js": ["content_script.js"]}], "commands": {"toggle-command-palette": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open Bookmark Search Palette"}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Open Bookmark Explorer", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "offline_enabled": true, "oauth2": {"client_id": "YOUR_CLIENT_ID_HERE.apps.googleusercontent.com", "scopes": ["https://www.googleapis.com/auth/drive.file"]}, "browser_specific_settings": {"gecko": {"id": "bookmark-explorer@godmode.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}