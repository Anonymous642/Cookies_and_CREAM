{"manifest_version": 2, "name": "Tab Saver", "version": "1.0.0", "description": "Saves titles and URLs of all open tabs to a text file", "browser_specific_settings": {"gecko": {"id": "tab-saver@alsheikhmedia.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "downloads"], "icons": {"16": "icon16.png", "48": "icon48.png", "96": "icon96.png", "128": "icon128.png"}, "browser_action": {"default_title": "Save Tabs", "default_icon": {"16": "icon16.png", "48": "icon48.png"}}, "background": {"scripts": ["background.js"]}, "content_security_policy": "script-src 'self'; object-src 'self'"}