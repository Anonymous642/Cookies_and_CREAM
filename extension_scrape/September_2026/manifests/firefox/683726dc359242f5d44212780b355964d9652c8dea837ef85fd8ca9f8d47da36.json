{"manifest_version": 3, "name": "RapidIdentity Auto-Login for NCEdCloud", "version": "1.1.0", "description": "One-click username and password autofill for NCEdCloud with multi-account support.", "permissions": ["storage", "scripting", "activeTab", "tabs"], "background": {"scripts": ["credentials.js", "background.js"]}, "host_permissions": ["https://idp.ncedcloud.org/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://idp.ncedcloud.org/*"], "js": ["content.js"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "NCEdCloud Auto-Login", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "browser_specific_settings": {"gecko": {"id": "rapididentity-auto-login@example.com", "strict_min_version": "109.0"}}}