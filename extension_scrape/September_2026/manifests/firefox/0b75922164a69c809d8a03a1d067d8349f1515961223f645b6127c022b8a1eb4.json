{"manifest_version": 3, "name": "PIA - Personal Intelligence Assistant", "version": "1.1.5", "description": "Your personal AI-powered bookmark dashboard - beautiful startup page with smart organization", "author": "Harry Buining", "chrome_url_overrides": {"newtab": "index.html"}, "permissions": ["storage", "tabs", "history", "contextMenus", "notifications", "identity"], "host_permissions": ["https://pia-app.online/*", "https://*.googleapis.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "Save to PIA"}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "pia@buiningdesign.nl", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "bookmarksInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}