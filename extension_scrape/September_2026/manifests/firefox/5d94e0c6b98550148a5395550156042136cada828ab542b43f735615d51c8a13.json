{"manifest_version": 3, "name": "Copy Multi URLs", "version": "1.0.1", "description": "Copy all URLs from selected text at once. Right-click or use the toolbar button.", "permissions": ["menus", "clipboardWrite", "activeTab", "scripting", "notifications"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/url-extractor.js", "content.js"], "all_frames": true}], "action": {"default_title": "Copy selected URLs", "default_icon": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}}, "icons": {"32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "commands": {"copy-selected-urls": {"suggested_key": {"default": "Ctrl+Shift+U", "mac": "MacCtrl+Shift+U"}, "description": "Copy all URLs from the current selection"}}, "browser_specific_settings": {"gecko": {"id": "copy-multi-urls@example.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}