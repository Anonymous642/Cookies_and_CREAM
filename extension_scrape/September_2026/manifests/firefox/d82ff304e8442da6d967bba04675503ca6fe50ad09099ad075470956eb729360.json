{"manifest_version": 3, "name": "AppSheet Copilot", "version": "1.4.0", "description": "AI assistant for the AppSheet editor: build columns, views and actions with Claude Code, Gemini or your own API key.", "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "AppSheet Assistant", "default_icon": {"48": "icons/icon48.png"}}, "options_ui": {"page": "src/popup/index.html", "open_in_tab": true}, "permissions": ["storage"], "host_permissions": ["https://www.appsheet.com/*", "https://generativelanguage.googleapis.com/*", "https://api.deepseek.com/*", "https://api.anthropic.com/*", "https://gemini.google.com/*"], "content_scripts": [{"matches": ["https://www.appsheet.com/template/*", "https://www.appsheet.com/Template/*"], "js": ["src/content/index.js"], "run_at": "document_idle"}, {"matches": ["https://www.appsheet.com/template/*", "https://www.appsheet.com/Template/*"], "js": ["src/content/bridge.js"], "world": "MAIN", "run_at": "document_idle"}, {"matches": ["https://gemini.google.com/*"], "js": ["src/content/gemini-driver.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["https://www.appsheet.com/*"]}], "sidebar_action": {"default_title": "AppSheet Assistant", "default_panel": "src/sidebar/index.html", "default_icon": {"48": "icons/icon48.png"}}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Alt+A"}, "description": "Toggle the AppSheet Assistant sidebar"}}, "background": {"scripts": ["src/background/index.js"]}, "content_security_policy": {"extension_pages": "script-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "appsheet-copilot@gimasys.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}