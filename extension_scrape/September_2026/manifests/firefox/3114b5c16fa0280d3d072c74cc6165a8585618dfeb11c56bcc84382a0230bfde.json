{"manifest_version": 2, "name": "Mohnoks Clipper", "version": "1.0.3", "description": "Save images and pages to Mohnoks", "browser_specific_settings": {"gecko": {"id": "mohnoks-clipper@mohnoks.com", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["contextMenus", "nativeMessaging", "activeTab", "storage", "unlimitedStorage", "<all_urls>"], "icons": {"48": "images/icon-48.png", "96": "images/icon-96.png", "128": "images/icon-128.png", "256": "images/icon-256.png", "512": "images/icon-512.png"}, "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_popup": "popup.html", "default_title": "Mohnoks Clipper", "default_icon": {"48": "images/icon-48.png", "128": "images/icon-128.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["batch-overlay.js", "content.js"], "run_at": "document_idle"}]}