{"manifest_version": 2, "name": "StatsFox", "version": "1.0.0", "description": "Suivez pr\u00e9cis\u00e9ment votre navigation : temps par site, YouTube, cat\u00e9gories, tendances et bien plus \u2014 100% local, sans aucune collecte.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "unlimitedStorage", "tabs", "webNavigation", "idle", "alarms", "<all_urls>"], "background": {"scripts": ["lib/storage.js", "lib/categories.js", "lib/utils.js", "background/tracker.js", "background/background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/activity.js"], "run_at": "document_idle", "all_frames": false}, {"matches": ["*://www.youtube.com/*", "*://youtube.com/*", "*://m.youtube.com/*"], "js": ["content/youtube.js"], "run_at": "document_idle", "all_frames": false}], "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}, "default_title": "StatsFox"}, "chrome_url_overrides": {"newtab": "newtab/newtab.html"}, "options_ui": {"page": "stats/stats.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "statsfox@local.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}