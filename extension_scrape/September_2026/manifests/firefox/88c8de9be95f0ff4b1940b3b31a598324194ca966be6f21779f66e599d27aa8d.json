{"manifest_version": 3, "name": "strimora", "short_name": "Strimora", "version": "1.0.2", "description": "Cherchez un film, une s\u00e9rie ou un jeu et trouvez o\u00f9 le regarder / y jouer, directement depuis votre navigateur.", "browser_specific_settings": {"gecko": {"id": "extension@strimora.de", "data_collection_permissions": {"required": ["searchTerms"], "optional": ["authenticationInfo"]}, "strict_min_version": "142.0"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "Rechercher sur Strimora", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "background": {"scripts": ["background.js"]}, "permissions": ["contextMenus"], "host_permissions": ["https://strimora.de/*"]}