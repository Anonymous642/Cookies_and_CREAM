{"manifest_version": 2, "name": "Furikazan", "version": "1.1.1", "description": "Show or hide Japanese furigana instantly.", "author": "SilverwoodsLabs <thomas@silverwoodslabs.com>", "homepage_url": "https://github.com/tkemperman/furikazan", "icons": {"48": "icons/furikazan.svg", "96": "icons/furikazan.svg"}, "permissions": ["contextMenus", "activeTab", "storage", "unlimitedStorage", "https://www.edrdg.org/*"], "background": {"scripts": ["dictionary.js", "background.js"]}, "browser_action": {"default_title": "Show/Hide furigana", "default_icon": {"48": "icons/furikazan.svg", "96": "icons/furikazan.svg"}}, "commands": {"toggle-furigana": {"suggested_key": {"default": "Ctrl+Shift+F"}, "description": "Show or hide furigana"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "furikazan@silverwoodslabs.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}