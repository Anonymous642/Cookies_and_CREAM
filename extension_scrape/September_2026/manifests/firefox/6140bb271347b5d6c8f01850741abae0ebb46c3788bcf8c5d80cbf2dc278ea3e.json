{"manifest_version": 3, "name": "Steam \u2192 GOG Checker", "version": "0.1.1", "description": "Shows whether the Steam game page you are viewing appears to be available on GOG.com.", "permissions": ["storage"], "host_permissions": ["https://store.steampowered.com/*", "https://catalog.gog.com/*", "https://www.gog.com/*"], "content_scripts": [{"matches": ["https://store.steampowered.com/app/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "steam-gog-checker@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "action": {"default_title": "Steam \u2192 GOG Checker", "default_popup": "popup.html"}}