{"manifest_version": 3, "name": "A1 Image Batch Saver", "short_name": "A1 Images", "version": "0.1.0", "description": "Scan the active page for visible images, filter them by size, type, and host, then download selected image files after user action.", "homepage_url": "https://a1local.com.au/extensions/image-batch-saver/", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_title": "A1 Image Batch Saver", "default_popup": "popup.html"}, "options_page": "options.html", "permissions": ["activeTab", "scripting", "downloads", "storage"], "browser_specific_settings": {"gecko": {"id": "image-batch-saver@a1local.com.au", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "142.0"}}}