{"manifest_version": 3, "name": "ChromaScroll Image Filter", "description": "Apply dynamic color filters to web images instantly for better visibility and reduced eye strain while scrolling.", "version": "1.0.0", "author": "Lumina Labs", "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "chromascrollimagefilter@luminalabs.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}