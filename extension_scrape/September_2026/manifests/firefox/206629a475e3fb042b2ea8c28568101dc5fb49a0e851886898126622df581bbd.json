{"manifest_version": 3, "name": "Nexora", "version": "1.0.0", "description": "Nexora mobile workspace for managing Discord profiles, notes, categories and quick actions in Firefox.", "permissions": ["tabs", "storage"], "host_permissions": ["https://discord.com/*", "https://www.discord.com/*"], "action": {"default_title": "Nexora", "default_popup": "index.html"}, "browser_specific_settings": {"gecko": {"id": "@nexora-workspace", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}, "background": {"scripts": ["background.js"]}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}