{"manifest_version": 2, "name": "Marquee Link Selector", "version": "1.0", "description": "Marquee-style tool to select links (including Hyperlinks). Has two modes toggled by Tilde/Backtick key. Opens links in batches (of 10 by default).", "permissions": ["storage", "tabs"], "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "browser_specific_settings": {"gecko": {"id": "marquee-selector@example.com", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"]}}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png"}}, "background": {"scripts": ["lib/browser-polyfill.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["lib/browser-polyfill.js", "content.js"], "run_at": "document_start"}]}