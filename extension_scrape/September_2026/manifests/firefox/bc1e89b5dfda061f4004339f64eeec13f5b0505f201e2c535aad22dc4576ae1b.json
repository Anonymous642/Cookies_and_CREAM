{"manifest_version": 3, "name": "KinoIn - IMDb Ratings for Tubi", "version": "0.1.4", "description": "Stop guessing what to watch. See IMDb scores directly on Tubi titles. Click any rating to open its IMDb page for further details.", "permissions": ["storage"], "host_permissions": ["https://tubitv.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://tubitv.com/*"], "js": ["content-loader.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["content.js", "api-*.js"], "matches": ["https://tubitv.com/*"]}], "options_page": "options.html", "action": {"default_popup": "popup.html"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "extension@kinoin.xyz", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}