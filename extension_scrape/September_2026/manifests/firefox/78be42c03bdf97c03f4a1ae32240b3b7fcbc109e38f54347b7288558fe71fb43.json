{"manifest_version": 3, "name": "PureSwipe Video Controls", "version": "1.3.9", "description": "Control volume, brightness, and seeking with intuitive gestures. Vertical swipe for volume/brightness, horizontal swipe to seek. Long press down for 0.5x or up for 2.0x speed. Double tap (touch) for \u00b110s jump. Works both on PC and touch.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png", "512": "icon512.png"}, "host_permissions": ["<all_urls>"], "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["*://*.youtube.com/*", "*://*.x.com/*", "*://*.twitter.com/*", "*://*.netflix.com/*", "*://*.twitch.tv/*", "*://*.kinopoisk.ru/*", "*://*.okko.tv/*", "*://*.ivi.ru/*", "*://*.vimeo.com/*", "*://*.tiktok.com/*", "*://*.instagram.com/*", "*://*.disneyplus.com/*", "*://*.hbo.com/*", "*://*.max.com/*", "*://*.apple.com/apple-video-plus/*", "*://*.vk.com/*", "*://*.rutube.ru/*", "*://*.primevideo.com/*", "*://*.hulu.com/*", "*://*.facebook.com/*", "*://*.reddit.com/*"], "js": ["content-script.js"], "css": ["overlay.css"], "run_at": "document_idle", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "psvc@timhmdv.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}