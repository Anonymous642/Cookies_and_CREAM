{"manifest_version": 2, "name": "Coles and Woolworths shopping helper", "description": "Allergen and dietary-profile warnings from OpenFoodFacts on Coles and Woolworths product and search pages.", "version": "2.0.1", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "https://www.woolworths.com.au/*", "https://www.woolworths.co.nz/*", "https://www.coles.com.au/*", "https://*.openfoodfacts.org/*"], "browser_specific_settings": {"gecko": {"id": "supermarket_extension@kirafleming.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}}, "browser_action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "theme_icons": [{"size": 16, "dark": "icon/16.png", "light": "icon/dark/16.png"}, {"size": 32, "dark": "icon/32.png", "light": "icon/dark/32.png"}, {"size": 48, "dark": "icon/48.png", "light": "icon/dark/48.png"}, {"size": 96, "dark": "icon/96.png", "light": "icon/dark/96.png"}, {"size": 128, "dark": "icon/128.png", "light": "icon/dark/128.png"}], "default_title": "Food facts settings", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.coles.com.au/*", "https://www.woolworths.co.nz/*", "https://www.woolworths.com.au/*"], "js": ["content-scripts/content.js"]}]}