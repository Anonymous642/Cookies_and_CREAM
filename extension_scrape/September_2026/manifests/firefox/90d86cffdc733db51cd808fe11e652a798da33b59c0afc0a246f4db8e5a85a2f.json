{"manifest_version": 3, "name": "EndorseHQ \u2014 Review Importer", "version": "2.0.1", "description": "Capture customer reviews from Google, Trustpilot, Facebook, and LinkedIn into your EndorseHQ dashboard.", "permissions": ["activeTab", "storage", "identity", "tabs"], "host_permissions": ["https://www.google.com/*", "https://www.google.co.uk/*", "https://www.trustpilot.com/*", "https://uk.trustpilot.com/*", "https://www.facebook.com/*", "https://www.linkedin.com/*", "https://app.endorsehq.com/*"], "background": {"scripts": ["service-worker.js"]}, "content_scripts": [{"matches": ["https://www.google.com/maps/*", "https://www.google.co.uk/maps/*", "https://www.google.com/search*", "https://www.google.co.uk/search*", "https://www.trustpilot.com/review/*", "https://uk.trustpilot.com/review/*", "https://www.facebook.com/*", "https://www.linkedin.com/in/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "EndorseHQ Review Importer", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "{97b3da35-1da5-413e-826b-00d7e56c54ed}", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}}, "sidebar_action": {"default_panel": "popup.html", "default_title": "EndorseHQ", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}}