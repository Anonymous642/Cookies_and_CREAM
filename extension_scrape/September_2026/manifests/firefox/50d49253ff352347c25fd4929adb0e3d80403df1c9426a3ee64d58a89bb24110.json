{"manifest_version": 3, "name": "Receptor", "version": "1.1.0", "description": "Intercept and modify network requests. Create rules to modify response of AJAX requests. Redirect requests. Inject custom content", "icons": {"16": "icon/icon16.png", "48": "icon/icon48.png", "128": "icon/icon128.png"}, "permissions": ["declarativeNetRequest", "storage", "unlimitedStorage", "activeTab"], "host_permissions": ["https://*/*", "http://*/*"], "background": {"scripts": ["scripts/receptor-worker.js"]}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["scripts/content.js"]}], "web_accessible_resources": [{"resources": ["scripts/inject.js"], "matches": ["https://*/*", "http://*/*"]}], "action": {"default_popup": "index.html"}, "browser_specific_settings": {"gecko": {"id": "receptor-firefox@receptor-io.com", "strict_min_version": "131.0"}}}