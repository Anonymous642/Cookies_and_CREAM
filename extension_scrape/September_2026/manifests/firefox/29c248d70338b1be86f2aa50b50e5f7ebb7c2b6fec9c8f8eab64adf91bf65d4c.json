{"manifest_version": 3, "name": "Hover PDF", "version": "0.10.4", "description": "Enhanced PDF reader for immersive academic reading experience", "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "permissions": ["tabs", "storage", "webRequest", "webRequestBlocking"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "default_title": "Hover PDF"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["index.html", "assets/*", "popup.html", "popup.css", "popup.js", "pdfium.wasm"], "matches": ["<all_urls>"]}], "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "hoverpdf@chihshengj.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}