{"manifest_version": 3, "name": "Flight Rising Cauldron Notifier", "version": "1.3", "description": "Plays a sound and sends a system notification when Baldwin's Cauldron finishes brewing.", "browser_specific_settings": {"gecko": {"id": "cauldron-notifier@yourname.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["activeTab", "notifications", "storage"], "host_permissions": ["https://*.flightrising.com/*"], "icons": {"16": "icon.png", "48": "icon.png", "128": "icon.png"}, "action": {"default_icon": "icon.png", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.flightrising.com/trading/baldwin*"], "js": ["content.js"]}], "web_accessible_resources": [{"resources": ["ding.mp3"], "matches": ["https://*.flightrising.com/*"]}]}