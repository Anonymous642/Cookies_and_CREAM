{"manifest_version": 3, "name": "timeshifter", "description": "Captura informa\u00e7\u00f5es de navega\u00e7\u00e3o e envia para o app do timeshifter, para criar um timesheet com IA.", "version": "2.2", "permissions": ["tabs", "scripting", "storage", "notifications", "nativeMessaging", "alarms"], "host_permissions": ["http://*/*", "https://*/*"], "incognito": "not_allowed", "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "default_title": "Timeshifter"}, "icons": {"16": "images/icon16.png", "48": "images/icon48.png", "128": "images/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "labella@timeshifter.com.br", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent", "browsingActivity"], "optional": []}}}}