{"manifest_version": 3, "name": "TubeUnarchiver", "version": "1.0.0", "description": "Retrouve les vid\u00e9os YouTube disparues : index d'une cha\u00eene reconstruit depuis les archives, motif d'indisponibilit\u00e9, sous-titres et vignettes.", "homepage_url": "https://github.com/Othman-Benbrahim/tube-unarchiver", "browser_specific_settings": {"gecko": {"id": "tube-unarchiver@othman-benbrahim", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["storage", "tabs", "scripting"], "host_permissions": ["*://*.youtube.com/*", "*://web.archive.org/*", "*://i.ytimg.com/*", "*://findyoutubevideo.thetechrobo.ca/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Ouvrir TubeUnarchiver", "default_icon": {"48": "icons/icon.svg", "96": "icons/icon.svg"}}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}]}