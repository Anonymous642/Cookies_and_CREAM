{"manifest_version": 3, "name": "Auto Scroller for Reels, Shorts & TikTok", "version": "2.0.5", "description": "Auto scroll through Instagram Reels, YouTube Shorts, TikTok & Facebook. Hands-free scrolling for a seamless video experience.", "browser_specific_settings": {"gecko": {"id": "auto-scroller@2piotr", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage", "tabs"], "host_permissions": ["https://*.instagram.com/*", "https://*.youtube.com/*", "https://*.tiktok.com/*", "https://*.facebook.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/smalllogo.png", "48": "icons/smalllogo.png"}}, "content_scripts": [{"matches": ["https://*.instagram.com/*", "https://*.youtube.com/*", "https://*.tiktok.com/*", "https://*.facebook.com/*"], "js": ["compat.js", "constants.js", "utils.js", "platform.js", "ui.js", "scroller.js"], "css": ["status-indicator.css"], "run_at": "document_end"}], "icons": {"16": "icons/smalllogo.png", "48": "icons/smalllogo.png"}, "web_accessible_resources": [{"resources": ["icons/sun.svg", "icons/moon.svg", "icons/facebook.svg", "icons/instagram.svg", "icons/tiktok.svg", "icons/youtube.svg", "icons/smalllogo.png", "icons/drag.svg", "icons/pause.svg", "icons/play.svg"], "matches": ["https://*.instagram.com/*", "https://*.youtube.com/*", "https://*.tiktok.com/*", "https://*.facebook.com/*"]}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}}