{"manifest_version": 2, "name": "WordLink - Keyword URL Mapper", "version": "1.2.0", "description": "Map keywords to URLs. Search a mapped word on Google and jump directly to your URL \u2014 no results page needed.", "author": "", "permissions": ["storage", "tabs", "https://*.google.com/search*", "https://google.com/search*", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "wordlink@extension", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"]}}}}