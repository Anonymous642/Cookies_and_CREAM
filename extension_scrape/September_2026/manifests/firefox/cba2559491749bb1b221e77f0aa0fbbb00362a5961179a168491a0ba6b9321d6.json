{"manifest_version": 3, "name": "OpenGuessr - Hide Street Names", "version": "1.0.0", "description": "Disables the Google Street View road-name overlay labels on openguessr.com, so you can't accidentally read the street name while guessing.", "author": "you", "permissions": [], "content_scripts": [{"matches": ["*://openguessr.com/*", "*://www.openguessr.com/*", "*://www.google.com/maps/embed*"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "web_accessible_resources": [{"resources": ["inject.js"], "matches": ["*://openguessr.com/*", "*://www.openguessr.com/*", "*://www.google.com/*"]}], "browser_specific_settings": {"gecko": {"id": "hide-street-names-openguessr@local.extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}