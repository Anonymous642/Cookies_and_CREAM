{"manifest_version": 3, "name": "HN Keyboard Boost", "version": "0.1.2", "description": "Minimal keyboard navigation for Hacker News.", "content_scripts": [{"matches": ["https://news.ycombinator.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "hn-keyboard-boost@jessesoo", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "109.0"}}}