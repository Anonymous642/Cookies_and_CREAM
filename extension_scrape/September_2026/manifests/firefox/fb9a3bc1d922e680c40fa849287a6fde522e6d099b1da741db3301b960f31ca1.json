{"manifest_version": 3, "name": "History to CSV Exporter", "version": "1.0", "description": "Export Firefox browsing history to a CSV file.", "permissions": ["history", "downloads", "scripting", "storage"], "action": {"default_title": "Export history to CSV"}, "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html"}, "browser_specific_settings": {"gecko": {"id": "@history-to-csv", "data_collection_permissions": {"required": ["none"]}, "strict_min_version": "58.0"}}}