{"manifest_version": 3, "name": "Siteflow Connect", "description": "Connecte votre serveur Siteflow et ouvre API Lab, Track, EDF Connector, Doc Explorer et Data Extractor en production.", "version": "1.0.17", "permissions": ["storage", "scripting", "tabs"], "host_permissions": ["https://lab.siteflow.app/*", "https://track.siteflow.app/*", "https://edf-connector.siteflow.app/*", "https://doc-explorer.siteflow.app/*", "https://data-extractor.siteflow.app/*"], "optional_host_permissions": ["https://*.siteflow.app/*"], "background": {"scripts": ["bridge-config-client.js", "background.js"]}, "content_scripts": [{"matches": ["https://lab.siteflow.app/*", "https://track.siteflow.app/*", "https://edf-connector.siteflow.app/*", "https://doc-explorer.siteflow.app/*", "https://data-extractor.siteflow.app/*"], "js": ["content-lab.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Siteflow Connect \u2014 Applications", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "options_page": "options.html", "storage": {"managed_schema": "managed_schema.json"}, "browser_specific_settings": {"gecko": {"id": "siteflow-connect@siteflow.app", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}}}