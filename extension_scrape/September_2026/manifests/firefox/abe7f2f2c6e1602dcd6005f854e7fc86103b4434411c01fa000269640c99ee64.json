{"manifest_version": 3, "name": "WhatsApp Web Privacy Mode", "short_name": "WA Privacy Mode", "description": "Blur WhatsApp Web & Telegram Web messages, previews, names, avatars and media until you hover. Toggle with Alt+X.", "version": "1.7.2", "author": "Guntur Saputro", "default_locale": "en", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "WhatsApp Web Privacy Mode", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "permissions": ["storage"], "host_permissions": ["https://web.whatsapp.com/*", "https://web.telegram.org/*"], "background": {"scripts": ["common.js", "background.js"]}, "content_scripts": [{"matches": ["https://web.whatsapp.com/*", "https://web.telegram.org/*"], "js": ["common.js", "content/content.js"], "css": ["content/blur.css"], "run_at": "document_start"}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "wa-web-privacy-mode@guntur.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}