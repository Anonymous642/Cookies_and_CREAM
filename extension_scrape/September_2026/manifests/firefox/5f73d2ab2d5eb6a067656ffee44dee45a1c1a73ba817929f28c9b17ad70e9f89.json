{"manifest_version": 3, "name": "Bladead Lead Capture", "short_name": "Bladead", "version": "0.1.2", "description": "Capture emails from the page and save them to Bladead Contacts.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Bladead", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["lib/storage.js", "lib/api.js", "lib/emails.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "lead-capture@bladead.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personallyIdentifyingInfo", "browsingActivity", "websiteContent"], "optional": ["technicalAndInteraction"]}}}, "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["https://api.bladead.com/*", "https://*.bladead.com/*", "http://*/*", "https://*/*"], "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["lib/emails.js", "content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["icons/*"], "matches": ["http://*/*", "https://*/*"]}]}