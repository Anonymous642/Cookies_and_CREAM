{"manifest_version": 2, "name": "Boil It Down", "version": "1.0.1", "description": "Extract recipes from any website into a clean, ad-free view. Save, translate, and organize your favorite recipes.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["activeTab", "tabs", "storage", "<all_urls>", "https://api.mymemory.translated.net/*", "https://libretranslate.de/*"], "background": {"scripts": ["shims/chrome-promise-shim.js", "background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["shims/chrome-promise-shim.js", "utils/translations.js", "utils/i18n.js", "utils/translator.js", "content/detector.js", "content/extractor.js", "content/renderer.js", "content/recipe-cache.js", "content/runtime-bridge.js"], "css": ["styles/decluttered.css"], "run_at": "document_idle"}], "browser_action": {"default_popup": "popup/popup.html", "default_title": "Boil It Down", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "options_page": "popup/settings.html", "web_accessible_resources": ["styles/decluttered.css", "styles/decluttered-dark.css"], "browser_specific_settings": {"gecko": {"id": "boil-it-down@firefox", "strict_min_version": "126.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}