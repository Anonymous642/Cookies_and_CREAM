{"manifest_version": 2, "name": "Psychology Today Price Sort", "version": "0.2.2", "description": "Adds client-side price sorting controls to Psychology Today search results.", "icons": {"48": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "psychology-today-price-sort@diffrint.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["activeTab", "tabs", "contextMenus", "*://psychologytoday.com/*", "*://*.psychologytoday.com/*"], "browser_action": {"default_title": "Psychology Today Price Sort", "default_icon": {"48": "icon.png"}}, "background": {"scripts": ["background.js"]}, "commands": {"open-price-sort": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Open Psychology Today Price Sort in the current tab"}}}