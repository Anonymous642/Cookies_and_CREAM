{"manifest_version": 2, "name": "Manhware Dumper", "version": "1.0.1", "description": "Download and save manga/manhwa chapters", "author": "Kugijo", "browser_specific_settings": {"gecko": {"id": "nenosbacks@gmail.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": [], "description": "This extension does not collect any user data. It only downloads images from the current webpage to your local Downloads folder."}}}, "permissions": ["downloads", "activeTab", "tabs", "notifications", "storage", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start"}], "browser_action": {"default_title": "Manhware Dumper", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_popup": "popup.html"}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}