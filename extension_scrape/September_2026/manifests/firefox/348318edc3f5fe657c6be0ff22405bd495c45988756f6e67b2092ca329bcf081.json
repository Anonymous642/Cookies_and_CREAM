{"manifest_version": 3, "name": "FantasyForgeworks Tokens", "version": "0.1.2", "description": "Browse FantasyForgeworks tokens and drag your owned tokens onto web-based VTTs (Roll20, Foundry, Owlbear Rodeo).", "browser_specific_settings": {"gecko": {"id": "extension@fantasyforgeworks.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteActivity"]}}}, "icons": {"48": "assets/icon-48.png", "128": "assets/icon-128.png"}, "action": {"default_title": "FantasyForgeworks Tokens", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_title": "FantasyForgeworks Tokens", "default_panel": "panel.html", "default_icon": {"16": "assets/icon-16.png", "32": "assets/icon-32.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["storage", "activeTab", "scripting", "tabs"], "host_permissions": ["https://fantasyforgeworks.com/*", "https://*.fantasyforgeworks.com/*", "https://*.r2.cloudflarestorage.com/*"], "optional_host_permissions": ["*://*/*"], "content_scripts": [{"matches": ["https://app.roll20.net/editor*"], "js": ["content-roll20.js"], "run_at": "document_idle"}, {"matches": ["https://*.owlbear.rodeo/*", "https://owlbear.rodeo/*"], "js": ["content-owlbear.js"], "run_at": "document_idle"}, {"matches": ["https://*.forge-vtt.com/*", "https://*.forgevtt.com/*"], "js": ["content-foundry.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["assets/*"], "matches": ["<all_urls>"]}]}