{"manifest_version": 2, "name": "QuantumAuth Bridge", "short_name": "QuantumAuth", "description": "Connects web apps to the local QuantumAuth client.", "version": "0.2.0", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "activeTab", "alarms", "<all_urls>"], "background": {"scripts": ["dist/background.global.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["dist/content.global.js"], "run_at": "document_start"}], "browser_action": {"default_title": "QuantumAuth", "default_popup": "dist/ui/popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "browser_specific_settings": {"gecko": {"id": "hello@quantumauth.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}