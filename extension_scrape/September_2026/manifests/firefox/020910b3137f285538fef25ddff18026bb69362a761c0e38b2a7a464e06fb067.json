{"manifest_version": 3, "name": "Spilpause \u2014 Gambling Filter", "version": "1.0.0", "description": "Blokerer alle gambling-sider og redirecter til en motiverende blokeringsside. Til skoler, institutioner og ludomaner.", "browser_specific_settings": {"gecko": {"id": "gambling-filter@spilpause.dk", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["webNavigation", "storage", "alarms", "tabs"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["browser-polyfill.min.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}