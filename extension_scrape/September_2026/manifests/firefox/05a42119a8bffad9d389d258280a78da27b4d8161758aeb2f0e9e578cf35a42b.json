{"manifest_version": 2, "name": "Focus Time - Productivity Blocker", "version": "2.0.0", "description": "Block online distractions during focus sessions. Track your productivity with detailed statistics.", "author": "Focus Time Team", "permissions": ["webRequest", "webRequestBlocking", "<all_urls>", "storage", "tabs", "notifications", "idle"], "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "Focus Time"}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "incognito": "spanning", "browser_specific_settings": {"gecko": {"id": "focus-time-blocker@extension.dev", "strict_min_version": "60.0", "data_collection_permissions": {"required": ["none"]}}}}