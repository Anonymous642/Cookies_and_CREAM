{"manifest_version": 3, "name": "SubPulse", "version": "0.9.10.6", "description": "A customizable, background-syncing feed of recent videos from your YouTube subscriptions.", "permissions": ["storage", "alarms", "tabs", "identity"], "host_permissions": ["https://www.youtube.com/*", "https://www.googleapis.com/*", "https://oauth2.googleapis.com/*", "https://oauth.subpulse.myreadygo.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "SubPulse", "default_popup": "popup/popup.html", "default_icon": {"16": "icons/subpulse-16.png", "32": "icons/subpulse-32.png", "48": "icons/subpulse-48.png", "96": "icons/subpulse-96.png"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"16": "icons/subpulse-16.png", "32": "icons/subpulse-32.png", "48": "icons/subpulse-48.png", "96": "icons/subpulse-96.png", "128": "icons/subpulse-128.png"}, "browser_specific_settings": {"gecko": {"id": "subpulse@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent", "websiteActivity"]}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com"}, "homepage_url": "https://subpulse.myreadygo.com/"}