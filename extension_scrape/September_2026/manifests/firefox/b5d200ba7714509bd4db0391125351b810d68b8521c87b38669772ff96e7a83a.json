{"manifest_version": 3, "name": "ChatGPT Navigation Enhancer", "description": "Adds conversation navigation and one-click Markdown copying to ChatGPT.", "version": "1.2.3", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["markdown-converter.js", "content-script.js"], "run_at": "document_idle"}], "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "chatgpt-navigation-enhancer@example.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"]}