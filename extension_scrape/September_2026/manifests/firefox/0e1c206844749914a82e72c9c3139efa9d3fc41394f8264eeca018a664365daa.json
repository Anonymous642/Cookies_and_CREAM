{"manifest_version": 3, "name": "YouTube Subtitle Reset", "version": "1.0", "description": "Reset YouTube subtitle styles to default and adjust size via a slider.", "permissions": ["activeTab", "scripting"], "host_permissions": ["*://*.youtube.com/*", "*://youtu.be/*"], "browser_specific_settings": {"gecko": {"id": "yt-subtitle-reset@jouwdomein.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icon.svg"}, "action": {"default_title": "Subtitle Settings", "default_icon": "icon.svg", "default_popup": "popup.html"}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Alt+S", "mac": "Command+Alt+S"}, "description": "Open subtitle menu"}}}