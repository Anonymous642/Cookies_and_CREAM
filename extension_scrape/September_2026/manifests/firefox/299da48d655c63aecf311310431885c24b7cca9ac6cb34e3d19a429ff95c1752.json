{"manifest_version": 3, "name": "lived \u2014 Productivity Dashboard", "short_name": "lived", "version": "1.0.0", "description": "Opens your lived productivity dashboard on every new tab to track goals, habits, and daily tasks.", "chrome_url_overrides": {"newtab": "newtab.html"}, "permissions": ["storage"], "host_permissions": ["https://lived.best/*", "*://localhost/*", "*://127.0.0.1/*", "*://*.test/*", "*://*.local/*"], "action": {"default_popup": "popup.html", "default_title": "lived Dashboard Settings", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "lived-extension@lived.app", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}