{"manifest_version": 3, "name": "Fast Search Box", "version": "2.0.0", "author": "Fatih Kapa\u011fan", "description": "Se\u00e7ili metin \u00fczerinde h\u0131zl\u0131 arama ve d\u00fczenleme ara\u00e7lar\u0131 sunar.", "browser_specific_settings": {"gecko": {"id": "fast-search-box@fatihkapagan.com", "strict_min_version": "142.0", "data_collection_permissions": {"interaction_data": false, "technical_data": true, "required": ["none"]}}}, "permissions": ["activeTab", "scripting", "clipboardWrite", "tabs"], "host_permissions": ["*://*/*"], "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "content_scripts": [{"matches": ["*://*/*"], "js": ["content.js"], "run_at": "document_end"}], "web_accessible_resources": [{"resources": ["button_icons/*.png"], "matches": ["*://*/*"]}]}