{"manifest_version": 3, "name": "YTVS", "version": "0.0.4", "description": "YTVS is a browser extension that saves and share videos watched on YouTube", "permissions": ["storage", "tabs"], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "host_permissions": ["*://*.youtube.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": "icons/icon-48.png"}, "browser_specific_settings": {"gecko": {"id": "sudoer.zero@gmail.com"}}}