{"manifest_version": 3, "name": "SubSorter", "version": "0.2.2", "description": "Sorts your YouTube subscriptions into categories, with a free AI in your browser that suggests categories and searches by meaning.", "browser_specific_settings": {"gecko": {"id": "yt-auto-organizer@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "permissions": ["storage", "tabs", "declarativeNetRequestWithHostAccess"], "optional_host_permissions": ["https://www.youtube.com/*", "https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*", "https://api.openai.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["browser-polyfill.js", "content.js"], "run_at": "document_end"}], "action": {"default_title": "SubSorter (click to open your sorted feed)", "default_icon": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}}