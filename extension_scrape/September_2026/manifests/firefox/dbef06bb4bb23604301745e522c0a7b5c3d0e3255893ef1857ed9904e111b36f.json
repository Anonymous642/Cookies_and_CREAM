{"manifest_version": 3, "name": "BTGuard Browser Protection", "version": "0.3.1", "description": "Route this browser's traffic through BTGuard encrypted proxy servers. Protects the browser only \u2014 not a full-device VPN.", "browser_specific_settings": {"gecko": {"id": "browser-protection@btguard.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personalCommunications"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["proxy", "privacy", "storage", "alarms", "webRequest", "webRequestBlocking"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "BTGuard", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}