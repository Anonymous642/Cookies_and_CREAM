{"manifest_version": 3, "name": "Slop Squash", "description": "Slop Squash flags posts, pictures and comments that look AI-made while you scroll. Tap the squash to see what raised the flag.", "version": "0.2.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["https://api.slopsquash.com/*"], "action": {"default_icon": {"16": "icon/16.png", "32": "icon/32.png"}, "default_title": "Slop Squash", "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "extension@slopsquash.com", "strict_min_version": "115.0"}, "gecko_android": {"strict_min_version": "120.0"}}, "background": {"scripts": ["background.js"]}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "content_scripts": [{"matches": ["http://127.0.0.1:3000/*", "https://slopsquash.com/*", "https://www.slopsquash.com/*"], "all_frames": false, "run_at": "document_idle", "js": ["content-scripts/connect.js"]}, {"matches": ["<all_urls>"], "all_frames": true, "match_about_blank": true, "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}