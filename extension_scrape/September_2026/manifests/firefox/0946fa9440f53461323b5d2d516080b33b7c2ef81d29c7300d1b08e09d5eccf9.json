{"manifest_version": 2, "name": "Toernooi Matrix View", "version": "1.0", "description": "Shows tournament draws as a readable player-vs-player matrix on toernooi.nl", "browser_specific_settings": {"gecko": {"id": "toernooi-matrix@meuwissen.nl", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "content_scripts": [{"matches": ["*://mijnknltb.toernooi.nl/tournament/*/Draw/*", "*://mijnknltb.toernooi.nl/tournament/*/draw/*", "*://www.toernooi.nl/tournament/*/Draw/*", "*://www.toernooi.nl/tournament/*/draw/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_idle"}], "icons": {"48": "icon.png"}}