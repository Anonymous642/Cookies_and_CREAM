{"manifest_version": 3, "name": "Achadinho PRO", "version": "1.2608.7.1900", "description": "Ferramenta avan\u00e7ada para afiliados do Mercado Livre, Amazon e Shopee. Extraia produtos, gere links de afiliado e automatize buscas em lote.", "permissions": ["tabs", "activeTab", "scripting", "storage", "notifications", "cookies", "alarms"], "host_permissions": ["https://*.mercadolivre.com.br/*", "https://*.mercadolibre.com/*", "https://*.amazon.com.br/*", "https://*.shopee.com.br/*", "https://*.achadinhopro.com.br/*", "https://*.achadinho.pro/*", "https://*.worf.replit.dev/*"], "background": {"scripts": ["background/service-worker.js"]}, "content_scripts": [{"matches": ["https://*.mercadolivre.com.br/*", "https://*.mercadolibre.com/*"], "js": ["content/scrapers/ml-price-utils.js", "content/scrapers/ml-pdp-scraper.js", "content/scrapers/ml-scraper.js"], "run_at": "document_idle"}, {"matches": ["https://*.shopee.com.br/*"], "js": ["content/scrapers/shopee-scraper.js"], "run_at": "document_idle"}, {"matches": ["https://*.amazon.com.br/*"], "js": ["content/scrapers/amazon-price-utils.js", "content/scrapers/amazon-image-utils.js", "content/scrapers/amazon-scraper.js"], "run_at": "document_idle"}, {"matches": ["https://*.achadinhopro.com.br/*", "https://*.achadinho.pro/*", "https://*.worf.replit.dev/*"], "js": ["content/version-injector.js", "content/coupons-bridge.js"], "run_at": "document_idle"}], "action": {"default_title": "Achadinho PRO"}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "sidebar_action": {"default_panel": "ui/sidepanel.html", "default_title": "Achadinho PRO", "default_icon": {"48": "icons/icon48.png"}}, "browser_specific_settings": {"gecko": {"id": "achadinho-pro@achadinhopro.com.br", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["websiteContent", "personallyIdentifyingInfo"]}}}}