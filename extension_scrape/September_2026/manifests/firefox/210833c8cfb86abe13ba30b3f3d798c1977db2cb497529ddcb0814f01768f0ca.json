{"manifest_version": 3, "name": "FCL Weather", "version": "1.0.0", "description": "Fills CMiC weather fields using weather data from Open-Meteo.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png"}, "permissions": ["storage", "activeTab", "scripting"], "host_permissions": ["https://archive-api.open-meteo.com/*", "https://geocoding-api.open-meteo.com/*"], "action": {"default_title": "FCL Weather", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "browser_specific_settings": {"gecko": {"id": "fcl-weather@fertig.us", "data_collection_permissions": {"required": ["locationInfo"]}}}}