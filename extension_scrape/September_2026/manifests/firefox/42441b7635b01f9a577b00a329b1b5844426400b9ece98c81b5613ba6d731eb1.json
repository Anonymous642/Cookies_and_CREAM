{"manifest_version": 3, "name": "TProfile Tools", "version": "1.0.2", "description": "This extension used along side your TProfile instance gives you access to tools to help various aspects of your workflow.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["<all_urls>"], "action": {"default_popup": "popup.html", "default_title": "TProfile Tools"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "admin@tprofile.co.uk", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"]}}}}