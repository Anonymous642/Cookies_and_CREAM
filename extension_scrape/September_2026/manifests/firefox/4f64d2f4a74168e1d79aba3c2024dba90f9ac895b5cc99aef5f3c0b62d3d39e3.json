{"manifest_version": 3, "name": "Shortsight", "version": "1.0.0", "description": "Track, limit, and reclaim your time from YouTube Shorts. Made by Netichz.", "permissions": ["storage", "tabs", "alarms"], "host_permissions": ["https://www.youtube.com/*", "https://firestore.googleapis.com/*", "https://firebase.googleapis.com/*", "https://ipapi.co/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "shortsight@netichz.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "locationInfo", "browsingActivity"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Shortsight", "default_icon": {"16": "icons/shortsight.png", "32": "icons/shortsight.png", "48": "icons/shortsight.png", "128": "icons/shortsight.png"}}, "icons": {"16": "icons/shortsight.png", "32": "icons/shortsight.png", "48": "icons/shortsight.png", "128": "icons/shortsight.png"}}