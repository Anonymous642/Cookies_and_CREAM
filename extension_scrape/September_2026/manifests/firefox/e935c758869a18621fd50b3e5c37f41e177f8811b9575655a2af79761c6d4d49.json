{"manifest_version": 3, "name": "Onplana Tasks", "version": "1.4.1", "description": "Your Onplana tasks in one click: see what's due, quick-add, check things off, and turn any page into a task.", "action": {"default_title": "Onplana Tasks", "default_popup": "popup.html"}, "background": {"scripts": ["assets/service-worker.js"], "type": "module"}, "permissions": ["identity", "storage", "contextMenus", "alarms", "notifications", "activeTab", "scripting", "clipboardWrite"], "host_permissions": ["https://api.onplana.com/*", "https://mcp.onplana.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "tasks@onplana.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"], "optional": ["technicalAndInteraction"]}}}}