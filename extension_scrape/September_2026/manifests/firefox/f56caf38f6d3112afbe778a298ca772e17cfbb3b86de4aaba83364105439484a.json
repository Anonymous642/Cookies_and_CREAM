{"manifest_version": 2, "name": "Search Redirector", "version": "1.0.0", "description": "Redirects address bar searches to Perplexity, ChatGPT, or Claude.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "applications": {"gecko": {"id": "search-redirector@jlaswell.github.com", "strict_min_version": "109.0"}}, "permissions": ["storage", "tabs", "webRequest", "webRequestBlocking", "*://www.google.com/*", "*://duckduckgo.com/*", "*://www.bing.com/*", "*://search.yahoo.com/*", "*://www.startpage.com/*", "*://www.perplexity.ai/*", "*://chatgpt.com/*", "*://chat.openai.com/*", "*://claude.ai/*"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "browser_action": {"default_title": "Search Redirector", "default_popup": "options.html"}, "content_scripts": [{"matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"], "js": ["content-chatgpt.js"], "run_at": "document_idle"}, {"matches": ["https://claude.ai/*"], "js": ["content-claude.js"], "run_at": "document_idle"}]}