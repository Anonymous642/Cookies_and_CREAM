{"manifest_version": 3, "name": "Grokipedia Redirector", "version": "1.1", "description": "Redirects Wikipedia pages to Grokipedia, with an option to bypass.", "permissions": ["webNavigation", "storage", "tabs"], "host_permissions": ["https://*.wikipedia.org/wiki/*", "https://grokipedia.com/page/*"], "background": {"scripts": ["browser-polyfill.min.js", "background.js"]}, "icons": {"48": "icon48.png", "128": "icon128.png"}, "action": {"default_popup": "options.html"}, "content_scripts": [{"matches": ["*://grokipedia.com/page/*"], "js": ["browser-polyfill.min.js", "content.js"], "css": ["banner.css"]}, {"matches": ["*://*.wikipedia.org/wiki/*"], "js": ["browser-polyfill.min.js", "wikipedia-content.js"], "css": ["wikipedia-banner.css"]}], "web_accessible_resources": [{"resources": ["icon_close.png"], "matches": ["*://*.wikipedia.org/*"]}], "browser_specific_settings": {"gecko": {"id": "grokipedia-redirector@your-domain.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}