{"manifest_version": 3, "name": "AdPrune", "description": "Removes YouTube pre-roll, mid-roll and post-roll video ads plus on-page ad units.", "version": "1.0.0", "short_name": "AdPrune", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["storage", "declarativeNetRequest"], "host_permissions": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*", "*://*.googlevideo.com/*"], "web_accessible_resources": [{"resources": ["main-world-fallback.js"], "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"]}], "declarative_net_request": {"rule_resources": [{"id": "ad-networks", "enabled": true, "path": "rules/ad-network-rules.json"}]}, "browser_specific_settings": {"gecko": {"id": "adprune@local", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "AdPrune", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube-nocookie.com/*", "*://*.youtube.com/*"], "all_frames": true, "run_at": "document_start", "js": ["content-scripts/youtube-main.js"], "world": "MAIN"}, {"matches": ["*://*.youtube-nocookie.com/*", "*://*.youtube.com/*"], "run_at": "document_start", "js": ["content-scripts/youtube.js"]}]}