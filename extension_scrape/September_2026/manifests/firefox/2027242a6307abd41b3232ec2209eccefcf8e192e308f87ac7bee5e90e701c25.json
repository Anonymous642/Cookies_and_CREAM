{"manifest_version": 2, "name": "SeshTab", "description": "Save tab groups, sync across devices, sleep tabs for later. The lightweight tab manager for power users.", "version": "1.0.2", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "permissions": ["tabs", "storage", "alarms", "windows", "sessions", "https://*.supabase.co/*", "https://www.getseshtab.com/*", "https://getseshtab.com/*"], "externally_connectable": {"matches": ["https://www.getseshtab.com/*", "https://getseshtab.com/*"]}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+K", "mac": "Command+Shift+K"}, "description": "Open SeshTab"}}, "browser_specific_settings": {"gecko": {"data_collection_permissions": {"required": ["none"], "optional": ["technicalAndInteraction"]}, "id": "{61204fdd-bede-42c8-a42d-e17cbe2a1f4f}"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "SeshTab \u2014 Tab Manager", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.google.com/*"], "js": ["content-scripts/content.js"]}]}