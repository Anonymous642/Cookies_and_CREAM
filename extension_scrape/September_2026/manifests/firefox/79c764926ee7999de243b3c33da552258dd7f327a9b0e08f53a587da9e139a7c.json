{"manifest_version": 3, "name": "Vimium New Tab Page", "version": "1.0", "description": "Show a new tab page that Vimium can control", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_page": "options.html", "chrome_url_overrides": {"newtab": "redirect.html"}, "permissions": ["tabs", "storage"], "browser_specific_settings": {"gecko": {"id": "@vimium-new-tab", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["none"]}}}}