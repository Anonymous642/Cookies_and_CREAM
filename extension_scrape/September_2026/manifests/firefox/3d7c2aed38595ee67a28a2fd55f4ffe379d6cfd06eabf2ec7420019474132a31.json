{"manifest_version": 3, "name": "Custom Speed Controller for YouTube", "version": "1.8", "description": "Privacy-first playback speed controller for YouTube. Fine-tune video speed from 0.1x to 4x with custom hotkeys and instant presets.", "permissions": ["storage", "tabs"], "host_permissions": ["*://*.youtube.com/*"], "action": {"default_popup": "popup.html", "default_title": "Speed Settings", "default_icon": "logo.svg"}, "icons": {"16": "logo.svg", "48": "logo.svg", "128": "logo.svg"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "browser_specific_settings": {"gecko": {"id": "customspeedyt@privacy.addon", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}