{"manifest_version": 3, "name": "Bookmark Maze", "version": "1.0.0", "description": "Generate a tiny maze from your bookmarks' titles. Play inside popup; adding bookmarks creates new levels.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage", "bookmarks", "activeTab"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png"}}, "web_accessible_resources": [{"resources": ["assets/*", "icons/*"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "@bookmarkmaze-example", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}