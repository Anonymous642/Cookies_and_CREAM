{"manifest_version": 3, "name": "Jobless poe trade helper", "version": "0.1.3", "description": "Save PoE trade searches with readable filter summaries, folders, and local history. A compact helper that stays closed until you need it.", "permissions": ["storage"], "background": {"scripts": ["core.js", "background.js"]}, "action": {"default_title": "Jobless poe trade helper", "default_icon": {"32": "icons/icon32.png", "64": "icons/icon64.png"}}, "icons": {"32": "icons/icon32.png", "64": "icons/icon64.png", "128": "icons/icon128.png"}, "commands": {"toggle-helper": {"suggested_key": {"default": "Alt+Shift+J"}, "description": "Open or close Jobless poe trade helper"}}, "content_scripts": [{"matches": ["https://www.pathofexile.com/trade/*", "https://www.pathofexile.com/trade2/*", "https://pathofexile.com/trade/*", "https://pathofexile.com/trade2/*"], "js": ["core.js", "capture.js", "panel.js", "content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["panel.css"], "matches": ["https://www.pathofexile.com/*", "https://pathofexile.com/*"]}], "browser_specific_settings": {"gecko": {"id": "jobless-poe-trade-helper@jobless.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}