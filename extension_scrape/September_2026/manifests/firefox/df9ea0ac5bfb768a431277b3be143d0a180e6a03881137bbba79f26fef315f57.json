{"manifest_version": 3, "name": "DeObfus Email", "description": "Convert obfuscated/masked emails to real addresses via right-click and copy. For example, you can copy test[dot]email[at]myemailserver[dot]com as test.email@myemailserver.com.", "version": "0.0.1", "browser_specific_settings": {"gecko": {"id": "deobfus-email@extension.com", "strict_min_version": "115.0"}}, "permissions": ["contextMenus", "clipboardWrite", "storage"], "host_permissions": ["<all_urls>"], "icons": {"32": "icons/32.png", "48": "icons/48.png", "64": "icons/64.png", "96": "icons/96.png"}, "content_scripts": [{"matches": ["*://*/*"], "js": ["src/app.js"]}], "background": {"scripts": ["src/service_worker.mjs"], "type": "module"}}