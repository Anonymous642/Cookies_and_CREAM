{"manifest_version": 3, "name": "YouTube Playlist Autosort", "version": "1.0.0", "description": "Adds a button to YouTube playlist pages that sorts the playlist by channel, date added, duration, title, or upload date.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "youtube-playlist-autosort@local.extension", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage"], "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["content_script.js"], "css": ["content_script.css"], "run_at": "document_idle"}]}