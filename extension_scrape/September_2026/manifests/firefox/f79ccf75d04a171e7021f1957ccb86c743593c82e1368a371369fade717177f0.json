{"manifest_version": 2, "name": "X Reply Filter", "version": "0.1.0", "description": "Hide replies on X/Twitter by custom blacklist keywords.", "permissions": ["storage", "https://x.com/*", "https://twitter.com/*"], "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "options_ui": {"page": "options.html", "browser_style": false}, "browser_action": {"default_title": "X Reply Filter", "default_popup": "options.html"}, "browser_specific_settings": {"gecko": {"id": "x-reply-filter@example.local", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "113.0"}}}