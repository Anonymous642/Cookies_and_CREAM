{"manifest_version": 2, "name": "Apple Music Redirector", "author": "BADGumby", "version": "1.2", "browser_specific_settings": {"gecko": {"id": "apple-music-redirector@badgumby.com", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "*://music.apple.com/*"], "icons": {"32": "icon_32.png", "64": "icon_64.png", "128": "icon_128.png", "256": "icon_256.png", "512": "icon_512.png"}, "content_scripts": [{"matches": ["*://music.apple.com/*"], "js": ["content.js"], "run_at": "document_end"}]}