{"manifest_version": 3, "name": "Onscreen \u2014 AI Page Context Explainer", "version": "1.0.0", "description": "Highlight text on any web page, right-click, and get instant inline AI explanations using surrounding page context.", "permissions": ["contextMenus", "storage", "scripting", "activeTab"], "host_permissions": ["<all_urls>"], "background": {"service_worker": "background.js", "scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_title": "Onscreen"}, "commands": {"trigger-onscreen": {"suggested_key": {"default": "Alt+Shift+A", "mac": "Alt+Shift+A"}, "description": "Instantly query highlighted text with Onscreen"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "onscreen-ai@onscreen.app", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}