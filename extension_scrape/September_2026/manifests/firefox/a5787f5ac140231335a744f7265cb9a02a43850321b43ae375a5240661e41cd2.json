{"manifest_version": 2, "name": "YouTube Mono to Stereo", "version": "1.0.0", "description": "Automatically detect and convert mono audio to stereo on YouTube videos", "author": "MightyX3N", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["storage", "activeTab", "*://*.youtube.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "background": {"scripts": ["background.js"]}, "browser_action": {"default_icon": {"48": "icons/icon-48.png"}, "default_title": "YouTube Mono to Stereo", "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html", "browser_style": true}, "browser_specific_settings": {"gecko": {"id": "youtube-mono-stereo@mightyx3n.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}