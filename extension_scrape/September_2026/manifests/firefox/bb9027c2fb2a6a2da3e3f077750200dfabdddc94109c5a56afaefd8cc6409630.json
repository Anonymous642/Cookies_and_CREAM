{"manifest_version": 2, "name": "Agtweb", "version": "0.7.0", "description": "Let local software agents inspect and automate web pages in your browser.", "permissions": ["tabs", "nativeMessaging", "webNavigation", "downloads", "<all_urls>"], "background": {"scripts": ["firefox-product-bundle.js", "background.js"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "exclude_matches": ["https://challenges.cloudflare.com/*", "https://*.hcaptcha.com/*", "https://www.google.com/recaptcha/*", "https://www.recaptcha.net/*", "https://*.mastercard.com/*", "https://*.paypal.com/*", "https://*.stripe.com/*"], "js": ["content-authorization.js", "content-deadline.js", "content-boundary.js", "content.js"], "run_at": "document_idle", "all_frames": true}], "browser_specific_settings": {"gecko": {"id": "@agtweb.emee.ai", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "searchTerms", "websiteActivity", "websiteContent"]}}}, "browser_action": {"default_title": "Agtweb \u2014 local agent browser automation", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}}