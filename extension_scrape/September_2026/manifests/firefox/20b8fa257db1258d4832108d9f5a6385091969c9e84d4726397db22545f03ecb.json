{"manifest_version": 3, "name": "XSpeeds Torrent Hider", "version": "1.2.2", "description": "Hide/filter torrents on xspeeds.eu and hide similar episodes easily.", "permissions": ["storage"], "host_permissions": ["*://xspeeds.eu/*", "*://*.xspeeds.eu/*"], "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["*://xspeeds.eu/browse.php*", "*://*.xspeeds.eu/browse.php*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "web_accessible_resources": [{"resources": ["icons/delete-ban.svg", "icons/delete-red.svg", "icons/delete-blue.svg", "icons/delete-line.svg"], "matches": ["*://*.xspeeds.eu/*"]}], "browser_specific_settings": {"gecko": {"id": "xspeeds-torrent-hider-jmc@addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}