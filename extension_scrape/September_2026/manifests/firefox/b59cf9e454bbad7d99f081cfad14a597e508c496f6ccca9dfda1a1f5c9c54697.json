{"manifest_version": 2, "name": "Time Waster Pro", "version": "1.0.2", "description": "Discover interesting independent websites - a spiritual successor to StumbleUpon", "permissions": ["storage", "tabs", "notifications", "alarms", "https://timewasterpro.xyz/*"], "icons": {"32": "icons8-hourglass-32.png", "64": "icons8-hourglass-64.png"}, "browser_action": {"default_title": "Time Waster Pro", "default_popup": "popup.html", "default_icon": {"32": "icons8-hourglass-32.png", "64": "icons8-hourglass-64.png"}, "theme_icons": [{"dark": "icons8-hourglass-32.png", "light": "icons8-hourglass-32-dark.png", "size": 32}, {"dark": "icons8-hourglass-64.png", "light": "icons8-hourglass-64-dark.png", "size": 64}]}, "commands": {"stumble": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Stumble to a random website"}, "thumbs-up": {"suggested_key": {"default": "Alt+Shift+U"}, "description": "Like current website"}, "thumbs-down": {"suggested_key": {"default": "Alt+Shift+D"}, "description": "Dislike current website"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "admin@timewasterpro.xyz", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}}}