{"manifest_version": 3, "name": "Read Time Helper", "version": "1.0.0", "description": "Show estimated reading time and word count for the current page. Optional per-site auto display.", "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"], "action": {"default_title": "Read Time Helper", "default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png"}}, "browser_specific_settings": {"gecko": {"id": "read-time-helper@yourdomain.example", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}