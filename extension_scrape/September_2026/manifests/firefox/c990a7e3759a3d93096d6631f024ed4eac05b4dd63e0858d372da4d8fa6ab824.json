{"manifest_version": 2, "name": "NewsParse", "version": "1.1", "description": "Get News Intelligence in a Sidebar. languages: English, Arabic, Persian, Russian, Chinese, Turkish.", "browser_specific_settings": {"gecko": {"id": "newsparse@newsparse.com", "strict_min_version": "91.0"}}, "permissions": ["activeTab", "<all_urls>"], "icons": {"16": "16.png", "48": "48.png", "128": "128.png"}, "browser_action": {"default_icon": {"16": "16.png", "48": "48.png", "128": "128.png"}, "default_title": "Open Sidebar"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "css": ["styles.css"]}], "content_security_policy": "script-src 'self'; object-src 'self'"}