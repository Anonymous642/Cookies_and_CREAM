{"manifest_version": 3, "name": "Shortimax Studio Extension", "version": "1.9", "description": "Cette extension affiche les derni\u00e8res vid\u00e9os de la cha\u00eene Shortimax Studio.", "default_locale": "fr", "icons": {"256": "newicon.png"}, "action": {"default_title": "Derni\u00e8res vid\u00e9os", "default_popup": "popup/popup.html"}, "permissions": ["alarms", "storage", "notifications"], "host_permissions": ["https://www.youtube.com/", "https://youtube.com/", "https://www.googleapis.com/"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "shortimax.youtube@temporaly-id.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}