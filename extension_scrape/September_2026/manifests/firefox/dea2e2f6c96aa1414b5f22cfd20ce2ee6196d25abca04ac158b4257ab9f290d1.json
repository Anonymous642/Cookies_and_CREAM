{"manifest_version": 3, "name": "EZLookup", "version": "1.1.1", "description": "Look up selected text on your favourite sites from the right-click menu.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "permissions": ["contextMenus", "storage"], "optional_host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_title": "EZLookup settings"}, "browser_specific_settings": {"gecko": {"id": "ezlookup@local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}