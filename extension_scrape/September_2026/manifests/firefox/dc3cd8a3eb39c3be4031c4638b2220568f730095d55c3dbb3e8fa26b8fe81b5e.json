{"manifest_version": 3, "name": "DealSnap", "description": "Auto-capture product details from 17+ Indian shopping sites and share deals on Desidime with one click. Save time, share more!", "version": "1.0.1", "icons": {"16": "assets/dealsnap-16.png", "32": "assets/dealsnap-32.png", "48": "assets/dealsnap-48.png", "128": "assets/dealsnap-128.png"}, "permissions": ["activeTab", "scripting", "tabs", "storage"], "host_permissions": ["https://*.flipkart.com/*", "https://*.shopsy.in/*", "https://*.swiggy.com/*", "https://*.blinkit.com/*", "https://*.zeptonow.com/*", "https://*.zepto.com/*", "https://*.amazon.in/*", "https://*.amazon.com/*", "https://*.myntra.com/*", "https://*.ajio.com/*", "https://*.croma.com/*", "https://*.nykaa.com/*", "https://*.nykaafashion.com/*", "https://*.tatacliq.com/*", "https://*.pepperfry.com/*", "https://*.firstcry.com/*", "https://*.jiomart.com/*", "https://*.bigbasket.com/*", "https://www.desidime.com/*"], "action": {"default_title": "DealSnap", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://*.flipkart.com/*", "https://*.shopsy.in/*", "https://*.swiggy.com/*", "https://*.blinkit.com/*", "https://*.zeptonow.com/*", "https://*.zepto.com/*", "https://*.amazon.in/*", "https://*.amazon.com/*", "https://*.myntra.com/*", "https://*.ajio.com/*", "https://*.croma.com/*", "https://*.nykaa.com/*", "https://*.nykaafashion.com/*", "https://*.tatacliq.com/*", "https://*.pepperfry.com/*", "https://*.firstcry.com/*", "https://*.jiomart.com/*", "https://*.bigbasket.com/*"], "js": ["lib/browser-polyfill.min.js", "content.js"], "run_at": "document_idle"}, {"matches": ["https://www.desidime.com/deals/new*"], "js": ["lib/browser-polyfill.min.js", "dd_fill.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "dealsnap@desidime.com", "strict_min_version": "112.0"}}, "background": {"scripts": ["lib/browser-polyfill.min.js", "background.js"], "type": "module"}}