{"manifest_version": 3, "name": "Locstars-Claude-RTL", "version": "1.0.0", "description": "Fixes right-to-left (RTL) text rendering on claude.ai for Arabic, Hebrew, Urdu & Persian. Auto-detects direction per paragraph.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://claude.ai/*"], "js": ["rtl-core.js", "content.js"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage"], "host_permissions": ["https://claude.ai/*"], "browser_specific_settings": {"gecko": {"id": "claude-rtl@locstars.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}