{"manifest_version": 3, "name": "Tumblr Ad Block", "version": "1.1", "author": "Ramona French", "description": "A lightweight ad blocker for the Tumblr dashboard.", "developer": {"name": "Ramona French", "url": "https://www.tumblr.com/"}, "icons": {"48": "icon48.png", "96": "icon96.png"}, "permissions": ["declarativeNetRequest"], "host_permissions": ["*://www.tumblr.com/*"], "declarative_net_request": {"rule_resources": [{"id": "ruleset_1", "enabled": true, "path": "rules.json"}]}, "content_scripts": [{"matches": ["*://www.tumblr.com/*"], "js": ["content.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "tumblr-ad-block@ramonafrench.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}