{"manifest_version": 3, "name": "BlinkBrowse", "version": "0.8.2", "description": "Extension for quick keyboard navigation on a page without a mouse.", "permissions": ["scripting", "activeTab"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "@blink-browse-extension", "data_collection_permissions": {"required": ["none"]}}}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "F4"}, "description": "Open BlinkBrowse overlay"}}, "icons": {"48": "icon-48.png"}}