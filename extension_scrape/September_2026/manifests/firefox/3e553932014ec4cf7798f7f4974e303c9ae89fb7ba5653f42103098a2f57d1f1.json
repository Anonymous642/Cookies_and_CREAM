{"manifest_version": 2, "name": "Snapx", "description": "Capture full-page screenshots of any web page", "version": "1.0.0", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["activeTab", "storage", "tabs", "<all_urls>"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Snapx", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/capture.js"]}], "browser_specific_settings": {"gecko": {"id": "snapx@fragment.net", "data_collection_permissions": {"required": ["none"], "optional": []}}}}