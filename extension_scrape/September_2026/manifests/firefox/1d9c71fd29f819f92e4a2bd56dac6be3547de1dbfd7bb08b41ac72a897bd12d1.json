{"manifest_version": 3, "name": "LeadHarvest AI", "version": "6.3.0", "description": "Intelligent lead extractor for Google Maps \u2014 queue-based batch scraping with advanced email extraction, side panel UI, email discovery, CMS fingerprinting, Google Ads detection, and local-first storage. No external accounts required.", "browser_specific_settings": {"gecko": {"id": "leadharvest-ai@extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["storage", "scripting", "tabs", "activeTab", "downloads", "alarms"], "host_permissions": ["https://www.google.com/maps/*", "https://maps.google.com/*", "http://*/*", "https://*/*"], "background": {"scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["https://www.google.com/maps/*", "https://maps.google.com/*"], "js": ["src/lib/storage.js", "src/content/maps-content.js"], "run_at": "document_idle"}], "action": {"default_title": "LeadHarvest AI", "default_popup": "src/sidepanel/sidepanel.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}, "options_page": "src/options/options.html", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}