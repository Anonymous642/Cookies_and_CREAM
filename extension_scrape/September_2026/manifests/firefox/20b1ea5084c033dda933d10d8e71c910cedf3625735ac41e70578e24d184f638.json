{"manifest_version": 3, "name": "Pamgoma Video Downloader", "short_name": "Pamgoma", "version": "1.1.0", "description": "Download videos from TikTok, Instagram, Twitter, Facebook and more \u2014 instantly with Pamgoma.", "browser_specific_settings": {"gecko": {"id": "extension@pamgoma.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["websiteContent"], "optional": ["technicalAndInteraction"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png"}, "default_title": "Download with Pamgoma"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.tiktok.com/*", "*://*.instagram.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.facebook.com/*", "*://*.pinterest.com/*", "*://www.dailymotion.com/*", "*://*.twitch.tv/*", "*://*.snapchat.com/*"], "js": ["page-inject.js"], "world": "MAIN", "run_at": "document_start"}, {"matches": ["*://*.tiktok.com/*", "*://*.instagram.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.facebook.com/*", "*://*.pinterest.com/*", "*://www.dailymotion.com/*", "*://*.twitch.tv/*", "*://*.snapchat.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "permissions": ["activeTab", "tabs", "scripting"], "host_permissions": ["*://*.tiktok.com/*", "*://*.instagram.com/*", "*://*.twitter.com/*", "*://*.x.com/*", "*://*.facebook.com/*", "*://*.pinterest.com/*", "*://www.dailymotion.com/*", "*://*.twitch.tv/*", "*://*.snapchat.com/*"]}