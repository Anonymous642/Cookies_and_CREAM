{"manifest_version": 3, "name": "Secretus \u2014 Share a Secret", "version": "1.0.9", "description": "Share a one-time encrypted secret from your browser. The URL-fragment key is not sent to Secretus secret endpoints.", "browser_specific_settings": {"gecko": {"id": "extension@secretus.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "personalCommunications"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "incognito": "not_allowed", "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Share a secret with Secretus"}}, "permissions": ["identity", "activeTab", "scripting", "contextMenus", "storage"], "host_permissions": ["https://api.eu.secretus.app/*", "https://secretus-eu-1765116481.auth.eu-central-1.amazoncognito.com/*", "https://cognito-idp.eu-central-1.amazonaws.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_popup": "popup/popup.html", "default_title": "Share a secret securely with Secretus"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}