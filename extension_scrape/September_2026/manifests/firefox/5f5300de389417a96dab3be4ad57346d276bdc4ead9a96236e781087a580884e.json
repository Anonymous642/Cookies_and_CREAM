{"manifest_version": 3, "name": "Draft Buddy for Sleeper", "version": "1.4.0", "description": "Rank players from live ADP, then get a draft overlay that crosses them off as they are drafted on either Sleeper board.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Draft Buddy for Sleeper", "default_popup": "src/popup/popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "background": {"type": "module", "scripts": ["src/background.js"]}, "permissions": ["storage"], "host_permissions": ["https://sleeper.com/*", "https://api.sleeper.app/*"], "content_scripts": [{"matches": ["https://sleeper.com/*"], "js": ["src/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["src/main.js", "src/lib/*.js", "src/panel/*.js", "src/panel/panel.css", "src/rankings/rankings.html"], "matches": ["https://sleeper.com/*"]}], "browser_specific_settings": {"gecko": {"id": "sleeper-draft-buddy@steelflexsolid.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}