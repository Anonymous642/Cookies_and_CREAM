{"manifest_version": 3, "name": "Stash It", "version": "1.0.0", "description": "Only your most recent tabs stay in the sidebar. Older tabs stash away in a collapsible list \u2014 click to bring them back.", "browser_specific_settings": {"gecko": {"id": "stash-it@manan.dev", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["tabs", "tabHide", "storage"], "background": {"scripts": ["background.js"]}, "sidebar_action": {"default_panel": "sidebar.html", "default_title": "Stash", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "open_at_install": false}, "commands": {"_execute_sidebar_action": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Open or close Stash sidebar"}, "stash-tab": {"suggested_key": {"default": "Alt+X"}, "description": "Stash the current tab"}, "increment-N": {"suggested_key": {"default": "Ctrl+Shift+Up"}, "description": "Increase number of tabs shown"}, "decrement-N": {"suggested_key": {"default": "Ctrl+Shift+Down"}, "description": "Decrease number of tabs shown"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "action": {"default_title": "Stash this tab", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}}