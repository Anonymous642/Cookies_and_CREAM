{"manifest_version": 3, "name": "Reddit Nav Sidebar Collapser", "version": "142.0.0.1", "description": "Collapse the left sidebar navigation categories by default on Reddit's new site redesign.", "permissions": ["webRequest", "webRequestBlocking"], "browser_specific_settings": {"gecko": {"id": "reddit-nav-sidebar-collapser@private.citizen", "strict_min_version": "109.0"}}, "icons": {"32": "icons/collapse.svg"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.reddit.com/*"], "js": ["pageload.js"], "run_at": "document_idle"}]}