{"manifest_version": 3, "name": "AdaptlyPost: AI Social Media Scheduler", "version": "1.0.0", "description": "Social media scheduler in your toolbar. Write once, publish or schedule to the accounts you connected, without leaving the page.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "AdaptlyPost social media scheduler"}, "background": {"scripts": ["background.js"], "type": "module"}, "permissions": ["storage", "contextMenus", "activeTab", "scripting", "alarms", "notifications"], "host_permissions": ["https://post.adaptlypost.com/*", "https://*.r2.cloudflarestorage.com/*"], "browser_specific_settings": {"gecko": {"id": "extension@adaptlypost.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"]}}}}