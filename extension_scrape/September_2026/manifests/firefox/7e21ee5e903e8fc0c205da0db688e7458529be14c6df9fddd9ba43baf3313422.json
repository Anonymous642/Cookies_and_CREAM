{"manifest_version": 3, "name": "Auto Decision Assistant", "version": "1.3", "description": "Provides intelligent decision support by detecting indecision patterns and recommending actions.", "permissions": ["tabs", "storage", "notifications", "activeTab", "scripting"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["decisionEngine.js", "background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["contentScript.js"]}], "action": {"default_popup": "popup.html", "default_title": "Auto Decision Assistant"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Auto-Decision-Assistant", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}