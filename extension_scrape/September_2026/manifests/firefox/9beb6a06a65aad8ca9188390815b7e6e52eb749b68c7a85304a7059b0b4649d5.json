{"manifest_version": 3, "name": "TikTok Sequential Scheduler", "version": "1.0.0", "description": "Apply one caption and consecutive scheduled dates to videos on TikTok Studio.", "permissions": ["storage", "activeTab"], "host_permissions": ["https://www.tiktok.com/*"], "action": {"default_title": "TikTok Sequential Scheduler", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["https://www.tiktok.com/tiktokstudio/upload*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "tiktok-sequential-scheduler@example.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}