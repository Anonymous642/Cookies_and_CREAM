{"manifest_version": 3, "name": "YouTube Skipper", "version": "7.0", "description": "Skips YouTube video intros without fail.", "browser_specific_settings": {"gecko": {"id": "iam@danya.net", "strict_min_version": "109.0"}}, "permissions": ["storage", "scripting"], "host_permissions": ["*://*.youtube.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/skipper-48.png"}}, "icons": {"48": "icons/skipper-48.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}]}