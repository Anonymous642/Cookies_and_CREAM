{"manifest_version": 3, "name": "KronoFeed", "version": "1.1.0", "description": "Automatically opens Facebook group pages in chronological order.", "permissions": ["webNavigation", "storage"], "host_permissions": ["https://facebook.com/groups/*", "https://*.facebook.com/groups/*"], "background": {"scripts": ["background.js"]}, "icons": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "action": {"default_title": "KronoFeed", "default_icon": {"16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "default_popup": "popup.html"}, "browser_specific_settings": {"gecko": {"id": "kronofeed@kronofeed.extension", "data_collection_permissions": {"required": ["none"]}}}}