{"manifest_version": 2, "name": "Fire Mouse Move", "version": "2.0", "description": "Simulates mouse movement on webpages with configurable interval.", "permissions": ["storage", "tabs", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "@fire-mouse-move", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "browser_action": {"default_popup": "popup/popup.html", "default_title": "Fire Mouse Move"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}}