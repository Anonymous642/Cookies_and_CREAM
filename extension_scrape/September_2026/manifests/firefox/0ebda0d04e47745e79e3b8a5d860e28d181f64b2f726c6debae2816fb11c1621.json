{"manifest_version": 2, "name": "URL Locker", "version": "1.1.0", "description": "Block access to sites of your choice to stay focused", "permissions": ["tabs", "storage", "webRequest", "webRequestBlocking", "<all_urls>"], "icons": {}, "browser_action": {"default_icon": "icons/icon.png", "default_popup": "popup.html", "default_title": "URL Locker \u2013 Manage your blocked sites"}, "background": {"scripts": ["background.js"], "persistent": true}, "web_accessible_resources": ["block/blocked.html", "dashboard/dashboard.html"], "browser_specific_settings": {"gecko": {"id": "url-locker@extensions.local", "data_collection_permissions": {"required": ["none"], "collects_data": false}}}}