{"manifest_version": 2, "name": "floref extension", "description": "Add images easily to any active floref canvas tab!", "version": "1.3.3", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "permissions": ["alarms", "contextMenus", "declarativeNetRequest", "storage", "tabs", "activeTab", "http://*/*", "https://*/*"], "web_accessible_resources": ["floref-logo.svg"], "browser_specific_settings": {"gecko": {"id": "extension@floref.com", "data_collection_permissions": {"required": ["websiteActivity", "websiteContent"]}}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "floref extension", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["http://127.0.0.1/*", "http://localhost/*", "https://127.0.0.1/*", "https://app.floref.com/*", "https://localhost/*", "https://staging.floref.com/*"], "js": ["content-scripts/content.js"]}, {"matches": ["http://*/*", "https://*/*"], "exclude_matches": ["http://127.0.0.1/*", "http://localhost/*", "https://127.0.0.1/*", "https://app.floref.com/*", "https://localhost/*", "https://staging.floref.com/*"], "css": ["content-scripts/image-overlay.css"], "js": ["content-scripts/image-overlay.js"]}]}