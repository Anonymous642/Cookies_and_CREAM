{"manifest_version": 2, "name": "PoxyProxy", "version": "1.0", "description": "A simple proxy toggler.", "browser_specific_settings": {"gecko": {"id": "Nashpoxyproxy@yourdomain.com", "strict_min_version": "91.1.0"}}, "permissions": ["proxy", "storage", "<all_urls>"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "default_title": "PoxyProxy (Off)"}, "options_ui": {"page": "options.html", "browser_style": true}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}