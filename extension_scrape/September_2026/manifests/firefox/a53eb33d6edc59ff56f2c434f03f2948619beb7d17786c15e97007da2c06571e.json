{"manifest_version": 3, "name": "BingeFlow Auto Skip", "description": "Automatically skip intros, recaps, and credits on major streaming platforms for an uninterrupted viewing experience.", "version": "1.0.0", "author": "Streamline Labs", "permissions": ["storage", "scripting"], "host_permissions": ["*://*.netflix.com/*", "*://*.youtube.com/*", "*://*.disneyplus.com/*", "*://*.primevideo.com/*", "*://*.hulu.com/*"], "action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "bingeflowautoskip@streamlinelabs.addons.mozilla.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}