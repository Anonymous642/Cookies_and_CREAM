{"manifest_version": 2, "name": "Password Revealer", "version": "1.0.0", "description": "Hover over any password field to reveal its content. Click the eye icon to toggle visibility.", "author": "Password Revealer", "browser_specific_settings": {"gecko": {"id": "password-revealer@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_end"}], "browser_action": {"default_icon": {"48": "icons/icon-48.png"}, "default_title": "Password Revealer", "default_popup": "popup.html"}, "permissions": ["storage", "activeTab"]}