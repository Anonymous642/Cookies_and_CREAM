{"manifest_version": 3, "name": "Attendo", "short_name": "Attendo 1337", "version": "1.0.0", "description": "Track your 1337 (42 Network) attendance, logtime, and weekly progress directly from your browser. Stay on top of your campus hours, meal status, and streak with a beautiful glass interface.", "author": "Yassine Ajagrou", "homepage_url": "https://github.com/iaceene/attendo-extension", "browser_specific_settings": {"gecko": {"id": "attendo@iaceene.github.io", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "tabs", "cookies"], "host_permissions": ["https://attendo.1337.ma/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "192": "icons/icon192.png", "512": "icons/icon512.png"}}, "background": {"scripts": ["background.js"]}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "192": "icons/icon192.png", "512": "icons/icon512.png"}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}}