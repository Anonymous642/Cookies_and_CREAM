{"manifest_version": 3, "name": "YouTube Keys Control (with Shorts support)", "version": "0.5", "description": "Control YouTube with media keys including Shorts, even when out of focus", "icons": {"16": "default_icon.png", "32": "default_icon.png", "48": "default_icon.png", "128": "default_icon.png"}, "action": {"default_icon": "default_icon.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["contentScript.js"], "run_at": "document_idle"}], "host_permissions": ["*://*.youtube.com/*"], "browser_specific_settings": {"gecko": {"id": "youtube-mediakeys@example.com", "strict_min_version": "109.0"}}}