{"manifest_version": 3, "name": "LogiScan \u2014 analyser une annonce", "version": "2.1.0", "description": "Analyse l'annonce immobili\u00e8re que vous consultez, dans la page : adresse probable, prix compar\u00e9 aux ventes voisines, risques.", "homepage_url": "https://logiscan.fr/extension", "browser_specific_settings": {"gecko": {"id": "extension@logiscan.fr", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "128.0"}}, "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://*/*", "http://*/*"], "background": {"scripts": ["src/background.js"]}, "content_scripts": [{"matches": ["https://*/*", "http://*/*"], "js": ["src/detection.js", "src/content.js"], "run_at": "document_idle"}], "action": {"default_title": "Analyser cette annonce avec LogiScan", "default_icon": {"16": "icons/icone-16.png", "32": "icons/icone-32.png", "48": "icons/icone-48.png", "128": "icons/icone-128.png"}}, "web_accessible_resources": [{"resources": ["src/panneau.html", "src/panneau.css", "src/panneau.js", "src/service.js", "src/apercu.js", "brand/logo-horizontal-sombre.svg", "brand/logo-symbole-blanc.svg", "fonts/plus-jakarta-sans-latin.woff2"], "matches": ["https://*/*", "http://*/*"]}], "icons": {"16": "icons/icone-16.png", "32": "icons/icone-32.png", "48": "icons/icone-48.png", "128": "icons/icone-128.png"}}