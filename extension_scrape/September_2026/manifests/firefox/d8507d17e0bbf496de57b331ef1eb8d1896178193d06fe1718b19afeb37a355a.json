{"manifest_version": 2, "name": "GFG Problem Sync (MVP)", "version": "1.3", "description": "Auto-syncs GFG problems on submission. Bulk sync all solved problems. Resilient to API schema changes with local Llama assistance.", "browser_specific_settings": {"gecko": {"id": "gfg-sync-mvp@krish.local", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["cookies", "tabs", "downloads", "notifications", "*://*.geeksforgeeks.org/*", "http://localhost:11434/*"], "background": {"scripts": ["schema_guard.js", "background.js"], "persistent": true}, "content_scripts": [{"matches": ["*://*.geeksforgeeks.org/*"], "js": ["content.js"], "run_at": "document_idle"}], "web_accessible_resources": ["injected.js"], "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_popup": "popup.html", "default_title": "GFG Sync", "default_icon": {"48": "icons/icon48.png"}}}