{"manifest_version": 2, "name": "Interknot Auto-Fill", "version": "1.0", "description": "A browser extension that automatically fills in disk, weapon, and mindscape information for the Interknot Network.", "permissions": ["activeTab", "<all_urls>"], "browser_specific_settings": {"gecko": {"id": "interknot-autofill@example.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "developer": {"name": "Interknot Extension Developer"}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icon-48.png", "96": "icon-96.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["js/weapon-mapping.js", "js/handlers/character-handler.js", "js/handlers/disk-handler.js", "js/handlers/weapon-handler.js", "js/handlers/mindscape-handler.js", "js/content.js"]}]}