{"manifest_version": 3, "name": "ReelScore", "version": "1.0.0", "description": "Local-first Reel analytics and gamified activity score for Instagram.", "action": {"default_title": "ReelScore", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["https://www.instagram.com/*", "https://instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "permissions": ["storage", "tabs", "alarms"], "host_permissions": ["https://www.instagram.com/*", "https://instagram.com/*"], "options_page": "dashboard.html", "web_accessible_resources": [{"resources": ["dashboard.html"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "reelscore@example.com", "strict_min_version": "126.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "126.0"}}}