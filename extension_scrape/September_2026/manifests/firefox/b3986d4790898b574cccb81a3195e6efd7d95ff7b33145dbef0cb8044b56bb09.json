{"manifest_version": 3, "name": "MomentNotes: YouTube Notes with Timestamps", "version": "1.1.0", "description": "Timestamped notes for YouTube lectures and courses. Click a note to jump back. Export clean Markdown for Obsidian or Notion.", "permissions": ["storage", "downloads", "clipboardWrite"], "host_permissions": ["https://api.gumroad.com/*"], "background": {"scripts": ["sw.js"], "type": "module"}, "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content/notes.js"], "css": ["content/notes.css"], "run_at": "document_idle"}], "commands": {"toggle-panel": {"suggested_key": {"default": "Alt+Shift+N"}, "description": "Open the MomentNotes panel on a YouTube video"}}, "action": {"default_popup": "popup/popup.html", "default_title": "MomentNotes \u2014 your video notes", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "momentnotes@onceworks.tools", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}