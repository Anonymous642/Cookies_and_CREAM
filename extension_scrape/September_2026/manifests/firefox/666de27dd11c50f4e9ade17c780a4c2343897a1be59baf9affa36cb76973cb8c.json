{"manifest_version": 3, "name": "Google search with udm=14, tbs=li:1 presets", "description": "Adds a Google search engine that includes the udm=14 parameter (excludes much AI content) and the tbs=li:1 parameter (verbatim search requests)", "version": "1.0", "browser_specific_settings": {"gecko": {"id": "@udm14-verbatim", "strict_min_version": "106.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"id": "@udm14-verbatim", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "chrome_settings_overrides": {"search_provider": {"name": "udm14-verbatim", "search_url": "https://www.google.com/search?q={searchTerms}&udm=14&tbs=li:1", "suggest_url": "https://www.google.com/complete/search?client=firefox&q=%s", "keyword": "udm14", "is_default": true, "encoding": "UTF-8"}}}