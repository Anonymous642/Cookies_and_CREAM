{"manifest_version": 2, "name": "Unicode Style - Text Converter", "version": "1.1", "description": "Convert selected text to different cases easily.", "permissions": ["contextMenus", "activeTab"], "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "background": {"scripts": ["background.js"], "persistent": true}, "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "unicode-style@myextension", "data_collection_permissions": {"required": ["none"]}}}}