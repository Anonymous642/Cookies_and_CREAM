{"manifest_version": 2, "name": "Dark Mode Toggle", "version": "1.0", "description": "B\u1eadt/t\u1eaft ch\u1ebf \u0111\u1ed9 t\u1ed1i cho trang hi\u1ec7n t\u1ea1i b\u1eb1ng c\u00e1ch \u0111\u1ea3o m\u00e0u (kh\u00f4ng thu th\u1eadp d\u1eef li\u1ec7u).", "permissions": ["activeTab", "tabs", "storage"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Toggle Dark Mode"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "@dark-mode-toggle", "data_collection_permissions": {"required": ["none"]}}}}