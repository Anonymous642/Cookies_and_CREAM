{"manifest_version": 3, "name": "Amazon Search Filter", "version": "1.0.0", "description": "Hide products and sellers from Amazon search results to curate your shopping experience.", "permissions": ["storage"], "content_scripts": [{"matches": ["*://*.amazon.com/s*", "*://*.amazon.com/*/dp/*", "*://*.amazon.com/dp/*"], "css": ["styles.css"], "js": ["content.js"], "run_at": "document_end"}], "host_permissions": ["*://*.amazon.com/*"], "action": {"default_popup": "popup.html", "default_title": "Amazon Search Filter", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "amazon-product-hider@status1", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}