{"manifest_version": 2, "name": "Folio", "version": "0.1.4", "description": "Opinionated tab management for Firefox", "icons": {"48": "icons/logo/logo-48.png", "96": "icons/logo/logo-96.png", "128": "icons/logo/logo-128.png"}, "background": {"scripts": ["background.js"], "persistent": true}, "sidebar_action": {"default_title": "Folio", "default_panel": "index.html", "default_icon": "icons/logo/logo-outline.svg", "open_at_install": true}, "options_ui": {"page": "options.html", "open_in_tab": true}, "permissions": ["tabs", "tabHide", "sessions", "bookmarks", "storage", "alarms", "theme"], "browser_specific_settings": {"gecko": {"id": "folio@bradsharp.dev", "strict_min_version": "131.0", "data_collection_permissions": {"required": ["browsingActivity"]}}}}