{"manifest_version": 3, "name": "Codex Assisted Bridge", "version": "0.3.4", "description": "Shares sanitized data from user-approved tabs with a local Codex bridge and supports origin-scoped supervised safe actions.", "permissions": ["activeTab", "scripting"], "host_permissions": ["http://127.0.0.1:32146/*"], "optional_host_permissions": ["https://*/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Start or stop Codex supervised access", "default_popup": "popup.html"}, "incognito": "not_allowed", "browser_specific_settings": {"gecko": {"id": "firefox-codex-assisted@local.invalid", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["browsingActivity", "websiteContent", "websiteActivity"]}}}}