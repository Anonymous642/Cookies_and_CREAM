{"manifest_version": 2, "name": "AI-Watch Clock", "description": "Give your AI a watch. Time awareness for ChatGPT, Claude, Gemini and any AI \u2014 100% local, zero network.", "version": "1.0.26", "icons": {"16": "icon-16.png", "32": "icon-32.png", "48": "icon-48.png", "128": "icon-128.png"}, "browser_specific_settings": {"gecko": {"id": "clock@ai-watch.eu", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "scripting"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "\\u231A", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}, "content_scripts": [{"matches": ["https://chat.mistral.ai/*", "https://chat.openai.com/*", "https://chatgpt.com/*", "https://claude.ai/*", "https://gemini.google.com/*", "https://grok.com/*", "https://perplexity.ai/*", "https://www.perplexity.ai/*"], "js": ["content-scripts/watch.js"]}]}