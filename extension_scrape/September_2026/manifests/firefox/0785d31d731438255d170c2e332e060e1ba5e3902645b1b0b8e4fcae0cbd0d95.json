{"manifest_version": 3, "name": "Bookmarks Finder", "version": "1.0.8", "description": "Find any bookmark by name, title, folder or domain \u2014 even if you misspell it. Bookmark the current tab in one click.", "browser_specific_settings": {"gecko": {"id": "bookmarks-finder@selectorshub.com", "data_collection_permissions": {"required": ["bookmarksInfo"]}, "strict_min_version": "115.0"}}, "permissions": ["bookmarks", "storage", "activeTab", "contextMenus"], "background": {"scripts": ["background.js"], "type": "module"}, "action": {"default_title": "Bookmarks Finder", "default_popup": "popup.html", "default_area": "navbar", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "commands": {"_execute_action": {"suggested_key": {"default": "Alt+Shift+F", "mac": "Alt+Shift+F"}, "description": "Open Bookmarks Finder"}, "bookmark-tab": {"suggested_key": {"default": "Alt+Shift+D", "mac": "Alt+Shift+D"}, "description": "Bookmark this tab"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}