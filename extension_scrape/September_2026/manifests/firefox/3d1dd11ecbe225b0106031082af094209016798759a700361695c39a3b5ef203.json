{"manifest_version": 3, "name": "Nur Tab", "version": "1.3.0", "description": "A calm new tab for Muslim users \u2014 Ayat of the day, prayer times, Hijri calendar, focus mode, and more. Free and local-only.", "permissions": ["storage", "alarms", "notifications"], "host_permissions": ["https://ummahapi.com/*", "https://geocoding-api.open-meteo.com/*", "https://api.bigdatacloud.net/*"], "background": {"scripts": ["service-worker-loader.js"], "type": "module"}, "chrome_url_overrides": {"newtab": "src/newtab/index.html"}, "icons": {"16": "public/icons/icon16.png", "48": "public/icons/icon48.png", "128": "public/icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "nur-tab@anggaggaH.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["locationInfo", "searchTerms"]}}}}