{"manifest_version": 2, "name": "EtReply", "version": "1.0.4", "description": "Reads your Etsy conversations so EtReply can draft replies in Telegram.", "permissions": ["tabs", "scripting", "storage", "alarms", "idle", "https://www.etsy.com/*", "https://etreply.com/*"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_popup": "popup/popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "extension@etreply.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["websiteContent", "personalCommunications", "authenticationInfo"], "optional": []}}}}