{"manifest_version": 3, "name": "Flow", "version": "1.3", "description": "Auto-skip videos, documents, and navigate through Google Skills courses effortlessly.", "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "permissions": ["storage", "activeTab"], "host_permissions": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*", "*://skills.google/*", "*://*.skills.google/*"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "flow-auto-stepper@vignesh72.addon", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.youtube.com/embed/*", "*://*.youtube-nocookie.com/embed/*"], "all_frames": true, "js": ["youtube-content.js"]}, {"matches": ["*://skills.google/*", "*://*.skills.google/*"], "js": ["course-content.js"], "run_at": "document_idle"}]}