{"manifest_version": 3, "name": "FastJSON", "version": "0.2.0", "description": "Fast JSON viewer optimized for speed. Firefox for Android compatible.", "homepage_url": "https://github.com/waf/FastJSON-Firefox", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "permissions": ["webRequest", "webRequestBlocking"], "host_permissions": ["http://*/*", "https://*/*"], "web_accessible_resources": [{"resources": ["viewer.html"], "matches": ["http://*/*", "https://*/*"]}], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "fastjson@fuqua.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}