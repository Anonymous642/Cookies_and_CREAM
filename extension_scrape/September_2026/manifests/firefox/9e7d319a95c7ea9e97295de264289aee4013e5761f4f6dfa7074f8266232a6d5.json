{"manifest_version": 3, "name": "Atrium", "version": "1.0.0", "description": "A calm, private new tab and start page. Clock, weather, crypto, GitHub activity, news and speed dial \u2014 all local, no account, no permissions until you enable a widget.", "author": "Karl Dopplinger", "browser_specific_settings": {"gecko": {"id": "atrium@dopplinger.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": ["locationInfo", "searchTerms", "browsingActivity"]}}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "chrome_url_overrides": {"newtab": "src/newtab/index.html"}, "chrome_settings_overrides": {"homepage": "src/newtab/index.html"}, "background": {"scripts": ["src/background.js"]}, "action": {"default_title": "Atrium settings", "default_icon": {"48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "permissions": ["storage"], "optional_permissions": ["topSites", "bookmarks"], "optional_host_permissions": ["https://api.coingecko.com/*", "https://api.open-meteo.com/*", "https://geocoding-api.open-meteo.com/*", "https://api.github.com/*", "https://github.com/*", "https://hn.algolia.com/*", "https://duckduckgo.com/*", "https://icons.duckduckgo.com/*", "*://*/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}}