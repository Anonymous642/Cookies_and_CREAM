{"manifest_version": 3, "name": "AI Code Editor Browser Bridge", "version": "0.2.1", "description": "Companion bridge for AI Code Editor that opens or focuses ChatGPT through the browser without reading ChatGPT conversations.", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["tabs"], "host_permissions": ["file:///*", "http://localhost/*", "http://127.0.0.1/*"], "background": {"scripts": ["background.js"]}, "action": {"default_title": "Open ChatGPT", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["file:///*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["editor_bridge.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "ai-code-editor-bridge@ace.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {}}}