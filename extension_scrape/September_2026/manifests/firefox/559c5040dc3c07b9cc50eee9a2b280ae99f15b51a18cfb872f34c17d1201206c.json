{"manifest_version": 2, "name": "Paper2Audio", "description": "Listen to your research papers, web articles and ebooks with Paper2Audio", "version": "1.8.16", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "tabs", "activeTab", "scripting", "unlimitedStorage", "<all_urls>", "https://paper2audio.com/*"], "commands": {"_execute_browser_action": {"suggested_key": {"default": "Alt+Shift+S", "mac": "Alt+Shift+S"}, "description": "Open Paper2Audio extension (S for Submit)"}}, "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "Paper2Audio", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*/*", "*://*/*.epub", "*://*/*.pdf"], "js": ["content-scripts/content.js"]}], "browser_specific_settings": {"gecko": {"id": "{ff6c0a72-c186-4d87-bc26-11dd9a2944d8}"}}}