{"manifest_version": 3, "name": "Tailscale Browser-Router", "version": "0.3.0", "description": "Routet selektiv Browser-Traffic durch einen Tailscale-Userspace-SOCKS5-Tunnel. Fail-Closed, Leak-Guard.", "permissions": ["proxy", "storage", "privacy", "tabs", "nativeMessaging"], "host_permissions": ["<all_urls>"], "icons": {"48": "src/ui/icons/icon-48.png", "96": "src/ui/icons/icon-96.png", "128": "src/ui/icons/icon-128.png"}, "background": {"scripts": ["src/background/index.js"], "type": "module"}, "action": {"default_popup": "src/ui/popup/popup.html", "default_title": "Tailscale Browser-Router", "default_icon": {"48": "src/ui/icons/icon-48.png", "96": "src/ui/icons/icon-96.png", "128": "src/ui/icons/icon-128.png"}}, "options_ui": {"page": "src/ui/options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "tailscale-router@local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}