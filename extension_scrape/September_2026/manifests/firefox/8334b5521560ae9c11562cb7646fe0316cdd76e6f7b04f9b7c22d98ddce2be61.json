{"manifest_version": 3, "name": "YouTubeNotes", "version": "1.0.0", "description": "Take timestamped notes while watching YouTube videos. Jump to timestamps, organize notes by video. No API key needed!", "icons": {"48": "assets/icons/icon-48.png", "96": "assets/icons/icon-96.png", "128": "assets/icons/icon-128.png"}, "action": {"default_icon": {"48": "assets/icons/icon-48.png", "96": "assets/icons/icon-96.png"}, "default_title": "YouTubeNotes", "default_popup": "src/popup/popup.html"}, "permissions": ["storage", "activeTab"], "content_scripts": [{"matches": ["*://www.youtube.com/*"], "js": ["src/content/youtube.js"]}], "browser_specific_settings": {"gecko": {"id": "youtubenotes@video.tools", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}