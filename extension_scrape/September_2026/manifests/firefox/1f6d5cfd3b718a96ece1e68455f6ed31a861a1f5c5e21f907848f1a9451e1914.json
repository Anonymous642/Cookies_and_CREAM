{"manifest_version": 2, "name": "LirPay Robux", "version": "1.0.3", "description": "Pay with Robux on LirPay checkout using your Roblox account.", "browser_specific_settings": {"gecko": {"id": "robux@lirpay.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "financialAndPaymentInfo", "personallyIdentifyingInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["cookies", "storage", "tabs", "https://*.roblox.com/*", "https://roblox.com/*", "https://*.lirpay.com/*", "https://lirpay.com/*", "https://*.lirpay.org/*", "https://lirpay.org/*", "http://localhost/*", "http://127.0.0.1/*"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://*.lirpay.com/pay/*", "https://lirpay.com/pay/*", "https://*.lirpay.org/pay/*", "https://lirpay.org/pay/*", "http://localhost/*", "http://127.0.0.1/*"], "js": ["content.js"], "css": ["modal.css"], "run_at": "document_idle"}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_title": "LirPay Robux"}}