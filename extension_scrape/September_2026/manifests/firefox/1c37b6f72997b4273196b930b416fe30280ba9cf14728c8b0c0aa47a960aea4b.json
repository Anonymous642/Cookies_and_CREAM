{"manifest_version": 2, "name": "XTTS", "version": "1.1.1", "description": "Read Twitter/X tweets aloud with automatic language detection, word highlighting, and playback controls", "permissions": ["activeTab", "storage", "https://translate.google.com/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://twitter.com/*", "*://*.twitter.com/*", "*://x.com/*", "*://*.x.com/*"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}], "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "default_title": "XTTS Settings"}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "options_ui": {"page": "options.html", "browser_style": true}, "browser_specific_settings": {"gecko": {"id": "@xtts.persistent_avenger", "data_collection_permissions": {"required": ["none"]}}}}