{"manifest_version": 2, "name": "FreelyMemo - A floating notepad on every tab", "description": "A floating notepad on every tab. Press \u2318\u21e7O, jot your thought, keep browsing. Free trial available, no account needed.", "version": "1.6.0", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "homepage_url": "https://freelymemo.xyz", "permissions": ["storage", "contextMenus", "activeTab", "alarms", "<all_urls>"], "commands": {"toggle-pad": {"suggested_key": {"default": "Ctrl+Shift+O", "mac": "Command+Shift+O"}, "description": "Toggle FreelyMemo notepad"}}, "browser_specific_settings": {"gecko": {"id": "firefox@freelymemo.xyz", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "web_accessible_resources": ["fonts/*.woff2"], "background": {"scripts": ["background.js"]}, "browser_action": {"default_title": "FreelyMemo", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}]}