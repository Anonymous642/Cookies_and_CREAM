{"manifest_version": 3, "name": "Local Page Archive", "version": "1.2.2", "description": "Privately archive readable webpage text, search and manage it locally, and control retention.", "permissions": ["unlimitedStorage"], "background": {"scripts": ["src/background.js"], "type": "module"}, "content_scripts": [{"matches": ["http://*/*", "https://*/*", "file:///*"], "js": ["src/content.js"], "run_at": "document_idle", "all_frames": false}], "action": {"default_title": "Open Local Page Archive", "default_icon": "icons/archive.svg"}, "incognito": "not_allowed", "browser_specific_settings": {"gecko": {"id": "local-page-archive@local.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"32": "icons/archive.svg", "48": "icons/archive.svg", "64": "icons/archive.svg", "96": "icons/archive.svg"}}