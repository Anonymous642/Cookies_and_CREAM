{"manifest_version": 3, "name": "Thisge", "version": "1.1.2", "description": "Custom Twitch emotes and animated name paints you control, by Thisge.", "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["storage"], "host_permissions": ["*://*.twitch.tv/*", "https://api.thisge.app/*", "wss://events.thisge.app/*", "https://7tv.io/*", "https://api.betterttv.net/*", "https://api.frankerfacez.com/*"], "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://*.twitch.tv/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle"}], "action": {"default_popup": "popup.html", "default_title": "Thisge", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "web_accessible_resources": [{"resources": ["inject.js", "badges/*"], "matches": ["*://*.twitch.tv/*"]}], "browser_specific_settings": {"gecko": {"id": "thisge@extension", "data_collection_permissions": {"required": ["none"]}}}}