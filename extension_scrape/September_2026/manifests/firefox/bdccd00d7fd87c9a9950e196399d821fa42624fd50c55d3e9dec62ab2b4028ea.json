{"manifest_version": 3, "name": "YouTube Quick Control", "version": "1.0", "description": "Addon Firefox MV3 cho ph\u00e9p \u0111i\u1ec1u khi\u1ec3n video tr\u00ean YouTube nhanh t\u1eeb popup.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["scripting", "tabs", "activeTab"], "host_permissions": ["*://www.youtube.com/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "youtubecontrol@example.com", "strict_min_version": "109.0"}}}