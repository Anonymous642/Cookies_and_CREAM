{"manifest_version": 3, "name": "BCBlur", "version": "1.2.1", "description": "Blur sensitive data before you screen-share, record, or screenshot. Draw blur boxes, hide text or images, auto-detect emails, numbers and phone numbers. 100% local \u2014 no account, no tracking, nothing leaves your browser.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["tweetnacl.min.js", "background.js"]}, "browser_specific_settings": {"gecko": {"id": "bcblur@bcblur.local", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup-full.html", "default_title": "BCBlur", "default_icon": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}}, "icons": {"16": "images/icon-16.png", "32": "images/icon-32.png", "48": "images/icon-48.png", "128": "images/icon-128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end", "all_frames": true}], "web_accessible_resources": [{"resources": ["popup.js", "popup-full.html", "images/*"], "matches": ["<all_urls>"]}], "commands": {"toggle-selector": {"suggested_key": {"default": "Ctrl+Shift+9", "mac": "Command+Shift+9"}, "description": "Toggle the blur selector mode"}}}