{"manifest_version": 3, "name": "Dealvinci", "description": "Add the current product page to Dealvinci.", "version": "0.1.0", "action": {"default_popup": "popup.html", "default_title": "Dealvinci"}, "background": {"scripts": ["background.js"], "type": "module"}, "permissions": ["activeTab", "identity", "scripting", "storage", "tabs", "webNavigation"], "host_permissions": ["https://*.chromiumapp.org/*", "https://*.extensions.allizom.org/*", "https://api.dealvinci.com/*", "https://dealvinci.com/*", "https://www.dealvinci.com/*"], "browser_specific_settings": {"gecko": {"id": "tracker@dealvinci.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["personallyIdentifyingInfo", "authenticationInfo", "browsingActivity", "websiteContent"]}}}}