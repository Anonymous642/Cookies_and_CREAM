{"manifest_version": 3, "name": "Tiny Rec: Minimal Screen Recorder", "version": "1.2.0", "description": "A tiny, no-frills screen recorder. Pick a resolution, hit record, save the file. Everything stays on your device.", "action": {"default_title": "Open Tiny Rec", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "tinyrec@tri.dev", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}}