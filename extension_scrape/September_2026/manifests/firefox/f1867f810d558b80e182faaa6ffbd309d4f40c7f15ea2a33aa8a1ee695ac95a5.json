{"manifest_version": 2, "name": "Search Site Excluder", "version": "1.0.1", "description": "Automatically exclude specific websites from search engine results. Works with Google, Bing, DuckDuckGo, Yahoo, and Startpage.", "permissions": ["storage", "webNavigation", "*://*.google.com/*", "*://*.google.co.uk/*", "*://*.google.de/*", "*://*.google.fr/*", "*://*.google.ro/*", "*://*.google.es/*", "*://*.google.it/*", "*://*.google.nl/*", "*://*.google.pl/*", "*://*.google.ca/*", "*://*.google.com.au/*", "*://*.bing.com/*", "*://*.duckduckgo.com/*", "*://*.yahoo.com/*", "*://*.startpage.com/*"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "{e8b3f8a2-4c5d-4f6e-9a1b-2c3d4e5f6789}", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "homepage_url": "https://github.com/mircea-source/search-site-excluder", "developer": {"name": "mircea-source", "url": "https://github.com/mircea-source"}}