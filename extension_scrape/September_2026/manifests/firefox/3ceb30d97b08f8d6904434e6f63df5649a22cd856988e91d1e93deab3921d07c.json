{"manifest_version": 2, "name": "Court Listener Summarizer", "version": "1.2.1", "description": "Summarizes and enables chat with court opinions on CourtListener", "permissions": ["activeTab", "storage", "*://api.openai.com/*", "*://www.courtlistener.com/*"], "browser_specific_settings": {"gecko": {"id": "admin@legaltext.ai"}}, "browser_action": {"default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "persistent": true}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "content_scripts": [{"matches": ["*://www.courtlistener.com/opinion/*"], "js": ["content.js"]}], "author": "Mitch McD", "homepage_url": "https://legaltext.ai"}