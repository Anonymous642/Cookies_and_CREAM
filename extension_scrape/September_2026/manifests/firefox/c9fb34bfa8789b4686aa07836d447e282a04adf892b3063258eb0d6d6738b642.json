{"version": "1.4.4", "name": "Notix: Notion Web Clipper", "manifest_version": 2, "description": "Save the Web to Notion. Use AI to create summaries and auto-prefills. Easily create how-to guides with screenshots in Notion.", "default_locale": "en", "permissions": ["webNavigation", "activeTab", "tabs", "storage", "contextMenus", "<all_urls>"], "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "__MSG_extName__", "default_icon": {"19": "icons/19.png", "38": "icons/38.png"}}, "commands": {"_execute_browser_action": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}}}, "externally_connectable": {"matches": ["http://localhost:8001/*", "https://notix.so/*"]}, "web_accessible_resources": ["index.html"], "browser_specific_settings": {"gecko": {"id": "{a969fd45-f7db-4a40-b080-e3e01748d566}"}}}