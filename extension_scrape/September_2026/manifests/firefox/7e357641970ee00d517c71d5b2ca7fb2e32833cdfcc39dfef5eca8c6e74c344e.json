{"manifest_version": 3, "name": "InstaGrabber", "version": "2.1", "description": "Download Instagram posts and reels. Basic mode for quick grabs, Advanced mode with sync, stories, filters, ZIP export and more.", "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "browser_specific_settings": {"gecko": {"id": "deeprandom258@gmail.com", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["downloads", "storage", "cookies", "notifications", "activeTab", "scripting"], "host_permissions": ["*://*.instagram.com/*", "*://*.cdninstagram.com/*", "*://*.fbcdn.net/*"], "background": {"scripts": ["zip.js", "background.js"]}, "action": {"default_popup": "popup.html", "default_title": "InstaGrabber", "default_icon": {"48": "icons/icon48.png", "96": "icons/icon96.png"}}, "content_scripts": [{"matches": ["*://*.instagram.com/*"], "js": ["content.js"], "css": ["content.css"]}]}