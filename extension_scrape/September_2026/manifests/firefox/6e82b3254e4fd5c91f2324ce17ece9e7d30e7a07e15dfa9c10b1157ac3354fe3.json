{"manifest_version": 3, "name": "Sharp", "version": "0.5.2", "description": "Filter your timeline with your own AI provider, word rules and per-author rules.", "permissions": ["storage"], "host_permissions": ["https://x.com/*", "https://twitter.com/*", "https://www.youtube.com/*", "https://m.youtube.com/*", "https://openrouter.ai/*", "https://api.openai.com/*", "https://api.anthropic.com/*"], "optional_host_permissions": ["https://*/*"], "content_scripts": [{"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["wire.js"], "run_at": "document_start", "world": "MAIN"}, {"matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}, {"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "commands": {"toggle-filtering": {"suggested_key": {"default": "Alt+Shift+F"}, "description": "Turn filtering on or off"}, "toggle-thread": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "Stop filtering the thread you are viewing"}}, "background": {"scripts": ["background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "sharp@tshmieldev.github.io", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["websiteContent"]}}}}