{"manifest_version": 2, "name": "Codeforces Auto Copy Input", "version": "1.0.1", "description": "Automatically copies input examples from Codeforces problems to your clipboard", "permissions": ["activeTab", "clipboardWrite", "storage"], "browser_specific_settings": {"gecko": {"id": "cf-auto-copy@pratyushlab.site", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"48": "icon.png", "96": "icon.png"}, "content_scripts": [{"matches": ["https://codeforces.com/problemset/problem/*", "https://codeforces.com/contest/*/problem/*", "https://codeforces.com/gym/*/problem/*"], "js": ["content.js"], "run_at": "document_idle"}]}