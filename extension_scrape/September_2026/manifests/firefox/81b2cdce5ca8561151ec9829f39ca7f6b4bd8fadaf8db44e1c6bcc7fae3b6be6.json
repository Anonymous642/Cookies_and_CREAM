{"manifest_version": 3, "name": "DetoxAI: Filter for X, Reddit & Facebook", "version": "1.2.0", "description": "AI filter removing toxic & clickbait posts from X (Twitter), Reddit & Facebook. Protect your mental health.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "permissions": ["alarms", "storage", "activeTab", "scripting", "contextMenus"], "host_permissions": ["https://*.x.com/*", "https://*.twitter.com/*", "https://*.facebook.com/*", "https://*.instagram.com/*", "https://*.threads.net/*", "https://*.reddit.com/*", "https://*.cnn.com/*", "https://*.bbc.com/*", "https://*.bbc.co.uk/*", "https://*.nytimes.com/*", "https://*.washingtonpost.com/*", "https://*.theguardian.com/*", "https://*.reuters.com/*", "https://*.ap.org/*", "https://*.npr.org/*", "https://*.news.yahoo.com/*", "https://*.news.google.com/*", "https://openrouter.ai/api/*"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://*.x.com/*", "https://*.twitter.com/*", "https://*.threads.net/*", "https://*.facebook.com/*", "https://*.reddit.com/*", "https://*.cnn.com/*", "https://*.bbc.com/*", "https://*.bbc.co.uk/*", "https://*.nytimes.com/*", "https://*.washingtonpost.com/*", "https://*.theguardian.com/*", "https://*.reuters.com/*", "https://*.ap.org/*", "https://*.npr.org/*", "https://*.news.yahoo.com/*", "https://*.news.google.com/*"], "js": ["utils/blocklist.js", "adapters/site-adapter.js", "adapters/twitter.js", "adapters/threads.js", "adapters/facebook.js", "adapters/reddit.js", "adapters/generic.js", "content.js"], "css": ["styles.css"], "run_at": "document_start", "all_frames": false}], "sidebar_action": {"default_panel": "sidepanel/index.html", "default_icon": "icons/icon128.png", "default_title": "DetoxAI Sidebar"}, "browser_specific_settings": {"gecko": {"id": "detoxai-release@extension", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://openrouter.ai"}}