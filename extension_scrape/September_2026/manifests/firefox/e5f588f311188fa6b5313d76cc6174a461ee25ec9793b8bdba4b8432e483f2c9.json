{"manifest_version": 3, "name": "SuperrPaperr Clipper", "version": "1.1.0", "description": "Turn the web into your reading list. Clip any article to SuperrPaperr to read clean or play as audio.", "permissions": ["activeTab", "storage", "scripting", "identity"], "host_permissions": ["<all_urls>", "http://localhost/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "src/popup/index.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["defuddle.js", "extract.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["defuddle.js"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "extension@superr.ai", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent"], "optional": ["technicalAndInteraction"]}}}}