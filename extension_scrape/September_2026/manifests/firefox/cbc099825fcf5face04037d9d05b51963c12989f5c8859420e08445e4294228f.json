{"manifest_version": 3, "name": "Google Calendar Sidebar (Outlook-style)", "version": "0.2.3", "description": "Shows your Google Calendar in a right-side Firefox sidebar.", "permissions": ["identity", "storage", "tabs"], "host_permissions": ["https://www.googleapis.com/*"], "sidebar_action": {"default_title": "Calendar", "default_panel": "sidebar.html", "default_icon": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}}, "browser_specific_settings": {"gecko": {"id": "gcal-sidebar@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}