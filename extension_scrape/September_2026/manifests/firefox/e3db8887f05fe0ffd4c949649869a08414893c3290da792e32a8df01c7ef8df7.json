{"manifest_version": 3, "name": "Find Tab (FTab)", "version": "0.1.0", "description": "Search and open tabs by title/URL with a keyboard shortcut (fuzzy match).", "browser_specific_settings": {"gecko": {"id": "ftab@ppok24"}}, "permissions": ["tabs"], "action": {}, "icons": {"48": "icons/icon48.png", "96": "icons/icon96.png"}, "background": {"scripts": ["background.js"], "type": "module"}, "commands": {"open-tab-finder": {"suggested_key": {"default": "Ctrl+Space"}, "description": "Open the Tab Finder"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["style.js", "overlay.js"], "run_at": "document_idle"}]}