{"manifest_version": 3, "name": "TatkalExpress: IRCTC Booking Helper", "version": "1.0.7", "description": "Pre-fill login credentials, search details, passenger lists, and mobile numbers for rapid train ticket booking on IRCTC.", "browser_specific_settings": {"gecko": {"id": "tatkalexpress-booking-helper@shivamsharma.dev", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["*://*.irctc.co.in/*"], "background": {"scripts": ["background/background.js"]}, "icons": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon16.png", "48": "assets/icon48.png", "128": "assets/icon128.png"}}, "content_scripts": [{"matches": ["*://*.irctc.co.in/*"], "js": ["content/content.js"], "run_at": "document_idle"}]}