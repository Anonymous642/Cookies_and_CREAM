{"manifest_version": 3, "name": "Enhanced Text View", "version": "0.4", "description": "Renders ANSI SGR escape codes when viewing .txt files in your browser.", "author": "Ron Harel", "homepage_url": "https://github.com/ronharel02/enhanced-text-view", "browser_specific_settings": {"gecko": {"id": "{5fdfa271-5df3-4d64-99e6-fb566f871e11}"}}, "content_scripts": [{"matches": ["file://*/*.txt", "https://*/*", "http://*/*"], "js": ["bundle.js"], "run_at": "document_end"}], "action": {"default_popup": "popup/popup.html"}, "host_permissions": ["<all_urls>"], "permissions": ["storage"], "icons": {"48": "icons/icon_48.png", "256": "icons/icon_256.png", "512": "icons/icon_512.png"}}