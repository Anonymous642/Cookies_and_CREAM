{"manifest_version": 3, "name": "Finanzen.net Depot Diff", "description": "Extension for finanzen.net to show the diff of your portfolio since last login", "version": "0.3.1", "permissions": ["tabs", "storage"], "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "options.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png"}}, "content_scripts": [{"js": ["scripts/extensionApi.js", "scripts/common.js", "scripts/tableExpansion.js", "scripts/content.js"], "matches": ["https://www.finanzen.net/depot/*", "https://finanzen.net/depot/*"]}], "browser_specific_settings": {"gecko": {"id": "finanzen-net-last-visit-diff@zeberti.github.io", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}}