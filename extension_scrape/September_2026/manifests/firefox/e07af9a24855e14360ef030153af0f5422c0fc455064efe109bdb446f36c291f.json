{"manifest_version": 3, "name": "Parcel", "version": "1.0", "description": "Instant link previews on hover \u2014 title, description, and read time from metadata. No page load, no iframe.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Parcel", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background/background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content/content.js"], "css": ["content/content.css"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "parcel@extensions", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}}