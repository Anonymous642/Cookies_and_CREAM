{"manifest_version": 3, "name": "DiceLedger Tabletop", "version": "1.0.0", "description": "Roll tabletop dice formulas, track turn order, and export local session logs.", "browser_specific_settings": {"gecko": {"id": "diceledger-tabletop@example.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["clipboardWrite", "storage", "tabs"], "background": {"scripts": ["shared/constants.js", "shared/browser.js", "shared/diceTools.js", "shared/storage.js", "background.js"]}, "action": {"default_title": "DiceLedger Tabletop", "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icon.svg", "32": "assets/icon.svg", "48": "assets/icon.svg", "96": "assets/icon.svg"}}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "commands": {"open-diceledger-session": {"suggested_key": {"default": "Ctrl+Shift+Y"}, "description": "Open the DiceLedger session board"}, "quick-roll-d20": {"suggested_key": {"default": "Ctrl+Shift+U"}, "description": "Roll one d20 and save it locally"}}, "icons": {"16": "assets/icon.svg", "32": "assets/icon.svg", "48": "assets/icon.svg", "96": "assets/icon.svg"}}