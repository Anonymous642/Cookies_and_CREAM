{"manifest_version": 3, "name": "RetroAchievements-Infinite Backlog Bridge", "version": "0.2.0", "description": "Shows your local Infinite Backlog collection data on exact RetroAchievements game matches.", "icons": {"16": "resources/RA-IB-logo-16.png", "32": "resources/RA-IB-logo-32.png", "48": "resources/RA-IB-logo-48.png", "128": "resources/RA-IB-logo-128.png"}, "permissions": ["alarms", "declarativeNetRequestWithHostAccess", "storage", "webRequest"], "host_permissions": ["https://beta.infinitebacklog.net/*", "https://infinitebacklog.net/*", "https://retroachievements.org/*", "https://www.retroachievements.org/*"], "background": {"scripts": ["src/core.js", "src/db.js", "src/background.js"]}, "action": {"default_title": "RetroAchievements-Infinite Backlog Bridge", "default_popup": "src/popup.html", "default_icon": {"16": "resources/RA-IB-logo-16.png", "32": "resources/RA-IB-logo-32.png"}}, "content_scripts": [{"matches": ["https://retroachievements.org/game/*", "https://www.retroachievements.org/game/*"], "js": ["src/core.js", "src/content.js"], "run_at": "document_idle"}], "web_accessible_resources": [{"resources": ["resources/IB-logo.svg"], "matches": ["https://retroachievements.org/*", "https://www.retroachievements.org/*"]}], "browser_specific_settings": {"gecko": {"id": "ib-ra-companion@infinitebacklogposter.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo"]}}, "gecko_android": {"strict_min_version": "142.0"}}}