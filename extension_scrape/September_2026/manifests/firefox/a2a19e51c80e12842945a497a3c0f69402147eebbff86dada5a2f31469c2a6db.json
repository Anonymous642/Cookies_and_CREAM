{"manifest_version": 3, "name": "QuoraNotes", "version": "1.0.0", "description": "Save Quora answers as offline, searchable notes.", "permissions": ["storage", "clipboardWrite", "activeTab"], "host_permissions": ["https://www.quora.com/*"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["service-worker.js"], "type": "module"}, "content_scripts": [{"matches": ["https://www.quora.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "action": {"default_title": "QuoraNotes", "default_popup": "popup.html", "default_icon": {"16": "icons/icon-16.png", "24": "icons/icon-24.png", "32": "icons/icon-32.png"}}, "browser_specific_settings": {"gecko": {"id": "quoranotes@quoranotes.app", "strict_min_version": "121.0", "data_collection_permissions": {"required": ["none"]}}}}