{"manifest_version": 3, "name": "Magpie", "version": "1.0.1", "description": "Download video and audio from the web - clean, fast, no watermarks.", "background": {"scripts": ["src/settings.js", "src/tiers.js", "src/download-job.js", "src/detect.js", "src/dash.js", "src/adapters/reddit.js", "src/adapters/tiktok.js", "src/adapters/brightcove.js", "extension/license.js", "src/router.js", "extension/background.js"]}, "action": {"default_popup": "extension/popup.html", "default_title": "Magpie"}, "icons": {"48": "resources/logo_48.png", "96": "resources/logo_96.png", "128": "resources/logo_128.png"}, "permissions": ["downloads", "storage", "contextMenus", "scripting", "alarms"], "host_permissions": ["<all_urls>"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}, "browser_specific_settings": {"gecko": {"id": "magpie@jwum.com", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"], "optional": ["websiteContent"]}}, "gecko_android": {"strict_min_version": "120.0"}}}