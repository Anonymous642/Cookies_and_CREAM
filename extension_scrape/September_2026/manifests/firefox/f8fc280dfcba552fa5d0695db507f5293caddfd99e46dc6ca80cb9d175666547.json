{"manifest_version": 2, "name": "HiBob Project Filler", "version": "1.4.4", "description": "Auto-fills HiBob Project, Project task, and Reason when the modal opens. Robust retries + settle delays.", "permissions": ["storage", "activeTab", "contextMenus", "webRequest", "https://app.hibob.com/*", "https://*.hibob.com/*", "https://hibob.com/*"], "browser_action": {"default_title": "HiBob Project Filler", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["https://*.hibob.com/*", "https://hibob.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "commands": {"fill-hibob": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Fill Project, Project task, Reason"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_specific_settings": {"gecko": {"id": "hibob-autofill@example.com", "strict_min_version": "58.0", "data_collection_permissions": {"collectsTelemetry": false, "required": ["none"]}}}, "data_collection_permissions": {"collectsTelemetry": false}}