{"manifest_version": 2, "name": "Nivus - Simple Bookmark Manager", "version": "1.0.1", "description": "Save bookmarks to Nivus with one click. Simple, fast, and synced across all your devices.", "browser_specific_settings": {"gecko": {"id": "nivus@lemonpieapps.com", "data_collection_permissions": {"web_data": false, "user_data": false, "required": ["browsingActivity"]}}}, "permissions": ["activeTab", "tabs", "contextMenus", "notifications", "storage", "https://nivus.app/*", "<all_urls>"], "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "browser_action": {"default_popup": "popup.html", "default_title": "Save to Nivus", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "web_accessible_resources": ["*.js"]}