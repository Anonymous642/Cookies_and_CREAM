{"manifest_version": 3, "name": "HoloWeb: Holographic UI Enhancer", "version": "1.0", "description": "Display hologram-like interfaces on screens and websites", "icons": {"48": "icons/icon-48.png", "96": "icons/icon-96.png"}, "permissions": ["activeTab", "storage", "webNavigation"], "host_permissions": ["<all_urls>"], "action": {"default_icon": {"48": "icons/icon-48.png"}, "default_title": "HoloWeb", "default_popup": "popup/popup.html"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["hologram.css"]}], "web_accessible_resources": [{"resources": ["hologram.js"], "matches": ["<all_urls>"]}], "options_ui": {"page": "options/options.html", "open_in_tab": true}, "browser_specific_settings": {"gecko": {"id": "holoweb@example.com"}}}