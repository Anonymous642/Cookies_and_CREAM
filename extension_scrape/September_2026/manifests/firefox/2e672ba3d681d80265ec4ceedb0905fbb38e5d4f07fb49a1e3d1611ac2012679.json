{"manifest_version": 3, "name": "Zenblock", "description": "Stay focused. Block distracting sites and categories on a schedule \u2014 or lock in with zen mode.", "version": "0.1.1", "short_name": "Zenblock", "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}, "permissions": ["storage", "webRequest", "webRequestBlocking", "tabs", "alarms", "idle", "notifications"], "host_permissions": ["<all_urls>"], "web_accessible_resources": [{"resources": ["blocked.html"], "matches": ["<all_urls>"]}], "browser_specific_settings": {"gecko": {"id": "zenblock@hari.dev", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "Zenblock", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": true, "page": "options.html"}}