{"manifest_version": 2, "name": "Video Downloader Helper-like", "version": "1.0.0", "description": "Find downloadable media (video/audio) on the current page and provide download links. Local-only. Not affiliated with any third-party tool.", "permissions": ["activeTab", "tabs", "storage", "downloads"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Video Downloader", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content_script.js"], "run_at": "document_idle"}], "applications": {"gecko": {"id": "video-downloader-helper-like@example.com", "strict_min_version": "60.0"}}}