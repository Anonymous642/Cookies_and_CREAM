{"manifest_version": 2, "name": "Dark/Light Mode Switcher", "version": "1.0", "description": "Chuy\u1ec3n \u0111\u1ed5i gi\u1eefa ch\u1ebf \u0111\u1ed9 t\u1ed1i v\u00e0 s\u00e1ng cho trang web.", "permissions": ["tabs"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_title": "Toggle Dark/Light Mode", "default_icon": "icon.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "applications": {"gecko": {"id": "darklight@example.com"}}}