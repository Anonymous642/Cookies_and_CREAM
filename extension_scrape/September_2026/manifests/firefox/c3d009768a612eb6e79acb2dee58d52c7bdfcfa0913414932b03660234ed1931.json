{"manifest_version": 3, "name": "Magi Magi", "version": "1.3", "description": "Captura texto selecionado e envia para o servidor Flask.", "icons": {"128": "logo_p.png"}, "permissions": ["activeTab", "contextMenus", "storage"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background.js"], "service_worker": "background.js", "type": "module"}, "action": {"default_icon": "logo_p.png", "default_popup": "popup.html", "default_title": "Magi Magi"}, "browser_specific_settings": {"gecko": {"id": "magimagi-v2@addons", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end"}]}