{"manifest_version": 2, "name": "page metrics", "version": "1.0.0", "description": "View page load time, size, and request count", "icons": {"48": "icons/gauge-48.png", "96": "icons/gauge-96.png"}, "permissions": ["activeTab", "webNavigation", "storage"], "browser_action": {"default_popup": "reader/metric-popup.html", "default_title": "Metric"}, "browser_specific_settings": {"gecko": {"id": "metric@example.addons", "data_collection_permissions": {"required": ["none"], "description": "This addon collects no user data."}}}, "background": {"scripts": ["gauge/metric-gather.js"]}}