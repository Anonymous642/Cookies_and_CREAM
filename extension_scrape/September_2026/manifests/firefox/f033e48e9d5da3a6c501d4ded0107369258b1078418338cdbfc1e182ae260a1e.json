{"manifest_version": 2, "name": "Split Plus \u2014 Multi-Live Viewer", "version": "1.5.0", "description": "Watch multiple YouTube and Twitch live streams in custom split layouts: streams + chats side by side, swapped, a 2\u00d72 grid, or a no-chat stack made for Firefox's own split view.", "icons": {"48": "icons/icon.svg", "96": "icons/icon.svg"}, "permissions": ["tabs", "storage", "webRequest", "webRequestBlocking", "*://www.youtube.com/*", "*://www.youtube-nocookie.com/*", "*://s.youtube.com/*", "*://www.twitch.tv/*", "*://player.twitch.tv/*"], "browser_action": {"default_title": "Split Plus", "default_popup": "popup/popup.html", "default_icon": "icons/icon.svg"}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["*://www.youtube.com/live_chat*", "*://www.youtube.com/live_chat_replay*"], "js": ["chat-relay.js"], "all_frames": true, "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "split-plus@firefoxsplitplus.local", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}