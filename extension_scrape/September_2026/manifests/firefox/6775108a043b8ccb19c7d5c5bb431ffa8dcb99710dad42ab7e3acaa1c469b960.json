{"manifest_version": 2, "name": "LAN HTTP", "description": "Automatically downgrades HTTPS to HTTP for .lan domains. Prevents browser HTTPS-First/HTTPS-Only mode from upgrading local network services that don't have valid TLS certificates.", "version": "1.3", "browser_specific_settings": {"gecko": {"id": "lan-http@dev-crea.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["webRequest", "webRequestBlocking", "storage", "*://*.lan/*"], "background": {"scripts": ["background.js"]}, "options_ui": {"page": "options.html", "browser_style": true}, "icons": {"48": "icon-48.svg", "96": "icon-96.svg"}}