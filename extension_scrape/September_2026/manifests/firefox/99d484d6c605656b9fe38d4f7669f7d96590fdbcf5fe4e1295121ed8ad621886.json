{"manifest_version": 3, "name": "YouTube Shorts Blocker", "version": "1.2", "description": "Limits the number of YouTube Shorts you can watch per day, with a customizable daily limit.", "permissions": ["storage"], "host_permissions": ["https://www.youtube.com/*"], "content_scripts": [{"matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}], "action": {"default_popup": "popup.html", "default_icon": "icon.png"}, "browser_specific_settings": {"gecko": {"id": "shorts.limiters@extensions.com", "strict_min_version": "102.0"}}}