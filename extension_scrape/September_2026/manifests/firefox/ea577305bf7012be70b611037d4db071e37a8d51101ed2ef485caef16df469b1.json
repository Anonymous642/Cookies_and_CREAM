{"manifest_version": 3, "name": "MCP Auto-Confirm", "version": "1.1.0", "description": "Automatically checks 'Don't ask again' and clicks Confirm for MCP connector dialogs on ChatGPT.", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "action": {"default_title": "MCP Auto-Confirm", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["*://chatgpt.com/*", "*://www.chatgpt.com/*", "*://chat.openai.com/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true}], "host_permissions": ["*://chatgpt.com/*", "*://www.chatgpt.com/*", "*://chat.openai.com/*"], "browser_specific_settings": {"gecko": {"id": "mcp-autoconfirm@example.com", "strict_min_version": "109.0"}}}