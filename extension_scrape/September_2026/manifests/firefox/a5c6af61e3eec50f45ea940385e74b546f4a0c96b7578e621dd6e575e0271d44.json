{"manifest_version": 3, "name": "Distraction-Free Browser", "version": "0.1.0", "description": "Hide distracting content on YouTube, Facebook, and TikTok.", "permissions": ["storage", "unlimitedStorage"], "background": {"service_worker": "dist/background.js", "scripts": ["dist/background.js"]}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "host_permissions": ["*://*.youtube.com/*", "*://*.facebook.com/*", "*://*.tiktok.com/*"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["dist/content/youtube.js"], "css": ["styles/youtube.css"], "run_at": "document_start"}, {"matches": ["*://*.facebook.com/*"], "js": ["dist/content/facebook.js"], "css": ["styles/facebook.css"], "run_at": "document_start"}, {"matches": ["*://*.tiktok.com/*"], "js": ["dist/content/tiktok.js"], "css": ["styles/tiktok.css"], "run_at": "document_start"}], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup/popup.html", "default_title": "Distraction-Free Browser", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "browser_specific_settings": {"gecko": {"id": "distraction-free-browser@local", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["none"]}}}}