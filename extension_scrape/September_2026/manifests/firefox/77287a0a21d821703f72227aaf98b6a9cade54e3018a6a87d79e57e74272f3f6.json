{"manifest_version": 3, "name": "YouTube and Facebook AdBlocker Pro", "version": "21.0", "description": "Professional YouTube & Facebook ad blocker. Skip ads, block sponsored posts, ultra-compact UI.", "author": "Md. Abdur Rob (abdur.rob43@gmail.com)", "browser_specific_settings": {"gecko": {"id": "b5788c02-d927-4640-95bb-1380cd46686b@addon.local", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"], "optional": []}}}, "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["*://*.youtube.com/*", "*://*.facebook.com/*", "*://*.fb.com/*"], "background": {"scripts": ["background.js"]}, "action": {"default_popup": "popup.html", "default_title": "AdBlocker Pro"}, "icons": {"16": "icon16.png", "48": "icon48.png", "128": "icon128.png"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.facebook.com/*", "*://*.fb.com/*"], "js": ["content.js"], "css": ["style.css"], "run_at": "document_idle"}]}