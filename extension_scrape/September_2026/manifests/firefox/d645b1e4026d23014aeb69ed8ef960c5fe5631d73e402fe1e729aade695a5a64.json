{"name": "Nami Tab", "version": "0.9", "manifest_version": 3, "description": "Custom new tab view", "background": {"service_worker": "background.js", "scripts": ["background.js"]}, "permissions": ["storage", "activeTab"], "host_permissions": ["<all_urls>"], "chrome_url_overrides": {"newtab": "newtab.html"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "icons": {"16": "16x16.png", "32": "32x32.png", "48": "48x48.png", "128": "128x128.png"}, "commands": {"toggle-search": {"suggested_key": {"default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y"}, "description": "Open the search bar"}}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "nami-tab@faso", "strict_min_version": "109.0"}}}