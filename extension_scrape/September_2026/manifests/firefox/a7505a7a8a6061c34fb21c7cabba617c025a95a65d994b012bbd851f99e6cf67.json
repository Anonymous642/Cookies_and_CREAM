{"manifest_version": 3, "name": "NotebookLM Tex, MD Exporter", "version": "1.8", "description": "Turn your NotebookLM Notes to .tex, .md files", "permissions": ["notifications", "storage"], "host_permissions": ["https://notebooklm.google.com/*"], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self';"}, "background": {"scripts": ["background.js"]}, "action": {"default_popup": "index.html"}, "content_scripts": [{"matches": ["https://notebooklm.google.com/notebook/*"], "js": ["content.js"], "run_at": "document_idle"}], "icons": {"32": "icon32.png", "48": "icon48.png", "128": "icon128.png"}, "browser_specific_settings": {"gecko": {"id": "notebooklm-tex-md-exporter@none.com", "data_collection_permissions": {"required": ["none"]}}}}