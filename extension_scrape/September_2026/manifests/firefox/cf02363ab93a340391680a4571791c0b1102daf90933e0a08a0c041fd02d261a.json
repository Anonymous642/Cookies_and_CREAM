{"manifest_version": 3, "name": "AutoCV: Tailor your resume", "version": "0.6.2", "description": "Turn the job posting you are reading into an AutoCV application.", "permissions": ["activeTab", "scripting", "storage"], "host_permissions": ["https://autocv.online/*"], "action": {"default_title": "Capture this job posting", "default_popup": "popup.html"}, "background": {"scripts": ["core.js", "background.js"]}, "options_ui": {"page": "options.html"}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "content_scripts": [{"matches": ["https://autocv.online/*"], "js": ["announce.js"], "run_at": "document_start"}], "browser_specific_settings": {"gecko": {"id": "autocv@autocv.online", "strict_min_version": "115.0", "data_collection_permissions": {"required": ["websiteContent", "websiteActivity", "authenticationInfo"]}}}}