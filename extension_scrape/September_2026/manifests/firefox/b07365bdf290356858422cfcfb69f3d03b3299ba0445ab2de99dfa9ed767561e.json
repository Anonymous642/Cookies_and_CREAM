{"manifest_version": 3, "name": "AI Studio Automator", "version": "1.0.0", "browser_specific_settings": {"gecko": {"id": "ai-studio-automator@gmail.com"}}, "description": "Automates setting prompt to 'another' and clicking Run on aistudio.google.com with token cap handling.", "action": {"default_title": "AI Studio Automator", "default_popup": "src/popup.html"}, "permissions": ["storage", "activeTab", "tabs"], "host_permissions": ["https://aistudio.google.com/*"], "icons": {"16": "src/icons/icon.png", "32": "src/icons/icon.png", "48": "src/icons/icon.png", "128": "src/icons/icon.png"}, "content_scripts": [{"matches": ["https://aistudio.google.com/*"], "js": ["src/content.js"], "run_at": "document_idle"}]}