{"manifest_version": 3, "name": "YDL GUI Helper", "description": "Send video URLs and cookies to the YDL GUI desktop app.", "default_locale": "en", "version": "2.0.0", "permissions": ["cookies", "contextMenus", "notifications", "tabs", "storage"], "host_permissions": ["http://127.0.0.1:17654/*", "http://*/*", "https://*/*"], "background": {"scripts": ["background.js"], "type": "module"}, "browser_specific_settings": {"gecko": {"id": "ydlguihelper@example.com", "strict_min_version": "112.0", "data_collection_permissions": {"required": ["none"]}}}, "action": {"default_popup": "popup.html", "default_title": "YDL GUI Helper", "default_icon": {"32": "icons/icon16.png", "64": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"32": "icons/icon16.png", "64": "icons/icon48.png", "128": "icons/icon128.png"}}