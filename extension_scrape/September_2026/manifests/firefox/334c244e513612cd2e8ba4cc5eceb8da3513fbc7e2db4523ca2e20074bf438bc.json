{"manifest_version": 3, "name": "AdCut", "version": "2.0.11", "description": "A fast, privacy-first YouTube playback companion with responsive ad-skip handling and background-play assistance.", "developer": {"name": "Rakesh V"}, "browser_specific_settings": {"gecko": {"id": "adcut-pro@yourdomain.com", "strict_min_version": "140.0"}}, "permissions": ["storage", "declarativeNetRequest"], "host_permissions": ["https://*.youtube.com/*", "https://*.googlevideo.com/*", "https://*.doubleclick.net/*", "https://*.googleadservices.com/*", "https://*.googlesyndication.com/*", "https://adcut-app.netlify.app/*"], "action": {"default_title": "AdCut", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "96": "icons/icon96.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["content.js"], "run_at": "document_start"}], "homepage_url": "https://adcut-app.netlify.app/support", "declarative_net_request": {"rule_resources": [{"id": "adcut-rules", "enabled": true, "path": "rules.json"}]}}