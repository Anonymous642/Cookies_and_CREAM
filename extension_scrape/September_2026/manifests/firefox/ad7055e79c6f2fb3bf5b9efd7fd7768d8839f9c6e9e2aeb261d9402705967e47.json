{"manifest_version": 2, "name": "Auto Pause and Resume YouTube", "version": "1.0", "description": "Automatically pauses YouTube videos when you leave the page or tab and resumes them when you return.", "permissions": ["tabs", "storage"], "content_scripts": [{"matches": ["*://*.youtube.com/*"], "js": ["content.js"]}], "background": {"scripts": ["background.js"]}, "commands": {"toggle-pause-resume": {"suggested_key": {"default": "Ctrl+Shift+F"}, "description": "Toggle auto pause and resume"}}, "browser_action": {"default_popup": "popup.html", "default_icon": {"48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"48": "icons/icon48.png", "128": "icons/icon128.png"}, "applications": {"gecko": {"id": "auto-pause-resume-youtube@rudraksh.dev"}}}