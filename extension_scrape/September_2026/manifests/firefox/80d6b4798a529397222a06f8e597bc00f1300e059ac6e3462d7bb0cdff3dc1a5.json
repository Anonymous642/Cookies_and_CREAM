{"manifest_version": 3, "name": "Bulgarian Accenter", "description": "Marks stressed vowels in Bulgarian text on any page, offline, from a built-in dictionary.", "homepage_url": "https://github.com/noomorph/bulgarian-accenter", "action": {"default_title": "Bulgarian Accenter", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/dict.js", "src/accent.js", "src/content.js"], "run_at": "document_idle"}], "version": "1.0.2", "background": {"scripts": ["src/background.js"]}, "browser_specific_settings": {"gecko": {"id": "bulgarian-accenter@noomorph.github.io", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}, "web_accessible_resources": [{"resources": ["data/stress-dict.txt"], "matches": ["<all_urls>"]}]}