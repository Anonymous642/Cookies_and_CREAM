{"manifest_version": 3, "name": "HistA", "version": "1.0.1", "description": "HistA is an addon which allows you to re-enable autocorrect on a site which has auto-correct turned off", "permissions": ["tabs", "storage"], "host_permissions": ["*://*.mheducation.com/*", "*://learning.mheducation.com/*"], "background": {"scripts": ["background.js"], "type": "module"}, "content_scripts": [{"matches": ["*://*.mheducation.com/*"], "js": ["mainScript.js"], "run_at": "document_idle"}], "icons": {"16": "icons/pen-16.png", "32": "icons/pen-32.png", "96": "icons/pen-96.png"}, "action": {"default_title": "HistA", "default_popup": "popup.html", "default_icon": {"16": "icons/pen-16.png", "32": "icons/pen-32.png", "48": "icons/pen-48.png", "96": "icons/pen-96.png", "128": "icons/pen-128"}}, "browser_specific_settings": {"gecko": {"id": "hista@extension", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}