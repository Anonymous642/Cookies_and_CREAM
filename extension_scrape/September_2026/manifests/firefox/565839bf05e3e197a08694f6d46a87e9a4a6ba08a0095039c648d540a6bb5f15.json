{"manifest_version": 2, "name": "wikkily", "version": "1.0", "description": "Maps link surfing on Wikipedia.", "icons": {"48": "icon.jpg"}, "browser_specific_settings": {"gecko": {"id": "ravidosa@proton.me", "strict_min_version": "58.0", "data_collection_permissions": {"required": ["none"]}}}, "content_scripts": [{"matches": ["*://*.wikipedia.org/wiki/*"], "js": ["wikkily.js"]}], "permissions": ["contextMenus"], "browser_action": {"default_title": "wikkily"}, "background": {"scripts": ["background.js"]}}