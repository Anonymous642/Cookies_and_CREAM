{"manifest_version": 3, "name": "TextExpander", "version": "1.0.0", "description": "Text snippet expander. Save and quickly insert text snippets with shortcuts.", "icons": {"48": "expander-icons/icon-48.png", "96": "expander-icons/icon-96.png", "128": "expander-icons/icon-128.png"}, "action": {"default_icon": {"48": "expander-icons/icon-48.png", "96": "expander-icons/icon-96.png"}, "default_title": "TextExpander", "default_popup": "expander-ui/snippets.html"}, "permissions": ["clipboardWrite", "storage"], "browser_specific_settings": {"gecko": {"id": "textexpander@snippet.tool", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}