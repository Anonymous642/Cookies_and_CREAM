{"manifest_version": 2, "name": "LockOut", "version": "0.4.0", "description": "Local-first website lockouts with rolling usage limits, schedules, and configurable strictness.", "incognito": "not_allowed", "permissions": ["<all_urls>", "idle", "storage", "tabs", "webRequest", "webRequestBlocking"], "background": {"scripts": ["src/shared.js", "src/background.js"], "persistent": true}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["src/usage-nudge.js"], "run_at": "document_idle"}], "browser_action": {"default_title": "LockOut", "default_popup": "popup/popup.html"}, "options_ui": {"page": "options/options.html", "open_in_tab": true}, "web_accessible_resources": ["blocked/blocked.html"], "browser_specific_settings": {"gecko": {"id": "lockout@local.extension", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}