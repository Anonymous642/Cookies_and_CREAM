{"manifest_version": 3, "name": "Senior Defender", "version": "1.0.0", "description": "One-click safety check for links and emails. Built for seniors. No ads. No tracking.", "permissions": ["contextMenus", "activeTab", "storage", "alarms"], "action": {"default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "background": {"scripts": ["background.js"], "persistent": false}, "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "host_permissions": ["https://api.seniordefender.com/*", "https://seniordefender.com/*"], "options_page": "options.html", "options_ui": {"page": "options.html", "open_in_tab": false}, "browser_specific_settings": {"gecko": {"id": "seniordefender@seniordefender.com", "data_collection_permissions": {"required": ["websiteContent"]}}}}