{"manifest_version": 2, "name": "Nexus", "description": "Save pages to your Nexus bookmark library in one click.", "version": "0.1.0", "short_name": "Nexus", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "permissions": ["activeTab", "storage", "identity", "https://stash.nexus/*"], "background": {"scripts": ["background.js"]}, "browser_specific_settings": {"gecko": {"id": "nexus@stash.nexus", "strict_min_version": "127.0", "data_collection_permissions": {"required": ["authenticationInfo", "bookmarksInfo"]}}}, "browser_action": {"default_title": "Nexus", "default_popup": "popup.html"}}