{"manifest_version": 2, "name": "LuLuksa Startpage", "version": "1.0.2", "description": "Forces https://app.luluksa.de/firefox/ as New Tab and homepage.", "permissions": ["tabs", "<all_urls>"], "background": {"scripts": ["background.js"]}, "chrome_url_overrides": {"newtab": "forced-newtab.html"}, "chrome_settings_overrides": {"homepage": "https://app.luluksa.de/firefox/"}, "browser_specific_settings": {"gecko": {"id": "startpage-forcer@local", "strict_min_version": "91.0", "data_collection_permissions": {"required": ["none"]}}}, "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png"}, "homepage_url": "https://luluksa.de"}