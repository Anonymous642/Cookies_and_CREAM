{"manifest_version": 3, "name": "Youtio", "version": "1.0.2", "description": "Optimize YouTube Studio titles, descriptions, tags and thumbnails with AI. Requires a Youtio account.", "icons": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "action": {"default_title": "Youtio", "default_popup": "popup.html", "default_icon": {"16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["storage", "activeTab", "scripting", "cookies"], "host_permissions": ["https://studio.youtube.com/*", "https://www.youtube.com/*", "https://yt3.ggpht.com/*", "https://*.ggpht.com/*", "https://i.ytimg.com/*", "https://yteklentiai.vercel.app/*", "https://youtio.com/*", "https://www.youtio.com/*"], "sidebar_action": {"default_title": "Youtio", "default_panel": "popup.html", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png"}, "open_at_install": false}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://studio.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'"}, "homepage_url": "https://youtio.com", "browser_specific_settings": {"gecko": {"id": "youtio@youtio.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}