{"manifest_version": 3, "name": "ArchLinuxCN Wiki Search", "short_name": "archlinuxcn_search_wiki", "description": "Adds ArchLinuxCN Wiki as a search engine.", "version": "1.0.0", "icons": {"16": "icons/arch-w.svg", "64": "icons/arch-w.svg", "256": "icons/arch-w.svg"}, "chrome_settings_overrides": {"search_provider": {"name": "ArchLinuxCN Wiki", "keyword": "alcnwiki", "favicon_url": "icons/arch-w.svg", "search_url": "https://wiki.archlinuxcn.org/wzh/index.php?search={searchTerms}"}}, "browser_specific_settings": {"gecko": {"id": "ArchLinuxCNWiki@archlinuxcn.org", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["searchTerms"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "author": "snowdropQwQ", "homepage_url": "https://github.com/xpe-online/firefox-extension-arch-search-archcn"}