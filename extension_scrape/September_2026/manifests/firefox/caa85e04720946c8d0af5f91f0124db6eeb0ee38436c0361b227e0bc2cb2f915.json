{"manifest_version": 2, "name": "React-DomPicker (Official)", "version": "1.2.3", "description": "Click any UI element to instantly jump to its React source code in VS Code. Perfect for React + Tailwind + ShadCN projects.", "author": "Rajitha Disanayaka", "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "background": {"scripts": ["background.js"], "persistent": false}, "browser_action": {"default_icon": {"16": "icons/inactive-16.png", "32": "icons/inactive-32.png", "48": "icons/inactive-48.png"}, "default_title": "React-DomPicker (Click to toggle)"}, "options_page": "options.html", "permissions": ["activeTab", "tabs", "storage", "http://localhost/*", "http://127.0.0.1/*", "https://localhost/*", "https://127.0.0.1/*"], "content_scripts": [{"matches": ["http://localhost/*", "http://127.0.0.1/*", "https://localhost/*", "https://127.0.0.1/*"], "js": ["hook-installer.js"], "run_at": "document_start"}, {"matches": ["http://localhost/*", "http://127.0.0.1/*", "https://localhost/*", "https://127.0.0.1/*"], "js": ["bridge.js"], "run_at": "document_start"}], "commands": {"toggle-picker": {"suggested_key": {"default": "Ctrl+Shift+P", "mac": "Command+Shift+P"}, "description": "Toggle React-DomPicker on/off"}}, "content_security_policy": "script-src 'self'; object-src 'self';", "browser_specific_settings": {"gecko": {"id": "react-dompicker-official@dom-map.dev", "strict_min_version": "126.0", "data_collection_permissions": {"required": ["none"]}}}}