{"manifest_version": 3, "name": "SciCalc Sidekick \u2014 Scientific Calculator", "version": "2.0.1", "description": "A precision scientific calculator beside every page: LaTeX-typeset results, unit-aware math, persistent history. By Science Digest.", "homepage_url": "https://sciencedigest.org", "action": {"default_popup": "src/popup/index.html", "default_title": "SciCalc Sidekick"}, "background": {"scripts": ["service-worker-loader.js"], "type": "module"}, "permissions": ["storage", "contextMenus", "activeTab", "scripting", "alarms"], "host_permissions": [], "commands": {"toggle-panel": {"suggested_key": {"default": "Alt+Shift+S"}, "description": "Toggle SciCalc side panel"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; style-src 'self' 'unsafe-inline'"}, "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "sidebar_action": {"default_panel": "src/sidepanel/index.html", "default_title": "SciCalc Sidekick"}, "browser_specific_settings": {"gecko": {"id": "scicalc-sidekick@sciencedigest.org", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["none"]}}}}