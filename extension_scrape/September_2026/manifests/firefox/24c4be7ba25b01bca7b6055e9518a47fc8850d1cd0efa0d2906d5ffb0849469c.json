{"manifest_version": 3, "name": "Essentials", "version": "1.1.2", "description": "Your favorite sites, one click away. Color-coded spaces, Firefox Sync, and no developer telemetry.", "permissions": ["storage", "tabs", "contextMenus", "scripting", "alarms"], "host_permissions": ["<all_urls>"], "background": {"scripts": ["background/index.js"], "type": "module"}, "action": {"default_popup": "popup/index.html", "default_title": "Essentials", "default_icon": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png"}, "theme_icons": [{"light": "assets/icons/icon-16-light.png", "dark": "assets/icons/icon-16.png", "size": 16}, {"light": "assets/icons/icon-32-light.png", "dark": "assets/icons/icon-32.png", "size": 32}, {"light": "assets/icons/icon-48-light.png", "dark": "assets/icons/icon-48.png", "size": 48}]}, "options_ui": {"page": "options/index.html", "open_in_tab": true}, "commands": {"_execute_action": {"suggested_key": {"default": "Ctrl+Shift+E", "mac": "Command+Shift+E"}, "description": "Toggle the Essentials popup"}}, "icons": {"16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png", "256": "assets/icons/icon-256.png"}, "browser_specific_settings": {"gecko": {"id": "essentials@essentialsforfirefox.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "personallyIdentifyingInfo"]}}}}