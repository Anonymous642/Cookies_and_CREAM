{"manifest_version": 3, "name": "eGCA -ATC Logbook Autofill", "version": "2.16.0", "description": "Fills eGCA ATC e-Logbook entries from a CSV file, one at a time. Never auto-submits \u2014 you review and submit every entry yourself.", "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}, "action": {"default_popup": "popup.html", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}}, "permissions": ["activeTab", "scripting", "storage"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["https://iamatc.aai.aero/*", "https://*.iamatc.aai.aero/*"], "js": ["iamatc-bridge.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "egca-atc-logbook-autofill@iamatc.aai.aero", "strict_min_version": "128.0"}}}