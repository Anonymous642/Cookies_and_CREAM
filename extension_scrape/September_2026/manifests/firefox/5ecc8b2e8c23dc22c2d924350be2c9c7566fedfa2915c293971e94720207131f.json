{"manifest_version": 3, "name": "TabVault", "version": "1.0.1", "description": "Git-inspired tab manager. Save workspaces as commits, compare tab diffs, and sync with Firebase.", "browser_specific_settings": {"gecko": {"id": "tabvault@tabstore.app", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["browsingActivity", "personallyIdentifyingInfo"], "optional": []}}, "gecko_android": {"strict_min_version": "142.0"}}, "permissions": ["tabs", "storage", "alarms"], "host_permissions": ["https://*.googleapis.com/*", "https://*.gstatic.com/*", "https://*.firebaseapp.com/*", "https://github.com/*", "https://api.github.com/*"], "action": {"default_popup": "popup.html", "default_icon": "icon-128.png"}, "background": {"scripts": ["background.js"]}, "icons": {"48": "icon-48.png", "96": "icon-96.png", "128": "icon-128.png"}}