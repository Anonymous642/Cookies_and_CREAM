{"manifest_version": 2, "name": "Grab Largest Image From Tabs", "version": "2.1", "description": "Find the largest image (by file size) in each tab in a window and download it", "permissions": ["<all_urls>", "tabs", "downloads", "menus", "storage"], "background": {"scripts": ["background.js"], "persistent": false}, "browser_specific_settings": {"gecko": {"id": "GrabLargestImageFromTabs@OpenAddons.null", "data_collection_permissions": {"required": ["none"]}}}, "browser_action": {"default_popup": "popup/popup.html", "default_title": "Grab Image", "default_icon": "icon.svg", "theme_icons": [{"light": "icon.svg", "dark": "icon.svg", "size": 32}]}, "icons": {"16": "icon.svg", "32": "icon.svg", "48": "icon.svg", "96": "icon.svg"}}