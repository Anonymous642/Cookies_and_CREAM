{"manifest_version": 3, "name": "Memedex", "description": "Capture memes from the web and add them to your Memedex collection.", "version": "0.2.0", "short_name": "Memedex", "icons": {"16": "icon/16.png", "48": "icon/48.png", "128": "icon/128.png"}, "permissions": ["storage", "identity", "activeTab"], "host_permissions": ["<all_urls>"], "action": {"default_title": "Memedex", "default_popup": "popup.html"}, "options_ui": {"open_in_tab": false, "page": "options.html"}, "commands": {"open-picker": {"description": "Open Memedex image picker on the current tab", "suggested_key": {"default": "Ctrl+Shift+M", "mac": "Command+Shift+M"}}}, "browser_specific_settings": {"gecko": {"id": "memedex@thememedex.com", "strict_min_version": "142.0", "data_collection_permissions": {"required": ["authenticationInfo", "browsingActivity", "websiteContent"]}}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "run_at": "document_idle", "js": ["content-scripts/content.js"]}], "web_accessible_resources": [{"resources": ["content-scripts/content.css"], "use_dynamic_url": true, "matches": ["<all_urls>"]}]}