{"manifest_version": 3, "name": "Tab Mover", "version": "1.0", "description": "Move active tab left or right using keyboard shortcuts.", "permissions": ["tabs"], "browser_specific_settings": {"gecko": {"id": "tab-mover@yourdomain.local", "data_collection_permissions": {"required": ["none"]}}}, "background": {"scripts": ["background.js"]}, "commands": {"move-tab-left": {"suggested_key": {"default": "Alt+Shift+Q"}, "description": "Move tab left"}, "move-tab-right": {"suggested_key": {"default": "Alt+Shift+W"}, "description": "Move tab right"}}}