{"manifest_version": 2, "name": "Thinking Efficiency Score", "version": "1.3", "description": "A Firefox extension to analyze web pages and calculate a Thinking Efficiency Score based on signal-to-noise ratio and cognitive load.", "browser_action": {"default_icon": "icons/logo_64.png", "default_title": "Thinking Efficiency Score", "default_popup": "popup.html"}, "background": {"scripts": ["background.js"], "persistent": false}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"]}], "permissions": ["activeTab", "storage", "notifications", "contextMenus"], "icons": {"32": "icons/logo_32.png", "64": "icons/logo_64.png", "128": "icons/logo_128.png"}, "browser_specific_settings": {"gecko": {"id": "@Thinking-Efficiency-Score", "data_collection_permissions": {"required": ["locationInfo"], "optional": ["technicalAndInteraction"]}}}}