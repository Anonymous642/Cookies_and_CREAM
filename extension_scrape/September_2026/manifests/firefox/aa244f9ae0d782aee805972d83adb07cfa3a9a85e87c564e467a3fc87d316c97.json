{"manifest_version": 3, "name": "Tria \u00b7 derive", "version": "1.0.0", "description": "Deterministic password generator, in your sidebar. Nothing is stored, nothing is sent.", "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}, "sidebar_action": {"default_panel": "sidebar.html", "default_title": "Tria", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}}, "permissions": ["tabs", "activeTab", "clipboardWrite"], "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"}, "browser_specific_settings": {"gecko": {"id": "tria-derive@yourdomain.example", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}