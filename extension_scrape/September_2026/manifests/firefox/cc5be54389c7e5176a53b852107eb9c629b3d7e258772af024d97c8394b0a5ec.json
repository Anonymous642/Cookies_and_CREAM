{"manifest_version": 2, "name": "Hintergrundgrafik anzeigen", "version": "1.0", "description": "Zeigt CSS-Hintergrundbilder von Elementen in einem neuen Tab an. Rechtsklick auf ein Element und 'Hintergrundgrafik anzeigen' w\u00e4hlen.", "permissions": ["contextMenus", "activeTab"], "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": true}], "icons": {"48": "icon-48.svg", "96": "icon-96.svg"}, "browser_specific_settings": {"gecko": {"id": "hintergrundgrafik-anzeigen@erweiterung", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["none"]}}, "gecko_android": {"strict_min_version": "142.0"}}}