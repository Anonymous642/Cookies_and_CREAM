{"manifest_version": 3, "name": "Tomesphere", "version": "1.0.9", "description": "TLDR, citations, linked entities, and similar papers shown beside the research paper you're reading.", "browser_specific_settings": {"gecko": {"id": "tomesphere@tomesphere.com", "strict_min_version": "128.0", "data_collection_permissions": {"required": ["none"]}}}, "permissions": ["storage", "activeTab", "tabs", "contextMenus"], "host_permissions": ["https://arxiv.org/*", "https://www.arxiv.org/*", "https://pmc.ncbi.nlm.nih.gov/*", "https://www.ncbi.nlm.nih.gov/*", "https://www.biorxiv.org/*", "https://www.medrxiv.org/*", "https://elifesciences.org/*", "https://f1000research.com/*", "https://scholar.google.com/*", "https://paperverse.science/*", "https://tomesphere.com/*", "https://www.tomesphere.com/*", "http://localhost:3000/*", "http://localhost:3001/*"], "action": {"default_title": "Open Tomesphere panel", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}}, "icons": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "sidebar_action": {"default_title": "Tomesphere", "default_panel": "panel/panel.html", "default_icon": {"16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "open_at_install": false}, "background": {"scripts": ["background/service-worker-firefox.js"]}, "content_scripts": [{"matches": ["https://arxiv.org/abs/*", "https://www.arxiv.org/abs/*", "https://arxiv.org/pdf/*", "https://www.arxiv.org/pdf/*"], "js": ["content/arxiv.js"], "run_at": "document_idle"}, {"matches": ["https://pmc.ncbi.nlm.nih.gov/articles/*", "https://www.ncbi.nlm.nih.gov/pmc/articles/*", "https://www.biorxiv.org/content/*", "https://www.medrxiv.org/content/*", "https://elifesciences.org/articles/*", "https://f1000research.com/articles/*"], "js": ["content/universal.js"], "run_at": "document_idle"}, {"matches": ["https://scholar.google.com/scholar*"], "js": ["content/scholar.js"], "run_at":