{"manifest_version": 3, "name": "Reel Control for Instagram", "version": "1.0.0", "description": "Sets a custom daily limit on Instagram Reels.", "permissions": ["storage"], "host_permissions": ["https://www.instagram.com/*"], "action": {"default_popup": "popup.html", "default_title": "Reel Control"}, "content_scripts": [{"matches": ["https://www.instagram.com/*"], "js": ["content.js"], "run_at": "document_idle"}], "browser_specific_settings": {"gecko": {"id": "reel-control@example.com", "data_collection_permissions": {"required": ["none"]}}}}