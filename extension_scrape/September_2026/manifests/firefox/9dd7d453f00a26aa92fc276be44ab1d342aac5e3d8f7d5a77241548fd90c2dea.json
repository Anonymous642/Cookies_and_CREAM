{"manifest_version": 3, "name": "TunnelBear VPN", "short_name": "TunnelBear VPN", "description": "Rawwwr! Put a Bear in your browser and privately access a more open internet in seconds!", "homepage_url": "https://tunnelbear.com", "author": "TunnelBear Inc.", "incognito": "spanning", "action": {"default_popup": "src/index.html", "default_icon": "assets/images/icon_off_grey.png"}, "icons": {"16": "assets/images/icon_16.png", "128": "assets/images/icon_128.png"}, "background": {"scripts": ["src/service-worker.js"], "type": "module"}, "permissions": ["proxy", "storage", "declarativeNetRequest", "webRequest", "privacy", "webRequestBlocking"], "host_permissions": ["<all_urls>"], "commands": {"toggle-tunnelling": {"suggested_key": {"default": "Ctrl+Shift+U", "windows": "Ctrl+Shift+U", "mac": "Command+Shift+U"}, "description": "Toggle tunnelling"}, "incognito-tunnelling": {"suggested_key": {"default": "Alt+Shift+N", "windows": "Alt+Shift+N", "mac": "Alt+Shift+N"}, "description": "Incognito tunnelling"}, "send-feedback": {"description": "Send feedback"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}, "developer": {"name": "TunnelBear Inc.", "url": "https://www.tunnelbear.com"}, "browser_specific_settings": {"gecko": {"id": "browser@tunnelbear.com", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["authenticationInfo", "locationInfo", "personallyIdentifyingInfo"], "optional": ["technicalAndInteraction"]}}}, "version": "4.5.0"}