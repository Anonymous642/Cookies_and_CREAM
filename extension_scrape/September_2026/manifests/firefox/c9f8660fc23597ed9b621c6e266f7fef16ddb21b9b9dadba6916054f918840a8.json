{"manifest_version": 2, "browser_specific_settings": {"gecko": {"id": "blurs@blurs.app", "strict_min_version": "79.0"}}, "name": "Blurs", "version": "0.1.0", "description": "Hide your browser info", "author": "Blurs Team", "homepage_url": "https://www.blurs.app", "permissions": ["storage", "activeTab", "tabs", "<all_urls>"], "browser_action": {"default_popup": "popup.html", "default_icon": {"16": "images/icon.png", "48": "images/icon.png", "128": "images/icon.png"}}, "background": {"scripts": ["background.js"]}, "content_scripts": [{"matches": ["<all_urls>"], "js": ["content.js"], "css": ["styles.css"], "run_at": "document_end"}], "icons": {"16": "images/icon.png", "48": "images/icon.png", "128": "images/icon.png"}, "web_accessible_resources": ["images/pixelated.webp", "images/remove.svg", "images/icon.png", "images/fixed.svg", "images/check.svg", "images/blur.png", "images/icon-inactive.png"]}