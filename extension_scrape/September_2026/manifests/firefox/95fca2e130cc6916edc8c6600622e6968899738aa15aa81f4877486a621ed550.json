{"manifest_version": 2, "name": "SubFinder Lite", "version": "1.0.0", "description": "Quickly toggle and select available subtitles on supported video sites like YouTube or Vimeo.", "permissions": ["activeTab"], "browser_action": {"default_title": "SubFinder Lite", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.youtube.com/*", "*://*.vimeo.com/*"], "js": ["content.js"]}], "browser_specific_settings": {"gecko": {"id": "subfinder-lite@amo.local", "data_collection_permissions": {"required": ["none"], "optional": []}}}}