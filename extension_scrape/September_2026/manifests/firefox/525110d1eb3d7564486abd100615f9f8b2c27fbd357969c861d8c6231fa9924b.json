{"manifest_version": 3, "name": "YTZero Redirect", "version": "1.1", "description": "Redirects YouTube URLs to a self-hosted YTZero instance.", "permissions": ["webNavigation", "tabs", "storage"], "host_permissions": ["*://*.youtube.com/*"], "icons": {"48": "icon-48.png", "128": "icon-128.png"}, "background": {"scripts": ["background.js"], "service_worker": "background.js"}, "options_ui": {"page": "options.html", "open_in_tab": true}, "action": {"default_popup": "popup.html", "default_title": "YTZero Redirect", "default_icon": "icon.svg"}, "browser_specific_settings": {"gecko": {"id": "ytzero-redirect@pekempy", "strict_min_version": "109.0", "data_collection_permissions": {"required": ["none"]}}}}