{"manifest_version": 3, "name": "YT Music Keep Alive", "version": "1.0.0", "description": "YouTube Music / YouTube \u306e\u30bf\u30d6\u304c\u975e\u30a2\u30af\u30c6\u30a3\u30d6\u306b\u306a\u3063\u3066\u3082\u518d\u751f\u3092\u6b62\u3081\u306a\u3044", "permissions": ["storage"], "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"}, "action": {"default_popup": "popup.html", "default_title": "YT Music Keep Alive", "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}}, "content_scripts": [{"matches": ["https://music.youtube.com/*", "https://www.youtube.com/*"], "js": ["keepalive-loader.js"], "run_at": "document_start"}], "web_accessible_resources": [{"resources": ["keepalive-inject.js"], "matches": ["https://music.youtube.com/*", "https://www.youtube.com/*"]}], "browser_specific_settings": {"gecko": {"id": "yt-music-keepalive@example.com", "data_collection_permissions": {"required": ["none"]}}}}