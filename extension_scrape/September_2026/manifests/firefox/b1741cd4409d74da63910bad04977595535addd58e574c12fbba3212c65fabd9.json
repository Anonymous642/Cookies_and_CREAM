{"manifest_version": 3, "name": "AI Prompt Modifier", "description": "AI Prompt Modifier lets you easily adjust prompts on several ai chatbot websites for consistent and customized replies", "version": "5.3", "icons": {"16": "icon/16.png", "32": "icon/32.png", "48": "icon/48.png", "96": "icon/96.png", "128": "icon/128.png"}, "default_locale": "en", "permissions": ["activeTab", "storage", "scripting"], "host_permissions": ["*://*.chatgpt.com/*"], "oauth2": {"client_id": "modify-chatgpt-prompts-prod.apps.googleusercontent.com", "scopes": ["email", "profile"]}, "browser_specific_settings": {"gecko": {"id": "ef123789-3b2b-4a4d-a614-2fec04dfd00f@ai-propmt-modifier"}}, "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' blob: data: unsafe-eval"}, "background": {"scripts": ["background.js"]}, "action": {"default_title": "AI Prompt Modifier", "default_popup": "popup.html"}, "content_scripts": [{"matches": ["*://*.chatgpt.com/*", "*://*.deepseek.com/*"], "js": ["content-scripts/content.js"]}]}